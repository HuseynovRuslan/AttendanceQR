---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContactBody from '../../components/Pages/Contact/ContactBody.astro'
import { useTranslations } from '../../i18n/ui'
const lang = 'en' as const
const t = useTranslations(lang)
---
<BaseLayout lang={lang} path="/elaqe/" title={t('contact.metaTitle')} description={t('contact.metaDesc')}>
  <ContactBody lang={lang} />
</BaseLayout>
