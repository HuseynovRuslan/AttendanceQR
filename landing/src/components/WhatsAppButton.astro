---
/**
 * Sağ aşağı küncdə üzən WhatsApp düyməsi — BaseLayout onu hər səhifəyə qoyur.
 *
 * BaseLayout-da `.qrl-page`-dən KƏNARDA durmalıdır: loader bitəndə `.qrl-page`-ə transform animasiyası
 * verilir, transformlu valideynin içində isə `position: fixed` ekrana yox, həmin valideynə bağlanır.
 *
 * Görünmə anı üçün öz taymeri yoxdur. Loader (PageLoader.astro) işini bitirəndə <html>-dən
 * `qrl-lock`-u götürür — giriş animasiyası (0.6s gözləyib 0.4s) və ondan sonrakı üç nəbz o an
 * başlayır. Loader yoxdursa (bfcache-dən qayıdış), `qrl-lock` da yoxdur və düymə dərhal görünür.
 * Nəbz qəsdən üç dəfədir: daim yanıb-sönən element oxumağa mane olur (WCAG 2.2.2).
 *
 * İkon: Font Awesome Free 7.3.1, brands/whatsapp.svg (github.com/FortAwesome/Font-Awesome, 7.x),
 * olduğu kimi — kitabxana qoşulmur. İçindəki lisenziya şərhi CC BY 4.0-ın şərtidir, silinməməlidir.
 * WhatsApp-ın brend qaydasına görə ikon dəyişdirilmir, rəngi ağdır, fon rəsmi #25D366-dır.
 */
import { useTranslations, type Lang } from '../i18n/ui'
import { whatsappUrl } from '../data/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<a
  class="wa-fab"
  href={whatsappUrl(t('wa.message'))}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t('wa.aria')}
  data-wa
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true" focusable="false"><!--! Font Awesome Free 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2026 Fonticons, Inc. --><path fill="currentColor" d="M380.9 97.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480 117.7 449.1c32.4 17.7 68.9 27 106.1 27l.1 0c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zM325.1 300.5c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
  <!-- aria-hidden: the same words are already the link's aria-label; read once, not twice. -->
  <span class="wa-tip" aria-hidden="true">{t('wa.tooltip')}</span>
</a>

<!-- Without JavaScript the loader never takes qrl-lock off, so the button would stay hidden. -->
<noscript><style>html.qrl-lock .wa-fab{opacity:1;visibility:visible}</style></noscript>

<style is:global>
  /* Global, not scoped: the rules below key off classes on <html> (qrl-lock) and on the header
     (data-open), which are outside this component. Every name carries the wa- prefix. */
  .wa-fab {
    position: fixed;
    right: 20px;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    /* Under the loader (#qrl, 1000), over everything else — the header is 50. */
    z-index: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.35);
    transition: background-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .wa-fab:hover {
    background: #1ebe5a;
  }

  .wa-fab:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .wa-fab svg {
    display: block;
    width: 28px;
    height: 28px;
  }

  /* ---------- Entrance: waits for the loader ---------- */
  html.qrl-lock .wa-fab {
    opacity: 0;
    visibility: hidden;
  }

  html:not(.qrl-lock) .wa-fab {
    animation: wa-in 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.6s both;
  }

  @keyframes wa-in {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Three soft pulses once it is in, then still ---------- */
  .wa-fab::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: #25d366;
    opacity: 0;
    pointer-events: none;
  }

  /* 1s = the 0.6s wait + the 0.4s entrance. */
  html:not(.qrl-lock) .wa-fab::after {
    animation: wa-ring 1.6s ease-out 1s 3;
  }

  @keyframes wa-ring {
    from {
      opacity: 0.5;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  /* ---------- Tooltip: desktop pointer only ---------- */
  .wa-tip {
    position: absolute;
    top: 50%;
    right: calc(100% + 12px);
    padding: 7px 11px;
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    box-shadow:
      0 6px 20px -6px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.05);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(4px, -50%);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0s linear 0.15s;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 641px) {
    .wa-fab:hover .wa-tip,
    .wa-fab:focus-visible .wa-tip {
      opacity: 1;
      visibility: visible;
      transform: translate(0, -50%);
      transition-delay: 0s;
    }
  }

  /* ---------- Phone ---------- */
  @media (max-width: 640px) {
    .wa-fab {
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      width: 52px;
      height: 52px;
    }

    .wa-tip {
      display: none;
    }
  }

  /* The open mobile menu can reach the bottom of the screen; the button steps aside. */
  html:has([data-header-bar][data-open]) .wa-fab {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    html:not(.qrl-lock) .wa-fab,
    html:not(.qrl-lock) .wa-fab::after {
      animation: none;
    }

    .wa-fab,
    .wa-tip {
      transition: none;
    }
  }

  @media print {
    .wa-fab {
      display: none !important;
    }
  }
</style>

<script>
  // Analytics are not wired up on this site; whoever adds them listens for this event, as with the
  // how_step event in HowItWorks.astro.
  document.querySelector('[data-wa]')?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('qrlog:track', {
        detail: { event: 'whatsapp_click', path: location.pathname },
      })
    )
  })
</script>
