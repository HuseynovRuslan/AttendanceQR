---
/*
 * Modullar kartlarının ikonu: adı verirsən (`name`), 24×24 xətt ikonunu çəkir.
 * Harada işlənir: yalnız Modules.astro-da, hər kartın ikon plitəsində.
 * Props: name — ikonun adı (aşağıdakı `icons` siyahısından). Ölçünü və yerini Modules.astro-nun
 * CSS-i verir, ikonun rəngi isə ətrafdakı mətnin rəngidir (`currentColor`).
 * SVG kodu bir yerdə, burada saxlanır: yeni ikon əlavə etmək üçün `icons`-a bir sətir yazmaq kifayətdir.
 *
 * İkonların mənbəsi: Lucide (ISC lisenziyası) — https://lucide.dev
 */

// Yalnız ikonun içi saxlanır (<path>, <rect> …). Ortaq <svg> qabığı aşağıda bir dəfə yazılır.
const icons = {
  'calendar-clock':
    '<path d="M16 14v2.2l1.6 1"/><path d="M16 2v3"/><path d="M21 7.338V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h2.338"/><path d="M3 9h5.859"/><path d="M8 2v3"/><circle cx="16" cy="16" r="6"/>',
  'calendar-check':
    '<path d="M8 2v3"/><path d="M16 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="m9 15 2 2 4-4"/>',
  'clipboard-check':
    '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
  megaphone:
    '<path d="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/><path d="M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14"/><path d="M8 6v8"/>',
  'bell-ring':
    '<path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M22 8c0-2.3-.8-4.3-2-6"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/>',
  network:
    '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  'tablet-smartphone':
    '<rect width="10" height="14" x="3" y="8" rx="2"/><path d="M5 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2h-2.4"/><path d="M8 18h.01"/>',
}

// `keyof typeof icons` ikon adlarının siyahısını `icons`-dan özü çıxarır: yeni ikon əlavə edəndə
// bu tipi ayrıca yeniləmək lazım deyil, adda hərf səhvi olsa redaktor xəta göstərir.
// https://www.typescriptlang.org/docs/handbook/2/keyof-types.html
export type IconName = keyof typeof icons

interface Props {
  name: IconName
}
const { name } = Astro.props
---

<!--
  Xətt qalınlığı və rəng burada atribut kimi verilir (stroke-width 1.5, rəng = ətrafdakı mətnin rəngi),
  ona görə Modules.astro-da ikonun rəngini yalnız `color` dəyişir: plitə mavi dolanda ikon ağ olur.
-->
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
