---
/*
 * «Rəqəmlərlə» zolağı (#stats): QRLog-un REAL istifadə rəqəmləri — şirkət, işçi, filial və bir iş günündə giriş.
 * Harada işlənir: Landing.astro-da (yalnız ana səhifə), «Modullar» ilə «Kimlər üçün» arasında. Props: lang — səhifənin dili.
 *
 * Rəqəmlər bu faylda yazılmır: hamısı data/site.ts → STATS-dan gəlir, mətnlər ui.ts-dən (stats.* açarları).
 * Niyə STATS.show: rəqəmlər real olduğu üçün vaxtla köhnəlir. Yeniləməyə vaxt yoxdursa və ya panel rəqəmləri
 * hələ əlində deyilsə, zolağı kodu silmədən bir sətirlə gizlətmək olar — qiymət bölməsindəki PRICING.enabled kimi.
 * Landing.astro-da bu belə yazılır: `{STATS.show && <Stats lang={lang} />}` (React-dakı şərti render kimi).
 *
 * Astro komponentinin 3 hissəsi (React ilə müqayisə):
 *  1) Bu `---` ilə `---` arasındakı hissə (frontmatter) — React-da komponentin JS hissəsi kimidir: idxallar, props,
 *     sabitlər, funksiyalar. Build zamanı bir dəfə işləyir, brauzerə getmir.
 *  2) Aşağıdakı HTML — JSX kimidir, amma `class` yazılır (`className` yox). Stillərin demək olar hamısı Tailwind sinifləridir.
 *  3) Sonda `script` teqi — brauzerdə işləyən yeganə JS: bölmə görünəndə rəqəmləri 0-dan sayır.
 */
import { useTranslations, type Lang, type UIKey } from '../i18n/ui'
import { STATS } from '../data/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

// ---------- Sabitlər ----------
// Minliklərin ayırıcısı: BÖLÜNMƏYƏN boşluq ( ). Adi boşluq olsaydı, dar ekranda «1 200» iki sətrə qırıla bilərdi.
const THOUSANDS_SEPARATOR = ' '
// 10 000-dən böyük rəqəm minlərlə göstərilir: 183 450 → «183» + «min».
const THOUSAND = 1000
// Aşağı yuvarlaqlaşdırma cədvəli: rəqəm `below`-dan kiçikdirsə, `step`-ə bölünən ən yaxın kiçik rəqəmə endirilir.
// 27 → 27, 643 → 640, 1 237 → 1 200. Aşağı yuvarlaqlaşdırmaq qəsdəndir: sayt real rəqəmdən çox göstərməsin.
const ROUNDING_TIERS = [
  { below: 100, step: 1 },
  { below: 1000, step: 10 },
  { below: 10000, step: 100 },
]
// Giriş animasiyasında başlıq (0) və tarix nişanı (1) artıq çıxır; rəqəmlər 2-dən başlayır (bax: style="--i:…").
const FIRST_STAT_RISE_INDEX = 2

// ---------- Funksiyalar ----------
interface RoundedStat {
  value: number // saytda göstərilən rəqəm (183 450 üçün 183 — minlərlə)
  inThousands: boolean // true olanda rəqəmin yanında «min» yazılır
}

// Dəqiq rəqəmi saytda göstəriləcək rəqəmə çevirir: roundStat(1069) → 1000, roundStat(556) → 550, roundStat(183450) → 183 (min).
function roundStat(exact: number): RoundedStat {
  for (const tier of ROUNDING_TIERS) {
    if (exact < tier.below) {
      return { value: Math.floor(exact / tier.step) * tier.step, inThousands: false }
    }
  }
  return { value: Math.floor(exact / THOUSAND), inThousands: true }
}

// 1200 → «1 200» (minliklər bölünməyən boşluqla). toLocaleString('en-US') «1,200» yazır, vergülü boşluqla əvəz edirik.
// Skriptdəki formatNumber ilə eyni qaydadır: sayğac də eyni formatda saymalıdır, yoxsa rəqəm sayma bitəndə «tullanar».
function formatNumber(value: number): string {
  return value.toLocaleString('en-US').replaceAll(',', THOUSANDS_SEPARATOR)
}

// '2026-10-13' → «Oktyabr 2026» / «Октябрь 2026» / «October 2026».
// Intl rusca «октябрь 2026 г.» yazır (kiçik hərf və « г.»), ona görə yalnız ay və il hissələrini götürüb ilk hərfi böyüdürük.
// timeZone: 'UTC' lazımdır: yoxsa saat qurşağı ABŞ-da olan maşında '2026-10-01' «September» kimi çıxardı.
// toLocaleUpperCase(lang): azərbaycan dilində «iyun» → «İyun» (adi toUpperCase «Iyun» yazardı).
function formatMonthYear(isoDate: string, language: Lang): string {
  const formatter = new Intl.DateTimeFormat(language, { month: 'long', year: 'numeric', timeZone: 'UTC' })
  let month = ''
  let year = ''
  for (const part of formatter.formatToParts(new Date(isoDate))) {
    if (part.type === 'month') month = part.value
    if (part.type === 'year') year = part.value
  }
  return `${month.charAt(0).toLocaleUpperCase(language)}${month.slice(1)} ${year}`
}

// ---------- Rəqəmlər ----------
// Dörd rəqəm massivdir, aşağıda `map()` ilə çəkilir — React-dakı `array.map()` kimi. `exact` — STATS-dakı dəqiq rəqəm,
// `name` — ekran oxuyucu üçün qısa ad, `caption` — rəqəmin altındakı görünən izah (hər ikisi ui.ts-dəki açardır).
interface StatSource {
  exact: number | null
  name: UIKey
  caption: UIKey
}
const sources: StatSource[] = [
  { exact: STATS.companies, name: 'stats.n1', caption: 'stats.s1' },
  { exact: STATS.employees, name: 'stats.n2', caption: 'stats.s2' },
  { exact: STATS.locations, name: 'stats.n3', caption: 'stats.s3' },
  { exact: STATS.dailyCheckins, name: 'stats.n4', caption: 'stats.s4' },
]

// Qoruma: rəqəmlərdən biri boşdursa (null və ya 0), zolaq heç nə göstərmir — hətta STATS.show true olsa belə.
const hasAllNumbers = sources.every((source) => source.exact !== null && source.exact > 0)

// Hər rəqəm üçün hazır məlumat: `value` sayğacın çatacağı rəqəm, `text` ilkin yazı (JS işləməsə də bu görünür),
// `suffix` — rəqəmdən solğun yazılan hissə: «+» və ya « min+».
const stats = sources.map((source) => {
  const rounded = roundStat(source.exact ?? 0)
  const unit = rounded.inThousands ? t('stats.thousand') : ''
  return {
    name: source.name,
    caption: source.caption,
    value: rounded.value,
    text: formatNumber(rounded.value),
    suffix: `${unit}+`,
  }
})

// Sağ-yuxarıdakı nişanda ay və il: rəqəmlərin götürüldüyü gün (STATS.updatedAt) səhifənin dilində.
const updatedLabel = formatMonthYear(STATS.updatedAt, lang)
---

{
  hasAllNumbers && (
    <section
      id="stats"
      aria-labelledby="stats-title"
      class="relative overflow-hidden bg-brand py-20 text-white lg:py-24"
      data-stats
      data-surface="brand"
    >
      <!-- Arxa fon: iki dekor qatı (CSS-i aşağıdakı <style>-dadır). Yuxarı-sağda işıq + aşağı-solda tünd keçid, sağda nöqtə şəbəkəsi. -->
      <div class="stats-glow" aria-hidden="true" />
      <div class="stats-dots" aria-hidden="true" />

      <!-- Konteyner digər bölmələrlə eyni enlidir (`wrap`). `leading-normal` — Preflight olmadığı üçün line-height açıq yazılıb. -->
      <div class="wrap relative leading-normal">
        <!-- Başlıq sırası: mobildə alt-alta, lg-dən iki tərəfə (solda başlıq, sağda tarix nişanı). `st-rise` — giriş animasiyasının sinfi, `--i` sıra nömrəsidir. -->
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <!-- Solda: eyebrow və H2. Mobildə H2 18 simvoldan sonra sətrə keçir, lg-dən bir sətirdir (nowrap). -->
          <div class="st-rise" style="--i:0">
            <p class="inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-white/80 uppercase">
              <span class="h-px w-8 bg-white/70" aria-hidden="true" />
              {t('stats.title')}
            </p>
            <h2
              id="stats-title"
              class="mt-5 max-w-[18ch] text-[32px] leading-[1.1] font-semibold tracking-tight sm:text-[40px] lg:max-w-none lg:whitespace-nowrap"
            >
              {t('stats.sub')}
            </h2>
          </div>

          <!-- Sağda: «mənbə · ay il» nişanı. Solundakı yaşıl nöqtə «canlı» deməkdir: bir halqa çıxıb itir. -->
          <p
            class="st-rise inline-flex items-center gap-2.5 self-start rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-[13px] text-white/85 backdrop-blur-sm lg:self-auto"
            style="--i:1"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="stats-live-ring absolute inset-0 rounded-full bg-[#6EE7B7]" />
              <span class="relative h-2 w-2 rounded-full bg-[#34D399]" />
            </span>
            {t('stats.source')} · {updatedLabel}
          </p>
        </div>

        <!-- 4 rəqəm: mobildə 2×2, lg-dən 4 sütun. lg-də aralarında nazik ağ xətt; birinci sütunda xətt və sol boşluq yoxdur
             (`first:`), sonuncuda sağ boşluq yoxdur (`last:`). Boşluq px-6-dır: px-8 olsa, 1024px-də mətnlərə yer çatmır. -->
        <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 lg:mt-16 lg:grid-cols-4 lg:gap-0">
          {stats.map((stat, index) => (
            <div
              class="st-rise lg:border-l lg:border-white/20 lg:px-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0"
              style={`--i:${FIRST_STAT_RISE_INDEX + index}`}
            >
              {/* Ekran oxuyucu üçün qısa ad: ekranda görünmür (sr-only). Massivin içində JSX şərhi yazılıb (HTML şərhi yox): o, HTML-ə düşmür, 4 dəfə təkrarlanmır. */}
              <dt class="sr-only">{t(stat.name)}</dt>

              {/* Böyük rəqəm. whitespace-nowrap — rəqəm heç vaxt iki sətrə qırılmasın; tabular-nums — saymada rəqəmlər «titrəməsin».
                  Ölçülər pillə-pillədir: «183 min+» 320px-də də sığır. data-stat-count — sayğacın hədəfi (BaseLayout-dakı
                  ümumi sayğac [data-count] axtarır, ona görə bizim ad fərqlidir: iki skript eyni rəqəmi saymasın).
                  İçindəki flex — rəqəm və «+» arasında kod boşluğu qalmasın deyə. */}
              <dd class="text-[32px] leading-none font-semibold tracking-[-0.03em] whitespace-nowrap tabular-nums min-[380px]:text-[38px] sm:text-[52px] lg:text-[48px] xl:text-[60px]">
                <span class="flex items-baseline">
                  <span data-stat-count={stat.value}>{stat.text}</span>
                  <span class="text-white/70">{stat.suffix}</span>
                </span>
                {/* Rəqəmin altındakı 48px-lik nazik xətt: giriş animasiyasında soldan dolur. Xətt <dd>-nin içindədir,
                    çünki <dl> içindəki <div>-də yalnız <dt> və <dd> ola bilər. */}
                <span class="st-line mt-5 block h-px w-12 bg-white/60" aria-hidden="true" />
              </dd>

              {/* İzah: mobildə 22 simvolluq enə qədər sətirlərə bölünür, lg-dən bir sətirdir (mətnlər buna görə qısadır — uzatma). */}
              <dd class="mt-4 max-w-[22ch] text-[15px] leading-snug text-white/80 lg:max-w-none lg:whitespace-nowrap">
                {t(stat.caption)}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  /* Tailwind-in rahat yazmadığı yalnız 4 şey burada qalıb. Ad prefiksləri: stats- / st- (@keyframes adı Astro-da scope olunmur). */

  /* 1) Arxa fonda QR «modulları» kimi nöqtə şəbəkəsi: sağda görünür, sola doğru itir (mask). pointer-events: none — klikləri tutmasın. */
  .stats-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1.2px, transparent 1.3px);
    background-size: 16px 16px;
    -webkit-mask-image: radial-gradient(70% 90% at 85% 40%, #000 0%, transparent 70%);
    mask-image: radial-gradient(70% 90% at 85% 40%, #000 0%, transparent 70%);
  }

  /* Yuxarı-sağda yumşaq işıq, aşağı-solda tünd keçid: düz mavi «plakat» kimi görünməsin deyə. */
  .stats-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(45% 70% at 90% 0%, rgba(255, 255, 255, 0.18), transparent 70%),
      radial-gradient(50% 80% at 0% 100%, rgba(8, 32, 110, 0.45), transparent 70%);
  }

  /* 2) «Canlı» nöqtəsi: bir halqa böyüyüb itir, 2 saniyədən bir təkrarlanır. */
  .stats-live-ring {
    animation: stats-live-ring 2s ease-out infinite;
  }

  @keyframes stats-live-ring {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* 3) Giriş animasiyası (bir dəfə). Gizli başlanğıc YALNIZ `[data-anim]` altındadır: atribut skriptlə yazılır,
     ona görə JS söndürülübsə hər şey adi halda görünür. `--i` sıra nömrəsidir: hər element 90ms gec başlayır. */
  [data-anim] .st-rise {
    opacity: 0;
  }

  [data-anim].is-live .st-rise {
    animation: st-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  @keyframes st-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Rəqəmin altındakı xətt sayma ilə birlikdə soldan dolur (scaleX 0 → 1). */
  .st-line {
    transform-origin: left;
  }

  [data-anim] .st-line {
    transform: scaleX(0);
  }

  [data-anim].is-live .st-line {
    transform: scaleX(1);
    transition: transform 1.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 90ms + 150ms);
  }

  /* 4) Hərəkəti azalt: nöqtə sakitdir, elementlər animasiyasız, dərhal görünür, xətt dolu. */
  @media (prefers-reduced-motion: reduce) {
    .stats-live-ring {
      animation: none;
    }

    [data-anim] .st-rise {
      opacity: 1;
      animation: none !important;
    }

    [data-anim] .st-line {
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // ---------- Sabitlər ----------
  // Bölmənin neçə hissəsi ekranda olanda animasiya və sayma başlasın (0.3 = 30%).
  const LIVE_THRESHOLD = 0.3
  // Hər rəqəm 0-dan son dəyərinə qədər bu qədər saniyə sayılır.
  const COUNT_DURATION_MS = 1400
  // Sayma bölmə görünəndən 0.2 saniyə sonra başlayır (o vaxt rəqəmin yazısı artıq görünməyə başlayır); hər növbəti rəqəm 90ms gec.
  const FIRST_COUNT_DELAY_MS = 200
  const COUNT_STAGGER_MS = 90
  // Minliklərin ayırıcısı: bölünməyən boşluq (frontmatter-dəki ilə eyni).
  const THOUSANDS_SEPARATOR = ' '

  // Əvvəl sürətli, sonda yavaşlayan hərəkət (ease-out): progress 0…1 → nəticə 0…1.
  function easeOutCubic(progress: number): number {
    return 1 - Math.pow(1 - progress, 3)
  }

  // 1200 → «1 200». Frontmatter-dəki formatNumber ilə eyni qayda: sayma bitəndə rəqəm «tullanmasın».
  function formatNumber(value: number): string {
    return value.toLocaleString('en-US').replaceAll(',', THOUSANDS_SEPARATOR)
  }

  // Rəqəmi 0-dan data-stat-count dəyərinə qədər sayır. requestAnimationFrame funksiyanı ekranın növbəti yenilənməsində
  // çağırır — hamar animasiya üçün. https://developer.mozilla.org/en-US/docs/Web/API/Window/requestAnimationFrame
  function countUp(counter: HTMLElement, delayMs: number): void {
    const target = Number(counter.dataset.statCount)
    setTimeout(function () {
      const startTime = performance.now()
      function drawFrame(now: number): void {
        const progress = Math.min((now - startTime) / COUNT_DURATION_MS, 1)
        counter.textContent = formatNumber(Math.round(target * easeOutCubic(progress)))
        if (progress < 1) {
          requestAnimationFrame(drawFrame)
        }
      }
      requestAnimationFrame(drawFrame)
    }, delayMs)
  }

  // Bölmə ekrana ilk dəfə kifayət qədər girəndə `is-live` sinfini verir, rəqəmləri saymağa başlayır və izləməni DAYANDIRIR:
  // hamısı bir dəfə olur. https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
  function startWhenVisible(section: HTMLElement): void {
    const observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting) {
          return
        }
        section.classList.add('is-live')
        const counters = section.querySelectorAll<HTMLElement>('[data-stat-count]')
        counters.forEach(function (counter, index) {
          countUp(counter, FIRST_COUNT_DELAY_MS + index * COUNT_STAGGER_MS)
        })
        observer.disconnect()
      },
      { threshold: LIVE_THRESHOLD }
    )
    observer.observe(section)
  }

  function initStats(): void {
    // Bölmə səhifədə olmaya bilər (STATS.show: false), onda heç nə etmirik.
    const section = document.querySelector<HTMLElement>('[data-stats]')
    if (!section) {
      return
    }

    // «Hərəkəti azalt» seçilibsə və ya brauzer IntersectionObserver-i bilmirsə: `data-anim` yazılmır, sayma olmur —
    // son rəqəmlər artıq HTML-dədir. https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
    const isMotionReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (isMotionReduced || !('IntersectionObserver' in window)) {
      return
    }

    section.dataset.anim = 'on'
    startWhenVisible(section)
  }

  initStats()
</script>
