---
import { useTranslations, type Lang } from '../i18n/ui'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)

// The "before" of the story — PAS's Problem/Agitate. It sits right after the customer band and
// before the product screens: name the pains of the old way (buddy-punching, per-site hardware,
// manual/late records) so the sections that follow read as the answer to each one. Every pain
// here maps to a control the product actually has — anti-fraud, no hardware, the live board.
// Deliberately measured, not fear-mongering: three real costs, stated plainly.
const pains = [
  // identity / buddy-punching
  { t: 'prob.p1t', d: 'prob.p1d', p: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.7 5.7 0 0 1 11 0"/><path d="m16.5 8 4 4M20.5 8l-4 4"/>' },
  // per-site hardware
  { t: 'prob.p2t', d: 'prob.p2d', p: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5"/><path d="m5 5 14 14"/>' },
  // manual / late
  { t: 'prob.p3t', d: 'prob.p3d', p: '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M18 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/><path d="M9 13h4M9 17h2"/>' },
]
---

<section class="problem" id="problem">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">{t('prob.eyebrow')}</span>
      <h2>{t('prob.title')}</h2>
      <p>{t('prob.sub')}</p>
    </div>
    <div class="pain-grid">
      {pains.map((p, i) => (
        <div class={`pain rv d${i + 1}`}>
          <div class="ic"><svg viewBox="0 0 24 24" set:html={p.p} /></div>
          <h3>{t(p.t as any)}</h3>
          <p>{t(p.d as any)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
