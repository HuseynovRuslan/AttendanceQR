---
// Footer — hər səhifənin ən aşağısı: loqo, qısa təsvir, Google Play nişanı, dörd keçid sütunu
// (Məhsul, Şirkət, Hüquqi, Bizimlə əlaqə) və müəllif hüququ sətri.
// Harada işlənir: BaseLayout.astro onu hər səhifənin sonuna qoyur.
// Props: lang — səhifənin dili ('az' | 'ru' | 'en').
// Necə işləyir: mətnlər t('açar') ilə i18n/ui.ts-dən, telefon/WhatsApp/e-poçt isə data/site.ts-dəki
// SITE-dan gəlir. Burada yalnız HTML var — stillər global.css-dədir (.foot-grid, .fcol, .foot-bot).
import { Image } from 'astro:assets'
import { useTranslations, localizedPath, type Lang } from '../i18n/ui'
import { SITE, PRICING, whatsappUrl } from '../data/site'
import GooglePlayBadge from './GooglePlayBadge.astro'
import logoMarkWhite from '../assets/images/brand/logo-mark-white.png'

// <Image>-in yaratdığı faylın eni (px). Astro bu rəqəmi <img>-ə width="79" height="60" atributu kimi
// də yazır. Ekrandakı ölçünü global.css-dəki .flogo img { height: 30px; width: auto } verir: loqo 30px
// hündürlükdə, ~40px enində görünür. Oradakı width: auto-nu silsən, loqo 79px enə uzanar.
// 79 ekrandakı enin 2 qatıdır — retina ekranda loqo bulanıq görünməsin deyə.
const LOGO_WIDTH_PX = 79
// Google Play nişanının hündürlüyü (px) — qara nişanın özünün, ətrafdakı şəffaf boşluq sayılmır.
const BADGE_HEIGHT_PX = 40

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)
const homePath = localizedPath(lang, '/')

// Sayt statik qurulur: il brauzerdə yox, build zamanı hesablanır. Yeni ildə sayt yenidən build
// olunmasa, footer köhnə ili göstərəcək.
const currentYear = new Date().getFullYear()

// Hüquqi səhifələr (Məxfilik, Hesabın silinməsi) yalnız azərbaycancadır — Google Play onlara link
// verir. Ona görə hər dildə link AZ səhifəsinə aparır. /ru/ və /en/-də linkin mətni səhifənin öz
// dilində qalır, hreflang="az" isə oxucuya hansı dildə səhifə açılacağını bildirir. AZ səhifədə
// hreflang lazım deyil: dəyəri undefined olan atributu Astro HTML-ə heç yazmır.
const legalHreflang = lang === 'az' ? undefined : 'az'

// Zəng linkinə (tel:) yalnız rəqəmlər və + lazımdır. /[^+\d]/g — "rəqəm və + olmayan hər simvol"
// (g — hamısı), yəni '+994 50 600 16 55' → 'tel:+994506001655'.
// Eyni sətir ContactBody.astro-da da var — linkin qurulma qaydasını dəyişsən, ikisini də dəyiş.
const phoneHref = `tel:${SITE.phone.replace(/[^+\d]/g, '')}`
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="flogo">
          <Image src={logoMarkWhite} alt={SITE.name} width={LOGO_WIDTH_PX} />
          <span class="fword">QR<span>Log</span></span>
        </div>
        <p>{t('foot.tag')}</p>
        <GooglePlayBadge lang={lang} height={BADGE_HEIGHT_PX} align="start" class="fbadge" />
      </div>
      <div class="fcol">
        <h4>{t('foot.product')}</h4>
        <a href={`${homePath}#modules`}>{t('nav.modules')}</a>
        <a href={`${homePath}#how`}>{t('nav.how')}</a>
        {PRICING.enabled && <a href={localizedPath(lang, '/qiymet/')}>{t('nav.pricing')}</a>}
        <a href={`${homePath}#faq`}>{t('nav.faq')}</a>
      </div>
      <div class="fcol">
        <h4>{t('foot.company')}</h4>
        <a href={localizedPath(lang, '/haqqimizda/')}>{t('foot.about')}</a>
        {/*
          Bloq linki müvəqqəti gizlidir: bloqda hələ bir məqalə var və tək məqaləyə aparan link saytı
          yarımçıq göstərir. Səhifə və məqalə yerindədir — 3 məqalə olanda bu sətri qaytar.
          <a href="/bloq/">{t('foot.blog')}</a>
        */}
        <a href={localizedPath(lang, '/elaqe/')}>{t('nav.contact')}</a>
      </div>
      <div class="fcol">
        <h4>{t('foot.legal')}</h4>
        <a href="/mexfilik/" hreflang={legalHreflang}>{t('foot.privacy')}</a>
        <a href="/hesab-silinmesi/" hreflang={legalHreflang}>{t('foot.deletion')}</a>
      </div>
      <div class="fcol fcontact">
        <h4>{t('foot.contact')}</h4>
        {/*
          Hər linkin öz yazısı var ("Telefon", "WhatsApp"), çünki iki ayrı nömrə var:
          zəng xətti və WhatsApp xətti.
        */}
        {SITE.phone && (
          <a href={phoneHref}>
            {t('contact.phone')} <span>{SITE.phone}</span>
          </a>
        )}
        <!-- <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          {t('contact.whatsapp')} <span>{SITE.whatsapp}</span>
        </a> -->
        <a href={`mailto:${SITE.email}`}>
          {t('contact.email')} <span>{SITE.email}</span>
        </a>
      </div>
    </div>
    <div class="foot-bot">
      <span>© {currentYear} {SITE.name}. {t('foot.rights')}</span>
      <span>{SITE.address}</span>
    </div>
  </div>
</footer>
