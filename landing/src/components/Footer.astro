---
/*
 * Footer — hər səhifənin ən aşağısı: loqo, qısa təsvir, mağaza düymələri, keçid sütunları, əlaqə,
 * Instagram və müəllif hüququ sətri.
 * Harada işlənir: BaseLayout.astro onu hər səhifənin sonuna qoyur. Props: lang — səhifənin dili ('az' | 'ru' | 'en').
 *
 * Astro komponentinin 3 hissəsi (React ilə müqayisə):
 *  1) Bu `---` ilə `---` arasındakı hissə (frontmatter) — React-da komponentin JS hissəsi kimidir: idxallar,
 *     props, sabitlər, massivlər. Build zamanı bir dəfə işləyir, brauzerə getmir.
 *  2) Aşağıdakı HTML — JSX kimidir, amma `class` yazılır (`className` yox). Stillərin demək olar hamısı
 *     Tailwind sinifləridir; `<style>` yalnız Tailwind-in edə bilmədiyi 4 şey üçündür.
 *  3) Sonda `<script>` — brauzerdə işləyən yeganə JS: footer görünəndə giriş animasiyasını başladır.
 */
import { Image } from 'astro:assets'
// İkonlar Lucide-dəndir; hər biri öz faylından idxal olunur (səbəbi Audience.astro-nun başındakı şərhdədir).
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right'
import MapPin from '@lucide/astro/icons/map-pin'
import Smartphone from '@lucide/astro/icons/smartphone'
import { useTranslations, localizedPath, type Lang, type UIKey } from '../i18n/ui'
import { SITE, PRICING } from '../data/site'
import GooglePlayBadge from './GooglePlayBadge.astro'
import ContactIcon from './ContactIcon.astro'
import logoWordWhite from '../assets/images/brand/logo-word-white.png'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const homePath = localizedPath(lang, '/')

// ---------- Sabitlər ----------
// Loqo faylının eni (px). Ekranda h-8 (32px hündürlük) ilə ~107px görünür; 214 = onun 2 qatı, retina ekranda
// loqo bulanıq olmasın deyə. <Image> bu rəqəmi <img width="214"> kimi yazır, ekrandakı ölçünü isə h-8 w-auto verir.
const LOGO_WIDTH_PX = 214
// Google Play nişanının hündürlüyü (px) — qara nişanın özünün, ətrafdakı şəffaf boşluq sayılmır.
const BADGE_HEIGHT_PX = 40
// İkonların ölçüsü (px): əlaqə sətirlərindəki, «Tezliklə App Store»-dakı, Instagram və ox ikonu.
const CONTACT_ICON_SIZE = 16
const SOON_ICON_SIZE = 15
const INSTAGRAM_ICON_SIZE = 18
const ARROW_ICON_SIZE = 16

// Sayt statik qurulur: il brauzerdə yox, build zamanı hesablanır. Yeni ildə sayt yenidən build
// olunmasa, footer köhnə ili göstərəcək.
const currentYear = new Date().getFullYear()

// Zəng linkinə (tel:) yalnız rəqəmlər və + lazımdır. /[^+\d]/g — "rəqəm və + olmayan hər simvol"
// (g — hamısı), yəni '+994 50 600 16 55' → 'tel:+994506001655'.
// Eyni sətir ContactBody.astro-da da var — linkin qurulma qaydasını dəyişsən, ikisini də dəyiş.
const phoneHref = `tel:${SITE.phone.replace(/[^+\d]/g, '')}`

// ---------- Keçid sütunları ----------
// Hər sütun massivdir, aşağıda `map()` ilə çəkilir — React-dakı `array.map()` kimi. Yeni link əlavə etmək
// üçün massivə bir sətir yazmaq kifayətdir. `label` — ui.ts-dəki mətn açarı: `UIKey` tipi sayəsində açarda
// hərf səhvi olsa, redaktor və `npm run check` xəta göstərir.
interface FooterLink {
  label: UIKey
  href: string
}
// «Məhsul» sütununun linki: adi linkin üstünə «görünsün, ya yox» sahəsi əlavə olunur.
interface ProductLink extends FooterLink {
  isVisible: boolean
}

// «Məhsul» sütunu. Linklər ana səhifənin bölmələrinə (#modules …) aparır: başqa səhifədən baxanda da işləsin deyə
// başına ana səhifənin yolu (homePath) qoyulur. `isVisible` — qiymətlər söndürülübsə (site.ts → PRICING.enabled)
// «Qiymət» bölməsi ana səhifədə yoxdur, ona görə link də görünmür.
const allProductLinks: ProductLink[] = [
  { label: 'nav.modules', href: `${homePath}#modules`, isVisible: true },
  { label: 'nav.how', href: `${homePath}#how`, isVisible: true },
  { label: 'nav.pricing', href: `${homePath}#pricing`, isVisible: PRICING.enabled },
  { label: 'nav.faq', href: `${homePath}#faq`, isVisible: true },
]
const productLinks = allProductLinks.filter((link) => link.isVisible)

// «Şirkət» sütunu.
const companyLinks: FooterLink[] = [
  { label: 'foot.about', href: localizedPath(lang, '/haqqimizda/') },
  // Bloq linki müvəqqəti gizlidir: bloqda hələ bir məqalə var və tək məqaləyə aparan link saytı
  // yarımçıq göstərir. Səhifə və məqalə yerindədir — 3 məqalə olanda bu sətri qaytar.
  // { label: 'foot.blog', href: '/bloq/' },
  { label: 'nav.contact', href: localizedPath(lang, '/elaqe/') },
]

// Alt sətirdəki hüquqi linklər (köhnə «Hüquqi» sütununun yerinə). İkisi də səhifənin öz dilindəki ünvana aparır.
const legalLinks: FooterLink[] = [
  { label: 'foot.privacy', href: localizedPath(lang, '/mexfilik/') },
  { label: 'foot.deletion', href: localizedPath(lang, '/hesab-silinmesi/') },
]

// ---------- Əlaqə sətirləri ----------
// Hər sətirdə solda ikon qutusu, sağda dəyər var. `href` olmayan sətir (ünvan) link deyil, sadə yazıdır.
// `icon` — hansı ikon: 'phone' və 'email' ContactIcon.astro-dandır (Əlaqə səhifəsi ilə ortaqdır), 'pin' Lucide-in MapPin-idir.
// `isVisible`: telefon boşdursa (site.ts-də SITE.phone = '') sətir heç göstərilmir — işləməyən nömrədən yaxşıdır.
interface ContactRow {
  icon: 'phone' | 'email' | 'pin'
  text: string
  href?: string
  textClass?: string
  isVisible: boolean
}
const allContactRows: ContactRow[] = [
  // `tabular-nums` — rəqəmlər eyni enli olur; `whitespace-nowrap` — dar sütunda nömrə iki sətrə bölünmür.
  { icon: 'phone', text: SITE.phone, href: phoneHref, textClass: 'tabular-nums whitespace-nowrap', isVisible: SITE.phone.length > 0 },
  { icon: 'email', text: SITE.email, href: `mailto:${SITE.email}`, isVisible: true },
  { icon: 'pin', text: SITE.address, isVisible: true },
  // WhatsApp sətri müvəqqəti gizlidir. Qaytaranda: data/site-dan `whatsappUrl`-i idxal et, Lucide-dən
  // `message-circle` ikonunu idxal et və aşağıdakı sətri aç. Link yeni tabda açılmalıdır — markup-dakı
  // <Row>-a target="_blank" rel="noopener noreferrer" əlavə et.
  // { icon: MessageCircle, text: SITE.whatsapp, href: whatsappUrl(), isVisible: true },
]
const contactRows = allContactRows.filter((contact) => contact.isVisible)
---

<!--
  Footer yuxarı küncləri yuvarlaq olan tünd blokdur. `-mt-8 lg:-mt-12` onu əvvəlki bölmənin üstünə 32px
  (böyük ekranda 48px) mindirir. Niyə: yuvarlaq künclərin arxasında boş yer qalır; footer bölmənin üstünə
  minəndə həmin yerdə əvvəlki bölmənin öz rəngi görünür, ağ və ya boz zolaq yox. Bunun işləməsi üçün hər
  səhifənin son blokunun alt boşluğu (padding) mindirmədən çox olmalıdır — yoxsa footer məzmunun üstünü örtər.
  `relative z-10` — footer bölmənin ÜSTÜNDƏ çəkilsin. `overflow-hidden` — blur-lu işıq və künclər kənara daşmasın.
  `leading-normal` (line-height 1.5) footer-də və başlıqlarda açıq yazılıb: saytda Tailwind-in Preflight-ı yoxdur,
  body 1.6, h4 isə 1.08 verir — dizayn isə 1.5 üzərində ölçülüb.
  `data-foot` — aşağıdakı skript footer-i bu atributla tapır.
-->
<footer
  class="relative z-10 -mt-8 overflow-hidden rounded-t-[28px] bg-[#0B0C0D] leading-normal text-white lg:-mt-12 lg:rounded-t-[48px]"
  data-foot
>
  <!-- Yuxarı-solda zəif mavi işıq (dekor). CSS-i aşağıdakı <style>-dadır. -->
  <div class="foot-glow" aria-hidden="true"></div>

  <!-- Konteyner: `wrap` digər bölmələrdəki eyni enli sinifdir. `relative` — işığın üstündə çəkilsin. -->
  <div class="wrap relative pt-16 lg:pt-24">
    <!-- Mobildə alt-alta, lg-dən 12 sütun: 5-i sol tərəf, 7-si sağ tərəf. `foot-rise` — giriş animasiyasının
         sinfi, `--i` sıra nömrəsidir: hər sütun 80ms fasilə ilə bir-bir çıxır. -->
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <!-- Sol: loqo, qısa təsvir, mağaza düymələri. -->
      <div class="foot-rise lg:col-span-5" style="--i:0">
        <!-- <Image> loqonu build zamanı optimallaşdırır (webp, ölçü) və <img>-ə width/height yazır.
             `h-8 w-auto` — ekranda 32px hündürlük, en nisbətlə hesablanır (w-auto olmasa loqo 214px-ə dartılar). -->
        <a href={homePath} class="inline-block">
          <Image src={logoWordWhite} alt={SITE.name} width={LOGO_WIDTH_PX} class="h-8 w-auto" />
        </a>
        <p class="mt-5 max-w-[34ch] text-[15px] leading-[1.7] text-white/60">{t('foot.tag')}</p>

        <!-- Mağazalar sırası: solda işləyən Google Play linki, yanında «tezliklə» olan App Store nişanı. -->
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <!-- Hover-də nişan 2px qalxır. `motion-safe:` — «hərəkəti azalt» seçilibsə qalxma olmur. -->
          <GooglePlayBadge
            lang={lang}
            height={BADGE_HEIGHT_PX}
            align="start"
            class="transition duration-200 motion-safe:hover:-translate-y-0.5"
          />

          <!-- Apple-ın rəsmi App Store nişanı yalnız tətbiq artıq App Store-da olanda işlədilə bilər. Ona görə
               öz sadə nişanımız var. Bu LİNK DEYİL (<span>-dır), klikləmir — Pwa.astro-dakının tünd variantıdır. -->
          <span
            class="inline-flex h-10 cursor-default items-center gap-2.5 rounded-[10px] border border-dashed border-white/20 bg-white/[.03] pr-3.5 pl-2 select-none"
          >
            <span class="grid h-7 w-7 place-items-center rounded-lg bg-white/[.07] text-[#7DA6FA]" aria-hidden="true">
              <Smartphone size={SOON_ICON_SIZE} />
            </span>
            <span class="flex flex-col leading-tight">
              <span class="text-[10px] font-bold tracking-[.08em] text-[#7DA6FA] uppercase">{t('pwa.soon')}</span>
              <span class="text-[14px] font-semibold">App Store</span>
            </span>
            <!-- Yavaş yanıb-sönən nöqtə: «hazırlanır» deməkdir. Animasiyası aşağıdakı <style>-dadır. -->
            <span class="foot-blink ml-0.5 h-1.5 w-1.5 rounded-full bg-[#4C86FF]" aria-hidden="true"></span>
          </span>
        </div>
      </div>

      <!-- Sağ: mobildə 2 sütun (əlaqə bütün eni tutur), sm-dən 3 sütun (üçüncü sütun 1.5 qat enlidir). -->
      <div class="grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-[1fr_1fr_1.5fr] lg:col-span-7">
        <!-- «Məhsul» sütunu. Preflight olmadığına görə list-none yazılıb (yoxsa siyahıda nöqtələr çıxır). -->
        <div class="foot-rise" style="--i:1">
          <h4 class="font-mono text-[11.5px] leading-normal font-medium tracking-[.16em] text-white/40 uppercase">{t('foot.product')}</h4>
          <ul class="mt-5 list-none space-y-3.5 text-[15px]">
            {
              productLinks.map((link) => (
                <li>
                  <a href={link.href} class="text-white/70 transition-colors hover:text-white">
                    {t(link.label)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- «Şirkət» sütunu. -->
        <div class="foot-rise" style="--i:2">
          <h4 class="font-mono text-[11.5px] leading-normal font-medium tracking-[.16em] text-white/40 uppercase">{t('foot.company')}</h4>
          <ul class="mt-5 list-none space-y-3.5 text-[15px]">
            {
              companyLinks.map((link) => (
                <li>
                  <a href={link.href} class="text-white/70 transition-colors hover:text-white">
                    {t(link.label)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- «Bizimlə əlaqə» sütunu: mobildə 2 sütunu tutur (col-span-2), sm-dən 1 sütun. -->
        <div class="foot-rise col-span-2 sm:col-span-1" style="--i:3">
          <h4 class="font-mono text-[11.5px] leading-normal font-medium tracking-[.16em] text-white/40 uppercase">{t('foot.contact')}</h4>

          <!-- Əlaqə sətirləri: ikon qutusu + dəyər. `group` / `group-hover:` — valideyn (link) üstünə gələndə
               onun içindəki ikon qutusu da dəyişir: valideynə `group`, uşağa `group-hover:...` yazılır.
               <Row> dinamik teqdir: href varsa <a>, yoxdursa (ünvan) <div>. `group` yalnız linkdədir,
               ona görə ünvan sətrinin üstünə gələndə heç nə dəyişmir. -->
          <ul class="mt-5 list-none space-y-3 text-[15px]">
            {
              contactRows.map((contact) => {
                const Row = contact.href ? 'a' : 'div'
                return (
                  <li>
                    <Row
                      href={contact.href}
                      class:list={[
                        'inline-flex items-center gap-3',
                        contact.href ? 'group text-white/80 transition-colors hover:text-white' : 'text-white/60',
                      ]}
                    >
                      <span
                        class="grid h-9 w-9 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/[.04] text-white/70 transition group-hover:border-brand group-hover:bg-brand group-hover:text-white"
                        aria-hidden="true"
                      >
                        {contact.icon === 'pin' ? <MapPin size={CONTACT_ICON_SIZE} /> : <ContactIcon name={contact.icon} size={CONTACT_ICON_SIZE} />}
                      </span>
                      <span class={contact.textClass}>{contact.text}</span>
                    </Row>
                  </li>
                )
              })
            }
          </ul>

          <!-- Instagram: hələlik yeganə sosial şəbəkədir, ona görə ikon + ad + istifadəçi adı olan tək düymədir.
               Başqa şəbəkələr əlavə olunanda bu blokun dizaynı dəyişəcək (məsələn, ikonlar sırası).
               `-ml-[7px]` vacibdir: düymənin daxili boşluğu (6px) və kənarı (1px) qədər sola çəkir. Belə olanda
               içindəki Instagram ikonu yuxarıdakı telefon, e-poçt və ünvan ikonları ilə, «@qrlog.az» yazısı isə
               onların mətni ilə eyni şaquli xəttə düşür. Düymənin eni dəyişsə, bu rəqəmi də yenidən ölç. -->
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-6 -ml-[7px] inline-flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[.04] py-1.5 pr-4 pl-1.5 transition-colors hover:border-white/25 hover:bg-white/[.07]"
          >
            <span class="relative grid h-9 w-9 place-items-center overflow-hidden rounded-xl bg-white/[.07] text-white">
              <!-- Instagram rəng keçidi: adi halda tam şəffafdır (opacity-0), hover-də görünür. -->
              <span
                class="absolute inset-0 bg-linear-to-tr from-[#FEDA75] via-[#D62976] to-[#4F5BD5] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"></span>
              <!-- İkon ContactIcon.astro-dadır (inline SVG, Font Awesome Free, CC BY 4.0 — lisenziya şərhi orada saxlanılır). -->
              <span class="relative flex">
                <ContactIcon name="instagram" size={INSTAGRAM_ICON_SIZE} />
              </span>
            </span>
            <span class="flex flex-col leading-tight">
              <span class="text-[11.5px] text-white/45">Instagram</span>
              <span class="text-[15px] font-medium text-white/90">{SITE.instagramHandle}</span>
            </span>
            <!-- Ox hover-də azca sağa-yuxarı sürüşür (translate-x / -translate-y). -->
            <ArrowUpRight
              size={ARROW_ICON_SIZE}
              class="ml-1 text-white/40 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Alt sətir: müəllif hüququ solda, hüquqi linklər sağda (mobildə alt-alta).
         `pr-14` (56px) qəsdəndir: səhifənin sonunda sağ-aşağıdakı üzən WhatsApp və «yuxarı» düymələri (ekranın
         sağından 16–20px, eni 52–56px) bu sətrin üstünə düşür; sağdakı boşluq linkləri onların altında qoymur. -->
    <div
      class="foot-rise mt-16 flex flex-col gap-4 border-t border-white/10 pt-7 pr-14 pb-10 text-[13px] text-white/45 sm:flex-row sm:items-center sm:justify-between lg:mt-20"
      style="--i:4"
    >
      <span>© {currentYear} {SITE.name}. {t('foot.rights')}</span>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legalLinks.map((link) => (
            <a href={link.href} class="transition-colors hover:text-white">
              {t(link.label)}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  /* Tailwind-in rahat yazmadığı yalnız 4 şey burada qalıb. */

  /* 1) Yuxarı-solda zəif mavi işıq. Blur-lu radial gradient; pointer-events: none — işıq klikləri tutmasın.
     Footer-in overflow-hidden-ı onu kənardan kəsir, ona görə üfüqi sürüşmə yaratmır. */
  .foot-glow {
    position: absolute;
    top: -30%;
    left: -10%;
    width: 60%;
    height: 70%;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(21, 94, 239, 0.22), transparent);
    filter: blur(30px);
  }

  /* 2) «Tezliklə» nöqtəsi yavaş yanıb-sönür. @keyframes adı Astro-da scope olunmur, ona görə `foot-` prefiksi. */
  .foot-blink {
    animation: foot-blink 1.6s ease-in-out infinite;
  }

  @keyframes foot-blink {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* 3) Giriş animasiyası (bir dəfə). Gizli başlanğıc YALNIZ `[data-anim]` altındadır: atribut skriptlə yazılır,
     ona görə JS söndürülübsə hər şey adi halda görünür. `--i` sıra nömrəsidir: hər sütun 80ms gec başlayır. */
  [data-anim] .foot-rise {
    opacity: 0;
  }

  [data-anim].is-live .foot-rise {
    animation: foot-rise 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes foot-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* 4) Hərəkəti azalt: nöqtə yanıb-sönmür (dolu qalır), elementlər animasiyasız, dərhal görünür. */
  @media (prefers-reduced-motion: reduce) {
    .foot-blink {
      animation: none;
    }

    [data-anim] .foot-rise {
      opacity: 1;
      animation: none !important;
    }
  }
</style>

<script>
  // ---------- Sabitlər ----------
  // Footer-in neçə hissəsi ekranda olanda animasiya başlasın (0.15 = 15%).
  const LIVE_THRESHOLD = 0.15

  // Footer ekrana ilk dəfə kifayət qədər girəndə `is-live` sinfini verir və izləməni DAYANDIRIR: animasiya bir dəfə oynanır.
  // Sinfi verəndən sonra qalanını CSS edir. https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
  function startWhenVisible(footer: HTMLElement): void {
    const observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting) {
          return
        }
        footer.classList.add('is-live')
        observer.disconnect()
      },
      { threshold: LIVE_THRESHOLD }
    )
    observer.observe(footer)
  }

  function initFooter(): void {
    const footer = document.querySelector<HTMLElement>('[data-foot]')
    if (!footer) {
      return
    }

    // Sistemdə «hərəkəti azalt» seçilibsə və ya brauzer IntersectionObserver-i bilmirsə, heç nə gizlədilmir:
    // `data-anim` yazılmır, ona görə bütün elementlər dərhal görünür.
    // https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
    const isMotionReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (isMotionReduced || !('IntersectionObserver' in window)) {
      return
    }

    footer.dataset.anim = 'on'
    startWhenVisible(footer)
  }

  initFooter()
</script>
