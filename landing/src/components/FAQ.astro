---
/*
 * «Suallar» bölməsi: solda başlıq (böyük ekranda yapışqan), sağda altı sual-kart (akkordeon).
 * Harada işlənir: Landing.astro-da (ana səhifə; AZ/RU/EN).
 * Props: lang — səhifənin dili.
 * Necə işləyir: sual və cavablar ui.ts-dəki faq.q1…q6 / faq.a1…a6 açarlarıdır. Eyni anda yalnız bir cavab
 * açıqdır (ilk kart başlanğıcda açıqdır). Açılıb-bağlanma CSS-dədir, skript yalnız sinfi dəyişir.
 */

// İkon ayrıca fayldan idxal olunur — səbəbi Audience.astro-nun başındakı şərhdədir.
import ChevronDown from '@lucide/astro/icons/chevron-down'
import { useTranslations, type Lang, type UIKey } from '../i18n/ui'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

// BaseLayout.astro-dakı FAQPage JSON-LD eyni faq.q1…q6 açarlarını oxuyur. Sual əlavə etsən, ORADAKI siyahını da
// dəyiş (faqKeys), yoxsa axtarış sistemi köhnə siyahını görər.
const QUESTION_NUMBERS = [1, 2, 3, 4, 5, 6]

// Hansı kart başlanğıcda açıq olsun (0 = birinci). Cavablar JS-siz səhifədə hamısı açıq görünür.
const INITIALLY_OPEN_INDEX = 0

// Sağdakı ox ikonunun ölçüsü (px) və xəttinin qalınlığı.
const CHEVRON_SIZE = 18
const CHEVRON_STROKE = 2

// Açar adı mətn kimi yığılır ('faq.q' + nömrə): TypeScript onu özü yoxlaya bilmir, ona görə `as UIKey`.
// Açar ui.ts-də yoxdursa, t() AZ mətnə qayıdır.
const items = QUESTION_NUMBERS.map((number, index) => ({
  number,
  question: t(`faq.q${number}` as UIKey),
  answer: t(`faq.a${number}` as UIKey),
  isOpen: index === INITIALLY_OPEN_INDEX,
}))
---

<section id="faq" aria-labelledby="faq-title" class="relative bg-page py-20 lg:py-28">
  <!--
    Bu kiçik skript `is:inline`-dır, yəni səhifədə olduğu yerdə dərhal işləyir (aşağıdakı əsas skript isə səhifə
    yüklənəndən sonra). Məqsəd: JS varsa, cavablar səhifə ilk çəkiləndə artıq yığılmış olsun — yoxsa əvvəl hamısı
    açıq görünüb sonra birdən yığılardı (səhifə "sıçrayardı"). JS yoxdursa, atribut yazılmır və CSS-dəki
    `[data-faq-js]` qaydaları işləmir: bütün cavablar açıq qalır, məzmun itmir.
    `document.currentScript` — hazırda işləyən <script> elementidir, `parentElement` isə onun içində olduğu <section>.
  -->
  <script is:inline>
    document.currentScript.parentElement.setAttribute('data-faq-js', '')
  </script>

  <!-- Üst xətt: yuxarıdakı «Qiymət» bölməsinin alt xətti yoxdur, ona görə aralarında dəqiq BİR xətt qalır.
       Alt xətt: aşağıdakı «Telefona quraşdırın» bölməsinin üst xətti yoxdur. -->
  <div class="edge-rule pointer-events-none absolute inset-x-0 top-0 h-px bg-hair" aria-hidden="true"></div>
  <div class="edge-rule pointer-events-none absolute inset-x-0 bottom-0 h-px bg-hair" aria-hidden="true"></div>

  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <!-- Sol: başlıq. lg-dən yapışqandır (sticky): sağdakı kartlar uzananda başlıq ekranda qalır.
           top-28 = 112px: sabit menyunun hündürlüyündən (98px) bir az çoxdur. -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <div class="faq-rise" style="--i:0">
            <span class="inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-brand uppercase">
              <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
              {t('faq.eyebrow')}
            </span>
            <h2
              id="faq-title"
              class="mt-5 text-[32px] leading-[1.1] font-semibold tracking-tight text-ink sm:text-[38px]"
            >
              {t('faq.title')}
            </h2>
            <p class="mt-4 max-w-[40ch] text-[15px] leading-[1.75] text-pretty text-ink2">{t('faq.sub')}</p>
          </div>
        </div>
      </div>

      <!-- Sağ: suallar. Preflight olmadığına görə list-none və p-0 yazılıb. `--i` kartın sıra nömrəsidir:
           CSS onu giriş animasiyasının gecikməsini hesablamaq üçün oxuyur. -->
      <ul class="grid list-none gap-3 p-0 lg:col-span-7">
        {
          items.map((item, index) => (
            <li class={item.isOpen ? 'faq-card faq-rise is-open' : 'faq-card faq-rise'} style={`--i:${index + 1}`}>
              <h3>
                <button
                  class="faq-btn"
                  type="button"
                  id={`faq-q${item.number}`}
                  aria-expanded={item.isOpen ? 'true' : 'false'}
                  aria-controls={`faq-a${item.number}`}
                >
                  <span class="faq-text">{item.question}</span>
                  <span class="faq-ic" aria-hidden="true">
                    <span class="faq-chevron">
                      <ChevronDown size={CHEVRON_SIZE} stroke-width={CHEVRON_STROKE} />
                    </span>
                  </span>
                </button>
              </h3>
              <div class="faq-panel" id={`faq-a${item.number}`} role="region" aria-labelledby={`faq-q${item.number}`}>
                <div class="faq-panel-inner">
                  <p class="faq-answer">{item.answer}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ---------- Bu bölməyə xas dəyərlər ---------- */
  #faq {
    --faq-card-bg: var(--color-page); /* bağlı kartın fonu */
    --faq-card-bg-hover: #eef1f7; /* bağlı kartın hover fonu: səhifə fonundan bir az tünd */
    --faq-card-open-border: #d5e1fb; /* açıq kartın çərçivəsi: brand mavisinin çox açıq çaları */
    --faq-card-open-shadow: 0 22px 44px -30px color-mix(in oklab, var(--color-brand) 38%, transparent);
    --faq-answer-text: #57534e; /* cavab mətni (Tailwind-in stone-600 rəngi) */
    --faq-icon-size: 36px; /* sağdakı dairəvi ikonun eni və hündürlüyü */
    /* Saytın bölmələrində işlənən yumşaq əyri (Security, Qiymət, Kimlər üçün). */
    --faq-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    /* Panelin açılıb-bağlanması üçün: başlayanda və bitəndə yumşaq, ortada sürətli. */
    --faq-ease-panel: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ---------- Bölmənin qabığı ---------- */

  /* Xəttin kənarlara doğru əriməsi. Eyni qayda Security, Qiymət, HowItWorks və Modules-də də var —
     orada scoped-dur, ona görə burada da təkrarlanır. */
  .edge-rule {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
  }

  /* ---------- Sual kartı ----------
     Bağlı kart açıq boz, açıq kart ağ + mavi çərçivə + yumşaq kölgə. Çərçivə həmişə var (bağlıda şəffafdır):
     açılanda kart 1px böyüməsin və mətn yerindən tərpənməsin. */
  .faq-card {
    /* --faq-pad-x: kartın sağ/sol daxili boşluğu. Sual və cavab eyni xətdən başlasın deyə hər ikisi bunu işlədir. */
    --faq-pad-x: 18px;
    --faq-gap: 12px; /* sual mətni ilə ikon arası */
    border: 1px solid transparent;
    border-radius: 20px;
    background: var(--faq-card-bg);
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  @media (min-width: 640px) {
    .faq-card {
      --faq-pad-x: 24px;
      --faq-gap: 16px;
    }
  }

  .faq-card.is-open {
    background: #fff;
    border-color: var(--faq-card-open-border);
    box-shadow: var(--faq-card-open-shadow);
  }

  /* Başlıq: global.css h3-ə böyük şrift və sıx sətir verir, ona görə ölçülər açıq yazılıb. */
  .faq-card h3 {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: normal;
    line-height: normal;
  }

  /* Bütün kart düymədir (klaviatura ilə də açılır). Düymənin şrifti brauzerin öz şriftidir, ona görə `font: inherit`. */
  .faq-btn {
    display: flex;
    width: 100%;
    align-items: center;
    gap: var(--faq-gap);
    padding: 18px var(--faq-pad-x);
    border: 0;
    border-radius: 20px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .faq-btn {
      padding-block: 21px;
    }
  }

  .faq-btn:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .faq-text {
    flex: 1;
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.005em;
  }

  @media (min-width: 640px) {
    .faq-text {
      font-size: 16.5px;
    }
  }

  /* Sağdakı dairəvi ikon: bağlıda ağ + ox aşağı, açıqda mavi + ox yuxarı (aşağı ox 180° fırlanır). */
  .faq-ic {
    display: grid;
    place-items: center;
    width: var(--faq-icon-size);
    height: var(--faq-icon-size);
    flex-shrink: 0;
    border: 1px solid var(--color-hair);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      color 0.4s ease;
  }

  /* Oxu bükən qabıqdır, Lucide-in <svg>-si deyil: svg-yə scoped qayda çatmır (bax Security.astro-dakı :global izahı). */
  .faq-chevron {
    display: inline-flex;
    transition: transform 0.6s var(--faq-ease);
  }

  .faq-card.is-open .faq-ic {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: #fff;
  }

  .faq-card.is-open .faq-chevron {
    transform: rotate(180deg);
  }

  /* Hover yalnız siçanlı cihazlarda: telefonda toxunuşdan sonra hover «ilişib» qalır. */
  @media (hover: hover) {
    .faq-card:not(.is-open):hover {
      background: var(--faq-card-bg-hover);
    }

    .faq-card:not(.is-open):hover .faq-ic {
      border-color: var(--color-brand);
      color: var(--color-brand);
    }
  }

  /* ---------- Cavabın yavaş açılması ----------
     CSS «height: auto»-nu animasiya edə bilmir. Ona görə panel 1 sətirlik grid-dir:
     grid-template-rows 0fr (bağlı, hündürlük 0) → 1fr (açıq, mətnin öz hündürlüyü). Bu keçid animasiya olunur.
     https://developer.mozilla.org/en-US/docs/Web/CSS/grid-template-rows
     Gizlətmə YALNIZ [data-faq-js] altındadır — JS işləməsə, bütün cavablar açıq görünür. */
  .faq-panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  .faq-panel-inner {
    overflow: hidden;
    min-height: 0; /* grid sətri 0fr-ə qədər yığıla bilsin deyə */
  }

  .faq-answer {
    /* Sağda ikonun yeri boş qalır: mətn ikonun altına girmir. Telefonda dar yerə görə bu boşluq yoxdur. */
    padding: 0 calc(var(--faq-pad-x) + var(--faq-icon-size) + var(--faq-gap)) 22px var(--faq-pad-x);
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.7;
    color: var(--faq-answer-text);
  }

  @media (max-width: 639px) {
    .faq-answer {
      padding-right: var(--faq-pad-x);
    }
  }

  [data-faq-js] .faq-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s var(--faq-ease-panel);
  }

  /* Açılış bağlanmadan bir az yavaşdır (0.7s / 0.55s). */
  [data-faq-js] .is-open .faq-panel {
    grid-template-rows: 1fr;
    transition-duration: 0.7s;
  }

  /* Bağlı cavab `visibility: hidden` olur: Tab ilə seçilmir, ekran oxuyucu oxumur. `visibility` animasiya
     olunmur, ona görə bağlananda 0.55s gecikməylə keçir — yığılma bitəndən sonra gizlənir. */
  [data-faq-js] .faq-answer {
    opacity: 0;
    translate: 0 -8px;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      translate 0.4s ease,
      visibility 0s linear 0.55s;
  }

  [data-faq-js] .is-open .faq-answer {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      opacity 0.5s ease 0.18s,
      translate 0.6s var(--faq-ease) 0.12s,
      visibility 0s;
  }

  /* ---------- Giriş animasiyası (bir dəfə) ---------- */

  /* Gizli başlanğıc YALNIZ `[data-anim]` altındadır: atribut olmasa (JS söndürülüb), hər şey adi halda görünür. */
  [data-anim] .faq-rise {
    opacity: 0;
  }

  /* Niyə `transition` yox, `animation ... both`: kartın öz `transition`-u (fon, çərçivə, kölgə) var; giriş də
     `transition` olsaydı, ikisi bir-birini əzərdi. `--i` sıra nömrəsidir: elementlər 70ms fasilə ilə bir-bir
     çıxır. Ayrıca `translate` xassəsi işlənir ki, `transform` ilə (ox fırlanması) toqquşmasın. */
  [data-anim].is-live .faq-rise {
    animation: faq-rise 0.7s var(--faq-ease) calc(var(--i, 0) * 70ms) both;
  }

  /* @keyframes adı Astro-da scope olunmur: global.css-də otuza yaxın keyframe var, ona görə `faq-` prefiksi. */
  @keyframes faq-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ---------- Hərəkəti azalt ----------
     Skriptin özü də bu halda `data-anim` yazmır (hər şey dərhal görünür). Burada isə qalanı: açılıb-bağlanma
     və ox fırlanması animasiyasız olur — cavab dərhal açılır/bağlanır. */
  @media (prefers-reduced-motion: reduce) {
    [data-anim] .faq-rise {
      opacity: 1;
      animation: none !important;
    }

    .faq-card,
    .faq-ic,
    .faq-chevron,
    [data-faq-js] .faq-panel,
    [data-faq-js] .faq-answer {
      transition: none !important;
    }
  }
</style>

<script>
  // ---------- Sabitlər ----------
  const SECTION_ID = 'faq'
  // Bölmənin neçə hissəsi ekranda olanda giriş animasiyası başlasın (0.15 = 15%).
  const LIVE_THRESHOLD = 0.15

  // Sistemdə «hərəkəti azalt» seçilibsə, heç nə gizlədilmir və canlanmır.
  // https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
  function isMotionReduced(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches
  }

  // ---------- Akkordeon: eyni anda yalnız bir cavab açıq ----------
  // Kartı açır və ya bağlayır: görünüşü CSS (`is-open` sinfi) həll edir, `aria-expanded` isə ekran oxuyucuya
  // kartın vəziyyətini deyir.
  function setOpen(card: HTMLElement, shouldOpen: boolean): void {
    card.classList.toggle('is-open', shouldOpen)
    const button = card.querySelector<HTMLButtonElement>('.faq-btn')
    if (button) {
      button.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false')
    }
  }

  function setupAccordion(section: HTMLElement): void {
    const cards = section.querySelectorAll<HTMLElement>('.faq-card')

    cards.forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('.faq-btn')
      if (!button) {
        return
      }
      button.addEventListener('click', () => {
        // Bağlıdırsa açılacaq, açıqdırsa bağlanacaq. Əvvəl hamısı bağlanır, sonra lazım olan açılır.
        const willOpen = !card.classList.contains('is-open')
        cards.forEach((otherCard) => setOpen(otherCard, false))
        if (willOpen) {
          setOpen(card, true)
        }
      })
    })
  }

  // ---------- Giriş animasiyası (bir dəfə) ----------
  // Bölmə ekrana ilk dəfə kifayət qədər girəndə `is-live` sinfi verir və izləməyi DAYANDIRIR: animasiya BİR dəfə
  // oynanır. https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
  function startWhenVisible(section: HTMLElement): void {
    const observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting) {
          return
        }
        section.classList.add('is-live')
        observer.disconnect()
      },
      { threshold: LIVE_THRESHOLD }
    )
    observer.observe(section)
  }

  // Layihədə Astro View Transitions (ClientRouter) işlənmir — BaseLayout onu idxal etmir — ona görə bu skript
  // səhifə başına bir dəfə işləyir. ClientRouter əlavə olunsa: initFaq-ı `astro:page-load`-da çağırın.
  function initFaq(): void {
    const section = document.getElementById(SECTION_ID)
    if (!section) {
      return
    }

    // Akkordeon animasiyadan asılı deyil: hərəkət azaldılsa da, kartlar açılıb-bağlanır.
    setupAccordion(section)

    if (isMotionReduced() || !('IntersectionObserver' in window)) {
      return
    }
    // `data-anim` PROGRESSIVE ENHANCEMENT-dir: gizli başlanğıc vəziyyət CSS-də yalnız `[data-anim]` altındadır,
    // atribut isə yalnız JS işləyəndə yazılır. JS söndürülübsə və ya hərəkət azaldılıbsa atribut yoxdur —
    // bütün kartlar adi halda tam görünür.
    section.dataset.anim = 'on'
    startWhenVisible(section)
  }

  initFaq()
</script>
