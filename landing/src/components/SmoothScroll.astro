---
 // Bu komponent səhifəyə Lenis kitabxanasını əlavə edir və onunla hamar sürüşməni işə salır.
---

<script>
  import Lenis from 'lenis'

  // ---------- Ayarlar ----------
  // Bir təkər hərəkətinin "sürüşmə" müddəti (saniyə). Artırsan, səhifə daha çox "süzür" və ləng hiss
  // olunur (1.4-dən yuxarı tövsiyə olunmur); azaltsan, brauzerin adi scroll-una yaxınlaşır.
  const SCROLL_DURATION = 1.5
  // Təkərin bir hərəkətinin qət etdiyi məsafənin vuruğu. 1 = brauzerin özü qədər. Artırsan, hər
  // hərəkət daha uzağa aparır (sürətli), azaltsan daha az (ehtiyatlı).
  const WHEEL_MULTIPLIER = 1
  // Menyu linkinə (#how, #modules, #pricing, #faq) və "Yuxarı" düyməsinə klikləyəndə bölməyə sürüşmənin
  // müddəti (saniyə). Yalnız linklərə aiddir, təkərlə sürüşməyə (SCROLL_DURATION) təsir etmir. Müddət
  // sabitdir: yaxın bölməyə də, uzaq bölməyə də eyni vaxta çatır. Azaltsan sürətlənir, artırsan yavaşlayır.
  const ANCHOR_DURATION = 1.6

  // Easing (sürət əyrisi) — sürüşmənin vaxt boyu necə sürətlənib-yavaşladığını təsvir edən funksiyadır.
  // progress: keçən vaxtın payı (0 = başlanğıc, 1 = son), nəticə: qət olunan məsafənin payı (0 → 1).
  // Təkərlə sürüşmə üçün: sürətlə başlayır, sonda yumşaq dayanır (Lenis sənədindəki easeOutExpo).
  function easeOutExpo(progress: number): number {
    return Math.min(1, 1.001 - Math.pow(2, -10 * progress))
  }

  // Linklərlə sürüşmə üçün: easeInOutCubic — əvvəl yavaş başlayır, ortada sürətlənir, sonda yumşaq
  // dayanır. İlk yarıda məsafə progress-in kubu ilə artır (yavaş start), ikinci yarıda eyni əyri
  // güzgüdə təkrarlanır (yavaş son). "Cubic" — üçüncü qüvvə: kvadrat daha yumşaq, dördüncü daha kəskin olardı.
  function anchorEasing(progress: number): number {
    if (progress < 0.5) {
      return 4 * progress * progress * progress
    }
    return 1 - Math.pow(-2 * progress + 2, 3) / 2
  }

  // Lenis-in `anchors` seçiminə və "Yuxarı" düyməsinə verilən ortaq ayar: ikisi eyni hissi versin.
  const ANCHOR_SCROLL = { duration: ANCHOR_DURATION, easing: anchorEasing }

  // Başqa komponentlərlə razılaşdırılmış adlar: orada dəyişsə, burada da dəyiş.
  const LOADER_LOCK_CLASS = 'qrl-lock' // PageLoader.astro: loader ekrandadırsa <html>-də olur
  const HEADER_BAR_SELECTOR = '[data-header-bar]' // Header.astro: zolağın qabığı
  const MENU_OPEN_ATTRIBUTE = 'data-open' // Header.astro: mobil menyu açıq olanda zolaqda olur

  // ---------- Lenis lazımdırmı? ----------
  // matchMedia JS-dən CSS media sorğusunu yoxlayır:
  // https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
  function isSmoothScrollAllowed(): boolean {
    const wantsReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    // pointer: coarse — əsas daxiletmə barmaqdır (telefon, planşet). Siçanlı laptop-da "fine"-dır.
    const isTouchDevice = window.matchMedia('(pointer: coarse)').matches
    return !wantsReducedMotion && !isTouchDevice
  }

  // ---------- Dayanma və davam etmə ----------
  // Səhifəni indi sürüşdürmək olmazmı? Cavab hər dəfə səhifədən oxunur, JS dəyişəni saxlanmır:
  // sinfi və atributu başqa fayllar dəyişir, onların nə vaxt dəyişdiyini burada bilmirik.
  function shouldPauseScroll(): boolean {
    const isLoaderOn = document.documentElement.classList.contains(LOADER_LOCK_CLASS)
    const isMenuOpen = document.querySelector(`${HEADER_BAR_SELECTOR}[${MENU_OPEN_ATTRIBUTE}]`) !== null
    return isLoaderOn || isMenuOpen
  }

  // stop() və start() təkrar çağırılsa zərər vermir: Lenis artıq həmin vəziyyətdədirsə, heç nə etmir.
  function pauseOrResume(lenis: Lenis): void {
    if (shouldPauseScroll()) {
      lenis.stop()
    } else {
      lenis.start()
    }
  }

  // MutationObserver elementin atributu dəyişəndə xəbər verir. Callback mikrotask kimi işləyir,
  // yəni dəyişikliyi edən kodun dərhal ardınca — mobil menyudakı linkə klikdə menyu bağlanır və
  // Lenis anchor-a sürüşməzdən əvvəl artıq davam edir.
  // https://developer.mozilla.org/en-US/docs/Web/API/MutationObserver
  function keepLenisInSyncWithPage(lenis: Lenis): void {
    const observer = new MutationObserver(() => pauseOrResume(lenis))
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })

    const headerBar = document.querySelector(HEADER_BAR_SELECTOR)
    if (headerBar) {
      observer.observe(headerBar, { attributes: true, attributeFilter: [MENU_OPEN_ATTRIBUTE] })
    }

    // Loader Lenis-dən əvvəl bitibsə və ya menyu artıq açıqdırsa, ilk vəziyyət də düzgün olsun.
    pauseOrResume(lenis)
  }

  // ---------- İşə salma ----------
  function startSmoothScroll(): void {
    const lenis = new Lenis({
      duration: SCROLL_DURATION,
      easing: easeOutExpo,
      wheelMultiplier: WHEEL_MULTIPLIER,
      smoothWheel: true, // təkər və touchpad hamarlanır
      syncTouch: false, // toxunuşla sürüşmə hamarlanmır: telefonda brauzerin öz sürüşməsi qalır
      autoRaf: true, // Lenis özü hər kadrda yenilənir (requestAnimationFrame dövrünü yazmaq lazım deyil)
      // href="#how" kimi eyni səhifədəki linklər hamar sürüşür: müddəti və əyrisi yuxarıdakı ANCHOR_SCROLL-dan
      // gəlir. Başlığın header-in altında qalmaması üçün offset vermirik: Lenis <html>-in
      // scroll-padding-top-unu (global.css) özü nəzərə alır.
      anchors: ANCHOR_SCROLL,
    })

    // BackToTop.astro bunlardan istifadə edir. window.lenis yox: onu Lenis özü başqa məqsədlə yazır.
    window.qrlLenis = lenis
    window.qrlAnchorScroll = ANCHOR_SCROLL

    keepLenisInSyncWithPage(lenis)
  }

  if (isSmoothScrollAllowed()) {
    startSmoothScroll()
  }
</script>
