---
/*
  PhoneFrame — real 3D cisim kimi qurulmuş telefon çərçivəsi (titan iPhone Pro). Ekranın içi `<slot />`-dadır.
  Harada işlənir: Hero.astro (ana səhifə, ekranda tətbiqin şəkli) və ContactBody.astro (WhatsApp yazışması).

  Props (komponentə kənardan verilən parametrlər):
    class      — kökə əlavə Tailwind sinifləri: yer, en və POZA (aşağıya bax).
    ariaLabel  — verilsə, bütün telefon bir şəkil kimi təsvir olunur (role="img"), içindəkilər ekran
                 oxuyucudan gizlənir. Ekranda öz alt mətni olan şəkil varsa (Hero), verilmir.

  `<slot />` — komponentin içinə çöldən HTML qoyulan yer: <PhoneFrame><div>ekran</div></PhoneFrame>.

  POZA. Telefonun bucağını kök elementdəki üç CSS dəyişəni verir, onları çağıran səhifə `class`-da yazır:
    --rx  arxaya əyilmə (+ = yuxarı hissə uzaqlaşır, aşağı kənar görünür)
    --ry  yana dönmə    (− = sağ kənar və düymələr görünür, + = sol kənar)
    --rz  yana əyilmə   (+ = yuxarı sağa əyilir)
  Məsələn: class="[--rx:15deg] [--ry:-20deg] [--rz:6deg] hover:[--rx:3deg] hover:[--ry:-6deg]".
  Dəyişən yazılmasa, bucaq 0-dır (telefon düz durur).

  QURULUŞ (kökdən içəri):
    kök (@container)  — ÖZ eninə görə ölçülür: bütün `cqw` ölçüləri TELEFONUN eninin 1%-dir. Ona görə
                        telefon nə qədər böyük olsa, bezel, radius və qalınlıq onunla birlikdə böyüyür.
    üzən sarğı        — `perspective` (3D dərinlik) və yavaş "üzmə" animasiyası (animate-phone-float).
      ├ döşəmə kölgəsi
      ├ GÖVDƏ (`transform-3d`) — telefonun qalınlığı: 16 titan qat bir-birinin arxasında, alt kənar
      │                         (dinamik dəlikləri + USB-C) və yan düymələr.
      └ ÖN ÜZ                  — titan haşiyə → qara bezel → ekran (slot + Dynamic Island + şüşə əksi).
  Ön üz qəsdən gövdədən AYRI elementdir: `preserve-3d` daxilindəki məzmunu brauzer aşağı ayırdetmə ilə
  çəkir və ekranın mətni bulanıq çıxır. Ön üz yastı elementdir, ona görə kəskin qalır; gövdənin önündə
  durur (translateZ = qalınlığın yarısı). Hər ikisi eyni dəyişənləri oxuyur, ona görə həmişə üst-üstə düşür.

  Bu elementlərdə `isolate`, `overflow`, `filter` OLMAMALIDIR: onlar 3D-ni yastılaşdırır, qalınlıq yox olur.
*/
interface Props {
  class?: string
  ariaLabel?: string
}
const { class: className, ariaLabel } = Astro.props

// Qalınlığı yaradan titan qatların nömrələri (0-dan 15-ə). Hər qat bir az arxada dayanır.
const depthLayers = Array.from({ length: 16 }, (_, i) => i)

// Yan düymələrin ortaq görünüşü: titan kənardan azca çıxan metal zolaq. Sol düymələr sola, güc və kamera
// düymələri sağa çıxır; çölə baxan kənar yuvarlaqdır, çöl tərəfdə ağ işıq, daxili tərəfdə zəif kölgə var
// (inset shadow = elementin İÇİNDƏ çəkilən kölgə). Hündürlük (top, h) hər düymədə ayrıca verilir.
const sideKey =
  'absolute w-[2cqw] bg-[linear-gradient(180deg,#d9dade,#6f7279_50%,#c3c5ca)]'
const keyLeft = `${sideKey} -left-[1.35cqw] rounded-l-[1cqw] shadow-[inset_0.35cqw_0_0_rgb(255_255_255/0.7),inset_-0.45cqw_0_0_rgb(0_0_0/0.25)]`
const keyRight = `${sideKey} -right-[1.35cqw] rounded-r-[1cqw] shadow-[inset_-0.35cqw_0_0_rgb(255_255_255/0.7),inset_0.45cqw_0_0_rgb(0_0_0/0.25)]`
---

<!-- Kök: `@container` — içindəki `cqw` bu elementin enidir. Çağıran səhifənin `class`-ı (yer, en, poza) buradadır. -->
<div
  class:list={['@container', className]}
  role={ariaLabel ? 'img' : undefined}
  aria-label={ariaLabel}
>
  <!-- Üzən sarğı: `perspective` 3D bucağa dərinlik verir (5.2 × telefonun eni). `--t` — telefonun qalınlığı. -->
  <div class="relative animate-phone-float perspective-[520cqw] [--t:12.4cqw] motion-reduce:animate-none">
    <!-- Döşəmə kölgəsi: telefon qalxanda azca kiçilib solğunlaşır (animate-phone-shadow). -->
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-[10%] top-[97%] h-[9.5cqw] animate-phone-shadow rounded-[50%] bg-slate-900/40 blur-[3.3cqw] motion-reduce:animate-none"
    ></span>

    <!-- GÖVDƏ: ön üzlə eyni ölçüdədir (inset-0), ön üzün ARXASINDA durur (DOM-da əvvəl gəlir). -->
    <div
      aria-hidden="true"
      class="absolute inset-0 transform-3d [transform:rotateX(var(--rx,0deg))_rotateY(var(--ry,0deg))_rotate(var(--rz,0deg))] transition-transform duration-800 ease-out motion-reduce:transition-none"
    >
      <!-- Qalınlıq: eyni ölçülü 16 titan qat; z = -qalınlığın yarısından +yarısına qədər. -->
      {
        depthLayers.map((i) => (
          <span
            class="absolute inset-0 rounded-[14cqw] bg-[linear-gradient(160deg,#aeb0b7_0%,#6f7279_26%,#bcbec3_48%,#6a6d74_72%,#9b9da4_100%)] [transform:translateZ(calc(var(--t)*(var(--i)/15_-_0.5)))]"
            style={`--i:${i}`}
          />
        ))
      }

      <!-- Alt kənar: dinamik dəlikləri (iki tərəfdə) və ortada USB-C. Kənarın qalınlığı = --t. -->
      <div
        class="absolute top-full left-[13%] h-[var(--t)] w-[74%] origin-top bg-[linear-gradient(90deg,#8e9097,#cdced3_30%,#7d8088_62%,#b4b6bc)] [transform:translateZ(calc(var(--t)/2))_rotateX(-90deg)]"
      >
        <span
          class="absolute top-1/2 left-[5%] h-[26%] w-[30%] -translate-y-1/2 bg-[radial-gradient(circle,#15161a_0.57cqw,transparent_0.76cqw)] bg-size-[2.26cqw_100%]"
        ></span>
        <span
          class="absolute top-1/2 left-1/2 h-[42%] w-[24%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#15161a]"
        ></span>
        <span
          class="absolute top-1/2 right-[5%] h-[26%] w-[30%] -translate-y-1/2 bg-[radial-gradient(circle,#15161a_0.57cqw,transparent_0.76cqw)] bg-size-[2.26cqw_100%]"
        ></span>
      </div>

      <!-- Yan düymələr. Sol: action, səs artır, səs azalt; sağ: güc və kamera düyməsi. -->
      <span class={`${keyLeft} top-[17%] h-[4.5%]`}></span>
      <span class={`${keyLeft} top-[25%] h-[8%]`}></span>
      <span class={`${keyLeft} top-[35%] h-[8%]`}></span>
      <span class={`${keyRight} top-[33%] h-[12%]`}></span>
      <span class={`${keyRight} top-[62%] h-[9%]`}></span>
    </div>

    <!-- ÖN ÜZ: gövdənin önündə (+qalınlığın yarısı). Nazik parlaq titan haşiyə. -->
    <div
      class="relative rounded-[14cqw] bg-[linear-gradient(135deg,#fbfbfc_0%,#c9cbd0_30%,#f1f2f4_55%,#b4b6bc_100%)] p-[0.7cqw] [transform:rotateX(var(--rx,0deg))_rotateY(var(--ry,0deg))_rotate(var(--rz,0deg))_translateZ(calc(var(--t)/2))] transition-transform duration-800 ease-out motion-reduce:transition-none"
    >
      <!-- QARA BEZEL: ekranın ətrafındakı nazik qara haşiyə. -->
      <div class="rounded-[13.2cqw] bg-[#050506] p-[2cqw]">
        <!-- EKRAN: slot (çağıranın məzmunu) və üstündəki iki bəzək. overflow-hidden künclərdən kəsir. -->
        <div class="relative overflow-hidden rounded-[11.2cqw]">
          <slot />

          <!-- Dynamic Island: ekranın yuxarısında ortada qara həb. -->
          <span
            aria-hidden="true"
            class="absolute top-[2.6%] left-1/2 h-[3.3%] w-[30%] -translate-x-1/2 rounded-full bg-black"
          ></span>

          <!-- Şüşə əksi: şəklin üstündən keçən zəif işıq zolağı; kliklərə mane olmur. -->
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(115deg,rgb(255_255_255/0.22)_0%,transparent_28%,transparent_70%,rgb(255_255_255/0.08)_100%)]"
          ></span>
        </div>
      </div>
    </div>
  </div>
</div>
