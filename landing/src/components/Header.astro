---
/**
 * Saytın yuxarısında üzən başlıq: loqo, bölmə linkləri, dil seçimi, "Daxil ol" və "Əlaqə saxlayın"
 * düymələri; `lg`-dən dar ekranda burger və mobil menyu. Harada: BaseLayout onu hər səhifəyə qoyur.
 * Props: lang — səhifənin dili; path — dil prefiksi olmadan cari ünvan (dil seçimi və açıq
 * səhifənin linkini işarələmək — aria-current — üçün).
 * Necə işləyir: HTML build zamanı hazırlanır; aşağıdakı script teqi menyuları açıb-bağlayır, aşağı
 * sürüşəndə şəffaf zolağı şüşə qapsula çevirir. Zolaq heç vaxt gizlənmir, həmişə ekranın yuxarısında qalır.
 */
import { AZ, RU, US } from "country-flag-icons/string/3x2";
import {
  useTranslations,
  localizedPath,
  availableLangs,
  type Lang,
} from "../i18n/ui";
import { SITE, PRICING } from "../data/site";
import { getImage } from "astro:assets";
import { LOGO_WORD } from "../data/brand";

// Loqo yazısının yeganə variantı: BaseLayout onu <head>-də əvvəlcədən yükləyir (preload), hero posteri
// də eyni faylı işlədir. Niyə məhz bir variant — src/data/brand.ts-də izah olunub.
const logoWord = await getImage(LOGO_WORD);

interface Props {
  lang: Lang;
  /**
   * Dil prefiksi olmadan cari ünvan — dil seçimi səni elə bu səhifədə saxlayır, menyuda isə açıq
   * səhifənin linki buna görə işarələnir (aria-current).
   */
  path?: string;
}
const { lang, path = "/" } = Astro.props;
const t = useTranslations(lang);

// Dil seçimi yalnız bu səhifənin həqiqətən build olunduğu dilləri təklif edir. Yalnız Azərbaycan
// dilində olan səhifədə (bloq, 404) isə ümumiyyətlə görünmür: bir elementli açılan siyahı mənasızdır,
// olmayan dillərə keçid isə əvvəllər 404-ə aparırdı.
const routeLangs = availableLangs(path);
const otherLangs = routeLangs.filter((routeLang) => routeLang !== lang);

// Hər dil öz dilində adlanır, hər səhifədə: rus dilini axtaran adam "Русский" sözünü axtarır, bəlkə
// də oxuya bilmədiyi dildə yazılmış adını yox. Bayraqlar build zamanı hazırlanan inline SVG
// sətirləridir — nə React, nə şəkil sorğusu. İngilis dili ABŞ bayrağını alır, çünki sayt başqa hər
// yerdə en-US elan edir (htmlLang, og:locale, sitemap).
// Record<Lang, ...> hər dil üçün mütləq bir yazı tələb edir: yeni dil əlavə edib burada unutsan,
// redaktor və `npm run check` tip xətası göstərir.
// https://www.typescriptlang.org/docs/handbook/utility-types.html#recordkeys-type
const langMeta: Record<Lang, { name: string; flag: string }> = {
  az: { name: "Azərbaycan", flag: AZ },
  ru: { name: "Русский", flag: RU },
  en: { name: "English", flag: US },
};

// Bölmə linkləri tam ünvandır (ana səhifə + #hash), ona görə eyni header /elaqe/ və /bloq/
// səhifələrində də işləyir: ana səhifədə klik həmin bölməyə hamar sürüşür, başqa səhifədən klik
// ana səhifəni açıb bölməyə düşür. Ayrıca «Qiymət» səhifəsi yoxdur — «Qiymət» də eyni cür bölmə
// linkidir (#pricing).
// `isVisible: false` olan link menyuya düşmür (aşağıdakı filter). «Qiymət» bölməsi ana səhifədə
// yalnız site.ts → PRICING.enabled olanda var, ona görə link də yalnız onda görünür. Footer-də
// eyni qayda işləyir.
// `page` — ayrıca səhifəyə aparan link üçündür (məs. "/haqqimizda/"): hazırda açıq olan səhifənin
// linki bununla işarələnir (aria-current="page"). Hazırda heç bir link `page` almır; massivin tipi
// onu ona görə elan edir ki, gələcəkdə əlavə olunan link bu sahəni yaza bilsin.
// Burada "Əlaqə" linki yoxdur: aşağıdakı "Əlaqə saxlayın" düyməsi elə həmin səhifəyə aparır, eyni
// yerə fərqli sözlərlə aparan iki element isə iki ayrı yer kimi oxunur. Footer-də bu link qalır.
interface NavLink {
  href: string;
  label: string;
  isVisible: boolean;
  page?: string;
}
const home = localizedPath(lang, "/");
const allLinks: NavLink[] = [
  { href: `${home}#how`, label: t("nav.how"), isVisible: true },
  { href: `${home}#modules`, label: t("nav.modules"), isVisible: true },
  { href: `${home}#pricing`, label: t("nav.pricing"), isVisible: PRICING.enabled },
  { href: `${home}#faq`, label: t("nav.faq"), isVisible: true },
];
const links = allLinks.filter((link) => link.isVisible);

// İşçilərin daxil olduğu tətbiq — bütün şirkətlər üçün eyni ünvan.
const appUrl = "https://app.qrlog.az";
const contactHref = localizedPath(lang, "/elaqe/");

// Ortaq sinif (class) sətirləri: bir neçə yerdə təkrarlanan görünüş bir dəfə yazılır — iki düymə
// həm zolaqda, həm mobil menyuda var, fokus halqası bir neçə elementdədir, bayraq qutusu isə həm
// dil düyməsində, həm də açılan siyahıda.
// Bu saytda Tailwind-in Preflight sıfırlaması yoxdur (styles/tailwind.css-ə bax), ona görə aşağıdakı
// hər <button> və <ul> brauzerin standart border, fon, şrift və siyahı stilini özü sıfırlayır.
// Neytral rənglər `slate` yox, `stone`-dur: saytın öz boz tonları istidir (#F6F5F1 kağız, #111211
// mürəkkəb), slate isə onların yanında bənövşəyi görünür. `brand` saytın göy rəngidir (#155EEF,
// loqodakı "Log") — tailwind.css-ə bax.
const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";
const buttonBase = `items-center justify-center whitespace-nowrap rounded-lg text-sm font-semibold transition-all duration-200 ${focusRing}`;
// Sakit, fonsuz düymə — "Daxil ol"
const buttonGhost = `${buttonBase} text-stone-700 hover:bg-stone-100 hover:text-stone-900`;
// Əsas göy düymə — "Əlaqə saxlayın"
const buttonPrimary = `${buttonBase} bg-brand bg-linear-to-b from-brand to-brand-600 text-white shadow-md shadow-brand/25 hover:bg-brand-600 hover:from-brand-600 hover:to-brand-700 hover:shadow-lg hover:shadow-brand/30 active:scale-[0.98]`;
const flagBox =
  "block h-3.5 w-[21px] shrink-0 overflow-hidden rounded-[3px] ring-1 ring-stone-900/10 [&>svg]:block [&>svg]:size-full";

// ---- Zolağın "şəffaf zolaq → üzən şüşə qapsul" animasiyası ----
// Səhifənin yuxarısında zolaq düzdür: fonsuz, çərçivəsiz, kölgəsiz (barFlat). Aşağı sürüşəndə skript
// ona `data-scrolled` verir və zolaq 0.4 saniyəyə qapsula çevrilir: ağ şüşə fon, çərçivə, kölgə
// (barGlass) və kənarlardan içəri daralma (barNarrow). Hamısı CSS keçididir, JS yalnız atributu qoyur.
// Mobil menyu açılanda (`data-open`) də şüşə fon lazımdır, yoxsa menyunun yazıları səhifənin
// üstündə çılpaq qalar. Tailwind yalnız tam yazılmış sinif adlarını tapır, ona görə hər sinif iki
// variantla ayrıca yazılıb.
// backdrop-saturate yalnız şüşə halında: şəffaf zolaqda qalsaydı, onun arxasındakı hero fonunun
// rəngi zolaq boyu doyunlaşıb ayrıca bir lent kimi seçilərdi.
const barFlat =
  "border-transparent bg-transparent shadow-none backdrop-blur-[0px] backdrop-saturate-100";
const barGlass =
  "data-scrolled:border-stone-200/60 data-open:border-stone-200/60 data-scrolled:bg-white/90 data-open:bg-white/90 data-scrolled:shadow-md data-open:shadow-md data-scrolled:shadow-stone-900/5 data-open:shadow-stone-900/5 data-scrolled:backdrop-blur-xl data-open:backdrop-blur-xl data-scrolled:backdrop-saturate-150 data-open:backdrop-saturate-150";
// Hər tərəfdən 32px daralır (yalnız `sm`-dən yuxarı: telefonda zolaq onsuz da ekranın kənarına yaxındır).
// Həm eni, həm max-eni dəyişir: dar ekranda max-en işləmir, geniş ekranda isə en işləmir.
const barNarrow =
  "sm:data-scrolled:w-[calc(100%-4rem)] sm:data-scrolled:max-w-[calc(var(--maxw)-96px)]";
// Zolağın içindəki sətrin kənar boşluğu. Düz halda zolağın çərçivəsi görünmür, ona görə loqo hero
// başlığı ilə eyni xətdə durmalıdır: səhifənin yan boşluğu `lg`-dən yuxarı 32px, aşağı 22px-dir
// (global.css .wrap), zolaq isə ekranın kənarından 16px içəridədir. `lg`-dən yuxarı 16px (pl-4)
// loqonu mətnlə üst-üstə salır, dar ekranda bu çox olardı, ona görə orada 6px (pl-1.5).
// Qapsulda (data-scrolled) və menyu açıq olanda (data-open) boşluq hər yerdə 16/12px olur.
const rowEdge =
  "pl-1.5 pr-1.5 lg:pl-4 lg:pr-3 group-data-scrolled/header:pl-4 group-data-scrolled/header:pr-3 group-data-open/header:pl-4 group-data-open/header:pr-3 transition-[padding] duration-400 ease-[cubic-bezier(0.22,0.61,0.36,1)] motion-reduce:transition-none";
// Animasiyanın müddəti və əyrisi: saytın başqa bölmələrindəki yumşaq əyri (cubic-bezier(0.22,0.61,0.36,1)).
const barMotion =
  "transition-[width,max-width,background-color,border-color,box-shadow,backdrop-filter] duration-400 ease-[cubic-bezier(0.22,0.61,0.36,1)] motion-reduce:transition-none";
---

<!--
  Üzən header. <header> elementinin özü yalnız zolağı ekranın kənarlarından aralı saxlayan
  çərçivədir. O, fixed-dir, ona görə səhifədə yer tutmur: hər səhifənin birinci bölməsi ən
  yuxarıdan başlayır və şüşə zolaq onun üstündə üzür. global.css .hero və .page-hero-ya bu
  hündürlüyü geri verir (--header-h). <header> klikləri özündən keçirir (pointer-events-none),
  ona görə onun şəffaf kənarlarının altındakı səhifə kliklənə bilir.

  Zolağın özü ([data-header-bar]) səhifənin yuxarısında şəffafdır; aşağı sürüşəndə şüşə qapsula
  çevrilib daralır (yuxarıdakı barFlat / barGlass / barNarrow sabitləri).
-->
<header
  data-header
  class="pointer-events-none fixed inset-x-0 top-0 z-50 p-3 sm:p-4"
>
  <div
    data-header-bar
    class={`group/header pointer-events-auto relative mx-auto w-full max-w-[calc(var(--maxw)-32px)] rounded-2xl border ${barFlat} ${barGlass} ${barNarrow} ${barMotion}`}
  >
    <div class={`flex h-16 items-center gap-3 lg:gap-8 ${rowEdge}`}>
      <a class={`shrink-0 rounded-md ${focusRing}`} href={home} aria-label={SITE.name}>
        <img
          class="h-6.5 w-auto sm:h-7"
          src={logoWord.src}
          alt={SITE.name}
          width={LOGO_WORD.width}
          height={LOGO_WORD.height}
        />
      </a>

      <nav class="hidden lg:block" aria-label={t("a11y.nav")}>
        <ul class="flex list-none items-center gap-1">
          {
            links.map((link) => (
              <li>
                <a
                  class={`inline-flex h-10 items-center rounded-full px-3 text-[14.5px] font-medium text-stone-600 transition-colors duration-200 hover:bg-stone-100 hover:text-stone-900 aria-[current=page]:text-brand ${focusRing}`}
                  href={link.href}
                  aria-current={link.page === path ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1 sm:gap-2">
        {
          otherLangs.length > 0 && (
            <div class="group/lang relative" data-lang>
              <button
                type="button"
                class={`flex h-10 cursor-pointer items-center gap-2 rounded-full border-0 bg-transparent px-3 text-sm font-semibold text-stone-700 transition-colors duration-200 hover:bg-stone-100 hover:text-stone-900 group-data-open/lang:bg-stone-100 ${focusRing}`}
                aria-expanded="false"
                aria-controls="lang-menu"
                aria-label={`${t("a11y.lang")}: ${lang.toUpperCase()} (${langMeta[lang].name})`}
                data-lang-trigger
              >
                <span class={flagBox} aria-hidden="true" set:html={langMeta[lang].flag} />
                <span aria-hidden="true">{lang.toUpperCase()}</span>
                <svg
                  class="size-3.5 text-stone-500 transition-transform duration-200 group-data-open/lang:rotate-180"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 7.5 5 5 5-5" />
                </svg>
              </button>

              {/*
                `visibility` keçid (transition) siyahısındadır ki, kart bağlanarkən bütün sönmə
                müddətində ekranda qalsın. Amma yalnız bağlananda: açıq vəziyyət onu siyahıdan yenidən
                çıxarır, ona görə açılanda menyu elə həmin kadrda görünür və ↓ düyməsi fokusu dərhal
                içəri keçirə bilir.
              */}
              <ul
                id="lang-menu"
                class="invisible absolute right-0 top-full z-10 mt-5 min-w-48 origin-top-right -translate-y-1 scale-95 list-none rounded-xl border border-stone-200/70 bg-white p-1.5 opacity-0 shadow-lg shadow-stone-900/10 transition-[opacity,translate,scale,visibility] duration-150 ease-out group-data-open/lang:visible group-data-open/lang:translate-y-0 group-data-open/lang:scale-100 group-data-open/lang:opacity-100 group-data-open/lang:transition-[opacity,translate,scale]"
                data-lang-menu
              >
                {otherLangs.map((otherLang) => (
                  <li>
                    <a
                      class={`flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-stone-700 transition-colors duration-150 hover:bg-stone-100 hover:text-stone-900 focus-visible:bg-stone-100 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand`}
                      href={localizedPath(otherLang, path)}
                      hreflang={otherLang}
                      lang={otherLang}
                    >
                      <span class={flagBox} aria-hidden="true" set:html={langMeta[otherLang].flag} />
                      <span class="flex-1 font-medium">{langMeta[otherLang].name}</span>
                      <span
                        class="text-xs font-semibold tracking-wide text-stone-500"
                        aria-hidden="true"
                      >
                        {otherLang.toUpperCase()}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <!--
          İki çağırış düyməsi var və onlar fərqli insanlar üçündür. "Əlaqə saxlayın" hələ QRLog-u olmayan
          şirkət üçündür — əsas düymə odur, çünki bu sayt məhz bunun üçündür. "Daxil ol" isə QRLog-u
          artıq işlədən və yadında qalan adı yazıb bura düşən işçilər üçündür. O, app.qrlog.az-a
          aparır: işçinin hansı şirkətdən olduğunu bilmədən hər şirkət üçün işləyən yeganə ünvana.
          Qəsdən sakit, fonsuz (ghost) düymədir: satışla rəqabət aparmamalıdır.
          (2026-08-24-ə qədər saytda qəsdən heç bir giriş linki yox idi — insanların tətbiqə öz
          ünvanı ilə girəcəyi gözlənirdi, amma çoxu belə etmədi.)
          Hər düymə zolağa sığmadığı enlikdə mobil menyuya keçir: əsas düymə 540px-dən dar ekranda
          (540px-də zolağa hələ loqo, dil seçimi, bir düymə və burger sığır), daha sakit giriş linki
          isə bir addım tez — `sm`-dən dar ekranda. Hər düymənin eyni anda yalnız bir nüsxəsi görünür;
          aşağıda mobil menyudakı nüsxələr bunun güzgü əksi olan breakpoint-lərlə işləyir.
        -->
        <a class={`${buttonGhost} hidden px-4 py-2.5 sm:inline-flex`} href={appUrl}>
          {t("cta.login")}
        </a>
        <!--
          Bu düymə ana səhifədə hero-dakı "Əlaqə saxlayın" ekranda görünərkən gizlidir (eni sıfırdır),
          o ekrandan çıxanda yumşaq açılır — beləcə eyni düymə ekranda heç vaxt iki dəfə görünmür, amma
          səhifənin hər yerində əlçatan qalır. Başqa səhifələrdə hero düyməsi yoxdur, ona görə bu düymə
          həmişə görünür. Nə vaxt gizlənəcəyini aşağıdakı skriptdəki setupHeaderCta() qərar verir: o,
          zolağa (`[data-header-bar]`) `data-cta-hidden` atributu qoyur, bu sinifləri isə həmin atribut
          idarə edir (`group-data-cta-hidden/header:`: "qrup — zolaq — həmin atributa malikdirsə").

          Niyə grid? `width: auto` animasiya olunmur — brauzer "auto"-dan rəqəmə keçidi hesablaya bilmir.
          `grid-template-columns` isə `1fr → 0fr` animasiya olunur: tək sütunun eni düymənin öz eni ilə
          sıfır arasında hamar dəyişir. Düymə (`<a>`) sütuna sıxılır (`min-w-0`), taşan mətn
          `overflow-hidden` ilə kəsilir.
          Padding (px-5 py-2.5) düymənin özündə yox, içindəki <span>-dadır. Elementin padding-i heç
          vaxt sıfırdan kiçik ola bilməz: padding düymədə olsaydı, "gizli" halda da sütun 40px enində
          qalardı (yer tutardı, "Daxil ol" lazımsız yerə sola itələnərdi). <span>-da isə düymənin özü
          həqiqətən sıfır enə düşür.
        -->
        <div
          class="hidden min-[540px]:grid grid-cols-[1fr] transition-[grid-template-columns,opacity] duration-450 ease-out motion-reduce:transition-none group-data-cta-hidden/header:pointer-events-none group-data-cta-hidden/header:grid-cols-[0fr] group-data-cta-hidden/header:opacity-0"
        >
          <a
            class={`${buttonPrimary} inline-flex min-w-0 overflow-hidden whitespace-nowrap`}
            href={contactHref}
            data-header-cta
          >
            <span class="shrink-0 px-5 py-2.5">{t("cta.btn1")}</span>
          </a>
        </div>

        <button
          type="button"
          class={`group/burger relative flex size-10 cursor-pointer items-center justify-center rounded border-0 bg-transparent text-stone-800 transition-colors duration-200 hover:bg-stone-100 lg:hidden ${focusRing}`}
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t("nav.menu")}
          data-menu-trigger
        >
          <span
            class="absolute h-0.5 w-5 -translate-y-1.5 rounded-full bg-current transition duration-300 group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:rotate-45"
            aria-hidden="true"></span>
          <span
            class="absolute h-0.5 w-5 rounded-full bg-current transition duration-200 group-aria-expanded/burger:scale-x-0 group-aria-expanded/burger:opacity-0"
            aria-hidden="true"></span>
          <span
            class="absolute h-0.5 w-5 translate-y-1.5 rounded-full bg-current transition duration-300 group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:-rotate-45"
            aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <!-- Mobil menyu: -->
    <div
      id="mobile-menu"
      class="invisible grid grid-rows-[0fr] transition-[grid-template-rows,visibility] duration-300 ease-out group-data-open/header:visible group-data-open/header:grid-rows-[1fr] lg:hidden"
      data-menu
    >
      <div class="min-h-0 overflow-hidden">
        <!-- data-lenis-prevent: bu siyahının öz scroll-u var. Atribut olmasa, hamar scroll (Lenis) təkəri
             tutub səhifəni sürüşdürər, siyahı isə yerində qalar. Menyu açıq olanda Lenis onsuz da dayanır
             (SmoothScroll.astro). -->
        <div
          class="mx-2 max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain border-t border-stone-200/70 pb-3 pt-2"
          data-lenis-prevent
        >
          <nav aria-label={t("a11y.nav")}>
            <ul class="list-none">
              {
                links.map((link) => (
                  <li>
                    <a
                      class="block rounded-xl px-2 py-3 text-[15px] font-medium text-stone-700 transition-colors duration-200 hover:bg-stone-100 hover:text-stone-900 focus-visible:bg-stone-100 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand aria-[current=page]:text-brand"
                      href={link.href}
                      aria-current={link.page === path ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <!-- Sayta telefondan gələn işçi elə tətbiqə girmək istəyən adamdır. -->
          <div class="mt-2 grid gap-2 border-t border-stone-200/70 pt-3 sm:hidden">
            <a
              class={`${buttonGhost} flex px-4 py-3 ring-1 ring-inset ring-stone-200`}
              href={appUrl}>{t("cta.login")}</a
            >
            <a
              class={`${buttonPrimary} flex px-5 py-3 min-[540px]:hidden`}
              href={contactHref}>{t("cta.btn1")}</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Header-in davranışı dörd hissədir: dil menyusu, mobil menyu, onların bağlanması və sürüşəndə
  // zolağın şüşə qapsula çevrilməsi. Hər hissə aşağıda öz setup...() funksiyasındadır; hamısı faylın
  // sonunda çağırılır.

  // Bu qədər (px) aşağı sürüşəndən sonra şəffaf zolaq şüşə qapsula çevrilir (data-scrolled).
  const SCROLLED_AFTER_PX = 8;
  // Tailwind-in `lg` sərhədi: bu enlikdən burger düyməsi və mobil menyu gizlənir (lg:hidden).
  const DESKTOP_MEDIA_QUERY = "(min-width: 1024px)";
  // Header-in hündürlüyü global.css-dəki --header-h dəyişənindən oxunur (90px, 640px-dən geniş ekranda
  // 98px). Dəyişən nədənsə oxunmasa, bu ehtiyat dəyər işləyir.
  const FALLBACK_HEADER_HEIGHT_PX = 90;

  // <HTMLElement> TypeScript-ə hansı növ element qayıtdığını deyir (yalnız tip üçündür, işləmə
  // zamanı yoxlanmır) — onsuz nəticə sadəcə Element olur və .focus() kimi metodlar tip xətası verir.
  // https://www.typescriptlang.org/docs/handbook/2/generics.html
  const bar = document.querySelector<HTMLElement>("[data-header-bar]");

  if (bar) {
    const menuButton = bar.querySelector<HTMLButtonElement>("[data-menu-trigger]");
    const mobileMenu = bar.querySelector<HTMLElement>("[data-menu]");
    const langDropdown = bar.querySelector<HTMLElement>("[data-lang]");
    const langButton = langDropdown?.querySelector<HTMLButtonElement>("[data-lang-trigger]");
    const langLinks = langDropdown
      ? Array.from(langDropdown.querySelectorAll<HTMLAnchorElement>("[data-lang-menu] a"))
      : [];

    // ---------- Vəziyyət ----------
    // Panelin açıq və ya bağlı olması JS dəyişənində yox, yalnız atributlarda saxlanır: `data-open`
    // görünüşü idarə edir (group-data-open:* sinifləri), aria-expanded isə ekran oxuyucusuna xəbər
    // verir. Onları əl ilə dəyişmə — setLangDropdownOpen() və setMobileMenuOpen() ikisini birlikdə
    // yeniləyir.
    // Yeganə JS dəyişəni zolağın "sürüşdürülmüş" görünüşü üçündür; onun əsl başlanğıc dəyəri
    // setupScrolledLook()-da oxunur.
    let isScrolled = false; // zolaq "sürüşdürülmüş" görünüşdədirmi — `data-scrolled`-in kopyası

    // ---------- Panelləri açıb-bağlamaq ----------
    const isMobileMenuOpen = () => bar.hasAttribute("data-open");

    const isLangDropdownOpen = () => {
      if (!langDropdown) return false;
      return langDropdown.hasAttribute("data-open");
    };

    // Eyni anda yalnız bir panel açıq ola bilər, ona görə açılan panel o birini bağlayır.
    const setLangDropdownOpen = (open: boolean) => {
      if (!langDropdown || !langButton) return;
      langDropdown.toggleAttribute("data-open", open);
      langButton.setAttribute("aria-expanded", String(open));
      if (open) {
        setMobileMenuOpen(false);
      }
    };

    const setMobileMenuOpen = (open: boolean) => {
      if (!menuButton) return;
      bar.toggleAttribute("data-open", open);
      menuButton.setAttribute("aria-expanded", String(open));
      if (open) {
        setLangDropdownOpen(false);
      }
    };

    // ---------- Dil menyusu ----------
    // Dil düyməsində ↓ və ya ↑: menyunu açır və fokusu birinci (↓) və ya sonuncu (↑) dilə keçirir.
    const openLangDropdownFromKeyboard = (event: KeyboardEvent) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault(); // ox düyməsi səhifəni sürüşdürməsin
      setLangDropdownOpen(true);
      const targetIndex = event.key === "ArrowDown" ? 0 : langLinks.length - 1;
      langLinks[targetIndex]?.focus();
    };

    // Basılan düyməyə görə fokusun keçəcəyi dilin indeksini qaytarır.
    // -1 qaytarırsa, bu düymə siyahıda gəzmək üçün deyil.
    const findNextLangIndex = (key: string, currentIndex: number) => {
      const linkCount = langLinks.length;
      if (key === "ArrowDown") {
        return (currentIndex + 1) % linkCount; // sonuncudan sonra yenidən birinciyə
      }
      if (key === "ArrowUp") {
        return (currentIndex - 1 + linkCount) % linkCount; // birincidən əvvəl sonuncuya
      }
      if (key === "Home") {
        return 0;
      }
      if (key === "End") {
        return linkCount - 1;
      }
      return -1;
    };

    // Fokus dil siyahısının içindədirsə: ↓ ↑ Home End onu dillər arasında gəzdirir.
    // Elementi event.target-dən götürürük, document.activeElement-dən yox. Dil düyməsində basılan ↓
    // əvvəlcə yuxarıdakı funksiyada fokusu birinci dilə keçirir, sonra eyni hadisə bu konteynerə
    // qalxır (bubbling). activeElement-i oxusaydıq, o artıq birinci dil olardı və fokus ikinci dəfə
    // yerini dəyişərdi. event.target isə düymənin özüdür — siyahıda yoxdur, ona görə heç nə etmirik.
    const moveFocusInLangDropdown = (event: KeyboardEvent) => {
      const currentIndex = langLinks.indexOf(event.target as HTMLAnchorElement);
      if (currentIndex < 0) return;
      const nextIndex = findNextLangIndex(event.key, currentIndex);
      if (nextIndex < 0) return;
      event.preventDefault();
      langLinks[nextIndex].focus();
    };

    const setupLanguageMenu = () => {
      langButton?.addEventListener("click", () => setLangDropdownOpen(!isLangDropdownOpen()));
      langButton?.addEventListener("keydown", openLangDropdownFromKeyboard);
      langDropdown?.addEventListener("keydown", moveFocusInLangDropdown);
    };

    // ---------- Mobil menyu ----------
    const setupMobileMenu = () => {
      menuButton?.addEventListener("click", () => setMobileMenuOpen(!isMobileMenuOpen()));

      // Ana səhifədə bölmə linki (#how və s.) yeni səhifə yükləmir, ona görə menyu özü bağlanmalıdır.
      if (mobileMenu) {
        for (const link of mobileMenu.querySelectorAll("a")) {
          link.addEventListener("click", () => setMobileMenuOpen(false));
        }
      }

      // Planşeti çevirəndə və ya pəncərəni `lg`-dən genişləndirəndə burger düyməsi gizlənir; açıq
      // qalmış menyu isə pəncərə növbəti dəfə daralanda öz-özünə yenidən görünərdi.
      // matchMedia CSS media query-ni JavaScript-dən izləməyə imkan verir ("change" hadisəsi):
      // https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
      window.matchMedia(DESKTOP_MEDIA_QUERY).addEventListener("change", (event) => {
        if (event.matches) setMobileMenuOpen(false);
      });
    };

    // ---------- Ortaq bağlanma: fokus, kənara klik, Escape, "Geri" düyməsi ----------
    // Tab ilə zolaqdan çıxanda açıq panel bağlanır ki, Tab ardıcıllığı açıq panelin arxasında davam
    // etməsin. Amma yalnız fokus həqiqətən başqa yerə düşəndə: Safari klikdə linkə fokus vermir, ona
    // görə siçan kliki fokusu "heç yerə" aparır (relatedTarget null olur). O an bağlasaq, kliklənən
    // element klikin altından çəkilərdi. Kənara kliklər ayrıca, aşağıda tutulur.
    // relatedTarget — focusout-da fokusun keçdiyi element:
    // https://developer.mozilla.org/en-US/docs/Web/API/FocusEvent/relatedTarget
    const closePanelsWhenFocusLeaves = (event: FocusEvent) => {
      const newFocus = event.relatedTarget as Node | null;
      if (!newFocus || bar.contains(newFocus)) return;
      setLangDropdownOpen(false);
      setMobileMenuOpen(false);
    };

    // Kənara klik: dil menyusu öz qutusundan kənarda, mobil menyu isə zolaqdan kənarda edilən klikdə
    // bağlanır.
    const closePanelsOnOutsideClick = (event: MouseEvent) => {
      const target = event.target as Node;
      if (isLangDropdownOpen() && !langDropdown?.contains(target)) setLangDropdownOpen(false);
      if (isMobileMenuOpen() && !bar.contains(target)) setMobileMenuOpen(false);
    };

    // Escape açıq paneli bağlayır və fokusu onu açan düyməyə qaytarır — klaviatura ilə gəzən adam
    // yerini itirmir.
    const closePanelOnEscape = (event: KeyboardEvent) => {
      if (event.key !== "Escape") return;
      if (isLangDropdownOpen()) {
        setLangDropdownOpen(false);
        langButton?.focus();
      } else if (isMobileMenuOpen()) {
        setMobileMenuOpen(false);
        menuButton?.focus();
      }
    };

    // Brauzerin "Geri" düyməsi ilə qayıdanda səhifə tərk edildiyi kimi bərpa olunur (bfcache) — açıq
    // menyu da daxil olmaqla. Ona görə panelləri bağlayırıq.
    // event.persisted yalnız səhifə bfcache-dən qayıdanda true olur:
    // https://developer.mozilla.org/en-US/docs/Web/API/Window/pageshow_event
    // https://developer.mozilla.org/en-US/docs/Glossary/bfcache
    const resetAfterBackButton = (event: PageTransitionEvent) => {
      if (!event.persisted) return;
      setLangDropdownOpen(false);
      setMobileMenuOpen(false);
    };

    const setupClosing = () => {
      bar.addEventListener("focusout", closePanelsWhenFocusLeaves);
      document.addEventListener("click", closePanelsOnOutsideClick);
      document.addEventListener("keydown", closePanelOnEscape);
      window.addEventListener("pageshow", resetAfterBackButton);
    };

    // ---------- Sürüşmə (scroll) ----------
    // Zolaq heç vaxt gizlənmir: həmişə ekranın yuxarısında durur. Sürüşəndə yalnız görünüşü dəyişir —
    // səhifənin yuxarısında şəffafdır, bir az aşağı düşəndə şüşə qapsula çevrilir. Skript burada
    // yalnız `data-scrolled` atributunu qoyub-götürür, qalan hər şeyi CSS edir.

    // Zolağın "sürüşdürülmüş" görünüşünü (şüşə qapsul) yalnız vəziyyət dəyişəndə yeniləyir. Animasiyanı
    // özü CSS çəkir (barGlass, barNarrow): burada yalnız atribut qoyulub-götürülür.
    const updateScrolledLook = (scrollTop: number) => {
      const nowScrolled = scrollTop > SCROLLED_AFTER_PX;
      if (nowScrolled !== isScrolled) {
        isScrolled = nowScrolled;
        bar.toggleAttribute("data-scrolled", nowScrolled);
      }
    };

    const setupScrolledLook = () => {
      // Safari-də səhifənin yuxarısındakı "rezin" sıçrayışında scrollY mənfi ola bilər, ona görə
      // Math.max ilə 0-dan aşağı düşməyə qoymuruq.
      // passive: brauzerə deyir ki, bu dinləyici preventDefault() çağırmayacaq və scroll gözləməyə
      // bilər. https://developer.mozilla.org/en-US/docs/Web/API/EventTarget/addEventListener#passive
      window.addEventListener("scroll", () => updateScrolledLook(Math.max(window.scrollY, 0)), {
        passive: true,
      });

      // Səhifə ortadan yenidən yüklənəndə zolaq elə əvvəldən "sürüşdürülmüş" görünüşdə olur.
      updateScrolledLook(Math.max(window.scrollY, 0));
    };

    // ---------- Header-dəki "Əlaqə saxlayın" düyməsi ----------
    // Hero-dakı "Əlaqə saxlayın" (`data-hero-cta`) ekranda görünərkən header-dəki düymə gizlənir,
    // ekrandan çıxanda açılır. Skript yalnız `data-cta-hidden` atributunu qoyub-götürür (görünüşü
    // markupdakı `group-data-cta-hidden/header:` sinifləri çəkir) və gizli düyməni klaviaturadan və
    // ekran oxuyucudan da çıxarır.
    // `data-*` atributu ilə idarə etmək — vəziyyəti JS dəyişənində yox, elementin özündə saxlamaq
    // deməkdir: CSS atributu görür və görünüşü özü dəyişir.
    // `tabindex="-1"` — elementi Tab ardıcıllığından çıxarır (fokus ona düşmür). `aria-hidden="true"` —
    // ekran oxuyucuya "bu element yoxdur" deyir. Gizli düymə sıfır enlidir, ona fokus düşsəydi,
    // klaviaturadan istifadə edən adam görünməyən düymədə itərdi.
    const setHeaderCtaHidden = (headerCta: HTMLElement, isHidden: boolean) => {
      bar.toggleAttribute("data-cta-hidden", isHidden);
      if (isHidden) {
        headerCta.setAttribute("tabindex", "-1");
        headerCta.setAttribute("aria-hidden", "true");
      } else {
        headerCta.removeAttribute("tabindex");
        headerCta.removeAttribute("aria-hidden");
      }
    };

    // IntersectionObserver — element ekrana girəndə və ya ekrandan çıxanda xəbər verən brauzer aləti
    // (scroll hadisəsini hər an dinləməyə ehtiyac qalmır).
    // https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
    // rootMargin ekranın yuxarı kənarını header-in hündürlüyü qədər aşağı çəkir: hero düyməsinin
    // header-in altında qalan hissəsi "görünür" sayılmasın. Dəyər səhifə açılanda bir dəfə oxunur;
    // pəncərə sonradan 640px sərhədini keçsə, 8px fərq (90 ↔ 98) əhəmiyyətsizdir.
    const setupHeaderCta = () => {
      const heroCta = document.querySelector("[data-hero-cta]");
      const headerCta = bar.querySelector<HTMLElement>("[data-header-cta]");
      // Hero düyməsi yoxdursa (başqa səhifə) və ya brauzer IntersectionObserver-i tanımırsa, heç nə
      // etmirik: heç bir atribut qoyulmur, header düyməsi həmişə görünür.
      if (!heroCta || !headerCta || !("IntersectionObserver" in window)) return;

      const headerHeight =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) ||
        FALLBACK_HEADER_HEIGHT_PX;

      const observer = new IntersectionObserver(
        (entries) => {
          // Bir neçə xəbər birlikdə gəlsə, ən sonuncusu həqiqi vəziyyətdir.
          const latestEntry = entries[entries.length - 1];
          setHeaderCtaHidden(headerCta, latestEntry.isIntersecting);
        },
        { rootMargin: `-${headerHeight}px 0px 0px 0px` }
      );
      observer.observe(heroCta);
    };

    // const ilə yazılmış funksiyanı təyin olunduğu sətirdən əvvəl çağırmaq olmur (xəta verir), ona görə
    // çağırışlar ən sondadır.
    setupLanguageMenu();
    setupMobileMenu();
    setupClosing();
    setupScrolledLook();
    setupHeaderCta();
  }
</script>
