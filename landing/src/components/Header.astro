---
import { useTranslations, localizedPath, availableLangs, type Lang } from '../i18n/ui'
import { SITE } from '../data/site'

interface Props {
  lang: Lang
  /** Current route without the language prefix — the language switcher keeps you on this page. */
  path?: string
}
const { lang, path = '/' } = Astro.props
const t = useTranslations(lang)

// The switcher only offers languages this route was actually built in, and disappears entirely on
// an Azerbaijani-only page (the blog, 404) — a one-button switcher is noise, and the missing
// buttons used to lead to 404s.
const routeLangs = availableLangs(path)

// Section links are absolute (home + hash) so the same header works on /elaqe/ and /bloq/ too.
const home = localizedPath(lang, '/')
const links = [
  { href: `${home}#how`, label: t('nav.how') },
  { href: `${home}#features`, label: t('nav.features') },
  // Always shown: /qiymet/ exists whether or not the plan table does. With plans off it answers the
  // price question with an individual quote, which is still the page people came looking for.
  { href: localizedPath(lang, '/qiymet/'), label: t('nav.pricing') },
  { href: `${home}#faq`, label: t('nav.faq') },
  { href: localizedPath(lang, '/elaqe/'), label: t('nav.contact') },
]
---

<header>
  <div class="wrap nav">
    <a class="brand" href={home} aria-label={SITE.name}>
      <img src="/logo-word.png" alt={SITE.name} width="150" height="30" />
    </a>
    <nav class="nav-links" id="navlinks" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <!-- Mobile only: the header buttons are hidden under 560px, and an employee reaching this site
           on a phone is exactly the person who wants the app. -->
      <a class="nav-login-mobile" href="https://app.qrlog.az">{t('cta.login')}</a>
    </nav>
    <div class="nav-right">
      {routeLangs.length > 1 && (
      <div class="lang" role="group" aria-label={t('a11y.lang')}>
        {routeLangs.map((l) => (
          <a
            href={localizedPath(l, path)}
            class={l === lang ? 'active' : ''}
            hreflang={l}
            aria-current={l === lang ? 'true' : undefined}
          >{l.toUpperCase()}</a>
        ))}
      </div>
      )}
      <!--
        Two calls to action, and they are for different people. "Əlaqə saxlayın" is for a company that
        does not have QRLog yet — it stays the primary, because that is what this site is for. "Daxil
        ol" is for the staff who already use it and land here by typing the name they remember; it goes
        to app.qrlog.az, the one address that works for every company without knowing which company
        they belong to. It is the quiet ghost button on purpose: it must not compete with sales.
        (This site deliberately had no login link at all until 2026-08-24 — people were expected to
        reach the app by its own address, and enough of them did not.)
        Under 560px global.css hides .nav-right .btn, so both live in the mobile menu instead.
      -->
      <a class="btn btn-ghost nav-login" href="https://app.qrlog.az">{t('cta.login')}</a>
      <a class="btn btn-primary" href={localizedPath(lang, '/elaqe/')}>{t('cta.btn1')}</a>
      <button class="menu-toggle" id="menuToggle" aria-label={t('nav.menu')} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
