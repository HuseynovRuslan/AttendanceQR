---
import { useTranslations, localizedPath, type Lang } from '../i18n/ui'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)
const home = localizedPath(lang, '/')
const todayLabel = lang === 'az' ? 'Bugünkü davamiyyət' : lang === 'ru' ? 'Посещаемость сегодня' : 'Today’s attendance'
const timelineLabel = lang === 'az' ? 'Giriş aktivliyi' : lang === 'ru' ? 'Активность приходов' : 'Check-in activity'
const people = [
  { name: 'Aygün Məmmədova', initials: 'AM', time: '09:01' },
  { name: 'Rəşad Əliyev', initials: 'RƏ', time: '09:02' },
  { name: 'Nigar Hüseynova', initials: 'NH', time: '09:03' },
]
---

<section class="hero" id="top">
  <div class="hero-bg"></div>
  <div class="aurora a1"></div>
  <div class="aurora a2"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title">
        {t('hero.title.a')}<span class="hl">{t('hero.title.hl')}</span>{t('hero.title.b')}
      </h1>
      <p class="hero-sub">{t('hero.sub')}</p>
      <div class="hero-cta">
        <a href={localizedPath(lang, '/elaqe/')} class="btn btn-primary">
          {t('cta.btn1')}
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" /></svg>
        </a>
        <a href={`${home}#how`} class="btn btn-ghost">{t('hero.cta2')}</a>
      </div>
      <div class="stats" aria-label={t('stats.title')}>
        <div class="stat"><div class="num">{t('hero.s1n')}</div><div class="lab">{t('hero.s1l')}</div></div>
        <div class="stat"><div class="num">{t('hero.s2n')}</div><div class="lab">{t('hero.s2l')}</div></div>
        <div class="stat"><div class="num">{t('hero.s3n')}</div><div class="lab">{t('hero.s3l')}</div></div>
      </div>
    </div>

    <div class="ops-board" aria-label={`${todayLabel}. ${t('scan.demo')}`}>
      <div class="ops-head">
        <div><span>{todayLabel}</span><strong>24 / 08 / 2026</strong></div>
        <span class="ops-live"><i></i>{t('scan.live')}</span>
      </div>
      <div class="ops-kpis">
        <div class="ops-primary"><span>{t('dash.present')}</span><strong>184</strong><small>+12%</small></div>
        <div><span>{t('dash.out')}</span><strong>46</strong></div>
        <div><span>{t('dash.absent')}</span><strong>8</strong></div>
      </div>
      <div class="ops-timeline" aria-hidden="true">
        <div class="timeline-label"><span>{timelineLabel}</span><b>08:00 — 18:00</b></div>
        <div class="timeline-hours"><span>08</span><span>10</span><span>12</span><span>14</span><span>16</span><span>18</span></div>
        <div class="timeline-track">
          <span class="timeline-bar b1"></span><span class="timeline-bar b2"></span><span class="timeline-bar b3"></span>
          <span class="timeline-bar b4"></span><span class="timeline-bar b5"></span><span class="timeline-bar b6"></span>
          <span class="timeline-now"><i></i></span>
        </div>
      </div>
      <div class="ops-feed">
        <div class="ops-feed-head"><span>{t('scan.feed')}</span><small>{t('scan.demo')}</small></div>
        {people.map((person, index) => (
          <div class="ops-row" style={`--row-delay:${index * 1.6}s`}>
            <span class="ops-avatar">{person.initials}</span>
            <strong>{person.name}</strong>
            <span class="ops-state"><i></i>{t('scan.status')}</span>
            <time>{person.time}</time>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
