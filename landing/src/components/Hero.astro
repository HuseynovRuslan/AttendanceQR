---
import { Image, getImage } from "astro:assets";
import { useTranslations, localizedPath, type Lang } from "../i18n/ui";
import { LOGO_WORD } from "../data/brand";
import qrPoster from "../assets/images/product/qrlog.png";
import appShot from "../assets/images/product/qrlog-app.png";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const home = localizedPath(lang, "/");

// The same derivative the header preloads, so the poster wordmark costs no extra request.
const logoWord = await getImage(LOGO_WORD);

// The three figures under the rule: `n` the number, `l` what it counts.
const stats = [
  { n: t("hero.s1n"), l: t("hero.s1l") },
  { n: t("hero.s2n"), l: t("hero.s2l") },
  { n: t("hero.s3n"), l: t("hero.s3l") },
];

// The scene on the right is sample data, and the label in its corner says so. The person is the one
// the app screenshot itself greets — "Salam, Əli Məmmədov", "Giriş 08:58" — so the floating note and
// the screen behind it tell the same story. Change one and the other has to change with it.
const person = { name: "Əli Məmmədov", initials: "ƏM", time: "08:58" };
const team = ["CH", "NM", "RH"];
const checks = [t("hero.d.c1"), t("hero.d.c2"), t("hero.d.c3"), t("hero.d.c4")];
// The same 184 as the sentence in hero.d.liveD — if one moves the other has to move with it.
const atWork = 184;

// One skin for the notes over the scene: glass over whatever is behind them, a hairline edge and a
// lift under the pointer. The border colour is NOT in here — two border-* utilities on one element
// race in the stylesheet, and the live card needs a green edge — so each card brings its own.
const cardSkin =
  "rounded-2xl border p-2.5 shadow-[0_12px_30px_-14px_rgb(15_23_42/0.45)] backdrop-blur-md transition-transform duration-300 will-change-transform";
const cardWhite = `${cardSkin} border-white/70 bg-white/90`;
const card = `absolute z-20 ${cardWhite} hover:scale-105`;
// The live card is the one that says the system is running, so it carries a green edge and a little
// more glass.
const cardLive = `absolute z-20 ${cardSkin} border-emerald-500/20 bg-white/95 hover:scale-105`;
// The check-in note is the one card that is not always floating: while the scene is narrow it sits in
// the flow underneath, and only takes the pointer lift once it floats.
const cardFlow = `${cardWhite} @md:hover:scale-105`;
// No text size in here either: the "+181" badge needs a smaller one than the initials do.
const avatar =
  "flex size-6 shrink-0 items-center justify-center rounded-full font-bold ring-2 ring-white @md:size-7";

// The primary is the header's pill on the same brand blue, so the two CTAs read as one thing.
const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";
const btnBase = `inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-4 text-[15px] font-semibold transition-all duration-200 sm:w-auto ${focusRing}`;
---

<!--
  The `hero` class stays: global.css hangs the background, the minimum height and the space the fixed
  header takes off it on that one selector. Everything inside is Tailwind.
  One column on a phone (words, picture, figures), two from `lg` up — picture right, figures under the
  words.
-->
<section class="hero" id="top">
  <div
    class="wrap grid items-center gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16"
  >
    <div class="max-w-160 lg:col-start-1 lg:row-start-1">
      <h1
        class="text-[clamp(42px,6.2vw,76px)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance"
      >
        {
          t("hero.title.a")
        }<!--
          Scanner frame around "skan": four corners in `em`, so they scale with the heading. The word
          is inline-FLEX because a flex box drops the whitespace a formatter puts around the expression
          — otherwise the frame stops hugging the word.
        -->
        <span
          class="relative inline-flex whitespace-nowrap px-[0.16em] py-[0.04em]"
        >
          {t("hero.title.hl")}
          <span aria-hidden="true" class="absolute inset-0">
            <span
              class="absolute top-0 left-0 size-[0.3em] border-t-[0.05em] border-l-[0.05em] border-brand"
            ></span>
            <span
              class="absolute top-0 right-0 size-[0.3em] border-t-[0.05em] border-r-[0.05em] border-brand"
            ></span>
            <span
              class="absolute bottom-0 left-0 size-[0.3em] border-b-[0.05em] border-l-[0.05em] border-brand"
            ></span>
            <span
              class="absolute right-0 bottom-0 size-[0.3em] border-r-[0.05em] border-b-[0.05em] border-brand"
            ></span>
          </span>
        </span>{t("hero.title.b")}
      </h1>

      <p
        class="mt-6 max-w-147.5 text-[16px] leading-[1.7] text-stone-600 sm:text-[17px]"
      >
        {t("hero.sub")}
      </p>

      <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:items-center">
        <a
          class={`${btnBase} bg-brand bg-linear-to-b from-brand to-brand-600 text-white shadow-lg shadow-brand/25 hover:from-brand-600 hover:to-brand-700 hover:shadow-xl hover:shadow-brand/30 active:scale-[0.99]`}
          href={localizedPath(lang, "/elaqe/")}
        >
          {t("cta.btn1")}
        </a>
        <a
          class={`${btnBase} border border-stone-300/70 bg-white text-stone-800 hover:border-stone-400 hover:bg-stone-50`}
          href={`${home}#how`}
        >
          {t("hero.cta2")}
        </a>
      </div>
    </div>

    <!--
      The scene, with no frame around it. A bordered panel turned the demo into a picture OF a
      product; what is left is light and texture — two soft blooms behind, a dot field that fades out
      before it reaches an edge — and the phone and the poster are the objects, at the full width of
      the column. Nothing clips the notes; nothing boxes the device.

      Two pictures only — the QR of a printed poster and a real screen of the app; the poster, the
      phone shell and the four notes are markup, so every word in them is translated and every edge
      stays sharp at any size.

      Two sizing systems, on purpose:

      · Geometry — the phone's bezel and corner radii, the poster's radius and padding, the shadows —
        is in `cqw`, 1% of the scene's own width, so the whole thing scales as one piece. A 9px bezel
        around a 120px-wide phone reads as a cartoon.
      · Type is NOT. The scene is never wider than 640px, and at the `lg` breakpoint the right column
        is only ~430px, so a font size in `cqw` lands between 4px and 9px — which is why the old scene
        was unreadable on a desktop too, and not only on a phone. Everything carrying a word is in px.

      And the breakpoints are the CONTAINER's, not the viewport's (`@container`, `@md:`, `@xl:`),
      because what decides whether this scene fits is its own width — and that width does not grow
      with the viewport: it is 640px at a 700px screen and drops to ~430px at 1024px, where the
      two-column grid starts. Viewport breakpoints would size the scene for a screen it is not on.

      Under 448px of its own width the scene is compact: a bigger phone, a poster peeking out from
      behind it, two floating notes, and the check-in note dropped into the flow underneath where it
      has the full width to be read. Over 448px the fourth note appears and that one floats too.
    -->
    <div
      class="@container relative isolate mx-auto w-full max-w-160 not-supports-[width:1cqw]:hidden lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mr-0 lg:ml-auto"
    >
      <!--
        The colour the scene stands in. Two soft blooms in the brand blue and its indigo neighbour,
        behind everything. `isolate` keeps their negative z-index inside this box — without it they
        would fall through to the page's own stacking context and disappear under the section's
        background. `.hero` is `overflow:hidden`, so nothing they spill can widen the page.
      -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-10 -right-10 -z-20 size-64 rounded-full bg-brand/30 blur-3xl sm:size-80"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-12 -left-10 -z-20 size-56 rounded-full bg-indigo-400/25 blur-3xl sm:size-72"
      >
      </div>

      <!--
        The dot field, over the blooms and under the scene. With no frame to end against it is masked
        back to nothing well before its own edges, so it reads as the page's own texture rather than
        as a rectangle of pattern someone dropped behind the phone.
      -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -inset-[6%] -z-10 bg-[radial-gradient(#cbd5e1_1.2px,transparent_1.2px)] bg-size-[20px_20px] opacity-70 [mask-image:radial-gradient(ellipse_82%_76%_at_52%_45%,black_35%,transparent_88%)]"
      >
      </div>

      <!--
        This is the container being measured: `@md` means "the scene itself is 448px wide". It is also
        the box the check-in note positions against once it floats — which is why the label lives
        inside the figure and nothing else sits between the two.
      -->
      <figure
        class="relative aspect-5/7 w-full perspective-distant @md:aspect-square"
      >
        <!--
          The halo. It sits over the phone's place and nowhere else, so the device lifts off the
          panel instead of sitting on it, and it breathes on a seven-second cycle — slow enough to
          be light rather than a notification. Two layers: a tight brand core and a wide indigo
          bloom around it, because one gradient of one colour reads as a grey smudge at this size.
          First child of the figure and with no z-index of its own, so everything else paints over
          it; global.css stops the motion for anyone who asks for less of it.
        -->
        <div
          aria-hidden="true"
          class="absolute top-[4%] left-[32%] aspect-square w-[76%] animate-halo rounded-full bg-[radial-gradient(circle,rgb(21_94_239/0.3)_0%,rgb(99_102_241/0.16)_42%,transparent_70%)] blur-[4cqw] @md:top-[2%] @md:left-[28%] @md:w-[70%]"
        >
        </div>
        <div
          aria-hidden="true"
          class="absolute inset-[10%] rounded-[50%] bg-[radial-gradient(60%_55%_at_58%_50%,rgb(21_94_239/0.10),transparent_72%)] blur-[3cqw]"
        >
        </div>

        <figcaption
          class="absolute top-0 left-0 z-30 text-[10px] leading-none font-bold tracking-[0.18em] text-slate-400 uppercase @md:text-[11px]"
        >
          {t("hero.d.label")}
        </figcaption>

        <!--
          The printed poster, turned a few degrees away from the reader and standing up again when
          the pointer reaches it. The QR is the only picture in it; the words around it are the
          site's own. It holds the back plane — z-0, under everything.
        -->
        <div
          class="absolute top-[13%] bottom-[30%] left-0 z-0 flex w-[42%] flex-col -rotate-3 rounded-[3cqw] border border-white/70 bg-white p-[3cqw] shadow-[0_3cqw_5cqw_-2cqw_rgb(15_23_42/0.28)] transition-transform duration-500 ease-out will-change-transform hover:rotate-0 hover:rotate-y-0 @md:top-[10%] @md:bottom-[26%] @md:left-0 @md:w-[44%] @md:-rotate-2 @md:-rotate-y-6 @md:rounded-[2cqw] @md:p-[2.2cqw]"
        >
          <div class="flex items-center justify-between gap-1.5">
            <img
              class="h-3 w-auto @md:h-3.5"
              src={logoWord.src}
              alt=""
              width={LOGO_WORD.width}
              height={LOGO_WORD.height}
            />
            <!-- There is no room for it beside the wordmark while the poster is ~120px wide. -->
            <span class="hidden text-[10px] text-slate-400 @md:inline"
              >{t("hero.d.site")}</span
            >
          </div>
          <p
            class="mt-2 text-[12px] leading-[1.2] font-semibold text-slate-900 @md:text-[13px] @xl:text-[15px]"
          >
            {t("hero.d.poster")}
          </p>
          <!--
            512 = 2x of the widest this is ever painted, and there is a trap in getting to that
            number. The figure caps at max-w-160 (640px) while @md fires at 28rem (448px), so AT THE
            CAP it is the @md rules that govern: the poster is 44% wide minus 2.2cqw of padding
            either side — 253 CSS px, not the 42%/3cqw of the narrow state. 2x of that is 507. A 3x
            phone asks for less (404), so the desktop band is what sets the size.

            quality is pushed up because this is a QR: webp's default is tuned for photographs and
            rings the edges of hard black-and-white geometry.
          -->
          <Image
            class="mt-2 min-h-0 w-full flex-1 object-contain"
            src={qrPoster}
            alt=""
            width={512}
            quality={90}
            loading="eager"
            decoding="async"
          />
          <p
            class="mt-2 hidden text-[10px] leading-[1.35] text-slate-500 @md:line-clamp-2"
          >
            {t("hero.d.posterNote")}
          </p>
        </div>

        <!--
          The phone: a shell of hardware around the app's own screen — a dark bezel, a hairline of
          light on its edge where a real phone catches it, and one deep shadow rather than a flat
          box. It stands up straight under the pointer.

          The bezel and the radius are given twice because they are proportions of the PHONE, and
          the phone is 52% of the scene while the scene is narrow but 36% of it once it is wide —
          a single `cqw` number would round the corners half again too far in the wide state.
          The screenshot keeps its own ratio (h-auto, and the real 1170×2532 on the attributes),
          so nothing is cropped and nothing shifts while it loads.
        -->
        <div
          class="absolute top-[4%] left-[44%] z-10 w-[52%] rotate-1 rounded-[7cqw] border-[1.7cqw] border-slate-900 bg-slate-900 shadow-[0_4cqw_9cqw_-3cqw_rgb(15_23_42/0.55)] ring-1 ring-white/20 transition-transform duration-500 ease-out will-change-transform hover:rotate-0 hover:rotate-y-0 @md:left-[42%] @md:w-[42%] @md:rotate-2 @md:rotate-y-3 @md:rounded-[5cqw] @md:border-[1.2cqw]"
        >
          <!--
            640, not 512 like the poster: the widest DESKTOP paint is the same 253 CSS px (2x = 507),
            but the phone is 52% wide in the narrow state where the poster is 42%, so a 430px
            viewport at 3x asks for 545. The source is 1170 wide, so nothing is upscaled.
          -->
          <Image
            class="h-auto w-full rounded-[5.3cqw] @md:rounded-[3.8cqw]"
            src={appShot}
            alt={t("hero.d.shotAlt")}
            width={640}
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- The scan that starts it: the name on this note is the name on the screen behind it. -->
        <div
          class={`${card} top-0 left-[34%] flex w-[66%] items-center gap-2 @md:left-[56%] @md:w-[40%]`}
        >
          <span
            class="grid size-7 shrink-0 place-items-center rounded-full bg-blue-100 text-[10px] font-bold text-brand-600 @md:size-8 @md:text-[11px]"
            aria-hidden="true"
          >
            {person.initials}
          </span>
          <div class="min-w-0">
            <p
              class="text-[10px] font-semibold text-emerald-700 @md:text-[11px]"
            >
              {t("hero.d.scanned")}
            </p>
            <p
              class="truncate text-[12px] font-semibold text-slate-900 @md:text-[13px]"
            >
              {person.name}
            </p>
            <p class="text-[10px] text-slate-500 @md:text-[11px]">
              {t("demo.checkin")}, {person.time}
            </p>
          </div>
        </div>

        <!--
          The reassurance. It is the first thing to go when the scene is narrow: three notes over a
          150px-wide phone leave nothing of the screen to look at, and this is the one the reader
          can do without.
        -->
        <div
          class={`${card} hidden items-start gap-2 @md:top-[26%] @md:left-[68%] @md:flex @md:w-[36%]`}
        >
          <span
            class="grid size-7 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-500"
            aria-hidden="true"
          >
            <svg
              class="size-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 36 36"
              aria-hidden="true"
              ><circle cx="18" cy="29.54" r="3" fill="currentColor"></circle><path
                fill="currentColor"
                d="m29.18 17.71l.11-.17a1.51 1.51 0 0 0-.47-2.1A20.57 20.57 0 0 0 18 12.37c-.56 0-1.11 0-1.65.07l3.21 3.21a17.4 17.4 0 0 1 7.6 2.52a1.49 1.49 0 0 0 2.02-.46"
              ></path><path
                fill="currentColor"
                d="M32.76 9.38a27.9 27.9 0 0 0-22.58-3.11l2.63 2.63a24.68 24.68 0 0 1 18.29 3.22a1.49 1.49 0 0 0 2-.46l.11-.17a1.51 1.51 0 0 0-.45-2.11"
              ></path><path
                fill="currentColor"
                d="m3 4.75l3.1 3.1a27 27 0 0 0-2.92 1.57a1.51 1.51 0 0 0-.48 2.11l.11.17a1.49 1.49 0 0 0 2 .46a24.7 24.7 0 0 1 3.67-1.9l3.14 3.14a20.6 20.6 0 0 0-4.53 2.09a1.51 1.51 0 0 0-.46 2.1l.11.17a1.49 1.49 0 0 0 2 .46A17.5 17.5 0 0 1 14.25 16l3.6 3.6a13.4 13.4 0 0 0-6.79 1.93a1.5 1.5 0 0 0-.46 2.09l.1.16a1.52 1.52 0 0 0 2.06.44a10.2 10.2 0 0 1 9-.7L29 30.75l1.41-1.41l-26-26Z"
              ></path></svg
            >
          </span>
          <div class="min-w-0">
            <p
              class="text-[12px] font-semibold text-slate-900 @md:text-[13px]"
            >
              {t("hero.d.offlineT")}
            </p>
            <p
              class="mt-0.5 text-[10px] leading-[1.35] text-slate-600 @md:text-[11px]"
            >
              {t("hero.d.offlineD")}
            </p>
          </div>
        </div>

        <!--
          The live board. The dot pings the way a status light does — one ring going out, nothing
          else moving — and global.css stops it for anyone who asks for less motion. The stack
          shows three of the people at work and counts the rest on the badge at its end; it drops
          under the sentence while the card is narrow rather than squeezing it to two words a line.
        -->
        <div
          class={`${cardLive} bottom-[2%] left-[-1%] w-[70%] @md:top-[72%] @md:bottom-auto @md:left-[-2%] @md:w-[40%]`}
        >
          <p
            class="flex items-center gap-2 text-[11px] font-semibold text-slate-900 @md:text-[12px]"
          >
            <span
              class="relative flex size-2 shrink-0 @md:size-2.5"
              aria-hidden="true"
            >
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex size-full rounded-full bg-emerald-500"
              ></span>
            </span>
            <span
              >{t("hero.d.liveT")}: <span class="text-emerald-700"
                >{t("hero.d.liveOn")}</span
              ></span
            >
          </p>
          <div
            class="mt-2 flex flex-col gap-2 @md:flex-row @md:items-center @md:justify-between @md:gap-1.5"
          >
            <span
              class="text-[10px] leading-[1.35] text-slate-500"
            >
              {t("hero.d.liveD")}
            </span>
            <span class="flex shrink-0 -space-x-1" aria-hidden="true">
              {
                team.map((i) => (
                  <span class={`${avatar} bg-emerald-50 text-[10px] text-emerald-700 @md:text-[11px]`}>
                    {i}
                  </span>
                ))
              }
              <span
                class={`${avatar} bg-slate-100 text-[9px] text-slate-600 @md:text-[10px]`}
              >
                +{atWork - team.length}
              </span>
            </span>
          </div>
        </div>
      </figure>

      <!--
        What the check-in was actually checked against — those four are the product, so this note
        is never dropped. It is in the flow under the scene while the box is narrow, where it has
        the full width and the pills sit on two comfortable rows, and it floats over the phone once
        there is room. The pills wrap rather than filling a rigid two-column grid: "Совпадение
        лица" is half again as wide as "Üz uyğunluğu", and a cell sized for one truncates the other.
      -->
      <div
        class={`${cardFlow} relative z-20 mt-3 w-full @md:absolute @md:top-[67%] @md:left-[46%] @md:mt-0 @md:w-[42%]`}
      >
        <div class="flex items-center gap-2">
          <span
            class="grid size-6 shrink-0 place-items-center rounded-full bg-emerald-500 text-white @md:size-7"
            aria-hidden="true"
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m5 13 4 4L19 7"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p
              class="text-[12px] font-semibold text-slate-900 @md:text-[13px]"
            >
              {t("hero.d.recorded")}
            </p>
            <p class="text-[10px] text-slate-500 @md:text-[11px]">
              {person.time}, {t("hero.d.site")}
            </p>
          </div>
        </div>
        <ul role="list" class="mt-2 flex list-none flex-wrap gap-1">
          {
            checks.map((c) => (
              <li class="inline-flex items-center gap-1 rounded-lg bg-emerald-50/90 px-1.5 py-1 text-[10px] leading-[1.2] font-medium text-emerald-700 @md:text-[11px]">
                <svg
                  class="size-3 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 13 4 4L19 7" />
                </svg>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- The role is set by hand: list-none drops the list semantics in Safari. -->
    <ul
      role="list"
      class="grid list-none grid-cols-3 gap-4 border-t border-stone-300/60 pt-7 sm:gap-8 lg:col-start-1 lg:row-start-2"
      aria-label={t("stats.title")}
    >
      {
        stats.map((s) => (
          <li>
            <span class="block text-[22px] font-semibold tracking-[-0.03em] sm:text-[28px]">
              {s.n}
            </span>
            <span class="mt-1 block text-[13px] leading-snug text-stone-500">
              {s.l}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
