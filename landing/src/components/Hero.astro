---
import { useTranslations, localizedPath, type Lang } from "../i18n/ui";

const props = Astro.props;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const home = localizedPath(lang, "/");

// The three figures under the rule: `n` the number, `l` what it counts.
const stats = [
  { n: t("hero.s1n"), l: t("hero.s1l") },
  { n: t("hero.s2n"), l: t("hero.s2l") },
  { n: t("hero.s3n"), l: t("hero.s3l") },
];

// The scene on the right is sample data, and the label in its corner says so. The name is invented;
// the two pictures are real — the QR of a poster and a screen of the app itself.
const person = { name: "Çingiz Hümbətov", initials: "ÇH", time: "09:01" };
const team = ["CH", "NM", "RH"];
const checks = [t("hero.d.c1"), t("hero.d.c2"), t("hero.d.c3"), t("hero.d.c4")];
// The same 184 as the sentence in hero.d.liveD — if one moves the other has to move with it.
const atWork = 184;

// One card shape, four cards: glass over whatever is behind them, and a lift under the pointer.
const cardBase =
  "absolute z-30 rounded-[1.8cqw] shadow-[0_8px_30px_rgb(0_0_0/0.06)] backdrop-blur-xl transition-transform duration-300 will-change-transform hover:-translate-y-1";
const card = `${cardBase} border border-white/60 bg-white/80 p-[1.8cqw]`;
// The live card is the one that says the system is running, so it carries a green edge, a little
// more glass and a little more room — the avatar stack and its badge need it.
const cardLive = `${cardBase} border border-emerald-500/15 bg-white/90 p-[2.4cqw]`;
const avatar =
  "flex size-[4.8cqw] items-center justify-center rounded-full text-[1.7cqw] font-bold ring-[0.35cqw] ring-white";

// The primary is the header's pill on the same brand blue, so the two CTAs read as one thing.
const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";
const btnBase = `inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-4 text-[15px] font-semibold transition-all duration-200 sm:w-auto ${focusRing}`;
---

<!--
  The `hero` class stays: global.css hangs the background, the minimum height and the space the fixed
  header takes off it on that one selector. Everything inside is Tailwind.
  One column on a phone (words, picture, figures), two from `lg` up — picture right, figures under the
  words.
-->
<section class="hero" id="top">
  <div
    class="wrap grid items-center gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16"
  >
    <div class="max-w-160 lg:col-start-1 lg:row-start-1">
      <h1
        class="text-[clamp(42px,6.2vw,76px)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance"
      >
        {
          t("hero.title.a")
        }<!--
          Scanner frame around "skan": four corners in `em`, so they scale with the heading. The word
          is inline-FLEX because a flex box drops the whitespace a formatter puts around the expression
          — otherwise the frame stops hugging the word.
        -->
        <span
          class="relative inline-flex whitespace-nowrap px-[0.16em] py-[0.04em]"
        >
          {t("hero.title.hl")}
          <span aria-hidden="true" class="absolute inset-0">
            <span
              class="absolute top-0 left-0 size-[0.3em] border-t-[0.05em] border-l-[0.05em] border-brand"
            ></span>
            <span
              class="absolute top-0 right-0 size-[0.3em] border-t-[0.05em] border-r-[0.05em] border-brand"
            ></span>
            <span
              class="absolute bottom-0 left-0 size-[0.3em] border-b-[0.05em] border-l-[0.05em] border-brand"
            ></span>
            <span
              class="absolute right-0 bottom-0 size-[0.3em] border-r-[0.05em] border-b-[0.05em] border-brand"
            ></span>
          </span>
        </span>{t("hero.title.b")}
      </h1>

      <p
        class="mt-6 max-w-147.5 text-[16px] leading-[1.7] text-stone-600 sm:text-[17px]"
      >
        {t("hero.sub")}
      </p>

      <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:items-center">
        <a
          class={`${btnBase} bg-brand bg-linear-to-b from-brand to-brand-600 text-white shadow-lg shadow-brand/25 hover:from-brand-600 hover:to-brand-700 hover:shadow-xl hover:shadow-brand/30 active:scale-[0.99]`}
          href={localizedPath(lang, "/elaqe/")}
        >
          {t("cta.btn1")}
        </a>
        <a
          class={`${btnBase} border border-stone-300/70 bg-white text-stone-800 hover:border-stone-400 hover:bg-stone-50`}
          href={`${home}#how`}
        >
          {t("hero.cta2")}
        </a>
      </div>
    </div>

    <!--
      The scene. Two pictures only — the QR of a printed poster and a real screen of the app; the
      poster, the phone shell and the four cards are markup, so every word in them is translated and
      every edge stays sharp at any size.

      It scales as one piece. The box keeps a fixed aspect ratio, every position is a percentage of it
      and every size that has to hold its proportion — the phone's bezel, its corner radius, the card
      radii, the type — is in `cqw`, 1% of the box's own width (hence `@container` on the wrapper). A
      9px bezel around a 120px-wide phone would read as a cartoon, so the numbers from the design hold
      at the size the design was drawn at and shrink from there.
    -->
    <div
      class="@container mx-auto w-full max-w-160 not-supports-[width:1cqw]:hidden lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mr-0 lg:ml-auto"
    >
      <figure
        class="relative aspect-[624/589] w-full [perspective:1000px] max-sm:origin-top max-sm:-mb-[14.16cqw] max-sm:scale-[0.85]"
      >
        <!--
          The dot field. It reaches past the scene on every side and is masked back to nothing, so it
          fades into the page instead of ending on a straight line.
        -->
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[radial-gradient(circle,rgb(148_163_184/0.55)_1px,transparent_1px)] bg-[size:2.3cqw_2.3cqw] [mask-image:radial-gradient(ellipse_closest-side,black_85%,transparent_100%)]"
        >
        </div>

        <!-- A breath of brand colour under the phone, so the scene has a middle and not just corners. -->
        <div
          aria-hidden="true"
          class="absolute inset-[6%] rounded-[16cqw] bg-[radial-gradient(60%_55%_at_58%_50%,rgb(21_94_239/0.12),transparent_70%)] blur-[1.5cqw]"
        >
        </div>

        <figcaption
          class="absolute top-[0.5%] left-[3%] text-[11px] font-semibold tracking-wider text-slate-400/80 uppercase"
        >
          {t("hero.d.label")}
        </figcaption>

        <!--
          The printed poster, turned a few degrees away from the reader and standing up again when the
          pointer reaches it. The QR is the only picture in it; the words around it are the site's own.
        -->
        <div
          class="absolute top-[13%] bottom-[29%] left-[7%] z-10 flex w-[40%] flex-col -rotate-y-6 -rotate-2 rounded-[2cqw] border border-white/70 bg-white p-[2.2cqw] shadow-[0_2.6cqw_5cqw_-1.6cqw_rgb(15_23_42/0.25)] transition-transform duration-500 ease-out will-change-transform hover:rotate-0 hover:rotate-y-0"
        >
          <div class="flex items-center justify-between gap-[1cqw]">
            <img
              class="h-[2.4cqw] w-auto"
              src="/logo-word.png"
              alt=""
              width="640"
              height="192"
            />
            <span class="text-[1.6cqw] text-slate-400">{t("hero.d.site")}</span>
          </div>
          <p
            class="mt-[1.8cqw] text-[2.5cqw] leading-[1.15] font-semibold text-slate-900"
          >
            {t("hero.d.poster")}
          </p>
          <img
            class="mt-[1.8cqw] min-h-0 w-full flex-1 object-contain"
            src="/images/qrlog.png"
            alt=""
            width="1024"
            height="1024"
            loading="eager"
            decoding="async"
          />
          <p
            class="mt-[1.6cqw] line-clamp-2 text-[1.5cqw] leading-[1.35] text-slate-500"
          >
            {t("hero.d.posterNote")}
          </p>
        </div>

        <!--
          The phone: a shell of hardware around the app's own screen — a dark bezel, a hairline of
          light on its edge where a real phone catches it, and one deep shadow rather than a flat box.
        -->
        <div
          class="absolute top-[16%] left-[50%] z-20 w-[35%] rounded-[7.6cqw] border-[1.6cqw] border-slate-900 bg-slate-900 shadow-[0_3.5cqw_10cqw_-2.6cqw_rgb(15_23_42/1.90)] ring-1 ring-white/20"
        >
          <img
            class="h-auto w-full rounded-[6cqw] text-[1.6cqw] leading-snug text-slate-300"
            src="/images/mobile-app.jpg"
            alt={t("hero.d.shotAlt")}
            width="739"
            height="1600"
            loading="eager"
            decoding="async"
          />
        </div>

        <div
          class={`${card} top-[9%] left-[58%] flex w-[38%] items-center gap-[1.6cqw]`}
        >
          <span
            class="grid size-[5cqw] shrink-0 place-items-center rounded-full bg-blue-100 text-[1.7cqw] font-bold text-brand-600"
            aria-hidden="true"
          >
            {person.initials}
          </span>
          <div class="min-w-0">
            <p class="text-[1.5cqw] font-semibold text-emerald-700">
              {t("hero.d.scanned")}
            </p>
            <p class="truncate text-[1.9cqw] font-semibold text-slate-900">
              {person.name}
            </p>
            <p class="text-[1.5cqw] text-slate-500">
              {t("demo.checkin")}, {person.time}
            </p>
          </div>
        </div>

        <div
          class={`${card} top-[50%] left-[62%] flex w-[36%] items-start gap-[1.4cqw]`}
        >
          <span
            class="grid size-[4.4cqw] shrink-0 place-items-center rounded-[1.2cqw] bg-slate-100 text-slate-500"
            aria-hidden="true"
          >
            <svg
              {...props}
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 36 36"
              ><title>no-wifi-solid</title><circle
                cx="18"
                cy="29.54"
                r="3"
                fill="currentColor"
                class="clr-i-solid clr-i-solid-path-1"></circle><path
                fill="currentColor"
                d="m29.18 17.71l.11-.17a1.51 1.51 0 0 0-.47-2.1A20.57 20.57 0 0 0 18 12.37c-.56 0-1.11 0-1.65.07l3.21 3.21a17.4 17.4 0 0 1 7.6 2.52a1.49 1.49 0 0 0 2.02-.46"
                class="clr-i-solid clr-i-solid-path-2"></path><path
                fill="currentColor"
                d="M32.76 9.38a27.9 27.9 0 0 0-22.58-3.11l2.63 2.63a24.68 24.68 0 0 1 18.29 3.22a1.49 1.49 0 0 0 2-.46l.11-.17a1.51 1.51 0 0 0-.45-2.11"
                class="clr-i-solid clr-i-solid-path-3"></path><path
                fill="currentColor"
                d="m3 4.75l3.1 3.1a27 27 0 0 0-2.92 1.57a1.51 1.51 0 0 0-.48 2.11l.11.17a1.49 1.49 0 0 0 2 .46a24.7 24.7 0 0 1 3.67-1.9l3.14 3.14a20.6 20.6 0 0 0-4.53 2.09a1.51 1.51 0 0 0-.46 2.1l.11.17a1.49 1.49 0 0 0 2 .46A17.5 17.5 0 0 1 14.25 16l3.6 3.6a13.4 13.4 0 0 0-6.79 1.93a1.5 1.5 0 0 0-.46 2.09l.1.16a1.52 1.52 0 0 0 2.06.44a10.2 10.2 0 0 1 9-.7L29 30.75l1.41-1.41l-26-26Z"
                class="clr-i-solid clr-i-solid-path-4"></path><path
                fill="none"
                d="M0 0h36v36H0z"></path></svg
            >
          </span>
          <div>
            <p class="text-[1.95cqw] font-semibold text-slate-900">
              {t("hero.d.offlineT")}
            </p>
            <p class="mt-[0.4cqw] text-[1.65cqw] leading-[1.35] text-slate-600">
              {t("hero.d.offlineD")}
            </p>
          </div>
        </div>

        <div class={`${card} top-[66%] left-[48%] w-[37%]`}>
          <div class="flex items-center gap-[1.4cqw]">
            <span
              class="grid size-[4.6cqw] shrink-0 place-items-center rounded-full bg-emerald-500 text-white"
              aria-hidden="true"
            >
              <svg
                class="size-[2.6cqw]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m5 13 4 4L19 7"></path>
              </svg>
            </span>
            <div class="min-w-0">
              <p class="text-[1.8cqw] font-semibold text-slate-900">
                {t("hero.d.recorded")}
              </p>
              <p class="text-[1.45cqw] text-slate-500">
                {person.time}, {t("hero.d.site")}
              </p>
            </div>
          </div>
          <ul
            role="list"
            class="mt-[1.4cqw] grid list-none grid-cols-2 gap-[0.9cqw]"
          >
            {
              checks.map((c) => (
                <li class="flex items-center gap-[0.7cqw] rounded-[1cqw] bg-emerald-50/80 px-[1cqw] py-[0.8cqw] text-[1.35cqw] leading-[1.2] font-medium text-emerald-700">
                  <svg
                    class="size-[1.6cqw] shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m5 13 4 4L19 7" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
        
        <!-- Live Status Card -->
        <!--
          The live card. The dot pings the way a status light does — one ring going out, nothing
          else moving — and global.css stops it for anyone who asks for less motion. The stack shows
          three of the people at work and counts the rest on the badge at its end.
        -->
        <div class={`${cardLive} top-[70.5%] left-[1%] w-[42%]`}>
          <p class="flex items-center gap-[1.4cqw] text-[1.7cqw] font-semibold text-slate-900">
            <span class="relative flex size-[1.8cqw] shrink-0" aria-hidden="true">
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span class="relative inline-flex size-full rounded-full bg-emerald-500"></span>
            </span>
            {t("hero.d.liveT")}:
            <span class="font-semibold text-emerald-700">{t("hero.d.liveOn")}</span>
          </p>
          <div class="mt-[1.8cqw] flex items-center justify-between gap-[1.2cqw]">
            <span class="text-[1.55cqw] leading-[1.35] text-slate-500">
              {t("hero.d.liveD")}
            </span>
            <span class="flex shrink-0 -space-x-[0.8cqw]" aria-hidden="true">
              {
                team.map((i) => (
                  <span class={`${avatar} border border-emerald-100 bg-emerald-50 text-emerald-700`}>
                    {i}
                  </span>
                ))
              }
              <span
                class={`${avatar} border border-slate-200 bg-slate-100 text-[1.5cqw] text-slate-600`}
              >
                +{atWork - team.length}
              </span>
            </span>
          </div>
        </div>
      </figure>
    </div>

    <!-- The role is set by hand: list-none drops the list semantics in Safari. -->
    <ul
      role="list"
      class="grid list-none grid-cols-3 gap-4 border-t border-stone-300/60 pt-7 sm:gap-8 lg:col-start-1 lg:row-start-2"
      aria-label={t("stats.title")}
    >
      {
        stats.map((s) => (
          <li>
            <span class="block text-[22px] font-semibold tracking-[-0.03em] sm:text-[28px]">
              {s.n}
            </span>
            <span class="mt-1 block text-[13px] leading-snug text-stone-500">
              {s.l}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
