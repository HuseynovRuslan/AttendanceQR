---

// İkonlar ayrı-ayrı fayllardan idxal olunur (`@lucide/astro/icons/<ad>`) — səbəbi Audience.astro-nun
// başındakı şərhdədir (paketin kök faylı ~1700 ikonu yükləyir, dev server yavaşlayır).
import Lock from '@lucide/astro/icons/lock'
import ShieldCheck from '@lucide/astro/icons/shield-check'
import DatabaseBackup from '@lucide/astro/icons/database-backup'
import UserCheck from '@lucide/astro/icons/user-check'
import Check from '@lucide/astro/icons/check'
import { useTranslations, type Lang, type UIKey } from '../i18n/ui'
import QrDeco from './QrDeco.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

// Hover-də hər ikonun öz kiçik hərəkəti var; adı <style>-da `data-motion` ilə tutulur.
type IconMotion = 'lock' | 'shield' | 'backup' | 'roles'

interface SecurityCard {
  // `typeof Lock` — «Lucide ikon komponenti» deməkdir; bütün Lucide ikonları eyni tipdədir.
  icon: typeof Lock
  motion: IconMotion
  title: UIKey
  desc: UIKey
}

// `UIKey` tipi sayəsində açarda hərf səhvi olsa, redaktor və `npm run check` xəta göstərir.
const cards: SecurityCard[] = [
  { icon: Lock, motion: 'lock', title: 'sec.i1t', desc: 'sec.i1d' },
  { icon: ShieldCheck, motion: 'shield', title: 'sec.i2t', desc: 'sec.i3d' },
  { icon: DatabaseBackup, motion: 'backup', title: 'sec.i3t', desc: 'sec.i3d' },
  { icon: UserCheck, motion: 'roles', title: 'sec.i4t', desc: 'sec.i4d' },
]

// Kartların altındakı üç fakt. `satisfies` hər açarın ui.ts-də olduğunu yoxlayır.
const facts = ['sec.e1', 'sec.e2', 'sec.e3'] satisfies UIKey[]

// İkon ölçüləri: plitə 48px, içindəki ikon 24px; fakt işarəsi 16px, daha qalın xətt.
const CARD_ICON_SIZE = 24
const CARD_ICON_STROKE = 1.75
const FACT_ICON_SIZE = 16
const FACT_ICON_STROKE = 2.5
---

<section id="security" aria-labelledby="security-title" class="relative overflow-hidden bg-white py-20 lg:py-28">
  <div class="edge-rule pointer-events-none absolute inset-x-0 top-0 h-px bg-hair" aria-hidden="true"></div>
  <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <!-- Dekor: oxunmayan QR naxışı + bölmə ekrana gələndə bir dəfə enib-qalxan skan xətti. Yalnız md-dən böyük ekranda. -->
  <div
    class="sec-deco pointer-events-none absolute -top-12 -right-16 hidden w-95 md:block lg:-right-10 lg:w-105"
    aria-hidden="true"
  >
    <div class="sec-deco-pattern">
      <QrDeco class="block" />
    </div>
    <span class="sec-scan"></span>
  </div>

  <div class="wrap relative">
    <!-- Başlıq HowItWorks, AdminPanel və Kimlər üçün ilə eynidir: eyebrow + H2 + bir cümlə, solda, alt-alta. -->
    <div class="max-w-155">
      <span
        class="rv inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-brand uppercase"
      >
        <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
        {t('sec.eyebrow')}
      </span>
      <h2
        id="security-title"
        class="rv d1 mt-5 text-[32px] leading-[1.1] font-semibold tracking-tight text-ink sm:text-[38px]"
      >
        {t('sec.title')}
      </h2>
      <p class="rv d2 mt-4 max-w-[46ch] text-[15px] leading-[1.75] text-pretty text-ink2">{t('sec.sub')}</p>
    </div>

    <!--
      Kartlar: mobildə 1, sm-dən 2, lg-dən 4 sütun, aralıq 20px. Şəbəkə elementləri sütun boyu uzanır,
      ona görə eyni sətirdəki kartlar bərabər hündürlükdədir.
      Telefonda (sm-dən kiçik) ikon solda, mətn sağda durur — kart alçaq qalır; sm-dən ikon yuxarıda.
      `--i` kartın sıra nömrəsidir: CSS onu animasiya gecikməsini hesablamaq üçün oxuyur.
    -->
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {
        cards.map((card, index) => (
          <article
            class="sec-card flex gap-4 rounded-3xl border border-slate-200/80 p-6 sm:flex-col sm:gap-0"
            style={`--i:${index}`}
          >
            <span
              class="sec-icon inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand"
              data-motion={card.motion}
            >
              <card.icon size={CARD_ICON_SIZE} stroke-width={CARD_ICON_STROKE} />
            </span>
            {/* min-w-0: flex uşağı öz məzmunundan dar ola bilsin — yoxsa 320px-də uzun rus sözü kartı itələyir. */}
            <div class="min-w-0">
              <h3 class="text-[17px] leading-snug font-semibold tracking-[-0.01em] sm:mt-6">{t(card.title)}</h3>
              <p class="mt-2 text-[14.5px] leading-[1.65] text-ink2">{t(card.desc)}</p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Üç fakt: üstündən xətt keçən sadə siyahı. Preflight olmadığına görə list-none yazılıb. -->
    <ul
      class="mt-10 flex list-none flex-col gap-3 border-t border-slate-200/80 pt-8 text-[14.5px] leading-[1.6] text-ink2 md:flex-row md:flex-wrap md:gap-x-10"
    >
      {
        facts.map((fact, index) => (
          <li class="sec-fact flex items-start gap-2.5" style={`--i:${index}`}>
            <Check size={FACT_ICON_SIZE} stroke-width={FACT_ICON_STROKE} class="mt-0.75 shrink-0 text-brand" />
            <span>{t(fact)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ---------- Bu bölməyə xas dəyərlər ---------- */
  #security {
    --sec-deco-color: #dce3ef; /* dekorativ QR-in rəngi (HowItWorks-dakı .deco ilə eyni) */
    --sec-card-bg: #f8fafc; /* kartın fonu (Tailwind-in slate-50 rəngi) */
    --sec-card-border-hover: #b7cbf7; /* hover-də kartın kənarı: brand mavisinin açıq çaları */
    /* Saytın bütün bölmələrində işlənən yumşaq əyri (HowItWorks, AdminPanel, Kimlər üçün). */
    --sec-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    /* Qıfılın "bağlanması" üçün: sonda azca həddi aşıb qayıdır (1.6 > 1 — yay effekti). */
    --sec-bounce: cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  /* ---------- Bölmənin qabığı (HowItWorks ilə eyni) ---------- */

  /* Kənarlara doğru əriyən üst xətt. */
  .edge-rule {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
  }

  /* Yuxarı solda zəif brand işığı. color-mix() brand rənginin 6%-lik şəffaf variantını CSS-in özündə
     düzəldir: https://developer.mozilla.org/en-US/docs/Web/CSS/color_value/color-mix */
  .glow {
    background: radial-gradient(
      760px 360px at 14% -10%,
      color-mix(in oklab, var(--color-brand) 6%, transparent),
      transparent 70%
    );
  }

  /* ---------- Dekor: QR naxışı və skan xətti ---------- */

  /* Naxışın özü `currentColor` ilə çəkilir (bax QrDeco.astro) — rəngi buradan alır. Kənarları radial
     mask-image ilə əriyir: mərkəz görünür, kənar şəffaflaşır. */
  .sec-deco-pattern {
    color: var(--sec-deco-color);
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(72% 72% at 50% 50%, #000, transparent);
    mask-image: radial-gradient(72% 72% at 50% 50%, #000, transparent);
  }

  /* Skan xətti: 2px, mavi gradient, yumşaq parıltı. Başlanğıcda görünmür (opacity: 0); onu yalnız
     bölmə `is-live` olanda başlayan animasiya göstərir. `.sec-deco` mövqeli qabıqdır, ona görə
     `top: 4%` naxışın hündürlüyünə nisbətdir. */
  .sec-scan {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    height: 2px;
    border-radius: 2px;
    opacity: 0;
    background: linear-gradient(90deg, transparent, var(--color-brand) 30%, var(--color-brand) 70%, transparent);
    box-shadow: 0 0 14px color-mix(in oklab, var(--color-brand) 45%, transparent);
  }

  /* `data-anim` atributunu skript yazır (faylın sonuna bax). Atribut olmayanda — JS söndürülüb və ya
     "hərəkəti azalt" seçilib — heç bir qayda işləmir və hər şey tam görünür. */
  [data-anim].is-live .sec-scan {
    /* 4.8s, ease-in-out, 0.3s gecikmə, cəmi 1 dəfə; `both` = əvvəldə də, sonda da keyframe-in halı saxlanır. */
    animation: sec-scan 4.8s ease-in-out 0.3s 1 both;
  }

  /* 0–50%: yuxarıdan aşağı enir, 50–100%: aşağıdan yuxarı qalxır. 0%-də və 100%-də opacity: 0 —
     xətt yumşaq görünüb yumşaq itir. @keyframes adı Astro-da scope olunmur (bax HowItWorks.astro-dakı
     qeyd), ona görə `sec-` prefiksi var: global.css-də otuza yaxın keyframe var. */
  @keyframes sec-scan {
    0% {
      top: 4%;
      opacity: 0;
    }
    8% {
      opacity: 0.55;
    }
    50% {
      top: 94%;
      opacity: 0.55;
    }
    92% {
      opacity: 0.55;
    }
    100% {
      top: 4%;
      opacity: 0;
    }
  }

  /* ---------- Kart ---------- */
  .sec-card {
    background: var(--sec-card-bg);
    transition:
      transform 0.45s var(--sec-ease),
      box-shadow 0.45s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .sec-icon {
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      transform 0.45s var(--sec-ease);
  }

  /* ---------- Giriş animasiyası (bir dəfə) ---------- */

  /* Gizli başlanğıc YALNIZ `[data-anim]` altındadır: atribut olmasa (JS söndürülüb), kartlar və
     faktlar adi halda görünür. */
  [data-anim] .sec-card,
  [data-anim] .sec-fact {
    opacity: 0;
  }

  /* Niyə `transition` yox, `animation ... backwards`: `backwards` animasiya başlayana qədər (gecikmə
     vaxtı) keyframe-in `from` halını saxlayır, bitəndən sonra isə heç nəyi üstünə yazmır. Qayda
     `transform: none` yazsaydı, hover-dəki 4px qalxmanı (daha zəif seçici) əzərdi; üstəlik stagger
     gecikməsi hover keçidinə də düşərdi. `--i` kartın sıra nömrəsidir: 90ms fasilə ilə bir-bir qalxır. */
  [data-anim].is-live .sec-card {
    opacity: 1;
    animation: sec-rise 0.7s var(--sec-ease) calc(var(--i) * 90ms) backwards;
  }

  /* Faktlar kartlardan sonra gəlir: 0.5s gözləyir, sonra da 90ms fasilə ilə. */
  [data-anim].is-live .sec-fact {
    opacity: 1;
    animation: sec-rise 0.6s ease calc(0.5s + var(--i) * 90ms) backwards;
  }

  @keyframes sec-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /*
    İkon özü-özünü çəkir: `stroke-dasharray` xətti "tire-boşluq" ardıcıllığına çevirir. Tire 100 vahid
    uzunluğundadır (ikonun hər hissəsi 100-dən qısadır), `stroke-dashoffset: 100` isə nümunəni 100
    vahid sürüşdürür — beləcə tirenin yerinə boşluq düşür və xətt görünmür. Sürüşməni 0-a gətirəndə
    tire xəttin üstünə oturur və ikon "çəkilir".
    https://developer.mozilla.org/en-US/docs/Web/CSS/stroke-dashoffset

    :global() — Lucide-in yaratdığı <svg> və içindəki <path>-lər bu komponentin `data-astro-cid`
    atributunu almır, adi seçici (`.sec-icon svg *`) onlara çatmazdı. `.sec-icon` bu fayldadır, ona
    görə qayda kənara sızmır; :global() yalnız ikonun daxilinə girmək üçün işlənir.
    https://docs.astro.build/en/guides/styling/#global-styles
  */
  [data-anim] .sec-icon :global(svg *) {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  /* JS-siz səhifədə qıfılın hover keçidi (transform) bu qaydadan gəlir. */
  .sec-icon :global(svg *) {
    transition: transform 0.35s var(--sec-bounce);
  }

  /* `transition` TƏK xassədir: iki qayda yazılsa, sonuncu birincini silər. Ona görə qıfılın hover
     keçidi (transform) JS işləyəndə də bu siyahıdadır, yoxsa qıfıl yaysız "atılardı". */
  [data-anim].is-live .sec-icon :global(svg *) {
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 1.2s ease calc(0.25s + var(--i) * 90ms),
      transform 0.35s var(--sec-bounce);
  }

  /* ---------- Hover (yalnız siçanlı cihazlarda) ---------- */

  /* Telefonda toxunuşdan sonra hover "ilişib" qalır, ona görə yalnız `hover: hover` olan cihazlarda. */
  @media (hover: hover) {
    .sec-card:hover {
      transform: translateY(-4px);
      border-color: var(--sec-card-border-hover);
      background: white;
      box-shadow: 0 26px 46px -30px rgb(15 23 42 / 0.3);
    }

    .sec-card:hover .sec-icon {
      background: var(--color-brand);
      color: white;
      transform: scale(1.05);
    }

    /* Hər ikonun öz kiçik hərəkəti. `svg path` Lucide-in içindəki elementdir — :global() lazımdır
       (yuxarıdakı qeyd). `nth-of-type(n)` n-ci <path>-i tutur; sıra @lucide/astro 1.47.0-a görədir,
       paket yenilənsə yoxlayın: node_modules/@lucide/astro/src/icons/<ad>.ts. */

    /* Qıfıl: qövs hissəsi (tək <path>) 1.5px enir — qıfıl bağlanır. */
    .sec-card:hover .sec-icon[data-motion='lock'] :global(svg path) {
      transform: translateY(1.5px);
    }

    /* Qalxan və istifadəçi: "✓" xətti yenidən çəkilir (qalxanda 2-ci path, istifadəçidə 1-ci). */
    .sec-card:hover .sec-icon[data-motion='shield'] :global(svg path:nth-of-type(2)),
    .sec-card:hover .sec-icon[data-motion='roles'] :global(svg path:nth-of-type(1)) {
      animation: sec-redraw 0.6s ease both;
    }

    /* Baza: ox hissəsi (4-cü və 5-ci path) bir dövrə fırlanır. */
    .sec-card:hover .sec-icon[data-motion='backup'] :global(svg path:nth-of-type(4)),
    .sec-card:hover .sec-icon[data-motion='backup'] :global(svg path:nth-of-type(5)) {
      animation: sec-spin 0.8s cubic-bezier(0.45, 0, 0.2, 1) both;
    }
  }

  /* SVG elementi öz mərkəzi ətrafında fırlansın deyə: `transform-box: view-box` ölçü sistemini
     bütün SVG-nin (24×24) koordinatlarına bağlayır, `transform-origin` isə oxun mərkəzidir (17.5, 16.5).
     Bu olmasa brauzer fırlanmanı elementin deyil, SVG-nin yuxarı sol küncünə görə edər və ox yerindən
     "uçar". https://developer.mozilla.org/en-US/docs/Web/CSS/transform-box */
  .sec-icon[data-motion='backup'] :global(svg path:nth-of-type(4)),
  .sec-icon[data-motion='backup'] :global(svg path:nth-of-type(5)) {
    transform-box: view-box;
    transform-origin: 17.5px 16.5px;
  }

  /* `stroke-dasharray` keyframe-in ÖZÜNDƏDİR: yuxarıdakı qayda yalnız `[data-anim]` olanda yazılır,
     JS-siz səhifədə isə "✓" yenə də yenidən çəkilməlidir. Sonda dasharray 100 + offset 0 = tam xətt. */
  @keyframes sec-redraw {
    from {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
    }
    to {
      stroke-dasharray: 100;
      stroke-dashoffset: 0;
    }
  }

  @keyframes sec-spin {
    from {
      transform: rotate(0);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  /*
    Hərəkəti azalt: skriptin özü də bu halda `data-anim` yazmır (hər şey dərhal son vəziyyətdə
    görünür). Burada isə qalanı: skan xətti görünmür, ikon hərəkətləri yoxdur, hover-də kart qalxmır
    və ikon böyümür — yalnız rənglər dəyişir. `!important` hover qaydalarının seçici gücünü aşmaq üçündür.
  */
  @media (prefers-reduced-motion: reduce) {
    .sec-scan {
      display: none;
    }

    .sec-card,
    .sec-icon,
    .sec-icon :global(svg *) {
      transition: none;
      animation: none !important;
    }

    /* `[data-motion]` seçicini bilərəkdən yazırıq: o, qıfılın hover qaydası ilə eyni gücdə olsun
       ki, bu qayda onu əzə bilsin (seçici gücü eyni olanda sonuncu yazılan qalib gəlir). */
    .sec-card:hover,
    .sec-card:hover .sec-icon,
    .sec-card:hover .sec-icon[data-motion] :global(svg path) {
      transform: none;
    }
  }
</style>

<script>
  // Bölmənin neçə hissəsi ekranda olanda animasiya başlasın (0.25 = 25%). Mobildə bölmə hündürdür
  // (dörd kart alt-alta), ona görə 100% yox, dörddə bir hissə kifayətdir.
  const LIVE_THRESHOLD = 0.25
  const SECTION_ID = 'security'

  // Sistemdə «hərəkəti azalt» seçilibsə, heç nə gizlədilmir və canlanmır: hər şey dərhal son vəziyyətdə
  // görünür. https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
  function isMotionReduced(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches
  }

  // Bölmə ekrana ilk dəfə kifayət qədər girəndə ona `is-live` sinfi verir və izləməyi DAYANDIRIR:
  // animasiya BİR dəfə oynanır. IntersectionObserver scroll hadisəsini dinləmədən elementin ekrana
  // girdiyini bildirir: https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
  function markLiveOnce(section: HTMLElement): void {
    const observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting) {
          return
        }
        section.classList.add('is-live')
        observer.disconnect()
      },
      { threshold: LIVE_THRESHOLD }
    )
    observer.observe(section)
  }

  // Layihədə Astro View Transitions (ClientRouter) işlənmir — BaseLayout onu idxal etmir — ona görə bu
  // skript səhifə başına bir dəfə işləyir. ClientRouter əlavə olunsa: initSecurity-ni `astro:page-load`-da
  // çağırın, `astro:before-swap`-da isə observer-i `disconnect()` edin.
  function initSecurity(): void {
    const section = document.getElementById(SECTION_ID)
    if (!section || isMotionReduced() || !('IntersectionObserver' in window)) {
      return
    }

    // `data-anim` PROGRESSIVE ENHANCEMENT-dir: gizli başlanğıc vəziyyətlər CSS-də yalnız `[data-anim]`
    // altındadır, atribut isə yalnız JS işləyəndə yazılır. JS söndürülübsə, skript yüklənməyibsə və ya
    // hərəkət azaldılıbsa atribut yoxdur — kartlar, ikonlar və faktlar adi halda tam görünür.
    section.dataset.anim = 'on'
    markLiveOnce(section)
  }

  initSecurity()
</script>
