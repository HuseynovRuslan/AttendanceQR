---
/*
 * Footer — hər səhifənin ən aşağısı: loqo, təsvir, mağaza düymələri, keçid sütunları, əlaqə, Instagram, müəllif hüququ.
 * BaseLayout hər səhifənin sonuna qoyur. Props: lang — səhifənin dili.
 */
import { Image } from 'astro:assets'
// Lucide ikonları ayrı-ayrı fayldan idxal olunur (səbəb: Audience.astro).
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right'
import MapPin from '@lucide/astro/icons/map-pin'
import Smartphone from '@lucide/astro/icons/smartphone'
import { useTranslations, localizedPath, type Lang, type UIKey } from '../../i18n/ui'
import { SITE, PRICING } from '../../data/site'
import GooglePlayBadge from '../Shared/GooglePlayBadge.astro'
import ContactIcon from '../Shared/ContactIcon.astro'
import logoWordWhite from '../../assets/images/brand/logo-word-white.png'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const homePath = localizedPath(lang, '/')

// Markupdakı qəsdən seçilmiş dəyərlər:
// - footer `-mt-8 lg:-mt-12` ilə əvvəlki bölmənin üstünə minir (yuvarlaq künclərin arxasında onun rəngi görünsün);
//   hər səhifənin son blokunun alt padding-i bundan çox olmalıdır.
// - `leading-normal` açıq yazılıb: Preflight yoxdur, body 1.6, h4 1.08 verir, dizayn isə 1.5-də ölçülüb.
// - App Store nişanı link deyil, <span>-dır: Apple-ın rəsmi nişanı yalnız tətbiq App Store-da olanda işlədilə bilər.
// - Instagram düyməsində `-ml-[7px]` ikonu yuxarıdakı əlaqə ikonları ilə eyni xəttə salır (düymənin eni dəyişsə yenidən ölç).
// - Alt sətirdə `pr-14`: sağ-aşağıdakı üzən WhatsApp və «yuxarı» düymələri linklərin üstünə düşməsin.

// ---------- Sabitlər ----------
// Loqo faylının eni (px): ekranda h-8 ilə ~107px görünür, 214 = 2 qat (retina ekranda bulanıq olmasın).
const LOGO_WIDTH_PX = 214
// Google Play nişanının hündürlüyü (px); ətrafdakı şəffaf boşluq sayılmır.
const BADGE_HEIGHT_PX = 40
const CONTACT_ICON_SIZE = 16
const SOON_ICON_SIZE = 15
const INSTAGRAM_ICON_SIZE = 18
const ARROW_ICON_SIZE = 16

// İl build zamanı hesablanır: yeni ildə yenidən build olunmasa köhnə il qalır.
const currentYear = new Date().getFullYear()

// tel: linkinə yalnız rəqəmlər və + lazımdır ('+994 50 600 16 55' → 'tel:+994506001655').
// Eyni sətir ContactBody.astro-da da var — ikisini birlikdə dəyiş.
const phoneHref = `tel:${SITE.phone.replace(/[^+\d]/g, '')}`

// ---------- Keçid sütunları ----------
// `label` — ui.ts-dəki mətn açarı: UIKey tipi açarda səhv olsa xəta verir.
interface FooterLink {
  label: UIKey
  href: string
}
interface ProductLink extends FooterLink {
  isVisible: boolean
}

// «Məhsul» linkləri ana səhifənin bölmələrinə aparır (homePath başa qoyulur ki, başqa səhifədən də işləsin).
// Qiymət söndürülübsə (site.ts → PRICING.enabled) bölmə yoxdur, link də görünmür.
const allProductLinks: ProductLink[] = [
  { label: 'nav.modules', href: `${homePath}#modules`, isVisible: true },
  { label: 'nav.how', href: `${homePath}#how`, isVisible: true },
  { label: 'nav.pricing', href: `${homePath}#pricing`, isVisible: PRICING.enabled },
  { label: 'nav.faq', href: `${homePath}#faq`, isVisible: true },
]
const productLinks = allProductLinks.filter((link) => link.isVisible)

const companyLinks: FooterLink[] = [
  { label: 'foot.about', href: localizedPath(lang, '/haqqimizda/') },
  { label: 'foot.blog', href: localizedPath(lang, '/blog/') },
  { label: 'nav.contact', href: localizedPath(lang, '/elaqe/') },
]

// Alt sətirdəki hüquqi linklər.
const legalLinks: FooterLink[] = [
  { label: 'foot.privacy', href: localizedPath(lang, '/mexfilik/') },
  { label: 'foot.deletion', href: localizedPath(lang, '/hesab-silinmesi/') },
]

// ---------- Əlaqə sətirləri ----------
// `href` olmayan sətir (ünvan) link deyil, sadə yazıdır. `icon`: 'phone' və 'email' ContactIcon.astro-dandır,
// 'pin' Lucide MapPin. Telefon boşdursa (SITE.phone = '') sətir göstərilmir.
interface ContactRow {
  icon: 'phone' | 'email' | 'pin'
  text: string
  href?: string
  textClass?: string
  isVisible: boolean
}
const allContactRows: ContactRow[] = [
  // `tabular-nums` — rəqəmlər eyni enli olur; `whitespace-nowrap` — dar sütunda nömrə iki sətrə bölünmür.
  { icon: 'phone', text: SITE.phone, href: phoneHref, textClass: 'tabular-nums whitespace-nowrap', isVisible: SITE.phone.length > 0 },
  { icon: 'email', text: SITE.email, href: `mailto:${SITE.email}`, isVisible: true },
  { icon: 'pin', text: SITE.address, isVisible: true },
  // WhatsApp sətri müvəqqəti çıxarılıb.
]
const contactRows = allContactRows.filter((contact) => contact.isVisible)
---

<footer
  class="relative z-10 -mt-8 overflow-hidden rounded-t-[28px] bg-[#0B0C0D] leading-normal text-white lg:-mt-12 lg:rounded-t-[48px]"
  data-foot
>
  <div class="foot-glow" aria-hidden="true"></div>

  <div class="wrap relative pt-16 lg:pt-24">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="foot-rise lg:col-span-5" style="--i:0">
        <a href={homePath} class="inline-block">
          <Image src={logoWordWhite} alt={SITE.name} width={LOGO_WIDTH_PX} class="h-8 w-auto" />
        </a>
        <p class="mt-5 max-w-[34ch] text-[15px] leading-[1.7] text-white/60">{t('foot.tag')}</p>

        <div class="mt-8 flex flex-wrap items-center gap-2">
          <GooglePlayBadge
            lang={lang}
            height={BADGE_HEIGHT_PX}
            align="start"
            class="transition duration-200 motion-safe:hover:-translate-y-0.5"
          />

          <span
            class="inline-flex h-10 cursor-default items-center gap-2.5 rounded-[10px] border border-dashed border-white/20 bg-white/[.03] pr-3.5 pl-2 select-none"
          >
            <span class="grid h-7 w-7 place-items-center rounded-lg bg-white/[.07] text-[#7DA6FA]" aria-hidden="true">
              <Smartphone size={SOON_ICON_SIZE} />
            </span>
            <span class="flex flex-col leading-tight">
              <span class="text-[10px] font-bold tracking-[.08em] text-[#7DA6FA] uppercase">{t('pwa.soon')}</span>
              <span class="text-[14px] font-semibold">App Store</span>
            </span>
            <span class="foot-blink ml-0.5 h-1.5 w-1.5 rounded-full bg-[#4C86FF]" aria-hidden="true"></span>
          </span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-[1fr_1fr_1.5fr] lg:col-span-7">
        <div class="foot-rise" style="--i:1">
          <h4 class="font-mono text-[11.5px] leading-normal font-medium tracking-[.16em] text-white/40 uppercase">{t('foot.product')}</h4>
          <ul class="mt-5 list-none space-y-3.5 text-[15px]">
            {
              productLinks.map((link) => (
                <li>
                  <a href={link.href} class="text-white/70 transition-colors hover:text-white">
                    {t(link.label)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="foot-rise" style="--i:2">
          <h4 class="font-mono text-[11.5px] leading-normal font-medium tracking-[.16em] text-white/40 uppercase">{t('foot.company')}</h4>
          <ul class="mt-5 list-none space-y-3.5 text-[15px]">
            {
              companyLinks.map((link) => (
                <li>
                  <a href={link.href} class="text-white/70 transition-colors hover:text-white">
                    {t(link.label)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="foot-rise col-span-2 sm:col-span-1" style="--i:3">
          <h4 class="font-mono text-[11.5px] leading-normal font-medium tracking-[.16em] text-white/40 uppercase">{t('foot.contact')}</h4>

          <ul class="mt-5 list-none space-y-3 text-[15px]">
            {
              contactRows.map((contact) => {
                const Row = contact.href ? 'a' : 'div'
                return (
                  <li>
                    <Row
                      href={contact.href}
                      class:list={[
                        'inline-flex items-center gap-3',
                        contact.href ? 'group text-white/80 transition-colors hover:text-white' : 'text-white/60',
                      ]}
                    >
                      <span
                        class="grid h-9 w-9 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/[.04] text-white/70 transition group-hover:border-brand group-hover:bg-brand group-hover:text-white"
                        aria-hidden="true"
                      >
                        {contact.icon === 'pin' ? <MapPin size={CONTACT_ICON_SIZE} /> : <ContactIcon name={contact.icon} size={CONTACT_ICON_SIZE} />}
                      </span>
                      <span class={contact.textClass}>{contact.text}</span>
                    </Row>
                  </li>
                )
              })
            }
          </ul>

          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-6 -ml-[7px] inline-flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[.04] py-1.5 pr-4 pl-1.5 transition-colors hover:border-white/25 hover:bg-white/[.07]"
          >
            <span class="relative grid h-9 w-9 place-items-center overflow-hidden rounded-xl bg-white/[.07] text-white">
              <span
                class="absolute inset-0 bg-linear-to-tr from-[#FEDA75] via-[#D62976] to-[#4F5BD5] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"></span>
              <span class="relative flex">
                <ContactIcon name="instagram" size={INSTAGRAM_ICON_SIZE} />
              </span>
            </span>
            <span class="flex flex-col leading-tight">
              <span class="text-[11.5px] text-white/45">Instagram</span>
              <span class="text-[15px] font-medium text-white/90">{SITE.instagramHandle}</span>
            </span>
            <ArrowUpRight
              size={ARROW_ICON_SIZE}
              class="ml-1 text-white/40 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </div>

    <div
      class="foot-rise mt-16 flex flex-col gap-4 border-t border-white/10 pt-7 pr-14 pb-10 text-[13px] text-white/45 sm:flex-row sm:items-center sm:justify-between lg:mt-20"
      style="--i:4"
    >
      <span>© {currentYear} {SITE.name}. {t('foot.rights')}</span>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legalLinks.map((link) => (
            <a href={link.href} class="transition-colors hover:text-white">
              {t(link.label)}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  /* Tailwind-in rahat yazmadığı 4 şey. */

  /* 1) Yuxarı-solda zəif mavi işıq; pointer-events: none ki, klikləri tutmasın. */
  .foot-glow {
    position: absolute;
    top: -30%;
    left: -10%;
    width: 60%;
    height: 70%;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(21, 94, 239, 0.22), transparent);
    filter: blur(30px);
  }

  /* 2) «Tezliklə» nöqtəsi yanıb-sönür. @keyframes adı Astro-da scope olunmur, ona görə `foot-` prefiksi. */
  .foot-blink {
    animation: foot-blink 1.6s ease-in-out infinite;
  }

  @keyframes foot-blink {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* 3) Giriş animasiyası (bir dəfə). Gizli başlanğıc yalnız `[data-anim]` altındadır (skriptlə yazılır): JS
     söndürülübsə hər şey görünür. `--i` sıra nömrəsidir, hər sütun 80ms gec başlayır. */
  [data-anim] .foot-rise {
    opacity: 0;
  }

  [data-anim].is-live .foot-rise {
    animation: foot-rise 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes foot-rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* 4) Hərəkəti azalt: animasiyasız, dərhal görünür. */
  @media (prefers-reduced-motion: reduce) {
    .foot-blink {
      animation: none;
    }

    [data-anim] .foot-rise {
      opacity: 1;
      animation: none !important;
    }
  }
</style>

<script>
  // ---------- Sabitlər ----------
  // Footer-in neçə hissəsi ekranda olanda animasiya başlasın (0.15 = 15%).
  const LIVE_THRESHOLD = 0.15

  // Footer ilk dəfə kifayət qədər görünəndə `is-live` sinfini verir və izləməni dayandırır (animasiya bir dəfə oynanır).
  function startWhenVisible(footer: HTMLElement): void {
    const observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting) {
          return
        }
        footer.classList.add('is-live')
        observer.disconnect()
      },
      { threshold: LIVE_THRESHOLD }
    )
    observer.observe(footer)
  }

  function initFooter(): void {
    const footer = document.querySelector<HTMLElement>('[data-foot]')
    if (!footer) {
      return
    }

    // «Hərəkəti azalt» seçilibsə və ya IntersectionObserver yoxdursa `data-anim` yazılmır: hər şey dərhal görünür.
    const isMotionReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (isMotionReduced || !('IntersectionObserver' in window)) {
      return
    }

    footer.dataset.anim = 'on'
    startWhenVisible(footer)
  }

  initFooter()
</script>
