---
import Building from '@lucide/astro/icons/building'
import Check from '@lucide/astro/icons/check'
import Clock from '@lucide/astro/icons/clock'
import Copy from '@lucide/astro/icons/copy'
import Info from '@lucide/astro/icons/info'
import Send from '@lucide/astro/icons/send'
import ShieldCheck from '@lucide/astro/icons/shield-check'
import Smartphone from '@lucide/astro/icons/smartphone'
import Trash from '@lucide/astro/icons/trash'
import X from '@lucide/astro/icons/x'
import { useTranslations, type Lang } from '../i18n/ui'
import { SITE } from '../data/site'
import ContactIcon from './ContactIcon.astro'
import DeletionCard from './DeletionCard.astro'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)

// E-poçt düyməsi poçt proqramını mövzu sətri dolu açır. Mövzu səhifənin öz dilindədir (t('del.tplSubject')).
// encodeURIComponent: mövzudakı boşluq və başqa simvollar URL-də kodlaşdırılmalıdır.
const mailHref = `mailto:${SITE.email}?subject=${encodeURIComponent(t('del.tplSubject'))}`

// "Silinir" siyahısı: hər maddənin əsas mətni və (varsa) altındakı kiçik boz izahı.
const deleted = [
  { text: t('del.d1') },
  { text: t('del.d2') },
  { text: t('del.d3'), sub: t('del.d3s') },
  { text: t('del.d4'), sub: t('del.d4s') },
  { text: t('del.d5'), sub: t('del.d5s') },
]

// 3 addım. `icon` — Lucide ikonu, `who` — nişanın mətni, `isUs` — nişan "QRLog"-dur (boz), yoxsa "Siz" (mavi).
// Üçüncü addımın mətni qalın hissə ilə (30 gün) üç açara bölünüb: s3d.a / s3d.b / s3d.c.
const steps = [
  { icon: Send, who: t('del.whoYou'), isUs: false, title: t('del.s1t') },
  { icon: ShieldCheck, who: t('del.whoUs'), isUs: true, title: t('del.s2t') },
  { icon: Trash, who: t('del.whoUs'), isUs: true, title: t('del.s3t') },
]

// Dairələrin açılışda görünmə gecikmələri (saniyə): 0.3 / 1.3 / 2.4.
const popDelays = [0.3, 1.3, 2.4]

// Bütün H2 başlıqların ortaq sinifləri.
const h2 = 'text-[clamp(28px,3.2vw,40px)] leading-[1.1] font-semibold tracking-[-0.03em] text-ink'
---

<!-- ================= 1. HERO ================= -->
<!-- Açıq boz fon, altında nazik xətt. Header sabit olduğu üçün yuxarıdan onun hündürlüyü qədər boşluq. -->
<section
  class="relative overflow-hidden border-b border-hair bg-page pt-[calc(var(--header-h)+48px)] pb-16 sm:pb-20"
>
  <!-- Arxa fon: nöqtəli naxış. Sağda görünür, sola doğru itir (mask-image). Haqqımızda səhifəsindəkinin eynisi. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(#cbd5e1_1.1px,transparent_1.2px)] bg-[size:22px_22px] [mask-image:linear-gradient(100deg,transparent_35%,#000_75%)]"
  >
  </div>

  <!-- Desktop-da iki sütun (solda mətn, sağda kart); 860px və dardan bir sütun, kart mətnin altında. -->
  <div
    class="wrap relative grid max-w-[1080px] items-center gap-12 min-[861px]:grid-cols-[minmax(0,1fr)_300px] min-[861px]:gap-16"
  >
    <div>
      <!-- Eyebrow: mavi, böyük hərf, solunda 32px nazik mavi xətt (Problem.astro ilə eyni). -->
      <span class="inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-brand uppercase">
        <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
        {t('del.eyebrow')}
      </span>

      <h1
        class="mt-5 text-[clamp(36px,4.6vw,60px)] leading-[1.04] font-semibold tracking-[-0.045em] text-balance text-ink"
      >
        {t('del.title')}
      </h1>

      <p class="mt-6 max-w-[560px] text-[17px] leading-[1.7] text-pretty text-stone-600 sm:text-[18px]">
        {t('del.lead')}
      </p>

      <!-- İki ağ "çip": mavi ikon + qısa mətn. -->
      <ul role="list" class="mt-8 flex list-none flex-wrap gap-2.5">
        <li
          class="inline-flex items-center gap-2 rounded-full border border-hair bg-white px-4 py-2 text-[14px] font-medium text-ink"
        >
          <Smartphone size={17} class="text-brand" aria-hidden="true" />
          {t('del.chipApp')}
        </li>
        <li
          class="inline-flex items-center gap-2 rounded-full border border-hair bg-white px-4 py-2 text-[14px] font-medium text-ink"
        >
          <Clock size={17} class="text-brand" aria-hidden="true" />
          {t('del.chip30')}
        </li>
      </ul>
    </div>

    <!-- Sağ: animasiyalı işçi kartı. Telefonda mətnin altında, ortada. -->
    <div class="flex justify-center min-[861px]:justify-end">
      <DeletionCard lang={lang} />
    </div>
  </div>
</section>

<!-- ================= 2. SİLİNMƏNİ NECƏ TƏLƏB ETMƏK ================= -->
<section class="bg-white py-20 sm:py-24">
  <div class="wrap max-w-[1080px]">
    <h2 class={h2}>{t('del.howTitle')}</h2>
    <!-- Alt mətnin ortası qalın və qaradır; boşluqlar mətnlərin içindədir, ona görə yapışıq yazılıb. -->
    <p class="mt-4 max-w-[640px] text-[16px] leading-[1.7] text-stone-600 sm:text-[17px]">{t('del.howSub.a')}<strong class="font-semibold text-ink">{t('del.howSub.b')}</strong>{t('del.howSub.c')}</p>

    <!-- İki kart yan-yana; 760px və dardan alt-alta. -->
    <div class="mt-10 grid gap-5 min-[761px]:grid-cols-2">
      <!-- Kart 1: e-poçt ilə. Boz fon, mavi ikon qutusu. -->
      <div class="flex flex-col rounded-[22px] border border-hair bg-page p-6">
        <span class="grid size-11 place-items-center rounded-xl bg-brand text-white" aria-hidden="true">
          <ContactIcon name="email" size={22} />
        </span>
        <h3 class="mt-4 text-[19px] font-semibold tracking-[-0.01em] text-ink">{t('del.emailTitle')}</h3>
        <p class="mt-2 text-[15px] leading-[1.65] text-stone-600">
          <strong class="font-semibold text-ink">{SITE.email}</strong> {t('del.emailText')}
        </p>

        <!-- Məktub şablonu: ağ qutu, qırıq xətli çərçivə. Solda mono etiket, sağda məzmun. -->
        <dl class="mt-4 rounded-2xl border border-dashed border-stone-300 bg-white p-4 text-[14.5px]">
          <div class="grid grid-cols-[76px_minmax(0,1fr)] gap-3 py-1">
            <dt class="pt-0.5 font-mono text-[10.5px] tracking-[0.1em] text-ink2 uppercase">{t('del.tplSubjectL')}</dt>
            <dd class="m-0 font-medium text-ink">{t('del.tplSubject')}</dd>
          </div>
          <div class="grid grid-cols-[76px_minmax(0,1fr)] gap-3 py-1">
            <dt class="pt-0.5 font-mono text-[10.5px] tracking-[0.1em] text-ink2 uppercase">{t('del.tplBodyL')}</dt>
            <dd class="m-0 leading-[1.6] text-ink">
              <span class="font-medium text-brand">{t('del.tplName')}</span> ·
              <span class="font-medium text-brand">{t('del.tplPhone')}</span>
              <span class="text-ink2">{t('del.tplOr')}</span> ·
              <span class="font-medium text-brand">{t('del.tplCompany')}</span>
            </dd>
          </div>
        </dl>

        <!-- Düymələr: mavi "E-poçt yaz" (mailto) və ağ "Ünvanı kopyala". -->
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={mailHref}
            class="inline-flex h-11 items-center gap-2 rounded-xl bg-brand px-5 text-[15px] font-semibold text-white no-underline transition hover:-translate-y-0.5 hover:bg-brand-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <ContactIcon name="email" size={17} />
            {t('del.emailBtn')}
          </a>

          <!-- Kopyala düyməsi. data-copy — kopyalanacaq mətn, data-copied — "kopyalandı" yazısı (skript ikisini də
               oxuyur, mətni özü bilmir). Basılanda 1.5 saniyə `data-done` atributu yazılır: çərçivə yaşıl olur,
               ikon "tik"ə, yazı "Kopyalandı"ya dəyişir. -->
          <button
            type="button"
            data-copy={SITE.email}
            data-copied={t('del.copied')}
            class="group/copy inline-flex h-11 cursor-pointer items-center gap-2 rounded-xl border border-hair bg-white px-5 text-[15px] font-semibold text-ink transition hover:border-stone-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand data-[done]:border-emerald-500 data-[done]:text-emerald-700"
          >
            <Copy size={16} class="group-data-[done]/copy:hidden" aria-hidden="true" />
            <Check size={16} class="hidden group-data-[done]/copy:block" aria-hidden="true" />
            <span data-label>{t('del.copyBtn')}</span>
          </button>
        </div>
      </div>

      <!-- Kart 2: iş yeri vasitəsilə. Ağ fon, ağ ikon qutusu, mavi ikon. -->
      <div class="flex flex-col rounded-[22px] border border-hair bg-white p-6">
        <span
          class="grid size-11 place-items-center rounded-xl border border-hair bg-white text-brand"
          aria-hidden="true"
        >
          <Building size={22} />
        </span>
        <h3 class="mt-4 text-[19px] font-semibold tracking-[-0.01em] text-ink">{t('del.workTitle')}</h3>
        <p class="mt-2 text-[15px] leading-[1.65] text-stone-600">{t('del.workText1')}</p>
        <p class="mt-3 text-[15px] leading-[1.65] text-stone-600">{t('del.workText2')}</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= 3. TƏLƏBDƏN SONRA NƏ OLUR ================= -->
<section class="bg-page py-20 sm:py-24">
  <div class="wrap max-w-[1080px]">
    <!-- Bir ağ qutu. İçində 3 addım və onları birləşdirən xətt. -->
    <div class="rounded-[24px] border border-hair bg-white p-7 sm:p-9">
      <h2 class={h2}>{t('del.stepsTitle')}</h2>

      <!-- Addımlar: 761px-dən 3 sütun (mətn ortada), dardan şaquli (mətn solda). `gap-8` (2rem) xəttin
           uzunluğunu hesablayanda nəzərə alınır: hər addımın xətti "öz hündürlüyü/eni + 2rem" qədərdir. -->
      <ol class="mt-9 grid list-none gap-8 min-[761px]:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="relative flex gap-4 min-[761px]:flex-col min-[761px]:items-center min-[761px]:gap-0 min-[761px]:text-center">
              {/* Xətt parçası (yalnız 1-ci və 2-ci addımdan sonra): bu addımın dairəsinin mərkəzindən
                  növbəti dairənin mərkəzinə qədər. Üç qat: boz zolaq (fon), mavi doldurma (açılanda dolur),
                  işıq (sonra davamlı axır). <ol>-un birbaşa uşağı deyil, <li>-nin içindədir. */}
              {index < steps.length - 1 && (
                <span aria-hidden="true" class="del-seg" style={`--n:${index}`}>
                  <span class="del-fill" />
                  <span class="del-light" />
                </span>
              )}

              {/* Dairə: 44px mavi, ağ ikon, ətrafında 6px ağ halqa (xətt dairənin arxasında kəsilmiş görünür).
                  del-dot — açılışda kiçik "sıçrayışla" görünmə; del-ripple — işıq çatanda yayılan dalğa. */}
              <span class="del-dot group/dot relative z-10 shrink-0" style={`--n:${index}; --pop:${popDelays[index]}s`}>
                <span class="del-ripple absolute inset-0 rounded-full border-2 border-brand/50" />
                <span class="relative grid size-11 place-items-center rounded-full bg-brand text-white shadow-[0_0_0_6px_#fff]">
                  <step.icon
                    size={20}
                    class="transition-transform duration-200 group-hover/dot:scale-115 motion-reduce:transition-none"
                  />
                </span>
              </span>

              <div class="min-w-0 pt-0.5 min-[761px]:pt-0">
                {/* Kiçik nişan: "Siz" açıq mavi, "QRLog" boz. */}
                <span
                  class:list={[
                    'inline-block rounded-full px-2.5 py-1 font-mono text-[10.5px] tracking-[0.1em] uppercase min-[761px]:mt-4',
                    step.isUs ? 'bg-stone-100 text-ink2' : 'bg-[#EAF1FE] text-brand',
                  ]}
                >
                  {step.who}
                </span>
                <h3 class="mt-2.5 text-[18px] font-semibold tracking-[-0.01em] text-ink">{step.title}</h3>
                <p class="mt-1.5 text-[15px] leading-[1.65] text-stone-600">
                  {index === 0 && t('del.s1d')}
                  {index === 1 && t('del.s2d')}
                  {index === 2 && (
                    <>
                      {t('del.s3d.a')}
                      <strong class="font-semibold text-ink">{t('del.s3d.b')}</strong>
                      {t('del.s3d.c')}
                    </>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<!-- ================= 4. NƏ SİLİNİR, NƏ QALA BİLƏR ================= -->
<!-- Səhifənin sonu: altda footer-ə qədər normal boşluq (pb-24). -->
<section class="bg-white pt-20 pb-24 sm:pt-24">
  <div class="wrap max-w-[1080px]">
    <h2 class={h2}>{t('del.listTitle')}</h2>

    <!-- İki qutu yan-yana, bərabər enli; yalnız 560px və dardan alt-alta. -->
    <div class="mt-10 grid grid-cols-2 gap-4 max-[560px]:grid-cols-1">
      <!-- Silinir: ağ qutu, qırmızı-narıncı ikon. Hər maddənin solunda x ikonu, aralarında nazik xətt. -->
      <div class="rounded-[22px] border border-hair bg-white p-6">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-[#FEF1EA] text-[#C2410C]" aria-hidden="true">
            <Trash size={19} />
          </span>
          <h3 class="text-[19px] font-semibold tracking-[-0.01em] text-ink">{t('del.delTitle')}</h3>
        </div>
        <ul role="list" class="mt-5 list-none">
          {
            deleted.map((item) => (
              <li class="flex gap-3 border-t border-hair py-3 first:border-t-0 first:pt-0 last:pb-0">
                <span
                  class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-[#FEF1EA] text-[#C2410C]"
                  aria-hidden="true"
                >
                  <X size={12} stroke-width={3} />
                </span>
                <span class="min-w-0 text-[15px] leading-[1.5] text-ink">
                  {item.text}
                  {item.sub && <span class="mt-0.5 block text-[13px] leading-[1.5] text-ink2">{item.sub}</span>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Müəyyən müddət qala bilər: boz qutu, kəhrəba ikon, iki abzas (qalın hissələr üç açara bölünüb). -->
      <div class="rounded-[22px] border border-hair bg-page p-6">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-[#FEF6E7] text-[#B45309]" aria-hidden="true">
            <Clock size={19} />
          </span>
          <h3 class="text-[19px] font-semibold tracking-[-0.01em] text-ink">{t('del.keepTitle')}</h3>
        </div>
        <p class="mt-5 text-[15px] leading-[1.7] text-stone-600">
          <strong class="font-semibold text-ink">{t('del.keep1.a')}</strong>{t('del.keep1.b')}
        </p>
        <p class="mt-3 text-[15px] leading-[1.7] text-stone-600">
          {t('del.keep2.a')}<strong class="font-semibold text-ink">{t('del.keep2.b')}</strong>{t('del.keep2.c')}
        </p>
      </div>
    </div>

    <!-- Məlumat qeydi: tətbiqdəki "Telefondakı hesablar" düyməsi hesabı SİLMİR, yalnız telefondan çıxarır. -->
    <div class="mt-4 flex gap-3.5 rounded-2xl bg-page p-5 text-[15px] leading-[1.65] text-stone-600">
      <Info size={20} class="mt-0.5 shrink-0 text-brand" aria-hidden="true" />
      <p class="m-0">{t('del.note.a')}<strong class="font-semibold text-ink">{t('del.note.b')}</strong>{t('del.note.c')}</p>
    </div>
  </div>
</section>

<style>
  /* 3 addımlı izləmə xəttinin animasiyaları. @keyframes adı Astro-da scope olunmur, ona görə hamısı `del-` ilə
     başlayır. Əsas stil (animasiyasız) həmişə "hazır" haldır: xətt dolu, dairələr yerindədir — animasiya
     söndürüləndə və ya işləməyəndə hər şey düzgün görünür. `--n` — addımın nömrəsi (0, 1, 2). */

  /* ---- Xətt parçası ---- */
  /* Telefonda (dar): dairənin mərkəzindən (21px) aşağı, növbəti dairənin mərkəzinə qədər: bu addımın
     hündürlüyü + 2rem (aradakı boşluq). */
  .del-seg {
    position: absolute;
    top: 22px;
    left: 21px;
    width: 2px;
    height: calc(100% + 2rem);
    border-radius: 999px;
    background: var(--color-hair);
    overflow: hidden;
    pointer-events: none;
  }

  /* 761px-dən: üfüqi xətt — dairənin mərkəzindən (sütunun ortasından) növbəti sütunun ortasına qədər. */
  @media (min-width: 761px) {
    .del-seg {
      top: 21px;
      left: 50%;
      width: calc(100% + 2rem);
      height: 2px;
    }
  }

  /* Mavi doldurma: açılanda soldan sağa (telefonda yuxarıdan aşağı) dolur. 1-ci parça 0.3s-də, 2-ci 1.3s-də
     başlayır, ikisi birlikdə ~2.4s-də bitir. `backwards` — gecikmə bitənə qədər başlanğıc (boş) halda durur. */
  .del-fill {
    position: absolute;
    inset: 0;
    background: var(--color-brand);
    transform-origin: top left;
    animation: del-fill-v 1s ease-out backwards;
    animation-delay: calc(0.3s + var(--n) * 1s);
  }

  @keyframes del-fill-v {
    from {
      transform: scaleY(0);
    }
  }

  @media (min-width: 761px) {
    .del-fill {
      animation-name: del-fill-h;
    }
  }

  @keyframes del-fill-h {
    from {
      transform: scaleX(0);
    }
  }

  /* İşıq: ağ-mavi zolaq xətt boyu axır. Xəttin özünün üstündə `background-position` ilə hərəkət edir, ona görə
     xəttin kənarından çıxmır. Dövr 4.5s: 1-ci parça dövrün birinci yarısında, 2-ci parça ikinci yarısında
     (gecikmə +2.25s). Açılış (2.4s) bitəndən sonra başlayır (2.6s). */
  .del-light {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      transparent,
      rgb(255 255 255 / 0.95) 45%,
      rgb(130 170 255 / 0.9) 70%,
      transparent
    );
    background-repeat: no-repeat;
    background-size: 100% 45%;
    opacity: 0;
    animation: del-flow-v 4.5s linear infinite backwards;
    animation-delay: calc(2.6s + var(--n) * 2.25s);
  }

  @keyframes del-flow-v {
    0% {
      background-position: 0 -60%;
      opacity: 1;
    }
    48% {
      background-position: 0 160%;
      opacity: 1;
    }
    50%,
    100% {
      background-position: 0 160%;
      opacity: 0;
    }
  }

  @media (min-width: 761px) {
    .del-light {
      background-image: linear-gradient(
        to right,
        transparent,
        rgb(255 255 255 / 0.95) 45%,
        rgb(130 170 255 / 0.9) 70%,
        transparent
      );
      background-size: 45% 100%;
      animation-name: del-flow-h;
    }
  }

  @keyframes del-flow-h {
    0% {
      background-position: -60% 0;
      opacity: 1;
    }
    48% {
      background-position: 160% 0;
      opacity: 1;
    }
    50%,
    100% {
      background-position: 160% 0;
      opacity: 0;
    }
  }

  /* ---- Dairələr ---- */
  /* Açılışda kiçik "sıçrayışla" görünür (cubic-bezier-in sonuncu ədədi 1-dən böyükdür). Gecikmə (--pop) HTML-dədir: 0.3s / 1.3s / 2.4s. */
  .del-dot {
    animation: del-pop 0.3s cubic-bezier(0.3, 1.6, 0.5, 1) backwards;
    animation-delay: var(--pop, 0s);
  }

  @keyframes del-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  /* Dalğa: işıq dairəyə çatanda ondan halqa böyüyüb itir. Dövr 4.5s; 1-ci dairə işıq başlayanda (2.6s),
     2-ci yarıda (+2.25s), 3-cü sonda (+4.5s). `backwards` + opacity: 0 — başlayana qədər görünmür. */
  .del-ripple {
    opacity: 0;
    animation: del-ripple 4.5s ease-out infinite backwards;
    animation-delay: calc(2.6s + var(--n) * 2.25s);
  }

  @keyframes del-ripple {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    22%,
    100% {
      opacity: 0;
      transform: scale(2);
    }
  }

  /* Hərəkəti azalt: heç bir animasiya yoxdur; xətt və dairələr hazır görünür, işıq və dalğa gizlidir. */
  @media (prefers-reduced-motion: reduce) {
    .del-fill,
    .del-dot {
      animation: none;
    }

    .del-light,
    .del-ripple {
      display: none;
    }
  }
</style>

<script>
  // ---------- "Ünvanı kopyala" düyməsi (səhifədəki yeganə JavaScript) ----------
  // Düymədə data-copy="..." kopyalanacaq mətni, data-copied="..." isə "Kopyalandı" yazısını saxlayır (hər dildə öz
  // mətni — skript onu bilmir, HTML-dən oxuyur). Basılanda mətn mübadilə buferinə yazılır və düymə 1.5 saniyə yaşıl
  // olur (data-done atributu; stilləri HTML-dəki Tailwind siniflərindədir), sonra geri qayıdır.

  // Düymənin neçə millisaniyə "kopyalandı" halında qalması.
  const COPIED_MS = 1500

  // Səhifədəki bütün kopyala düymələrini tap.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy]')

  buttons.forEach((button) => {
    // Hər düyməyə basılanda:
    button.addEventListener('click', async () => {
      const text = button.dataset.copy
      if (!text) {
        return
      }

      try {
        // Mətni mübadilə buferinə yaz. Brauzer icazə verməsə (məsələn, http səhifə), səhv atılır və catch işə düşür.
        await navigator.clipboard.writeText(text)
      } catch {
        // Xəta olsa, heç nə etmirik (səssiz): düymə dəyişmir.
        return
      }

      // Yazını "Kopyalandı"ya çevir və düyməni yaşıl et; 1.5 saniyədən sonra hər şeyi geri qaytar.
      const label = button.querySelector<HTMLElement>('[data-label]')
      const originalLabel = label?.textContent ?? ''
      if (label && button.dataset.copied) {
        label.textContent = button.dataset.copied
      }
      button.dataset.done = ''

      setTimeout(() => {
        if (label) {
          label.textContent = originalLabel
        }
        delete button.dataset.done
      }, COPIED_MS)
    })
  })
</script>
