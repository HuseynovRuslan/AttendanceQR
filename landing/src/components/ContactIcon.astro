---
/*
  ContactIcon — əlaqə kanallarının dörd ikonu bir yerdə: telefon, e-poçt, Instagram, WhatsApp.
  Harada işlənir: Footer.astro («Bizimlə əlaqə» hissəsi) və ContactBody.astro (Əlaqə səhifəsi). İkon
  dəyişsə, yalnız burada dəyişir, hər iki yerdə eyni qalır.

  Props (komponentə çöldən verilən parametrlər):
    name   — hansı ikon: 'phone' | 'email' | 'instagram' | 'whatsapp'. Məsələn: <ContactIcon name="phone" />
    size   — ikonun ölçüsü (px), verilməsə 20.
    class  — əlavə Tailwind sinifləri (məsələn rəng üçün; ikonlar currentColor ilə çəkilir).

  Mənbələr (heç biri sıfırdan çəkilməyib):
    phone, email — Lucide (lucide.dev), Footer-dəki ilə eyni.
    instagram    — Font Awesome Free SVG-si, Footer-dən olduğu kimi köçürülüb.
    whatsapp     — Font Awesome şrift ikonu (BaseLayout-da qoşulan kitabxana), WhatsAppButton.astro-dakı ilə eyni.
*/
import Mail from '@lucide/astro/icons/mail'
import Phone from '@lucide/astro/icons/phone'

interface Props {
  name: 'phone' | 'email' | 'instagram' | 'whatsapp'
  size?: number
  class?: string
}
const { name, size = 20, class: className } = Astro.props
---

{name === 'phone' && <Phone size={size} class={className} />}
{name === 'email' && <Mail size={size} class={className} />}
{
  name === 'instagram' && (
    <svg class={className} width={size} height={size} viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
      {/* Font Awesome Free 7.3.1 (fa-brands fa-instagram) by @fontawesome — https://fontawesome.com · License: https://fontawesome.com/license/free Lisenziya şərhi CC BY 4.0-ın şərtidir — silmə. */}
      <path d="M224.3 141a115 115 0 1 0 -.6 230 115 115 0 1 0 .6-230zm-.6 40.4a74.6 74.6 0 1 1 .6 149.2 74.6 74.6 0 1 1 -.6-149.2zm93.4-45.1a26.8 26.8 0 1 1 53.6 0 26.8 26.8 0 1 1 -53.6 0zm129.7 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM399 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z" />
    </svg>
  )
}
{
  name === 'whatsapp' && (
    <i class:list={['fa-brands fa-whatsapp', className]} style={`font-size:${size}px`} aria-hidden="true" />
  )
}
