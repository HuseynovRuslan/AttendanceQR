---
// ContactBody — Əlaqə səhifəsinin (/elaqe/) əsas hissəsi: solda telefon, WhatsApp və e-poçt
// siyahısı, sağda "Bizə yazın" kartı iki düymə ilə (WhatsApp və e-poçt).
// Harada işlənir: pages/elaqe.astro, pages/ru/elaqe.astro, pages/en/elaqe.astro.
// Props: lang — səhifənin dili ('az' | 'ru' | 'en').
// Necə işləyir: əlaqə məlumatları data/site.ts-dəki SITE-dan, mətnlər t('açar') ilə i18n/ui.ts-dən
// gəlir. Stillər global.css-dədir (.contact-grid, .contact-card, .contact-list).
import { useTranslations, type Lang } from '../i18n/ui'
import { SITE, whatsappUrl } from '../data/site'

// E-poçt düyməsi basılanda poçt proqramında mövzu sətri artıq bununla dolu olur (hər dildə eyni).
const EMAIL_SUBJECT = 'QRLog — sorğu'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)

// HTML-dəki <ul class="contact-list"> haqqında: siyahının sırası (telefon → WhatsApp → e-poçt) ən
// tez cavab verən kanaldan ən gecinə doğrudur. Küçə ünvanı yoxdur: real ünvan olmadan
// "Bakı, Azərbaycan" burada etibar qazandırmır (footer-də qalır).

// Zəng linkinə (tel:) yalnız rəqəmlər və + lazımdır. /[^+\d]/g — "rəqəm və + olmayan hər simvol"
// (g — hamısı), yəni '+994 50 600 16 55' → 'tel:+994506001655'.
// Eyni sətir Footer.astro-da da var — linkin qurulma qaydasını dəyişsən, ikisini də dəyiş.
const phoneHref = `tel:${SITE.phone.replace(/[^+\d]/g, '')}`

// Forma yox, mailto linki. Landing statik saytdır, öz backend-i yoxdur; köhnə
// <form action="mailto:"> isə əksər brauzerlərdə mesajı səssizcə itirirdi — müraciəti itirən forma
// dürüst bir linkdən pisdir.
// encodeURIComponent: mövzudakı boşluq və "—" kimi simvollar URL-də kodlaşdırılmalıdır.
const emailButtonHref = `mailto:${SITE.email}?subject=${encodeURIComponent(EMAIL_SUBJECT)}`
---

<section class="prose-section">
  <div class="wrap contact-grid">
    <div class="contact-card">
      <h2>{t('contact.infoTitle')}</h2>
      <ul class="contact-list">
        {SITE.phone && (
          <li>
            <span>{t('contact.phone')}</span>
            <a href={phoneHref}>{SITE.phone}</a>
          </li>
        )}
        <li>
          <span>{t('contact.whatsapp')}</span>
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">{SITE.whatsapp}</a>
        </li>
        <li>
          <span>{t('contact.email')}</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
      </ul>
    </div>

    <div class="contact-card accent">
      <h2>{t('contact.writeTitle')}</h2>
      <p>{t('contact.writeText')}</p>
      <div class="contact-actions">
        <a
          class="btn btn-primary"
          href={whatsappUrl(t('wa.message'))}
          target="_blank"
          rel="noopener noreferrer">{t('contact.whatsappCta')}</a
        >
        <a class="btn btn-ghost" href={emailButtonHref}>{t('contact.writeBtn')}</a>
      </div>
    </div>
  </div>
</section>
