---
import { useTranslations, type Lang } from '../i18n/ui'
import { SITE, whatsappUrl } from '../data/site'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)

// Phone first, WhatsApp second, e-mail last: the order of how fast each one answers.
// A mailto link, not a form. The landing page is a static build with no backend of its own, and the
// old `<form action="mailto:">` silently dropped messages in most browsers — a contact form that
// loses enquiries is worse than an honest link.
// No street address: "Bakı, Azərbaycan" without a real one adds no trust here (the footer keeps it).
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent('QRLog — sorğu')}`
---

<section class="prose-section">
  <div class="wrap contact-grid">
    <div class="contact-card">
      <h2>{t('contact.infoTitle')}</h2>
      <ul class="contact-list">
        {SITE.phone && (
          <li>
            <span>{t('contact.phone')}</span>
            <a href={`tel:${SITE.phone.replace(/[^+\d]/g, '')}`}>{SITE.phone}</a>
          </li>
        )}
        <li>
          <span>{t('contact.whatsapp')}</span>
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">{SITE.whatsapp}</a>
        </li>
        <li>
          <span>{t('contact.email')}</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
      </ul>
    </div>

    <div class="contact-card accent">
      <h2>{t('contact.writeTitle')}</h2>
      <p>{t('contact.writeText')}</p>
      <div class="contact-actions">
        <a
          class="btn btn-primary"
          href={whatsappUrl(t('wa.message'))}
          target="_blank"
          rel="noopener noreferrer">{t('contact.whatsappCta')}</a
        >
        <a class="btn btn-ghost" href={mailto}>{t('contact.writeBtn')}</a>
      </div>
    </div>
  </div>
</section>
