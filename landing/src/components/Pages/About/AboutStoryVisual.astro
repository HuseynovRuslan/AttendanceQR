---
/*
  Hekayə bölməsinin "əvvəl → indi" vizualı: arxada kağız jurnal, önündə QRLog paneli. Props: lang.
  Adlar və vaxtlar nümunədir, tərcümə olunmur ("Nümunə" etiketi də bunu bildirir).
*/
import { useTranslations, type Lang } from '../../../i18n/ui'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)

// Status rəngləri: yaşıl — işdədir, narıncı — diqqət, boz — gəlməyib (avatar və nişan eyni rəngdədir).
const tones = {
  ok: 'bg-[#E7F6EF] text-[#12805C]',
  warn: 'bg-[#FEF3E2] text-[#B45309]',
  off: 'bg-[#F1F0EF] text-[#6B6560]',
}

const panelRows = [
  { initials: 'EQ', name: 'Elnur Q.', time: `${t('about.v.in')} 07:52`, status: t('about.v.sAtWork'), tone: tones.ok },
  { initials: 'SA', name: 'Səbinə A.', time: `${t('about.v.in')} 08:37`, status: t('about.v.sFace'), tone: tones.warn, marked: true },
  {
    initials: 'RM',
    name: 'Rauf M.',
    time: `${t('about.v.in')} 07:58 · ${t('about.v.offline')}`,
    status: t('about.v.sAtWork'),
    tone: tones.ok,
  },
  { initials: 'GH', name: 'Günay H.', time: t('about.v.noScan'), status: t('about.v.sAbsent'), tone: tones.off },
]

// Jurnalda `sign` — signPaths-dəki imzanın indeksi, null — imza yoxdur.
const signPaths = [
  'M2 11 C6 2, 9 2, 10 9 S15 14, 19 6 S25 3, 27 10 S34 13, 46 5',
  'M2 9 C5 14, 9 14, 11 6 S16 1, 20 9 S28 14, 32 7 S40 4, 46 10',
  'M2 12 C7 3, 10 4, 12 10 S18 13, 22 5 S27 2, 31 9 S39 12, 46 6',
]
const journalRows = [
  { name: 'Elnur Q.', time: '08:00', sign: 0 },
  { name: 'Səbinə A.', oldTime: '08:40', time: '08:00', sign: 1 },
  { name: 'Rauf M.', time: '08:00', sign: 2 },
  { name: 'Günay H.', unknown: true, sign: null },
]

// Əl yazısı şrifti (Tailwind-də şrift adındakı boşluq alt xətt ilə yazılır).
const handwriting = "font-['Segoe_Print','Comic_Sans_MS',cursive]"
---

<div
  role="img"
  aria-label={t('about.v.aria')}
  class="relative h-[640px] overflow-hidden rounded-[28px] border border-hair bg-page sm:h-[500px]"
>
  <span class="absolute top-4 right-5 font-mono text-[10px] tracking-[0.14em] text-ink2 uppercase">
    {t('about.v.sample')}
  </span>

  <div
    aria-hidden="true"
    class="absolute top-12 left-[4%] w-[72%] rotate-[-4deg] rounded-md bg-[#FBF8F1] p-4 shadow-[0_10px_30px_-12px_rgba(60,40,10,0.35)] sm:top-9 sm:left-[3%] sm:w-[54%]"
  >
    <p class="text-[11px] font-bold tracking-[0.08em] text-ink">{t('about.v.jTitle')}</p>
    <p class="mt-1 font-mono text-[10px] text-ink2">{t('about.v.jMeta')}</p>

    <div class="mt-3 border-t border-[#E3DAC4]">
      <div
        class="grid grid-cols-[1.4fr_0.9fr_1fr] gap-2 border-b border-[#E3DAC4] py-1.5 font-mono text-[9px] tracking-[0.06em] text-ink2 uppercase"
      >
        <span>{t('about.v.jName')}</span>
        <span>{t('about.v.jIn')}</span>
        <span>{t('about.v.jSign')}</span>
      </div>

      {
        journalRows.map((row) => (
          <div class="grid grid-cols-[1.4fr_0.9fr_1fr] items-center gap-2 border-b border-[#E3DAC4] py-2">
            <span class={`truncate text-[12px] text-[#2B3A67] ${handwriting}`}>{row.name}</span>
            <span class={`text-[12px] text-[#2B3A67] ${handwriting}`}>
              {row.unknown ? (
                <span class="font-bold text-orange-600">?</span>
              ) : (
                <>
                  {row.oldTime && <s class="mr-1 text-red-500/80">{row.oldTime}</s>}
                  {row.time}
                </>
              )}
            </span>
            <span>
              {row.sign !== null && (
                <svg viewBox="0 0 48 16" class="h-4 w-10" fill="none">
                  <path
                    d={signPaths[row.sign]}
                    stroke="#2B3A67"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="absolute right-[4%] bottom-5 w-[86%] rounded-[20px] bg-white p-4 shadow-[0_30px_60px_-24px_rgba(17,18,17,0.35)] ring-1 ring-black/5 transition-transform duration-300 hover:-translate-y-1 sm:right-[3%] sm:bottom-7 sm:w-[56%] sm:min-w-[290px]"
  >
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="truncate text-[14px] font-semibold text-ink">{t('about.v.aTitle')}</p>
        <p class="mt-0.5 text-[12px] text-ink2">{t('about.v.aDate')}</p>
      </div>
      <span
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#E7F6EF] px-2.5 py-1 text-[11px] font-semibold text-[#12805C]"
      >
        <span class="relative flex size-2">
          <span
            class="absolute inline-flex size-full animate-ping rounded-full bg-[#12805C] opacity-60"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-[#12805C]"></span>
        </span>
        {t('about.v.live')}
      </span>
    </div>

    <ul role="list" class="mt-3 list-none space-y-1">
      {
        panelRows.map((row, index) => (
          <li
            class={`about-row flex items-center gap-2.5 rounded-xl px-2 py-2 ${row.marked ? 'bg-linear-to-r from-[#FEF3E2] to-transparent' : ''}`}
            style={`--i: ${index}`}
          >
            <span
              class={`grid size-8 shrink-0 place-items-center rounded-full text-[11px] font-bold ${row.tone}`}
            >
              {row.initials}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[13px] font-semibold text-ink">{row.name}</span>
              <span class="block truncate font-mono text-[11px] text-ink2">{row.time}</span>
            </span>
            <span
              class={`shrink-0 rounded-full px-2 py-0.5 text-[11px] font-semibold whitespace-nowrap ${row.tone}`}
            >
              {row.status}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* --i sətrin nömrəsidir: sətirlər ardıcıl görünür. */
  .about-row {
    animation: qr-about-row 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) calc(0.3s + var(--i) * 0.12s) both;
  }

  @keyframes qr-about-row {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
