        <section id="rights" class={sectionClass}>
          <div class={headRow}>
            <span class={numBadge} aria-hidden="true">06</span>
            <h2 class={h2Class}>{t('priv.s6')}</h2>
          </div>
          <ul role="list" class="m-0 mt-5 flex list-none flex-wrap gap-2.5 p-0">
            {
              rights.map((item) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-hair bg-white px-4 py-2 text-[14px] font-medium text-ink">
