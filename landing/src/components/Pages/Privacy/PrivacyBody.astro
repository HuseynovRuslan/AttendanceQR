<script>
  // Mündəricat: linkə basanda bölməyə sürüşür, səhifə sürüşdükcə cari bölmənin linkini aktiv edir (scroll-spy).

  // Başlıq ekranın yuxarı 35%-ni keçəndə bölmə "cari" sayılır.
  const SPY_LINE = 0.35
  // Linkə basandan sonra spy bu qədər ms dayanır, yoxsa yolüstü bölmələr basılan linki əvəz edər.
  // Lenis ilə sürüşmə daha uzun çəkir (SmoothScroll.astro: 1.6s).
  const LOCK_MS = 700
  const LOCK_MS_LENIS = 1700
  // Tailwind-in aria-[current=true] stili bu atributu oxuyur.
  const CURRENT = 'aria-current'

  // Linklər və onların bölmələri eyni sıradadır (href="#data" → id="data").
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'))
  const sections = links.map((link) => document.getElementById(link.getAttribute('href')!.slice(1)) as HTMLElement)

  // Spy bu vaxta (Date.now(), ms) qədər dayanıb; 0 = dayanmayıb.
  let lockedUntil = 0

  function setActive(index: number): void {
    links.forEach((link, i) => {
      if (i === index) {
        link.setAttribute(CURRENT, 'true')
      } else {
        link.removeAttribute(CURRENT)
      }
    })
  }

  function updateActive(): void {
    if (Date.now() < lockedUntil) {
      return
    }

    // Səhifənin sonunda (2px xəta payı) son bölmə aktiv olur: qısa son bölmənin başlığı 35% xəttinə çatmaya bilər.
    const isAtBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
    if (isAtBottom) {
      setActive(sections.length - 1)
      return
    }

    const line = window.innerHeight * SPY_LINE
    let current = 0
    sections.forEach((section, i) => {
      if (section.getBoundingClientRect().top <= line) {
        current = i
      }
    })
    setActive(current)
  }

  // Üstdəki boşluq bölmənin `scroll-mt` sinfindən (header + 24px) oxunur.
  function scrollToSection(section: HTMLElement): void {
    const offset = parseFloat(getComputedStyle(section).scrollMarginTop) || 0
    const top = section.getBoundingClientRect().top + window.scrollY - offset

    // Lenis varsa sürüşməni o aparmalıdır, window.scrollTo onunla toqquşar.
    // Lenis telefonda yaranmır (SmoothScroll.astro).
    const lenis = window.qrlLenis
    if (lenis) {
      lenis.scrollTo(top, window.qrlAnchorScroll)
      return
    }

    window.scrollTo({ top, behavior: 'smooth' })
  }

  links.forEach((link, index) => {
    link.addEventListener('click', (event) => {
      // Brauzerin tullanması və Lenis-in öz #link izləyicisi dayandırılır, yoxsa iki sürüşmə toqquşar.
      event.preventDefault()
      event.stopPropagation()

      setActive(index)
      lockedUntil = Date.now() + (window.qrlLenis ? LOCK_MS_LENIS : LOCK_MS)
      // Dayanma bitəndən sonra bir dəfə yoxla: sürüşmə başqa yerdə qalıbsa, aktiv link düzəlsin.
      setTimeout(updateActive, (window.qrlLenis ? LOCK_MS_LENIS : LOCK_MS) + 50)

      scrollToSection(sections[index])
      // replaceState: ünvana #bölmə yazılır, amma yeni tarixçə qeydi yaranmır.
      history.replaceState(null, '', `#${sections[index].id}`)
    })
  })

  // Scroll hadisəsi çox tez-tez atəşlənir; hesablama kadra bir dəfə edilir (`isQueued` — növbədə var bayrağı).
  let isQueued = false
  function queueUpdate(): void {
    if (isQueued) {
      return
    }
    isQueued = true
    requestAnimationFrame(() => {
      isQueued = false
      updateActive()
    })
  }

  window.addEventListener('scroll', queueUpdate, { passive: true })
  window.addEventListener('resize', queueUpdate)

  // Açılışda bir dəfə: ünvanda #rights kimi bölmə varsa, link dərhal aktiv olsun.
  updateActive()
</script>
