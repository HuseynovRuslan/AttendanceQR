              <h3 class="mt-3.5 text-[16px] font-semibold text-ink">{t('priv.k2t')}</h3>
              <p class="mt-1.5 text-[14px] leading-[1.65] text-stone-600">{t('priv.k2d')}</p>
            </div>
            <div class={`${card} bg-white`}>
              <span class="grid size-[38px] place-items-center rounded-xl bg-[#EAF1FE] text-brand" aria-hidden="true">
                <Lock size={20} stroke-width={1.75} />
