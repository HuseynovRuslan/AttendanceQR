---
// "İcazələr" kartı — məxfilik səhifəsinin hero-sunun sağ tərəfi (PrivacyBody.astro). Props: lang.
// Bəzək xarakterlidir: açarlar öz-özünə açılıb-bağlanır.
import { getImage } from 'astro:assets'
import Bell from '@lucide/astro/icons/bell'
import Camera from '@lucide/astro/icons/camera'
import MapPin from '@lucide/astro/icons/map-pin'
import { useTranslations, type Lang } from '../../../i18n/ui'
import { LOGO_WORD } from '../../../data/brand'
import { SITE } from '../../../data/site'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)

// Header-dəki ilə eyni loqo variantı (brand.ts): ayrıca fayl yaranmır, preload boşa getmir.
const logoWord = await getImage(LOGO_WORD)

// `isOptional` — status boz, əks halda mavi. `delay` (saniyə) açarların bir-bir keçməsi üçündür.
const rows = [
  { icon: Camera, name: t('priv.permCam'), status: t('priv.permOnScan'), isOptional: false, delay: 0 },
  { icon: MapPin, name: t('priv.permGps'), status: t('priv.permOnScan'), isOptional: false, delay: 0.6 },
  { icon: Bell, name: t('priv.permPush'), status: t('priv.permOptional'), isOptional: true, delay: 1.2 },
]
---

<div
  role="img"
  aria-label={t('priv.permAria')}
  class="w-[320px] max-w-full rounded-[22px] bg-white p-[18px] shadow-[0_30px_60px_-28px_rgb(17_18_17/0.35)] ring-1 ring-black/[0.04]"
>
  <div aria-hidden="true">
    <div class="flex items-center justify-between gap-3 border-b border-[#EFEDEC] pb-3.5">
      <img src={logoWord.src} alt={SITE.name} width={LOGO_WORD.width} height={LOGO_WORD.height} class="h-6 w-auto" />
      <span class="text-[12px] text-ink2">{t('priv.permTitle')}</span>
    </div>

    <ul role="list" class="m-0 list-none p-0">
      {
        rows.map((row) => (
          <li class="flex items-center gap-3 border-t border-[#EFEDEC] py-3 first:border-t-0 first:pb-3">
            <span class="grid size-[34px] shrink-0 place-items-center rounded-[10px] bg-page text-ink">
              <row.icon size={18} stroke-width={1.75} />
            </span>

            <span class="min-w-0 flex-1">
              <span class="block text-[14.5px] leading-tight font-semibold text-ink">{row.name}</span>
              <span
                class:list={[
                  'mt-1 flex items-center gap-1.5 font-mono text-[10.5px] tracking-[0.08em] uppercase',
                  row.isOptional ? 'text-ink2' : 'text-brand',
                ]}
              >
                {!row.isOptional && <span class="size-1.5 rounded-full bg-brand" />}
                {row.status}
              </span>
            </span>

            <span class="perm-track relative h-6 w-10 shrink-0 rounded-full bg-stone-300" style={`--delay:${row.delay}s`}>
              <span class="perm-knob absolute top-0.5 left-0.5 size-5 rounded-full bg-white shadow-[0_1px_3px_rgb(0_0_0/0.25)]" />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* 9 saniyəlik dövr; açarlar eyni @keyframes-i işlədir, yalnız --delay fərqlidir.
     @keyframes adları Astro-da scope olunmur, ona görə `perm-` prefiksi. */
  .perm-track {
    animation: perm-track 9s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  .perm-knob {
    animation: perm-knob 9s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  /* 0–10% bağlı, 10–18% maviyə keçir, 18–70% açıq, 70–78% sönür, 78–100% bağlı. */
  @keyframes perm-track {
    0%,
    10%,
    78%,
    100% {
      background-color: var(--color-stone-300);
    }
    18%,
    70% {
      background-color: var(--color-brand);
    }
  }

  /* Düymə eyni anlarda sürüşür: 40px zolaq − 20px düymə − 2×2px boşluq = 16px. */
  @keyframes perm-knob {
    0%,
    10%,
    78%,
    100% {
      transform: translateX(0);
    }
    18%,
    70% {
      transform: translateX(16px);
    }
  }

  /* Animasiya yoxdur, açarlar açıq vəziyyətdə qalır. */
  @media (prefers-reduced-motion: reduce) {
    .perm-track,
    .perm-knob {
      animation: none;
    }

    .perm-track {
      background-color: var(--color-brand);
    }

    .perm-knob {
      transform: translateX(16px);
    }
  }
</style>
