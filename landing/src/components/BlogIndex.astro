---
/*
  Bloq siyahısı (üç dildə). Nazik səhifələr (pages/blog, pages/ru/blog, pages/en/blog) yalnız BaseLayout-u
  qurub bunu çağırır, ona görə hər dildə eyni məzmun bir yerdə yazılıb.

  Hissələr:
    1. Hero          — başlıq, giriş cümləsi və hərəkətli QR illüstrasiyası
    2. Kateqoriyalar — düymələr + canlı axtarış (məntiqi blogFilter.ts yazır, HTML ilə `data-*` ilə bağlıdır)
    3. Seçilmiş kart — featured: true olan ən yeni məqalə (axtarış yoxdursa)
    4. Kart şəbəkəsi — bütün məqalələr; boş vəziyyət kartı (axtarış nəticəsizdirsə)

  Props: lang — siyahının dili.
*/
// İkonlar ayrı-ayrı fayllardan idxal olunur (paketin kök faylı ~1700 ikonu yükləyir, dev server yavaşlayır).
import ArrowRight from '@lucide/astro/icons/arrow-right'
import Search from '@lucide/astro/icons/search'
import X from '@lucide/astro/icons/x'
import { useTranslations, fmt, type Lang } from '../i18n/ui'
import {
  getPosts,
  postSlug,
  blogPath,
  dateLocale,
  categories,
  categoryKey,
  readingMinutes,
  type BlogPost,
} from '../data/blog'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)

// Yalnız bu dilin məqalələri, yeni, sonra köhnə.
const posts = await getPosts(lang)

// Seçilmiş məqalə: `featured: true` olanların ən yenisi (posts artıq tarixə görə sıralıdır).
const featuredPost = posts.find((post) => post.data.featured)

// Yalnız bu dildə ən azı bir məqaləsi olan kateqoriyaların düyməsi çıxır.
const visibleCategories = categories.filter((category) => posts.some((post) => post.data.category === category))

// pubDate UTC-yə düşür; timeZone: 'UTC' olmasa, server UTC-dən geridə olanda tarix bir gün geri qaçardı.
const formatDate = (date: Date) =>
  date.toLocaleDateString(dateLocale[lang], { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })

const readTime = (post: BlogPost) => fmt(t('blog.readTime'), { n: readingMinutes(post) })
const categoryName = (post: BlogPost) => t(categoryKey[post.data.category])

// Axtarış mətni: başlıq + təsvir + qısa xülasə + kateqoriya adı (məqalənin tam mətni daxil deyil).
const searchText = (post: BlogPost) =>
  [post.data.title, post.data.description, post.data.summary, categoryName(post)].filter(Boolean).join(' ')

// Təkrar edən sinif sətirləri (tam yazılıb ki, Tailwind tapsın).
const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand'
const cardHover =
  'transition duration-300 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0'
// Kateqoriya çipi: yazı çipin içində padding ilə dayanır və sətir hündürlüyü leading-4 ilə sabitdir, ona görə
// yazı həmişə çipin düz ortasındadır (əvvəlki kiçik kvadrat yazı ilə dəqiq düzülmürdü). Mətn adi yazılışla qalır.
const categoryChip =
  'inline-flex items-center rounded-full bg-brand-50 px-[11px] py-[5px] text-[12.5px] leading-4 font-bold text-brand-700'
const buttonReset = 'cursor-pointer border-0 bg-transparent p-0 [font:inherit]'
---

{
  posts.length === 0 ? (
    <section class="bg-white pt-[calc(var(--header-h)+48px)] pb-24">
      <p class="wrap text-stone-600">{t('blog.empty')}</p>
    </section>
  ) : (
    <div
      data-blog-index
      data-tpl-results={t('blog.search.results')}
      data-tpl-query={t('blog.search.query')}
      data-tpl-empty-title={t('blog.search.emptyTitle')}
    >
      {/* 1. HERO: About səhifəsinin heroları ilə eyni fon; header sabit olduğu üçün yuxarıdan onun hündürlüyü qədər boşluq. */}
      <section class="relative overflow-hidden border-b border-hair bg-page pt-[calc(var(--header-h)+48px)] pb-16 sm:pb-20">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(#cbd5e1_1.1px,transparent_1.2px)] bg-[size:22px_22px] [mask-image:linear-gradient(100deg,transparent_35%,#000_75%)]"
        >
        </div>
        {/* Sağ yuxarıda yumşaq mavi işıq. */}
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(560px_380px_at_88%_4%,rgba(21,94,239,.11),transparent_70%)]"
        >
        </div>

        <div class="wrap relative grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,400px)] lg:gap-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,480px)] 2xl:grid-cols-[minmax(0,1fr)_minmax(0,560px)]">
          <div>
            <h1 class="text-[clamp(38px,5.4vw,72px)] leading-[1.02] font-semibold tracking-[-0.045em] text-balance text-ink">
              {t('blog.hero.title.a')}<span class="text-brand">{t('blog.hero.title.hl')}</span>{t('blog.hero.title.b')}
            </h1>
            <p class="mt-6 max-w-[520px] text-[17px] leading-[1.7] text-stone-600 sm:text-[18px]">
              {t('blog.hero.lead')}
            </p>
          </div>

          {/* <img>, inline SVG yox: skan xəttinin animasiyası və prefers-reduced-motion şəkilin içindədir.
              Sütun ÖLÇÜLÜDÜR (auto yox): auto sütunda w-full şəkli sıxıb kiçildirdi; indi şəkil sütunu doldurur. */}
          <img
            src="/blog/hero-qr.svg"
            width="560"
            height="460"
            fetchpriority="high"
            alt={t('blog.hero.imgAlt')}
            class="h-auto w-full max-w-[520px] lg:max-w-none"
          />
        </div>
      </section>

      <section class="bg-white pt-4 pb-24">
        <div class="wrap">
          {/* 2. KATEQORİYALAR + AXTARIŞ. wrap-reverse: sətir sarılanda axtarış kateqoriyaların ÜSTÜNDƏ qalır. */}
          <div class="flex flex-wrap-reverse items-center justify-between gap-x-6 gap-y-2 border-b border-hair">
            <div role="group" aria-label={t('blog.cats.aria')} class="flex flex-wrap gap-x-7">
              {
                ['all', ...visibleCategories].map((category) => (
                  <button
                    type="button"
                    data-cat-tab
                    data-cat={category}
                    aria-pressed={category === 'all' ? 'true' : 'false'}
                    class={`${buttonReset} -mb-px min-h-12 border-b-2 border-transparent px-0.5 py-3.5 text-base font-semibold text-ink2 hover:text-ink aria-pressed:border-brand aria-pressed:text-ink ${focusRing}`}
                  >
                    {category === 'all' ? t('blog.cat.all') : t(categoryKey[category as (typeof categories)[number]])}
                  </button>
                ))
              }
            </div>

            <div role="search" class="min-w-[240px] flex-[0_1_340px] max-sm:flex-[1_1_100%]">
              <label class="flex h-11 cursor-text items-center gap-2.5 rounded-xl border border-hair bg-white pr-1.5 pl-3.5 focus-within:border-brand focus-within:ring-[3px] focus-within:ring-brand/15">
                <Search class="size-[18px] flex-none text-ink2" aria-hidden="true" />
                {/* Preflight yoxdur: input-un brauzer çərçivəsi, fonu və axtarış ikonları əl ilə sıfırlanır. */}
                <input
                  type="search"
                  name="q"
                  autocomplete="off"
                  data-search-input
                  aria-label={t('blog.search.label')}
                  placeholder={t('blog.search.placeholder')}
                  class="h-full min-w-0 flex-1 appearance-none border-0 bg-transparent p-0 text-[15px] text-ink outline-none [font:inherit] placeholder:text-ink2 [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
                />
                <span data-search-clear-wrap hidden>
                  <button
                    type="button"
                    aria-label={t('blog.search.clear')}
                    class={`${buttonReset} flex size-8 items-center justify-center rounded-lg text-ink2 hover:bg-brand-50 hover:text-brand ${focusRing}`}
                  >
                    <X class="size-4" aria-hidden="true" />
                  </button>
                </span>
              </label>
            </div>
          </div>

          {/* Axtarış nəticəsinin statusu (ekran oxuyucuya da deyilir). Boşdursa yer tutmur (empty:mt-0). */}
          <p aria-live="polite" data-search-status class="mt-4 text-sm text-stone-600 empty:mt-0"></p>
          <p aria-live="polite" data-search-announce class="sr-only"></p>

          {/* 3. SEÇİLMİŞ KART: sarğıda display sinfi yoxdur ki, `hidden` işləsin. */}
          {
            featuredPost && (
              <div data-item data-kind="featured" data-cat={featuredPost.data.category} data-search={searchText(featuredPost)} class="mt-10">
                <a
                  href={blogPath(lang, postSlug(featuredPost))}
                  class={`group flex flex-wrap overflow-hidden rounded-[28px] border border-brand bg-brand text-white no-underline hover:shadow-[0_24px_48px_-24px_rgba(11,67,184,.4)] ${cardHover} ${focusRing}`}
                >
                  <div class="flex flex-[1_1_400px] flex-col justify-center gap-4 px-6 py-10 lg:px-11 lg:py-12">
                    {/* Mavi fonda açıq çip oxunmur: «Seçilmiş» ağ, kateqoriya tünd şəffaf mavi çipdədir. */}
                    <div class="flex flex-wrap items-center gap-2.5">
                      <span class="rounded-full bg-white px-[11px] py-[5px] text-[12.5px] leading-4 font-bold text-brand-700">{t('blog.featured')}</span>
                      <span class="rounded-full bg-brand-700/50 px-[11px] py-[5px] text-[12.5px] leading-4 font-bold text-white">{categoryName(featuredPost)}</span>
                    </div>
                    <h2 class="text-[clamp(28px,3.2vw,40px)] leading-[1.1] font-bold tracking-[-0.03em]">
                      {featuredPost.data.title}
                    </h2>
                    <p class="text-[17px] leading-[1.6] text-white/90">{featuredPost.data.description}</p>
                    <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-3">
                      <span class="inline-flex items-center gap-2 rounded-full bg-white px-[22px] py-3 font-bold text-brand-700 group-hover:bg-brand-50">
                        {t('blog.read')}
                        <ArrowRight class="size-[18px] transition-transform group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" aria-hidden="true" />
                      </span>
                      <span class="flex items-center gap-2 text-sm text-white/90">
                        <time datetime={featuredPost.data.pubDate.toISOString()}>{formatDate(featuredPost.data.pubDate)}</time>
                        {/* aria-hidden: ekran oxuyucu ayırıcı işarəni oxumasın. */}
                        <span aria-hidden="true">·</span>
                        <span>{readTime(featuredPost)}</span>
                      </span>
                    </div>
                  </div>
                  {
                    featuredPost.data.cover && (
                      <div class="aspect-[1.7/1] min-w-0 flex-[1.3_1_520px] self-stretch overflow-hidden">
                        <img
                          src={featuredPost.data.cover}
                          alt=""
                          width="1200"
                          height="600"
                          class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                        />
                      </div>
                    )
                  }
                </a>
              </div>
            )
          }

          {/* 4. KART ŞƏBƏKƏSİ: hər məqalə bir <li>. Seçilmiş məqalənin surəti əvvəldən gizlidir (yalnız axtarışda çıxır). */}
          <ul class="mt-10 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,330px),1fr))] gap-6 p-0">
            {
              posts.map((post) => {
                const isFeatured = post === featuredPost
                return (
                  <li
                    data-item
                    data-kind={isFeatured ? 'featured-copy' : 'post'}
                    data-cat={post.data.category}
                    data-search={searchText(post)}
                    hidden={isFeatured}
                  >
                    <a
                      href={blogPath(lang, postSlug(post))}
                      class={`group flex h-full flex-col rounded-[26px] border border-hair bg-white p-2.5 text-ink no-underline hover:border-brand/25 hover:shadow-[0_24px_48px_-24px_rgba(11,67,184,.4)] ${cardHover} ${focusRing}`}
                    >
                      <div class="aspect-[9/5] overflow-hidden rounded-[18px] bg-brand-50">
                        {post.data.cover && (
                          <img
                            src={post.data.cover}
                            alt=""
                            width="1200"
                            height="600"
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                          />
                        )}
                      </div>
                      <div class="flex flex-1 flex-col gap-3 px-3.5 pt-5 pb-3">
                        <div class="flex items-center justify-between gap-3">
                          <span class={categoryChip}>{categoryName(post)}</span>
                          <span class="text-[13px] text-ink2">{readTime(post)}</span>
                        </div>
                        <h2 class="text-[22px] leading-[1.3] font-bold tracking-[-0.015em]">{post.data.title}</h2>
                        <p class="text-[15px] leading-[1.6] text-stone-600">{post.data.description}</p>
                        <div class="mt-auto flex items-center justify-between gap-3 pt-3">
                          <time datetime={post.data.pubDate.toISOString()} class="text-[13px] text-ink2">
                            {formatDate(post.data.pubDate)}
                          </time>
                          <span class="inline-flex items-center gap-1.5 text-sm font-bold text-brand">
                            {t('blog.read')}
                            <ArrowRight class="size-[18px] transition-transform group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" aria-hidden="true" />
                          </span>
                        </div>
                      </div>
                    </a>
                  </li>
                )
              })
            }
          </ul>

          {/* 5. BOŞ VƏZİYYƏT: axtarış nəticəsizdir. Əvvəldən gizlidir; başlıq və düymələri blogFilter.ts idarə edir. */}
          <div data-empty hidden class="mt-10">
            <div class="flex flex-col items-center gap-3 rounded-[26px] border border-dashed border-hair bg-white px-6 py-16 text-center">
              <span class="flex size-14 items-center justify-center rounded-2xl bg-brand-50 text-brand" aria-hidden="true">
                <Search class="size-6" aria-hidden="true" />
              </span>
              <h2 data-empty-title class="text-[22px] leading-[1.3] font-bold tracking-[-0.015em] text-ink"></h2>
              <p class="max-w-[420px] text-[15px] leading-[1.6] text-stone-600">{t('blog.search.emptyHint')}</p>
              <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
                <button
                  type="button"
                  data-empty-reset
                  class={`${buttonReset} min-h-11 rounded-[10px] border border-hair bg-white px-5 text-sm font-semibold text-ink hover:border-brand hover:text-brand ${focusRing}`}
                >
                  {t('blog.search.reset')}
                </button>
                <span data-empty-widen-wrap hidden>
                  <button
                    type="button"
                    data-empty-widen
                    class={`${buttonReset} min-h-11 rounded-[10px] border border-brand bg-white px-5 text-sm font-semibold text-brand hover:bg-brand-50 ${focusRing}`}
                  >
                    {t('blog.search.widen')}
                  </button>
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  )
}

<script>
  import './blogFilter'
</script>
