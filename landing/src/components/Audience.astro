---
/*
 * «Kimlər üçün» bölməsi: komandanın harada işlədiyinə görə üç iş mühiti, üç böyük kart.
 * Harada işlənir: Landing.astro-da, «Rəqəmlərlə» zolağı ilə «Təhlükəsizlik» arasında (AZ/RU/EN).
 * Props: lang — səhifənin dili.
 * Necə işləyir: kartlar aşağıdakı `cards` massivindən `map()` ilə qurulur. Hər kartın vizualı ayrıca
 * komponentdir (AudienceMap, AudienceBranches, AudiencePoster). Faylın sonundakı skript kartlar
 * ekrana girəndə vizualları bir dəfə canlandırır; canlanmanın özü CSS-dədir.
 *
 * İkonlar Lucide-dəndir (ISC lisenziyası). `@lucide/astro` ikonu build zamanı adi <svg> kimi yazır —
 * brauzerə heç bir JavaScript getmir. İkonlar dekorativdir: paket onlara özü aria-hidden="true" verir.
 */

// Hər ikon öz faylından idxal olunur (`@lucide/astro/icons/<ad>`), `import { MapPin } from '@lucide/astro'`
// kimi yox. İkinci yol paketin kök faylını açır, o isə ~1700 ikonun hamısını (üstəlik köhnə adlarını)
// yükləyir: build-də istifadə olunmayanlar atılır, amma `npm run dev`-də ölçülüb — ilk sorğu 34 s,
// sonrakı hər yeniləmə ~4.5 s çəkirdi. Ayrı-ayrı idxalda 8.7 s və 0.5 s. Görünüş eynidir.
// Lucide-in saytında ikonun adı (məs. map-pin) faylın adıdır: https://lucide.dev/icons
import MapPin from '@lucide/astro/icons/map-pin'
import Store from '@lucide/astro/icons/store'
import BuildingComplex from '@lucide/astro/icons/building-complex'
import Check from '@lucide/astro/icons/check'
import { useTranslations, type Lang, type UIKey } from '../i18n/ui'
import AudienceMap from './AudienceMap.astro'
import AudienceBranches from './AudienceBranches.astro'
import AudiencePoster from './AudiencePoster.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

// Vizualın adı → onu çəkən komponent. Yeni vizual əlavə etmək üçün: komponenti yaz, bura və
// aşağıdakı VisualName-ə adını əlavə et, `cards`-da istifadə et.
const visualComponents = {
  map: AudienceMap,
  branches: AudienceBranches,
  poster: AudiencePoster,
}
type VisualName = keyof typeof visualComponents

interface AudienceCard {
  // `typeof MapPin` — «Lucide ikon komponenti» deməkdir; bütün Lucide ikonları eyni tipdədir.
  icon: typeof MapPin
  pill: UIKey
  title: UIKey
  desc: UIKey
  bullets: UIKey[]
  visual: VisualName
}

// `UIKey` tipi sayəsində açarda hərf səhvi olsa, redaktor və `npm run check` xəta göstərir.
// BuildingComplex — Lucide-in köhnə «Building2» ikonunun yeni adıdır, görünüşü eynidir.
const cards: AudienceCard[] = [
  {
    icon: MapPin,
    pill: 'aud.site.pill',
    title: 'aud.site.title',
    desc: 'aud.site.desc',
    bullets: ['aud.site.b1', 'aud.site.b2', 'aud.site.b3'],
    visual: 'map',
  },
  {
    icon: Store,
    pill: 'aud.chain.pill',
    title: 'aud.chain.title',
    desc: 'aud.chain.desc',
    bullets: ['aud.chain.b1', 'aud.chain.b2', 'aud.chain.b3'],
    visual: 'branches',
  },
  {
    icon: BuildingComplex,
    pill: 'aud.office.pill',
    title: 'aud.office.title',
    desc: 'aud.office.desc',
    bullets: ['aud.office.b1', 'aud.office.b2', 'aud.office.b3'],
    visual: 'poster',
  },
]
---

<!--
  Fon: Modullar bölməsi ilə eyni səhifə rəngi (bg-page). Beləcə mavi «Rəqəmlərlə» zolağı yuxarıda da,
  aşağıda da eyni fonun içində qalır.

  Kənar xətt YOXDUR, bilərəkdən:
  • üstdə mavi zolaq var, xəttə ehtiyac yoxdur;
  • altdakı «Təhlükəsizlik» bölməsinin öz üst xətti var (Security.astro-dakı `edge-rule`: hair rəngi,
    kənarlara doğru əriyir) — burada da xətt olsa, ikiqat xətt alınardı.
  «Rəqəmlərlə» zolağı gizlədiləndə (site.ts → STATS.show = false) bu bölmə birbaşa «Modullar»dan sonra gəlir.
  İki boz (bg-page) bölmə yanaşı düşür, amma aralarında artıq dəqiq BİR xətt var: «Modullar»ın alt xətti
  (Modules.astro-dakı `edge-rule`). Ona görə burada üst xətt əlavə etmə — ikiqat xətt alınar.

  overflow-hidden (Modullardakı overflow-x-clip yox): sağ yuxarıdakı dekorativ dairə bölmənin
  kənarından çıxır, onun yuxarı hissəsi mavi zolağın üstünə daşmasın. overflow-x-clip yalnız üfüqi
  daşmanı kəsir, şaquli istiqamətdə kəsmir — burada isə məhz şaquli kəsmək lazımdır.
  Yuxarı/aşağı boşluq burada (py) verilir, çünki global.css `section { padding }` yazır.
-->
<section
  id="audience"
  aria-labelledby="audience-title"
  class="relative overflow-hidden bg-page py-20 lg:py-28"
>
  <!--
    Dekorativ dairə: size-70 = 280px (sm-dən kiçik ekranda), sm:size-105 = 420px. Tailwind v4-də ölçü
    vahidi 4px-dir (70 × 4 = 280). Rəngləri <style>-dadır.
  -->
  <div
    class="aud-circle pointer-events-none absolute -top-28 -right-28 size-70 rounded-full sm:-top-40 sm:-right-32 sm:size-105"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative">
    <!-- Başlıq HowItWorks, AdminPanel və Modullardakı ilə eynidir: eyebrow + H2 + bir cümlə, solda, alt-alta. -->
    <div class="max-w-155">
      <span
        class="rv inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-brand uppercase"
      >
        <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
        {t('aud.eyebrow')}
      </span>
      <h2
        id="audience-title"
        class="rv d1 mt-5 text-[32px] leading-[1.1] font-semibold tracking-tight text-ink sm:text-[38px]"
      >
        {t('aud.title')}
      </h2>
      <!-- text-pretty: son sətirdə tək söz ("olunur.") qalmasın deyə brauzer sətirləri bir az fərqli bölür. -->
      <p class="rv d2 mt-4 max-w-[46ch] text-[15px] leading-[1.75] text-pretty text-ink2">{t('aud.sub')}</p>
    </div>

    <!--
      Kartlar şəbəkəsi: mobildə bir sütun, lg-dən üç sütun, aralıq 20px.

      lg-dən hər kart 5 sətirlik «subgrid»dir (pill, başlıq, cümlə, vizual, siyahı). Subgrid kartın
      sətirlərini onu əhatə edən şəbəkənin sətirlərinə bağlayır, ona görə üç kartın pill-i, başlığı,
      vizualı və siyahısı hərəsi öz ortaq sətirini bölüşür: mətn bir kartda (və ya rus dilində) uzun
      olsa da vizuallar və siyahılar üç kartda eyni xətdə durur. `lg:gap-y-0` — sətirlər arasında boşluq
      yoxdur; aralıqları elementlərin öz `mt-*` verir. `lg:grid-cols-1` — tək sütunun eni içindəki
      mətnə görə genişlənməsin.
    -->
    <div class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-3">
      {
        cards.map((card, index) => {
          const Visual = visualComponents[card.visual]
          return (
            <article
              class={`aud-card rv d${index + 1} flex flex-col rounded-3xl border border-slate-200/80 bg-white p-5 leading-normal sm:p-6 lg:row-span-5 lg:grid lg:grid-cols-1 lg:grid-rows-subgrid lg:gap-y-0`}
              data-aud-card
            >
              {/* max-w-full: ən dar telefonda (320px) ingiliscə pill ("Offices and head-office buildings", 250px)
                  242px-lik yerə sığmır — o zaman kartdan çıxmır, ikinci sətrə bölünür. */}
              <p class="inline-flex w-fit max-w-full items-center gap-2 rounded-full bg-brand-50 py-1.5 pr-3.5 pl-2.5 text-[13px] font-medium text-brand">
                <card.icon size={15} class="shrink-0" />
                {t(card.pill)}
              </p>
              <h3 class="mt-4 text-[22px] leading-[1.2] font-semibold tracking-[-0.02em]">{t(card.title)}</h3>
              <p class="mt-2.5 text-[14.5px] leading-[1.65] text-ink2">{t(card.desc)}</p>

              {/* Vizual qutusu ekran oxuyucudan gizlidir: yazıları kartın mətnində onsuz da var. */}
              <div class="aud-visual mt-6" aria-hidden="true">
                <Visual lang={lang} />
              </div>

              <ul class="mt-6 list-none space-y-2.5 border-t border-slate-200/80 pt-5 text-[14px]">
                {card.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5">
                    <Check size={15} stroke-width={2.5} class="mt-0.75 shrink-0 text-brand" />
                    {t(bullet)}
                  </li>
                ))}
              </ul>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  /* ---------- Bu bölməyə xas dəyərlər ---------- */
  #audience {
    /* Saytın bütün bölmələrində işlənən yumşaq əyri (HowItWorks, AdminPanel, Modullardakı ilə eyni).
       Üç vizual da bunu `var(--aud-ease)` kimi oxuyur: dəyişəndə bir yerdə dəyişir. */
    --aud-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Dekorativ dairə: üç rəng mərkəzdən kənara doğru açılır. Üçü də #F5F6FA fonundan bir az tünd mavidir
     ki, dairə disk kimi seçilsin; kənar rəngi fona ən yaxındır, ona görə kənar yumşaq əriyir. */
  .aud-circle {
    --aud-circle-core: #dfe8fa; /* mərkəz (ən tünd) */
    --aud-circle-mid: #e9effa; /* orta */
    --aud-circle-edge: #eff2fa; /* kənar (fona ən yaxın) */
    background: radial-gradient(
      circle at 38% 62%,
      var(--aud-circle-core) 0%,
      var(--aud-circle-mid) 48%,
      var(--aud-circle-edge) 100%
    );
  }

  /* ---------- Kart ---------- */
  .aud-card {
    transition:
      transform 0.45s var(--aud-ease),
      box-shadow 0.45s ease,
      border-color 0.3s ease;
  }

  /* Hover yalnız siçanı olan cihazlarda: telefonda toxunuşdan sonra hover "ilişib" qalır.
     3px qalxma yumşaqdır: kart oxunan elementdir, düymə deyil. Kənar rəngi slate-300-ün 90%-idir,
     kölgənin mənfi yayılması (-32px) onu kartın altında yığıb yanlara çıxarmır. */
  @media (hover: hover) {
    .aud-card:hover {
      transform: translateY(-3px);
      border-color: rgb(203 213 225 / 0.9);
      box-shadow: 0 26px 46px -32px rgb(15 23 42 / 0.32);
    }
  }

  /* Hərəkət azaldılıbsa kart qalxmır (keçidləri global.css onsuz da söndürür, qalxmanı isə yox). */
  @media (prefers-reduced-motion: reduce) {
    .aud-card:hover {
      transform: none;
    }
  }

  /* ---------- Vizual qutusu ----------
     Üç vizualın ortaq qabığı: sabit hündürlük (288px) kartları eyni xəttə gətirir və səhifə
     yüklənəndə sıçrayış (CLS) olmur.
     container-type: inline-size bu qutunu «konteyner» edir: vizualların içindəki @container
     qaydaları ekranın yox, məhz BU qutunun eninə baxır (bax AudienceMap.astro).
     isolation: isolate qutunun içindəki 3D-əyilmiş elementlərin yuvarlaq küncdən kənara çıxmasının
     qarşısını alır (Safari-də overflow: hidden + border-radius bəzən 3D elementləri kəsmir).
     line-height: Tailwind-in Preflight-ı qoşulmayıb, ona görə mockup-ın içindəki mətn saytın 1.6-sını yox,
     dizaynın 1.5-ini götürür. */
  .aud-visual {
    --aud-visual-top: #ffffff; /* qutunun yuxarı rəngi */
    --aud-visual-bottom: #f6f8fc; /* qutunun aşağı rəngi */
    position: relative;
    height: 288px;
    overflow: hidden;
    border: 1px solid rgb(226 232 240 / 0.8); /* slate-200-ün 80%-i */
    border-radius: 18px;
    background: linear-gradient(180deg, var(--aud-visual-top) 0%, var(--aud-visual-bottom) 100%);
    container-type: inline-size;
    isolation: isolate;
    line-height: 1.5;
  }
</style>

<script>
  // Kartın neçə hissəsi ekranda olanda vizual canlanır (0.35 = 35%). Mobildə kart uzundur,
  // ona görə 100% yox, üçdə bir hissə kifayətdir.
  const LIVE_THRESHOLD = 0.35
  const SECTION_ID = 'audience'
  // Hər kart bu atributla işarələnib (Audience.astro-nun markup-ında).
  const CARD_SELECTOR = '[data-aud-card]'
  // Asılmış postreri tutan qutu (AudiencePoster.astro-da).
  const HANG_SELECTOR = '[data-aud-hang]'

  // Sistemdə «hərəkəti azalt» seçilibsə, heç nə gizlədilmir və canlanmır: hər şey dərhal son vəziyyətdə
  // görünür. https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
  function isMotionReduced(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches
  }

  // Hər kart ekrana ilk dəfə kifayət qədər girəndə ona `is-live` sinfi verir və onu izləməyi dayandırır:
  // canlanma BİR dəfə oynanır. IntersectionObserver scroll hadisəsini dinləmədən elementin ekrana
  // girdiyini bildirir: https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
  function markCardsLiveOnce(cards: NodeListOf<HTMLElement>): void {
    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) {
            return
          }
          const card = entry.target as HTMLElement
          card.classList.add('is-live')
          observer.unobserve(card)
        })
      },
      { threshold: LIVE_THRESHOLD }
    )
    cards.forEach(function (card) {
      observer.observe(card)
    })
  }

  // Poster yenidən yellənsin deyə `re-swing` sinfi silinib qaytarılır. Brauzer animasiyanı yalnız
  // sinif DƏYİŞƏNDƏ başlayır; silmə ilə əlavə etmə arasında heç nə olmasa, o, dəyişikliyi görmür və
  // animasiya təkrarlanmır. `offsetWidth` oxumaq brauzeri elementin ölçüsünü indi hesablamağa məcbur
  // edir — beləcə «silinmə» real olur və əlavə edilən sinif animasiyanı sıfırdan başladır.
  function restartSoftSwing(hang: HTMLElement): void {
    hang.classList.remove('re-swing')
    void hang.offsetWidth
    hang.classList.add('re-swing')
  }

  // Siçan karta gələndə poster yenidən yumşaq yellənir (yalnız kart artıq canlanıbsa). İlk, böyük
  // yellənmə hələ gedirsə, hover onu kəsmir: yarı yolda 0° vəziyyətinə atılıb yenidən başlamaq
  // yellənmənin təbiiliyini pozur.
  function swingPosterOnHover(card: HTMLElement): void {
    const hang = card.querySelector<HTMLElement>(HANG_SELECTOR)
    if (!hang) {
      return
    }

    // animationend yuxarı qalxır (bubbling): içindəki skan xəttinin animasiyası da bu qutuya xəbər
    // göndərir. Ona görə yalnız qutunun ÖZ yellənməsinin bitməsinə baxırıq (event.target).
    let isIntroFinished = false
    hang.addEventListener('animationend', function (event) {
      if (event.target === hang) {
        isIntroFinished = true
      }
    })

    card.addEventListener('mouseenter', function () {
      if (!card.classList.contains('is-live') || !isIntroFinished) {
        return
      }
      restartSoftSwing(hang)
    })
  }

  // Layihədə Astro View Transitions (ClientRouter) işlənmir — BaseLayout onu idxal etmir — ona görə bu
  // skript səhifə başına bir dəfə işləyir. ClientRouter əlavə olunsa: initAudience-i `astro:page-load`-da
  // çağırın, `astro:before-swap`-da isə observer-i `disconnect()` edin.
  function initAudience(): void {
    const section = document.getElementById(SECTION_ID)
    if (!section || isMotionReduced()) {
      return
    }

    // Gizli başlanğıc vəziyyətlər CSS-də yalnız `[data-anim]` altındadır: bu atribut yazılmayana qədər
    // (JS söndürülüb və ya hərəkət azaldılıb) vizuallar tam görünür.
    section.dataset.anim = 'on'

    const cards = section.querySelectorAll<HTMLElement>(CARD_SELECTOR)
    markCardsLiveOnce(cards)
    cards.forEach(swingPosterOnHover)
  }

  initAudience()
</script>
