---
/*
 * «Kimlər üçün» bölməsi: üç iş mühiti, üç kart (AudienceMap, AudienceBranches, AudiencePoster vizualları).
 * Landing.astro-da «Rəqəmlərlə» zolağı ilə «Təhlükəsizlik» arasında işlənir. Props: lang.
 * İkonlar Lucide-dəndir (ISC lisenziyası); build zamanı adi <svg> kimi yazılır.
 */

// İkonlar öz faylından idxal olunur: kök idxal ~1700 ikonu yükləyir və `npm run dev` xeyli yavaşlayır.
import MapPin from '@lucide/astro/icons/map-pin'
import Store from '@lucide/astro/icons/store'
import BuildingComplex from '@lucide/astro/icons/building-complex'
import Check from '@lucide/astro/icons/check'
import { useTranslations, type Lang, type UIKey } from '../../i18n/ui'
import AudienceMap from './AudienceMap.astro'
import AudienceBranches from './AudienceBranches.astro'
import AudiencePoster from './AudiencePoster.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

// Vizualın adı → onu çəkən komponent.
const visualComponents = {
  map: AudienceMap,
  branches: AudienceBranches,
  poster: AudiencePoster,
}
type VisualName = keyof typeof visualComponents

interface AudienceCard {
  icon: typeof MapPin
  pill: UIKey
  title: UIKey
  desc: UIKey
  bullets: UIKey[]
  visual: VisualName
}

const cards: AudienceCard[] = [
  {
    icon: MapPin,
    pill: 'aud.site.pill',
    title: 'aud.site.title',
    desc: 'aud.site.desc',
    bullets: ['aud.site.b1', 'aud.site.b2', 'aud.site.b3'],
    visual: 'map',
  },
  {
    icon: Store,
    pill: 'aud.chain.pill',
    title: 'aud.chain.title',
    desc: 'aud.chain.desc',
    bullets: ['aud.chain.b1', 'aud.chain.b2', 'aud.chain.b3'],
    visual: 'branches',
  },
  {
    icon: BuildingComplex,
    pill: 'aud.office.pill',
    title: 'aud.office.title',
    desc: 'aud.office.desc',
    bullets: ['aud.office.b1', 'aud.office.b2', 'aud.office.b3'],
    visual: 'poster',
  },
]
---

<!-- Kənar xətt bilərəkdən yoxdur: qonşu bölmələrin (Modules, Security) öz xətti var. overflow-hidden:
     dekorativ dairə yuxarıdakı zolağa daşmasın (overflow-x-clip şaquli kəsmir) -->
<section
  id="audience"
  aria-labelledby="audience-title"
  class="relative overflow-hidden bg-page py-20 lg:py-28"
>
  <div
    class="aud-circle pointer-events-none absolute -top-28 -right-28 size-70 rounded-full sm:-top-40 sm:-right-32 sm:size-105"
    aria-hidden="true"
    data-parallax
  >
  </div>

  <div class="wrap relative">
    <div class="max-w-155" data-reveal="heading">
      <span
        class="inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-brand uppercase"
      >
        <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
        {t('aud.eyebrow')}
      </span>
      <h2
        id="audience-title"
        class="mt-5 text-[32px] leading-[1.1] font-semibold tracking-tight text-ink sm:text-[38px]"
      >
        {t('aud.title')}
      </h2>
      <p class="mt-4 max-w-[46ch] text-[15px] leading-[1.75] text-pretty text-ink2">{t('aud.sub')}</p>
    </div>

    <!-- lg-dən hər kart 5 sətirlik subgrid-dir (pill, başlıq, cümlə, vizual, siyahı): mətn uzun olsa da
         vizuallar və siyahılar üç kartda eyni xətdə durur -->
    <div class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-3" data-reveal="cards" data-skew>
      {
        cards.map((card) => {
          const Visual = visualComponents[card.visual]
          return (
            <article
              class="aud-card flex flex-col rounded-3xl border border-slate-200/80 bg-white p-5 leading-normal sm:p-6 lg:row-span-5 lg:grid lg:grid-cols-1 lg:grid-rows-subgrid lg:gap-y-0"
              data-aud-card
            >
              {/* max-w-full: 320px telefonda uzun ingiliscə pill kartdan çıxmır, ikinci sətrə bölünür */}
              <p class="inline-flex w-fit max-w-full items-center gap-2 rounded-full bg-brand-50 py-1.5 pr-3.5 pl-2.5 text-[13px] font-medium text-brand">
                <card.icon size={15} class="shrink-0" />
                {t(card.pill)}
              </p>
              <h3 class="mt-4 text-[22px] leading-[1.2] font-semibold tracking-[-0.02em]">{t(card.title)}</h3>
              <p class="mt-2.5 text-[14.5px] leading-[1.65] text-ink2">{t(card.desc)}</p>

              {/* Vizual ekran oxuyucudan gizlidir: yazıları kartın mətnində onsuz da var */}
              <div class="aud-visual mt-6" aria-hidden="true">
                <Visual lang={lang} />
              </div>

              <ul class="mt-6 list-none space-y-2.5 border-t border-slate-200/80 pt-5 text-[14px]">
                {card.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5">
                    <Check size={15} stroke-width={2.5} class="mt-0.75 shrink-0 text-brand" />
                    {t(bullet)}
                  </li>
                ))}
              </ul>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  /* ---------- Bu bölməyə xas dəyərlər ---------- */
  #audience {
    /* Saytın ortaq yumşaq əyrisi; üç vizual da bunu oxuyur. */
    --aud-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Dekorativ dairə: kənar rəngi fona (#F5F6FA) ən yaxındır, ona görə kənar yumşaq əriyir. */
  .aud-circle {
    --aud-circle-core: #dfe8fa; /* mərkəz (ən tünd) */
    --aud-circle-mid: #e9effa; /* orta */
    --aud-circle-edge: #eff2fa; /* kənar (fona ən yaxın) */
    background: radial-gradient(
      circle at 38% 62%,
      var(--aud-circle-core) 0%,
      var(--aud-circle-mid) 48%,
      var(--aud-circle-edge) 100%
    );
  }

  /* ---------- Kart ---------- */
  .aud-card {
    transition:
      transform 0.45s var(--aud-ease),
      box-shadow 0.45s ease,
      border-color 0.3s ease;
  }

  /* Hover yalnız siçanı olan cihazlarda: telefonda toxunuşdan sonra "ilişib" qalır. */
  @media (hover: hover) {
    .aud-card:hover {
      transform: translateY(-3px);
      border-color: rgb(203 213 225 / 0.9);
      box-shadow: 0 26px 46px -32px rgb(15 23 42 / 0.32);
    }
  }

  /* ---------- Vizual qutusu (üç vizualın ortaq qabığı) ----------
     Sabit hündürlük kartları eyni xəttə gətirir və CLS-i aradan qaldırır.
     container-type: vizualların @container qaydaları bu qutunun eninə baxır (bax AudienceMap.astro).
     isolation: Safari-də overflow: hidden + border-radius bəzən 3D elementləri kəsmir.
     line-height: Preflight qoşulmayıb, mockup mətni saytın 1.6-sını yox, dizaynın 1.5-ini götürür. */
  .aud-visual {
    --aud-visual-top: #ffffff; /* qutunun yuxarı rəngi */
    --aud-visual-bottom: #f6f8fc; /* qutunun aşağı rəngi */
    position: relative;
    height: 288px;
    overflow: hidden;
    border: 1px solid rgb(226 232 240 / 0.8); /* slate-200-ün 80%-i */
    border-radius: 18px;
    background: linear-gradient(180deg, var(--aud-visual-top) 0%, var(--aud-visual-bottom) 100%);
    container-type: inline-size;
    isolation: isolate;
    line-height: 1.5;
  }
</style>

<script>
  import { ScrollTrigger } from '../../scripts/motion/gsap'
  import { REVEAL_START, pageRevealed } from '../../scripts/motion/shared'

  const SECTION_ID = 'audience'
  const CARD_SELECTOR = '[data-aud-card]'
  const HANG_SELECTOR = '[data-aud-hang]' // AudiencePoster.astro-dakı asılqan

  // Kart ilk dəfə ekrana girəndə `is-live` alır: canlanma bir dəfə oynanır.
  function markCardsLiveOnce(cards: NodeListOf<HTMLElement>): void {
    cards.forEach(function (card) {
      ScrollTrigger.create({
        trigger: card,
        start: REVEAL_START,
        once: true,
        onEnter: () => pageRevealed.then(() => card.classList.add('is-live')),
      })
    })
  }

  // `offsetWidth` oxumaq reflow məcbur edir: sinfin silinməsi real olur və animasiya sıfırdan başlayır.
  function restartSoftSwing(hang: HTMLElement): void {
    hang.classList.remove('re-swing')
    void hang.offsetWidth
    hang.classList.add('re-swing')
  }

  // Siçan karta gələndə poster yumşaq yellənir; ilk yellənmə gedirsə, hover onu kəsmir.
  function swingPosterOnHover(card: HTMLElement): void {
    const hang = card.querySelector<HTMLElement>(HANG_SELECTOR)
    if (!hang) {
      return
    }

    // animationend yuxarı qalxır: içindəki skan xəttinin animasiyası da gəlir, ona görə event.target yoxlanılır.
    let isIntroFinished = false
    hang.addEventListener('animationend', function (event) {
      if (event.target === hang) {
        isIntroFinished = true
      }
    })

    card.addEventListener('mouseenter', function () {
      if (!card.classList.contains('is-live') || !isIntroFinished) {
        return
      }
      restartSoftSwing(hang)
    })
  }

  // ClientRouter işlənmir, skript səhifə başına bir dəfə işləyir. Əlavə olunsa: `astro:page-load`-da çağırın.
  function initAudience(): void {
    const section = document.getElementById(SECTION_ID)
    if (!section) {
      return
    }

    const cards = section.querySelectorAll<HTMLElement>(CARD_SELECTOR)
    markCardsLiveOnce(cards)
    cards.forEach(swingPosterOnHover)
  }

  initAudience()
</script>
