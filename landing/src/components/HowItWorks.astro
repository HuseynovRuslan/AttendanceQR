---
/*
 * "Necə işləyir" bölməsi: davamiyyətin üç addımı — poster asılır, işçi skan edir, rəhbərlik görür.
 * Harada işlənir: Landing.astro-da, yəni AZ/RU/EN ana səhifələrində.
 * Props: lang — səhifənin dili; decoPosition — fondakı dekorativ QR-in yeri (default 'left').
 * Desktopda solda üç tab, sağda səhnə: addımlar 7 saniyədən bir özü dəyişir (faylın sonundakı skript).
 * Mobildə eyni üç addım adi kart siyahısıdır; hər kart ekrana girəndə bir dəfə canlanır.
 */
import { useTranslations, type Lang, type UIKey } from '../i18n/ui'
import HowStepVisual from './HowStepVisual.astro'

interface Props {
  lang: Lang
  /**
   * Fondakı dekorativ QR sahəsinin yeri. Bölmə başqa səhifədə işlənsə və ya qonşu bölmənin fonu
   * ilə toqquşsa, 'right' ilə sağ tərəfə keçirmək, 'none' ilə isə tamam söndürmək olar. md-dən
   * kiçik ekranda onsuz da gizlidir.
   */
  decoPosition?: 'left' | 'right' | 'none'
}
const { lang, decoPosition = 'left' } = Astro.props
const t = useTranslations(lang)

/**
 * Metrik çipləri Hero bölməsindəki üç iddianın eynisidir (hero.s2n "0 ₼", hero.s1n "~10 san",
 * hero.s3l "anlıq") — burada yeni rəqəm uydurulmur, eyni söz iki yerdə təkrarlanır ki, oxucu
 * addımı yuxarıdakı vədlə eyniləşdirsin.
 *
 * `satisfies` hər açarın ui.ts-də həqiqətən olduğunu yoxlayır: açarda hərf səhvi olsa, redaktor
 * və `astro check` xəta göstərir. (TypeScript operatorudur, MDN-də yoxdur:
 * https://www.typescriptlang.org/docs/handbook/release-notes/typescript-4-9.html#the-satisfies-operator)
 */
const steps = [
  { number: '01', title: 'how.s1t', desc: 'how.s1d', metric: 'how.s1m' },
  { number: '02', title: 'how.s2t', desc: 'how.s2d', metric: 'how.s2m' },
  { number: '03', title: 'how.s3t', desc: 'how.s3d', metric: 'how.s3m' },
] satisfies { number: string; title: UIKey; desc: UIKey; metric: UIKey }[]

/** Skan anında eyni anda yoxlanan dörd şey — 02-ci səhnənin üstündəki çiplər. */
const checks = ['how.c1', 'how.c2', 'how.c3', 'how.c4'] satisfies UIKey[]
const CHECKS_STEP_INDEX = 1 // yoxlama çipləri (QR/Məkan/Cihaz/Üz) yalnız 02-ci addımda (skan) görünür

// Prototipdən olduğu kimi götürülmüş sinif sətirləri. Bir dəfə yazılır, üç addım da onu işlədir —
// belə olmasa üç düymənin sinifləri vaxt keçdikcə bir-birindən aralanır.
// `bg-transparent text-ink cursor-pointer` prototipdə yoxdur, çünki orada Tailwind-in Preflight-ı
// işləyirdi. Bu layihədə Preflight söndürülüb (bax styles/tailwind.css) və global.css düymələrə
// yalnız şrift verir — qalanı brauzerin öz düymə görünüşüdür. Bu siniflər olmasa, seçilməmiş iki
// addım boz `buttonface` kartı kimi görünür və üçü də bir-birinə oxşayır.
const tabClass =
  'step group cursor-pointer rounded-2xl border border-transparent bg-transparent p-5 text-left text-ink transition-colors duration-300 hover:bg-[#FAFBFE] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand aria-selected:border-hair aria-selected:bg-[#F7F9FD] aria-selected:shadow-[0_1px_2px_rgba(16,24,40,.04)]'
const chipClass =
  'flex h-10 w-10 font-bold shrink-0 items-center justify-center rounded-[9px] bg-[#EEF2FB] text-[14px] tracking-[0.06em] text-brand'
const metricClass =
  'shrink-0 rounded-full border border-hair px-2.5 py-1 font-mono text-[11px] text-slate-500'
---

<section id="how" aria-labelledby="how-title" class="relative overflow-hidden bg-white py-20 lg:py-28">
  <!-- Bölmənin üstü və altı: kənarlara doğru əriyən 1px xətt, ona görə maskalıdır. -->
  <div class="edge-rule pointer-events-none absolute inset-x-0 top-0 h-px bg-hair" aria-hidden="true"></div>
  <div class="edge-rule pointer-events-none absolute inset-x-0 bottom-0 h-px bg-hair" aria-hidden="true"></div>
  <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

  {
    decoPosition !== 'none' && (
      <div
        class:list={[
          'deco pointer-events-none absolute -bottom-24 hidden w-105 md:block',
          decoPosition === 'left' ? '-left-24' : '-right-24',
        ]}
        aria-hidden="true"
      >
        <svg viewBox="0 0 336 336" width="100%" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="112" height="16" rx="1.5"/><rect x="176" y="0" width="16" height="16" rx="1.5"/><rect x="224" y="0" width="112" height="16" rx="1.5"/><rect x="0" y="16" width="16" height="16" rx="1.5"/><rect x="96" y="16" width="16" height="16" rx="1.5"/><rect x="128" y="16" width="16" height="16" rx="1.5"/><rect x="160" y="16" width="48" height="16" rx="1.5"/><rect x="224" y="16" width="16" height="16" rx="1.5"/><rect x="320" y="16" width="16" height="16" rx="1.5"/><rect x="0" y="32" width="16" height="16" rx="1.5"/><rect x="32" y="32" width="48" height="16" rx="1.5"/><rect x="96" y="32" width="16" height="16" rx="1.5"/><rect x="128" y="32" width="64" height="16" rx="1.5"/><rect x="224" y="32" width="16" height="16" rx="1.5"/><rect x="256" y="32" width="48" height="16" rx="1.5"/><rect x="320" y="32" width="16" height="16" rx="1.5"/><rect x="0" y="48" width="16" height="16" rx="1.5"/><rect x="32" y="48" width="48" height="16" rx="1.5"/><rect x="96" y="48" width="16" height="16" rx="1.5"/><rect x="128" y="48" width="16" height="16" rx="1.5"/><rect x="176" y="48" width="32" height="16" rx="1.5"/><rect x="224" y="48" width="16" height="16" rx="1.5"/><rect x="256" y="48" width="48" height="16" rx="1.5"/><rect x="320" y="48" width="16" height="16" rx="1.5"/><rect x="0" y="64" width="16" height="16" rx="1.5"/><rect x="32" y="64" width="48" height="16" rx="1.5"/><rect x="96" y="64" width="16" height="16" rx="1.5"/><rect x="224" y="64" width="16" height="16" rx="1.5"/><rect x="256" y="64" width="48" height="16" rx="1.5"/><rect x="320" y="64" width="16" height="16" rx="1.5"/><rect x="0" y="80" width="16" height="16" rx="1.5"/><rect x="96" y="80" width="16" height="16" rx="1.5"/><rect x="128" y="80" width="16" height="16" rx="1.5"/><rect x="160" y="80" width="16" height="16" rx="1.5"/><rect x="224" y="80" width="16" height="16" rx="1.5"/><rect x="320" y="80" width="16" height="16" rx="1.5"/><rect x="0" y="96" width="112" height="16" rx="1.5"/><rect x="128" y="96" width="32" height="16" rx="1.5"/><rect x="224" y="96" width="112" height="16" rx="1.5"/><rect x="128" y="112" width="16" height="16" rx="1.5"/><rect x="160" y="112" width="48" height="16" rx="1.5"/><rect x="16" y="128" width="80" height="16" rx="1.5"/><rect x="128" y="128" width="64" height="16" rx="1.5"/><rect x="224" y="128" width="32" height="16" rx="1.5"/><rect x="304" y="128" width="16" height="16" rx="1.5"/><rect x="48" y="144" width="16" height="16" rx="1.5"/><rect x="80" y="144" width="48" height="16" rx="1.5"/><rect x="256" y="144" width="16" height="16" rx="1.5"/><rect x="288" y="144" width="48" height="16" rx="1.5"/><rect x="16" y="160" width="16" height="16" rx="1.5"/><rect x="64" y="160" width="32" height="16" rx="1.5"/><rect x="112" y="160" width="16" height="16" rx="1.5"/><rect x="160" y="160" width="32" height="16" rx="1.5"/><rect x="208" y="160" width="32" height="16" rx="1.5"/><rect x="304" y="160" width="16" height="16" rx="1.5"/><rect x="32" y="176" width="48" height="16" rx="1.5"/><rect x="144" y="176" width="16" height="16" rx="1.5"/><rect x="176" y="176" width="16" height="16" rx="1.5"/><rect x="224" y="176" width="16" height="16" rx="1.5"/><rect x="256" y="176" width="16" height="16" rx="1.5"/><rect x="304" y="176" width="16" height="16" rx="1.5"/><rect x="16" y="192" width="16" height="16" rx="1.5"/><rect x="48" y="192" width="32" height="16" rx="1.5"/><rect x="96" y="192" width="16" height="16" rx="1.5"/><rect x="128" y="192" width="16" height="16" rx="1.5"/><rect x="160" y="192" width="64" height="16" rx="1.5"/><rect x="320" y="192" width="16" height="16" rx="1.5"/><rect x="144" y="208" width="16" height="16" rx="1.5"/><rect x="256" y="208" width="64" height="16" rx="1.5"/><rect x="0" y="224" width="112" height="16" rx="1.5"/><rect x="128" y="224" width="48" height="16" rx="1.5"/><rect x="224" y="224" width="80" height="16" rx="1.5"/><rect x="0" y="240" width="16" height="16" rx="1.5"/><rect x="96" y="240" width="16" height="16" rx="1.5"/><rect x="128" y="240" width="16" height="16" rx="1.5"/><rect x="160" y="240" width="16" height="16" rx="1.5"/><rect x="192" y="240" width="16" height="16" rx="1.5"/><rect x="224" y="240" width="16" height="16" rx="1.5"/><rect x="256" y="240" width="16" height="16" rx="1.5"/><rect x="304" y="240" width="16" height="16" rx="1.5"/><rect x="0" y="256" width="16" height="16" rx="1.5"/><rect x="32" y="256" width="48" height="16" rx="1.5"/><rect x="96" y="256" width="16" height="16" rx="1.5"/><rect x="128" y="256" width="48" height="16" rx="1.5"/><rect x="192" y="256" width="16" height="16" rx="1.5"/><rect x="224" y="256" width="16" height="16" rx="1.5"/><rect x="256" y="256" width="32" height="16" rx="1.5"/><rect x="320" y="256" width="16" height="16" rx="1.5"/><rect x="0" y="272" width="16" height="16" rx="1.5"/><rect x="32" y="272" width="48" height="16" rx="1.5"/><rect x="96" y="272" width="16" height="16" rx="1.5"/><rect x="160" y="272" width="32" height="16" rx="1.5"/><rect x="208" y="272" width="16" height="16" rx="1.5"/><rect x="0" y="288" width="16" height="16" rx="1.5"/><rect x="32" y="288" width="48" height="16" rx="1.5"/><rect x="96" y="288" width="16" height="16" rx="1.5"/><rect x="144" y="288" width="48" height="16" rx="1.5"/><rect x="208" y="288" width="48" height="16" rx="1.5"/><rect x="304" y="288" width="32" height="16" rx="1.5"/><rect x="0" y="304" width="16" height="16" rx="1.5"/><rect x="96" y="304" width="16" height="16" rx="1.5"/><rect x="176" y="304" width="16" height="16" rx="1.5"/><rect x="240" y="304" width="32" height="16" rx="1.5"/><rect x="304" y="304" width="32" height="16" rx="1.5"/><rect x="0" y="320" width="112" height="16" rx="1.5"/><rect x="176" y="320" width="80" height="16" rx="1.5"/><rect x="288" y="320" width="48" height="16" rx="1.5"/></svg>
      </div>
    )
  }

  <div class="wrap relative">
    <div class="max-w-155">
      <span
        class="rv inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-brand uppercase"
      >
        <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
        {t('how.eyebrow')}
      </span>
      <h2
        id="how-title"
        class="rv d1 mt-5 text-[32px] leading-[1.1] font-semibold tracking-tight text-ink sm:text-[38px]"
      >
        {t('how.title')}
      </h2>
      <p class="rv d2 mt-4 max-w-[46ch] text-[15px] leading-[1.75] text-ink2">{t('how.sub')}</p>
    </div>

    <!--
      ══════════ DESKTOP ══════════
      Solda tablist, sağda sabit hündürlüklü səhnə — oxucu heç nəyə toxunmadan hər üç kadrı görür.
      data-state (running / paused / manual) aşağıdakı skriptdən yazılır, CSS ona baxır.
      Pause/play düyməsi və CTA qəsdən yoxdur: bu bölmə izah edir, satmır — çağırış CTA bölməsindədir.
    -->
    <div
      id="howDesk"
      data-state="running"
      class="mt-14 hidden lg:grid lg:grid-cols-[minmax(0,400px)_1fr] lg:gap-14"
    >
      <div class="rv d3 relative">
        <!--
          Ardıcıllıq relsi: nömrə çiplərinin mərkəzindən keçən şaquli xətt, üstündə aktiv addıma
          qədər dolan brand qatı. Mövqeyi və hündürlüyü JS çip mərkəzlərindən ölçür — sərt yazılmış
          piksel dəyəri şrift yüklənəndə və ya mətn iki sətrə düşəndə yerindən çıxır.
          Üfüqi mövqe (left-10) isə çipin enindən asılıdır: p-5 (20px) + çipin yarısı (20px). Çipin
          ölçüsü dəyişsə, bu rəqəm və aşağıdakı pl-13 / ml-13 də onunla birlikdə dəyişməlidir.
        -->
        <div data-rail class="pointer-events-none absolute left-10 z-1 w-px bg-hair" aria-hidden="true">
          <div
            data-rail-fill
            class="w-full bg-brand transition-[height] duration-500 ease-[cubic-bezier(.22,.61,.36,1)]"
            style="height:0"
          >
          </div>
        </div>

        <div role="tablist" aria-label={t('how.tabs')} aria-orientation="vertical" class="flex flex-col gap-2">
          {
            steps.map((step, index) => (
              <button
                type="button"
                role="tab"
                id={`how-tab-${index + 1}`}
                aria-controls={`how-panel-${index + 1}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                class={tabClass}
              >
                <span class="flex items-center gap-3">
                  {/* Çip relsin ÜSTÜNDƏ durur: z-2 onu xəttin üstünə qaldırır, ring-4 isə
                      ətrafında fon rəngində halqa çəkib xətti çipin altından kəsir. */}
                  <span
                    data-chip
                    class={`${chipClass} relative z-2 ring-4 ring-white transition-colors group-aria-selected:bg-brand group-aria-selected:text-white group-aria-selected:ring-[#F7F9FD]`}
                  >
                    {step.number}
                  </span>
                  <span class="text-[17px] font-medium tracking-[-0.01em]">{t(step.title)}</span>
                  <span
                    class={`${metricClass} ml-auto transition-colors group-aria-selected:border-[#D7E0F7] group-aria-selected:bg-white group-aria-selected:text-brand`}
                  >
                    {t(step.metric)}
                  </span>
                </span>
                <span class="mt-3 block pl-13 text-[14.5px] leading-[1.7] text-ink2">{t(step.desc)}</span>
                {/* Progress xətti. Növbəti addıma keçid bu xəttin animationend hadisəsi ilə olur —
                    setInterval yox (səbəbi aşağıda, stil blokundakı "Progress xətti" qeydindədir). */}
                <span class="hw-bar mt-4 ml-13 block h-0.5 overflow-hidden rounded-full bg-hair opacity-0 transition-opacity duration-300 group-aria-selected:opacity-100">
                  <i />
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="rv d4">
        <div class="relative h-105 overflow-hidden rounded-2xl border border-hair bg-page">
          <div class="stage-grid pointer-events-none absolute inset-0"></div>

          {
            steps.map((_, index) => (
              <div
                id={`how-panel-${index + 1}`}
                role="tabpanel"
                aria-labelledby={`how-tab-${index + 1}`}
                tabindex={index === 0 ? 0 : -1}
                data-active={index === 0 ? 'true' : 'false'}
                aria-hidden={index === 0 ? undefined : 'true'}
                class="scene stage absolute inset-0 flex items-center justify-center"
              >
                <div class="w-full max-w-135 px-4">
                  <HowStepVisual step={(index + 1) as 1 | 2 | 3} idSuffix="d" />
                </div>
                {index === CHECKS_STEP_INDEX && (
                  <div class="pointer-events-none absolute top-1/2 left-6 flex -translate-y-1/2 flex-col gap-2">
                    {checks.map((checkKey) => (
                      <span class="hchip inline-flex items-center gap-1.5 rounded-full border border-hair bg-white px-3 py-1.5 text-[12px] font-medium shadow-[0_1px_2px_rgba(16,24,40,.05)]">
                        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-[#EAF0FC] text-brand">
                          <svg
                            width="11"
                            height="11"
                            viewBox="0 0 12 12"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M2.4 6.4 4.8 8.8 9.6 3.6" />
                          </svg>
                        </span>
                        {t(checkKey)}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!--
      ══════════ MOBİL ══════════
      Tab məntiqi yoxdur — eyni üç addım adi kart siyahısıdır: kiçik ekranda sol sütuna yer yoxdur,
      gizlənmiş iki kadrı barmaqla axtarmaq isə sadəcə aşağı sürüşdürməkdən pisdir.
    -->
    <ol role="list" class="mt-10 flex flex-col gap-5 lg:hidden">
      {
        steps.map((step, index) => (
          <li
            data-active="false"
            class={`scene rv d${index + 1} overflow-hidden rounded-2xl border border-hair bg-white`}
          >
            <div class="relative flex h-55 items-center justify-center bg-page">
              <div class="w-full max-w-72.5 px-2">
                <HowStepVisual step={(index + 1) as 1 | 2 | 3} idSuffix="m" />
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-center gap-3">
                <span class={chipClass}>{step.number}</span>
                <h3 class="text-[17px] font-medium tracking-[-0.01em] text-ink">{t(step.title)}</h3>
              </div>
              <p class="mt-3 text-[14.5px] leading-[1.7] text-ink2">{t(step.desc)}</p>
              {index === CHECKS_STEP_INDEX && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {checks.map((checkKey) => (
                    <span class="hchip inline-flex items-center gap-1.5 rounded-full border border-hair bg-white px-2.5 py-1 text-[12px] font-medium">
                      <span class="text-brand">
                        <svg
                          width="11"
                          height="11"
                          viewBox="0 0 12 12"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M2.4 6.4 4.8 8.8 9.6 3.6" />
                        </svg>
                      </span>
                      {t(checkKey)}
                    </span>
                  ))}
                </div>
              )}
              <span class={`${metricClass} mt-4 inline-flex`}>{t(step.metric)}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /*
    Bölmənin bütün stili burada. Köhnə variantın .how / .steps / .step stilləri global.css-dən
    silinib — `.step` sinfi indi yalnız bu faylın qaydaları üçündür.

    Səhnələrin `.an-*` qarmaqları HowStepVisual.astro-dadır, amma onları hərəkətə gətirən qaydalar
    da buradadır: @keyframes adı Astro-da scope olunmur (bax Problem.astro-dakı qeyd), ona görə eyni
    keyframe-i iki komponentdə yazmaqdansa bütün hərəkətləri bir faylda saxlamaq daha təhlükəsizdir.
    Başqa komponentdəki elementə çatmaq üçün :global() işlənir — ana seçici (`.scene`) bu
    komponentdə olduğuna görə qayda kənara sızmır.
    https://docs.astro.build/en/guides/styling/#global-styles

    Keyframe adlarındakı `hw-` prefiksi qəsdəndir: styles/global.css-də otuza yaxın keyframe var
    və onlardan biri elə `fill` adlanır.
  */

  /* Səhnədə elementlərin görünmə animasiyalarının (hw-rise / hw-pop / hw-row) ortaq əyrisi. */
  :root {
    --how-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Kənarlara doğru əriyən üst/alt xətt. */
  .edge-rule {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
  }

  /* Hero və Problem bölmələrindəki eyni brand işığı — rəng tokendən gəlir, hex təkrarlanmır.
     color-mix() brand rənginin 6%-lik şəffaf variantını CSS-in özündə düzəldir:
     https://developer.mozilla.org/en-US/docs/Web/CSS/color_value/color-mix */
  .glow {
    background: radial-gradient(
      760px 360px at 14% -10%,
      color-mix(in oklab, var(--color-brand) 6%, transparent),
      transparent 70%
    );
  }

  .deco {
    color: #dce3ef;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(72% 72% at 55% 52%, #000, transparent);
    mask-image: radial-gradient(72% 72% at 55% 52%, #000, transparent);
  }

  /* Səhnənin arxasındakı nöqtə şəbəkəsi. */
  .stage-grid {
    background-image: radial-gradient(#d7deea 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(70% 70% at 50% 45%, #000, transparent);
    mask-image: radial-gradient(70% 70% at 50% 45%, #000, transparent);
  }

  /* ---------- Səhnə keçidi (yalnız desktop paneli) ---------- */
  .stage {
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .stage[data-active='true'] {
    opacity: 1;
    transform: none;
  }

  /*
    ---------- Progress xətti ----------
    Növbəti addıma keçidi bu animasiyanın `animationend` hadisəsi verir, setInterval yox: belə
    olanda gözün gördüyü xətt ilə keçid heç vaxt bir-birindən aralanmır — fon tabında brauzer
    animasiyanı dayandırırsa, keçid də dayanır.
  */
  .hw-bar > i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-brand);
    border-radius: 999px;
  }

  /* 7s — bir addımın ekranda qalma müddəti. JS-də ayrıca taymer yoxdur: bu rəqəmi dəyişsən,
     avtomatik keçid də o qədər tez / gec olacaq. */
  .step[aria-selected='true'] .hw-bar > i {
    animation: hw-fill 7s linear forwards;
  }

  /* Siçan bölmənin üstündədirsə, fokus içindədirsə və ya bölmə ekranda deyilsə — xətt dayanır. */
  [data-state='paused'] .step[aria-selected='true'] .hw-bar > i {
    animation-play-state: paused;
  }

  /* Nəzarət istifadəçiyə keçəndə xətt tamam yox olur — daha heç nə saymır. */
  [data-state='manual'] .hw-bar {
    opacity: 0 !important;
  }

  @keyframes hw-fill {
    to {
      width: 100%;
    }
  }

  /* ---------- Səhnə animasiyaları ---------- */
  /* Yalnız aktiv səhnədə (data-active='true') işləyir: addım dəyişəndə seçici yenidən uyğun gəlir
     və animasiya sıfırdan başlayır. Nə sıçrayış, nə yay effekti — görünmə animasiyaları eyni əyri
     (--how-ease) üzərindədir; skan xətti (hw-sweep) və nəbz (hw-pulse) isə sonsuz təkrarlanır. */
  .scene[data-active='true'] :global(.an-poster),
  .scene[data-active='true'] :global(.an-phone),
  .scene[data-active='true'] :global(.an-win) {
    animation: hw-rise 0.85s var(--how-ease) both;
  }

  .scene[data-active='true'] :global(.an-badge) {
    animation: hw-pop 0.55s var(--how-ease) 0.35s both;
  }

  .scene[data-active='true'] :global(.an-badge-2) {
    animation-delay: 0.6s;
  }

  .scene[data-active='true'] :global(.an-ok) {
    animation: hw-pop 0.55s var(--how-ease) 1.5s both;
  }

  .scene[data-active='true'] :global(.an-scan) {
    animation: hw-sweep 2.6s cubic-bezier(0.45, 0, 0.55, 1) 0.4s infinite;
  }

  .scene[data-active='true'] :global(.an-row) {
    animation: hw-row 0.5s var(--how-ease) 0.55s both;
  }

  .scene[data-active='true'] :global(.an-row-2) {
    animation-delay: 0.8s;
  }

  .scene[data-active='true'] :global(.an-row-3) {
    animation-delay: 1.05s;
  }

  .scene[data-active='true'] :global(.an-pulse) {
    animation: hw-pulse 2.4s ease-out infinite;
  }

  /* QR imzası / Məkan / Cihaz / Üz — SVG-nin içində deyil, üstündə HTML çipləridir, çünki onlar
     tərcümə olunan mətndir. 0.4s / 0.7s / 1.0s / 1.3s: skan xətti gəzərkən bir-bir yanır. */
  .scene[data-active='true'] .hchip {
    animation: hw-pop 0.5s var(--how-ease) both;
  }

  .scene[data-active='true'] .hchip:nth-child(1) {
    animation-delay: 0.4s;
  }

  .scene[data-active='true'] .hchip:nth-child(2) {
    animation-delay: 0.7s;
  }

  .scene[data-active='true'] .hchip:nth-child(3) {
    animation-delay: 1s;
  }

  .scene[data-active='true'] .hchip:nth-child(4) {
    animation-delay: 1.3s;
  }

  /* SVG elementinin transform başlanğıcı öz sərhədindən ölçülsün, bütün rəsmin deyil — yoxsa
     scale() elementi öz mərkəzi ətrafında yox, bütün rəsmə görə böyüdür və element yerindən sürüşür.
     https://developer.mozilla.org/en-US/docs/Web/CSS/transform-box */
  .scene :global(.an-poster),
  .scene :global(.an-phone),
  .scene :global(.an-win),
  .scene :global(.an-badge),
  .scene :global(.an-ok),
  .scene :global(.an-row),
  .scene :global(.an-pulse) {
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes hw-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hw-pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hw-row {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hw-sweep {
    0% {
      transform: translateY(-17px);
      opacity: 0;
    }
    12% {
      opacity: 0.85;
    }
    50% {
      transform: translateY(17px);
      opacity: 0.85;
    }
    62% {
      opacity: 0;
    }
    100% {
      transform: translateY(-17px);
      opacity: 0;
    }
  }

  @keyframes hw-pulse {
    0% {
      opacity: 0.5;
      transform: scale(1);
    }
    70% {
      opacity: 0;
      transform: scale(2.6);
    }
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  /*
    global.css onsuz da `* { animation:none !important; transition:none !important }` yazır, ona
    görə burada yalnız onun görmədiyi şey qalır: `both` doldurma rejimi işləmədiyinə görə bütün
    elementlər öz təbii halında görünür, amma sayğac kimi oxunan progress xətti mənasız qalır —
    gizlədilir.
  */
  @media (prefers-reduced-motion: reduce) {
    .hw-bar {
      display: none;
    }

    .stage[data-active='true'] {
      opacity: 1;
    }
  }
</style>

<script>
  /*
    Bu skriptin iki müstəqil hissəsi var:
      1) Desktop tab maşını — addımlar özü dəyişir, klik və klaviatura ilə idarə olunur.
      2) Mobil kartlar — hər kartın animasiyası kart ekrana girəndə bir dəfə işləyir.
    Bir addımın müddəti (7s) burada deyil, <style>-dakı hw-fill animasiyasındadır.
    Xarici kitabxana və şəbəkə sorğusu yoxdur.

    Layihədə Astro View Transitions (ClientRouter) işlənmir — BaseLayout onu idxal etmir — ona görə
    bu skript səhifə başına bir dəfə işləyir. ClientRouter əlavə olunsa, hər iki hissəni `init()`
    içinə yığıb `astro:page-load`-a bağlamaq və `astro:before-swap`-da observer-ləri
    `disconnect()` etmək lazımdır.
  */

  // Desktop blokunun neçə hissəsi görünəndə "ekrandadır" sayılır (0.3 = 30%).
  const DESKTOP_VISIBLE_THRESHOLD = 0.3
  // Mobil kartın neçə hissəsi görünəndə onun animasiyası başlayır (0.45 = 45%).
  const CARD_VISIBLE_THRESHOLD = 0.45

  // Addım nəyə görə dəyişdi — analitika hadisəsinə bu yazılır.
  type StepSource = 'click' | 'keyboard' | 'auto'

  // ══════════ 1) DESKTOP ══════════
  const desktop = document.getElementById('howDesk')

  if (desktop) {
    const tablist = desktop.querySelector('[role="tablist"]') as HTMLElement
    // <HTMLButtonElement> yalnız TypeScript üçündür: tapılan elementlərin düymə olduğunu bildirir.
    // https://www.typescriptlang.org/docs/handbook/2/generics.html
    const tabs = Array.from(desktop.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = Array.from(desktop.querySelectorAll<HTMLElement>('[role="tabpanel"]'))
    const rail = desktop.querySelector('[data-rail]') as HTMLElement
    const railFill = desktop.querySelector('[data-rail-fill]') as HTMLElement
    // Sistemdə "hərəkəti azalt" seçilibsə, addımlar özü-özünə dəyişmir — yalnız klik və ya klaviatura ilə.
    // matchMedia CSS media sorğusunu JS-dən yoxlamağa imkan verir:
    // https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
    const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches

    let currentIndex = 0
    // true olanda avtomatik keçid işləmir: ya istifadəçi addımı özü seçib (bir daha başlamır),
    // ya da sistemdə "hərəkəti azalt" açıqdır.
    let isManual = prefersReducedMotion
    // Siçan bölmənin üstündədir və ya fokus onun içindədir — keçid müvəqqəti dayanır.
    let isUserInside = false
    // Bölmə ekrandadır. Ekranda deyilsə, keçid müvəqqəti dayanır.
    let isOnScreen = false

    // Saytda analitika qoşulsa, window-da 'qrlog:track' hadisəsini dinləmək kifayətdir
    // (WhatsAppButton da eyni hadisəni göndərir). Burada kitabxana əlavə edilmir.
    // CustomEvent — öz adımız və öz məlumatımızla (detail) hadisə yaratmaq üçün:
    // https://developer.mozilla.org/en-US/docs/Web/API/CustomEvent/CustomEvent
    const trackStep = (step: number, source: StepSource) => {
      window.dispatchEvent(
        new CustomEvent('qrlog:track', { detail: { event: 'how_step', step, source } })
      )
    }

    // Relsin başı, sonu və dolğunluğu çip mərkəzlərindən ölçülür — sərt yazılmış piksel dəyəri
    // şrift yüklənəndə və ya başlıq iki sətrə düşəndə xətti çiplərdən qoparır.
    // Qaytarılan rəqəm tablist-in yuxarı kənarından çipin mərkəzinə qədər olan məsafədir (px).
    const getChipCenter = (index: number) => {
      const chip = tabs[index].querySelector('[data-chip]') as HTMLElement
      const chipRect = chip.getBoundingClientRect()
      const tablistTop = tablist.getBoundingClientRect().top
      return chipRect.top - tablistTop + chipRect.height / 2
    }

    // Boz relsi birinci çipdən sonuncuya qədər, brand rəngli dolğunu isə aktiv çipə qədər çəkir.
    const layoutRail = () => {
      const firstCenter = getChipCenter(0)
      const lastCenter = getChipCenter(tabs.length - 1)
      rail.style.top = firstCenter + 'px'
      rail.style.height = lastCenter - firstCenter + 'px'
      railFill.style.height = getChipCenter(currentIndex) - firstCenter + 'px'
    }

    // CSS [data-state] dəyərinə baxıb progress xəttini işlədir, dayandırır və ya gizlədir.
    const getState = () => {
      if (isManual) return 'manual'
      if (isOnScreen && !isUserInside) return 'running'
      return 'paused'
    }

    const updateState = () => {
      desktop.dataset.state = getState()
    }

    // Progress xəttinin animasiyasını sıfırdan başladır: inline `animation: none` yazırıq,
    // offsetWidth-i oxuyub brauzeri bu halı dərhal hesablamağa məcbur edirik (reflow), sonra
    // inline dəyəri silirik — CSS-dəki hw-fill yenidən 0-dan başlayır.
    // `void` — oxunan rəqəm lazım deyil, vacib olan oxumağın özüdür.
    const restartBarAnimation = (bar: HTMLElement) => {
      bar.style.animation = 'none'
      void bar.offsetWidth
      bar.style.animation = ''
    }

    const updateTab = (tab: HTMLButtonElement, isActive: boolean) => {
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false')
      // Klaviaturadakı Tab düyməsi ilə yalnız aktiv taba gəlmək olur; digər tablara oxlarla
      // keçilir (bax handleKeydown).
      tab.tabIndex = isActive ? 0 : -1
      const bar = tab.querySelector('.hw-bar > i') as HTMLElement | null
      if (isActive && bar) {
        restartBarAnimation(bar)
      }
    }

    const updatePanel = (panel: HTMLElement, isActive: boolean) => {
      panel.dataset.active = isActive ? 'true' : 'false'
      // Fokuslana bilən element aria-hidden-in içində qalmamalıdır, ona görə tabindex də dəyişir.
      panel.tabIndex = isActive ? 0 : -1
      if (isActive) {
        panel.removeAttribute('aria-hidden')
      } else {
        panel.setAttribute('aria-hidden', 'true')
      }
    }

    // Addımı göstərir: tabları, panelləri və relsi yeniləyir. source yalnız klik, klaviatura və
    // avtomatik keçiddə verilir — ilk açılışda (showStep(0)) analitika hadisəsi göndərilmir.
    const showStep = (stepIndex: number, source?: StepSource) => {
      currentIndex = stepIndex
      tabs.forEach((tab, index) => updateTab(tab, index === stepIndex))
      panels.forEach((panel, index) => updatePanel(panel, index === stepIndex))
      layoutRail()
      if (source) trackStep(stepIndex + 1, source)
    }

    const stopAutoPlay = () => {
      isManual = true
      updateState()
    }

    // Sonsuz dövr: 03 bitəndə yenidən 01. `%` (bölmədən qalıq) son indeksdən sonra 0 qaytarır.
    const showNextStepAutomatically = () => {
      if (!isManual) showStep((currentIndex + 1) % tabs.length, 'auto')
    }

    const bindTabEvents = () => {
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          stopAutoPlay()
          showStep(index, 'click')
        })
        // animationend — CSS animasiyası bitəndə gələn hadisə. Keçidi setInterval yox, bu hadisə
        // verir ki, keçid gözün gördüyü xətlə həmişə eyni anda olsun (bax <style>, "Progress xətti").
        // https://developer.mozilla.org/en-US/docs/Web/API/Element/animationend_event
        const bar = tab.querySelector('.hw-bar > i') as HTMLElement
        bar.addEventListener('animationend', showNextStepAutomatically)
      })
    }

    // Basılan düyməyə görə keçiləcək addımın indeksini qaytarır; başqa düymədirsə null.
    // Ox düymələri, Home və End — tab siyahısı üçün standart klaviatura qaydası:
    // https://www.w3.org/WAI/ARIA/apg/patterns/tabs/
    const getKeyTargetIndex = (key: string): number | null => {
      const stepCount = tabs.length
      if (key === 'ArrowDown' || key === 'ArrowRight') {
        return (currentIndex + 1) % stepCount // 03-dən sonra 01
      }
      if (key === 'ArrowUp' || key === 'ArrowLeft') {
        return (currentIndex - 1 + stepCount) % stepCount // 01-dən əvvəl 03
      }
      if (key === 'Home') return 0
      if (key === 'End') return stepCount - 1
      return null
    }

    const handleKeydown = (event: KeyboardEvent) => {
      const targetIndex = getKeyTargetIndex(event.key)
      if (targetIndex === null) return
      // Bu düymələrin səhifəni sürüşdürməsinin qarşısını alırıq.
      event.preventDefault()
      stopAutoPlay()
      showStep(targetIndex, 'keyboard')
      tabs[targetIndex].focus()
    }

    const bindHoverAndFocus = () => {
      desktop.addEventListener('mouseenter', () => {
        isUserInside = true
        updateState()
      })
      desktop.addEventListener('mouseleave', () => {
        isUserInside = false
        updateState()
      })
      desktop.addEventListener('focusin', () => {
        isUserInside = true
        updateState()
      })
      // Fokus bir tabdan digərinə keçəndə də focusout gəlir. relatedTarget — fokusun getdiyi
      // element; o hələ bölmənin içindədirsə, fasilə davam edir.
      // https://developer.mozilla.org/en-US/docs/Web/API/FocusEvent/relatedTarget
      desktop.addEventListener('focusout', (event) => {
        if (!desktop.contains(event.relatedTarget as Node)) {
          isUserInside = false
          updateState()
        }
      })
    }

    // Ekranda olmayan bölmə saymır — nə CPU yandırır, nə də oxucunun görmədiyi kadrı keçir.
    // IntersectionObserver elementin ekrana girib-çıxmasını scroll hadisəsi dinləmədən izləyir:
    // https://developer.mozilla.org/en-US/docs/Web/API/IntersectionObserver
    const watchVisibility = () => {
      const observer = new IntersectionObserver(
        (entries) => {
          isOnScreen = entries[0].isIntersecting
          updateState()
        },
        { threshold: DESKTOP_VISIBLE_THRESHOLD }
      )
      observer.observe(desktop)
    }

    // ---------- İşə salma ----------
    bindTabEvents()
    tablist.addEventListener('keydown', handleKeydown)
    bindHoverAndFocus()
    watchVisibility()

    // Pəncərənin eni dəyişəndə mətn başqa cür bükülür və çiplər yerini dəyişir — relsi yenidən ölçürük.
    window.addEventListener('resize', layoutRail)
    // Veb-şrift gec yüklənib mətnin hündürlüyünü dəyişə bilər — yükləndikdən sonra relsi yenidən ölçürük.
    // https://developer.mozilla.org/en-US/docs/Web/API/FontFaceSet/ready
    if (document.fonts) document.fonts.ready.then(layoutRail)

    showStep(0)
    updateState()
  }

  // ══════════ 2) MOBİL ══════════
  // Avtomatik keçid yoxdur. Kart ekrana girəndə ona data-active="true" yazılır və CSS-dəki
  // .scene[data-active='true'] animasiyaları bir dəfə işləyir.
  const cards = document.querySelectorAll<HTMLElement>('#how ol .scene')
  if (cards.length) {
    const cardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const card = entry.target as HTMLElement
          card.dataset.active = 'true'
          // Animasiya bir dəfə oynanır — kartı daha izləməyə ehtiyac yoxdur.
          cardObserver.unobserve(card)
        })
      },
      { threshold: CARD_VISIBLE_THRESHOLD }
    )
    cards.forEach((card) => cardObserver.observe(card))
  }
</script>
