---
import { useTranslations, fmt, type Lang, type UIKey } from '../i18n/ui'

/**
 * 12:40 — "Problemlər". «Rəhbərin bir günü» bölməsinin (AdminPanel.astro) ikinci ekranı.
 *
 * Canlı hadisə: 1.1 s sonra Samir üçüncü dəfə iş yerindən kənarda skan edir — sətri "2 dəfə" →
 * "3 dəfə", "son 12:31" → "son 12:40", "Problemli skan" 3 → 4; sətir və kart qısa müddət kəhrəba
 * fonla yanır. Qarmaqlar AdminPanelDashboard.astro-dakı kimidir, üstəlik:
 *   data-flash  hadisədə element bu rənglə qısa müddət yanır
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

const WARN = '#FFF4E5'
const failed = 3
const succeeded = 58
const alert = { branch: 'Xətai anbarı', problems: 3 }

const reasons = {
  outside: { label: 'panel.ui.m2.outside', tone: 'bg-[#FDECC8] text-[#92400E]' },
  noLocation: { label: 'panel.ui.m2.noLocation', tone: 'bg-[#FDE2E1] text-[#B91C1C]' },
} satisfies Record<string, { label: UIKey; tone: string }>

// `now` — canlı hadisədə sətrin yeni vaxtı; yalnız Samirdə var.
const rows = [
  { name: 'Samir Nəsirli', last: '12:31', now: '12:40', reason: 'outside', times: 2 },
  { name: 'Fərid Babayev', last: '11:58', reason: 'outside', times: 2 },
  { name: 'Elvin Məmmədov', last: '09:02', reason: 'noLocation', times: 1 },
] satisfies { name: string; last: string; now?: string; reason: keyof typeof reasons; times: number }[]

const lastAt = (time: string) => fmt(t('panel.ui.m2.last'), { t: time })
const times = (n: number) => fmt(t('panel.ui.m2.times'), { n })
const card = 'border border-[#E7E9EE] bg-white'
---

<p class="text-[17px] font-semibold tracking-[-0.02em]">{t('panel.ui.m2.title')}</p>
<p class="mt-0.5 text-[12px] text-slate-500">{t('panel.ui.m2.sub')}</p>

<div class="mt-4 grid grid-cols-2 gap-2.5">
  <div data-flash={WARN} class={`rounded-xl border-t-[3px] border-t-[#E4572E] px-3.5 py-3 ${card}`}>
    <p class="text-[11.5px] text-slate-500">{t('panel.ui.m2.failed')}</p>
    <p data-a={failed + 1} class="mt-1 text-[24px] leading-none font-semibold tabular-nums">{failed}</p>
  </div>
  <div class={`rounded-xl border-t-[3px] border-t-brand px-3.5 py-3 ${card}`}>
    <p class="text-[11.5px] text-slate-500">{t('panel.ui.m2.ok')}</p>
    <p class="mt-1 text-[24px] leading-none font-semibold tabular-nums">{succeeded}</p>
  </div>
</div>

<div class="mt-3 rounded-xl border border-[#F3DDB0] bg-[#FFF8EC] px-4 py-3">
  <p class="text-[13.5px] font-semibold text-[#9A3412]">{t('panel.ui.m2.alert')}</p>
  <span class="mt-2 inline-flex rounded-full bg-[#FDECC8] px-2.5 py-0.5 text-[11.5px] font-medium text-[#92400E]">
    {fmt(t('panel.ui.m2.alertTag'), { b: alert.branch, n: alert.problems })}
  </span>
  <p class="mt-2 text-[12.5px] leading-[1.6] text-ink2">
    {fmt(t('panel.ui.m2.alertText'), { r: t('panel.ui.m2.outside') })}
  </p>
</div>

<div class={`mt-3 overflow-hidden rounded-xl ${card}`}>
  <p class="px-4 pt-3 text-[13.5px] font-semibold">{t('panel.ui.m2.list')}</p>
  <ul class="mt-1.5 list-none divide-y divide-[#F0F1F4]">
    {
      rows.map((row) => (
        <li data-flash={row.now && WARN} class="px-4 py-2.5">
          <p class="flex items-center justify-between gap-2">
            <span class="text-[13px] font-semibold">{row.name}</span>
            <span data-a={row.now && lastAt(row.now)} class="font-mono text-[11px] text-slate-400">
              {lastAt(row.last)}
            </span>
          </p>
          <p class="mt-1 flex items-center gap-2">
            <span class:list={['rounded-md px-1.5 py-0.5 text-[11px] font-medium', reasons[row.reason].tone]}>
              {t(reasons[row.reason].label)}
            </span>
            <span data-a={row.now && times(row.times + 1)} class="text-[11.5px] font-semibold text-[#B91C1C]">
              {times(row.times)}
            </span>
          </p>
        </li>
      ))
    }
  </ul>
</div>
