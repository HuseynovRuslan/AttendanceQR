---
/*
  "Haqqımızda" hero-sunun sağındakı özünü yığan QR emblemi. Yalnız bəzəkdir.

  Bu `---` arasındakı kod brauzerdə yox, sayt YIĞILARKƏN (npm run build) bir dəfə işləyir və
  HTML-ə hazır nəticə yazır. Brauzerə heç bir JavaScript getmir.

  Plan: 21×21 tor = 441 kvadratcıq. Hər biri üçün iki məlumat saxlayırıq:
    on    — kvadratcıq dolu (qara) olsun, yoxsa boş,
    delay — animasiyası neçə millisaniyə gec başlasın (mərkəzdən uzaq olan gec peyda olur).
*/

const SIZE = 21 // torun hər tərəfində kvadratcıq sayı
const CENTER = 10 // mərkəz: 0-dan 20-yə qədər sayanda ortadakı indeks

// "Seed"li təsadüfi ədəd: eyni başlanğıc ədəd (seed) həmişə eyni ardıcıllığı verir.
// Ona görə sayt hər yığılanda QR naxışı eyni qalır, təsadüfi olsa da dəyişmir.
let seed = 7
function rnd() {
  seed = (seed * 16807) % 2147483647
  return seed / 2147483647 // 0 ilə 1 arası ədəd
}

// Tapıcı kvadrat: 7×7 ölçüdə, xarici çərçivə + ortada 3×3 dolu kvadrat.
// r və c — kvadratın DAXİLİNDƏ sətir və sütun (0-dan 6-ya qədər).
function finderOn(r: number, c: number) {
  const frame = r === 0 || r === 6 || c === 0 || c === 6
  const core = r >= 2 && r <= 4 && c >= 2 && c <= 4
  return frame || core
}

type Cell = { on: boolean; delay: number }
const cells: Cell[] = []

for (let row = 0; row < SIZE; row++) {
  for (let col = 0; col < SIZE; col++) {
    // Üç küncdə (sol yuxarı, sağ yuxarı, sol aşağı) tapıcı kvadratın yeri + yanındakı boş sıra.
    const nearTop = row <= 7
    const nearBottom = row >= SIZE - 8
    const nearLeft = col <= 7
    const nearRight = col >= SIZE - 8
    const inFinderZone = (nearTop && nearLeft) || (nearTop && nearRight) || (nearBottom && nearLeft)

    // Təsadüfi ədədi hər kvadratcıq üçün BİR dəfə çəkirik ki, ardıcıllıq sabit qalsın.
    const random = rnd()
    const jitter = rnd() * 180

    let on = random < 0.47
    if (inFinderZone) {
      // Zonanın 7×7 hissəsi tapıcı kvadratdır, qalan bir sıra boş qalır (QR-larda olduğu kimi).
      const r = nearBottom ? row - (SIZE - 7) : row
      const c = nearRight ? col - (SIZE - 7) : col
      on = r >= 0 && r <= 6 && c >= 0 && c <= 6 && finderOn(r, c)
    }

    // Mərkəzdən məsafə × 45ms + azacıq təsadüfilik: kvadratcıqlar mərkəzdən kənara doğru peyda olur.
    const distance = Math.hypot(row - CENTER, col - CENTER)
    cells.push({ on, delay: Math.round(distance * 45 + jitter) })
  }
}
---

<!-- Bəzək elementidir, ekran oxuyucudan gizlədilir. -->
<div aria-hidden="true" class="relative aspect-square w-[240px] md:w-[300px]">
  <!-- QR naxışı: 21 sütunluq tor. Dolu kvadratcıq qara, boşu şəffaf; hər birinin öz gecikməsi var. -->
  <div class="absolute inset-0 grid grid-cols-[repeat(21,1fr)] gap-[2px] p-1.5">
    {
      cells.map((cell) => (
        <i
          class={cell.on ? 'qr-cell rounded-[2px] bg-ink' : ''}
          style={cell.on ? `animation-delay: ${cell.delay}ms` : undefined}
        />
      ))
    }
  </div>

  <!--
    Dörd mavi vizör küncü (loader-dəki vizör motivi). Hər biri emblemin küncündən 14px kənardadır.
    --dx və --dy: animasiyanın başlanğıc yeri, yəni kənardan neçə piksel uzaqda başlayır.
  -->
  <span
    class="qr-corner absolute -top-3.5 -left-3.5 size-11 rounded-tl-xl border-t-[3px] border-l-[3px] border-brand [--dx:-14px] [--dy:-14px]"
  ></span>
  <span
    class="qr-corner absolute -top-3.5 -right-3.5 size-11 rounded-tr-xl border-t-[3px] border-r-[3px] border-brand [--dx:14px] [--dy:-14px]"
  ></span>
  <span
    class="qr-corner absolute -bottom-3.5 -left-3.5 size-11 rounded-bl-xl border-b-[3px] border-l-[3px] border-brand [--dx:-14px] [--dy:14px]"
  ></span>
  <span
    class="qr-corner absolute -right-3.5 -bottom-3.5 size-11 rounded-br-xl border-r-[3px] border-b-[3px] border-brand [--dx:14px] [--dy:14px]"
  ></span>

  <!-- Skan xətti: nazik mavi xətt, yumşaq parıltı. Animasiyası aşağıdakı <style> blokundadır. -->
  <span
    class="qr-scan absolute inset-x-0 top-0 h-0.5 rounded-full bg-brand shadow-[0_0_14px_3px_rgba(21,94,239,0.45)]"
  ></span>
</div>

<style>
  /*
    Animasiyaların hamısı yalnız CSS-dir. Elementlərin özündəki (bazadakı) stil son hal, yəni
    "hazır emblem"dir; animasiya onu yalnız başlanğıc haldan gətirir. Ona görə animasiya söndürüləndə
    emblem öz-özünə hazır görünür.

    Açarların adları qr-about- ilə başlayır: global.css-də otuza yaxın keyframe adı var, toqquşmasın.
  */

  /* Kvadratcıq: görünməzdən normal ölçüyə, bir az "sıçrayaraq" (cubic-bezier-in sonuncu ədədi 1-dən böyükdür). */
  .qr-cell {
    animation: qr-about-pop 0.45s cubic-bezier(0.2, 0.8, 0.3, 1.4) both;
  }

  @keyframes qr-about-pop {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Künc: 1.2s gecikmə ilə kənardan (--dx, --dy qədər uzaqdan) öz yerinə gəlir və görünür. */
  .qr-corner {
    animation: qr-about-corner 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both;
  }

  @keyframes qr-about-corner {
    from {
      transform: translate(var(--dx), var(--dy));
      opacity: 0;
    }
    to {
      transform: translate(0, 0);
      opacity: 1;
    }
  }

  /* Skan xətti: 2.1s-dən sonra başlayır, 4.5s-lik dövrlə yuxarıdan aşağı keçir, sonda sönür, təkrarlanır. */
  .qr-scan {
    animation: qr-about-scan 4.5s ease-in-out 2.1s infinite both;
  }

  @keyframes qr-about-scan {
    0% {
      top: 0;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  /* Hərəkəti azaltmaq istəyənlər üçün: animasiya yoxdur, emblem hazırdır, skan xətti gizlidir. */
  @media (prefers-reduced-motion: reduce) {
    .qr-cell,
    .qr-corner {
      animation: none;
    }

    .qr-scan {
      display: none;
    }
  }
</style>
