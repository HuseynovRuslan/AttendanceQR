---
/*
 * «Rəqəmlərlə» zolağı (#stats): real istifadə rəqəmləri, hamısı data/site.ts → STATS-dan, mətnlər ui.ts-dən.
 * Landing.astro-da «Modullar» ilə «Kimlər üçün» arasında; STATS.show false olsa və ya rəqəm boşdursa çəkilmir. Props: lang.
 */
import { useTranslations, type Lang, type UIKey } from '../../i18n/ui'
import { STATS } from '../../data/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

// Bölünməyən boşluq: dar ekranda «1 200» iki sətrə qırılmasın.
const THOUSANDS_SEPARATOR = ' '
// 10 000-dən böyük rəqəm minlərlə göstərilir: 183 450 → «183» + «min».
const THOUSAND = 1000
// Aşağı yuvarlaqlaşdırma qəsdəndir (sayt real rəqəmdən çox göstərməsin): 27 → 27, 643 → 640, 1 237 → 1 200.
const ROUNDING_TIERS = [
  { below: 100, step: 1 },
  { below: 1000, step: 10 },
  { below: 10000, step: 100 },
]
// Başlıq (0) və tarix nişanı (1) artıq çıxır, rəqəmlər 2-dən başlayır (--i).
const FIRST_STAT_RISE_INDEX = 2

interface RoundedStat {
  value: number // saytda göstərilən rəqəm (183 450 üçün 183 — minlərlə)
  inThousands: boolean // true olanda rəqəmin yanında «min» yazılır
}

// 1069 → 1000, 556 → 550, 183450 → 183 (min).
function roundStat(exact: number): RoundedStat {
  for (const tier of ROUNDING_TIERS) {
    if (exact < tier.below) {
      return { value: Math.floor(exact / tier.step) * tier.step, inThousands: false }
    }
  }
  return { value: Math.floor(exact / THOUSAND), inThousands: true }
}

// 1200 → «1 200». Skriptdəki formatNumber ilə eyni olmalıdır, yoxsa rəqəm sayma bitəndə «tullanır».
function formatNumber(value: number): string {
  return value.toLocaleString('en-US').replaceAll(',', THOUSANDS_SEPARATOR)
}

// '2026-10-13' → «Oktyabr 2026» / «Октябрь 2026» / «October 2026».
// Intl rusca «октябрь 2026 г.» verir, ona görə ay və ili ayrıca götürüb ilk hərfi böyüdürük.
// timeZone: 'UTC' saat qurşağından asılılığı aradan qaldırır; toLocaleUpperCase(lang) az dilində «iyun» → «İyun» verir.
function formatMonthYear(isoDate: string, language: Lang): string {
  const formatter = new Intl.DateTimeFormat(language, { month: 'long', year: 'numeric', timeZone: 'UTC' })
  let month = ''
  let year = ''
  for (const part of formatter.formatToParts(new Date(isoDate))) {
    if (part.type === 'month') month = part.value
    if (part.type === 'year') year = part.value
  }
  return `${month.charAt(0).toLocaleUpperCase(language)}${month.slice(1)} ${year}`
}

// exact — STATS-dakı rəqəm, name — ekran oxuyucu üçün ad, caption — görünən izah (ui.ts açarları).
interface StatSource {
  exact: number | null
  name: UIKey
  caption: UIKey
}
const sources: StatSource[] = [
  { exact: STATS.companies, name: 'stats.n1', caption: 'stats.s1' },
  { exact: STATS.employees, name: 'stats.n2', caption: 'stats.s2' },
  { exact: STATS.locations, name: 'stats.n3', caption: 'stats.s3' },
  { exact: STATS.dailyCheckins, name: 'stats.n4', caption: 'stats.s4' },
]

// Rəqəmlərdən biri boşdursa (null və ya 0), STATS.show true olsa da zolaq çəkilmir.
const hasAllNumbers = sources.every((source) => source.exact !== null && source.exact > 0)

// value — sayğacın hədəfi, text — ilkin yazı (JS işləməsə də görünür), suffix — solğun «+» və ya «min+».
const stats = sources.map((source) => {
  const rounded = roundStat(source.exact ?? 0)
  const unit = rounded.inThousands ? t('stats.thousand') : ''
  return {
    name: source.name,
    caption: source.caption,
    value: rounded.value,
    text: formatNumber(rounded.value),
    suffix: `${unit}+`,
  }
})

// Nişandakı ay və il: rəqəmlərin götürüldüyü gün (STATS.updatedAt).
const updatedLabel = formatMonthYear(STATS.updatedAt, lang)
---

{
  hasAllNumbers && (
    <section
      id="stats"
      aria-labelledby="stats-title"
      class="relative overflow-hidden bg-brand py-20 text-white lg:py-24"
      data-stats
      data-surface="brand"
    >
      
      <div class="stats-glow" aria-hidden="true" />
      <div class="stats-dots" aria-hidden="true" />

      
      <div class="wrap relative leading-normal">
        
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          
          <div class="st-rise" style="--i:0">
            <p class="inline-flex items-center gap-3 text-[12px] font-bold tracking-[0.2em] text-white/80 uppercase">
              <span class="h-px w-8 bg-white/70" aria-hidden="true" />
              {t('stats.title')}
            </p>
            <h2
              id="stats-title"
              class="mt-5 max-w-[18ch] text-[32px] leading-[1.1] font-semibold tracking-tight sm:text-[40px] lg:max-w-none lg:whitespace-nowrap"
            >
              {t('stats.sub')}
            </h2>
          </div>

          
          <p
            class="st-rise inline-flex items-center gap-2.5 self-start rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-[13px] text-white/85 backdrop-blur-sm lg:self-auto"
            style="--i:1"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="stats-live-ring absolute inset-0 rounded-full bg-[#6EE7B7]" />
              <span class="relative h-2 w-2 rounded-full bg-[#34D399]" />
            </span>
            {t('stats.source')} · {updatedLabel}
          </p>
        </div>

        
        <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 lg:mt-16 lg:grid-cols-4 lg:gap-0">
          {stats.map((stat, index) => (
            <div
              class="st-rise lg:border-l lg:border-white/20 lg:px-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0"
              style={`--i:${FIRST_STAT_RISE_INDEX + index}`}
            >
              {/* sr-only: yalnız ekran oxuyucu üçün qısa ad. */}
              <dt class="sr-only">{t(stat.name)}</dt>

              {/* Rəqəm bölünməsin (nowrap), saymada titrəməsin (tabular-nums). data-stat-count — sayğacın hədəfi. */}
              <dd class="text-[32px] leading-none font-semibold tracking-[-0.03em] whitespace-nowrap tabular-nums min-[380px]:text-[38px] sm:text-[52px] lg:text-[48px] xl:text-[60px]">
                <span class="flex items-baseline">
                  <span data-stat-count={stat.value}>{stat.text}</span>
                  <span class="text-white/70">{stat.suffix}</span>
                </span>
                {/* Xətt <dd>-nin içindədir: <dl> içindəki <div>-də yalnız <dt> və <dd> ola bilər. */}
                <span class="st-line mt-5 block h-px w-12 bg-white/60" aria-hidden="true" />
              </dd>

              {/* İzah: mobildə 22 simvolluq enə qədər bölünür, lg-dən bir sətirdir (mətnlər buna görə qısadır). */}
              <dd class="mt-4 max-w-[22ch] text-[15px] leading-snug text-white/80 lg:max-w-none lg:whitespace-nowrap">
                {t(stat.caption)}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  /* Ad prefiksləri stats- / st-: @keyframes adı Astro-da scope olunmur. */

  /* 1) Arxa fonda nöqtə şəbəkəsi: sağda görünür, sola doğru itir. */
  .stats-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1.2px, transparent 1.3px);
    background-size: 16px 16px;
    -webkit-mask-image: radial-gradient(70% 90% at 85% 40%, #000 0%, transparent 70%);
    mask-image: radial-gradient(70% 90% at 85% 40%, #000 0%, transparent 70%);
  }

  /* Yuxarı-sağda işıq, aşağı-solda tünd keçid. */
  .stats-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(45% 70% at 90% 0%, rgba(255, 255, 255, 0.18), transparent 70%),
      radial-gradient(50% 80% at 0% 100%, rgba(8, 32, 110, 0.45), transparent 70%);
  }

  /* 2) «Canlı» nöqtəsi: halqa böyüyüb itir. */
  .stats-live-ring {
    animation: stats-live-ring 2s ease-out infinite;
  }

  @keyframes stats-live-ring {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* 3) Giriş animasiyası. Gizli başlanğıc yalnız [data-anim] altındadır: atribut skriptlə yazılır,
     ona görə JS söndürülübsə hər şey görünür. `--i` — sıra nömrəsi, hər element 90ms gec. */
  [data-anim] .st-rise {
    opacity: 0;
  }

  [data-anim].is-live .st-rise {
    animation: st-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  @keyframes st-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Xətt sayma ilə birlikdə soldan dolur. */
  .st-line {
    transform-origin: left;
  }

  [data-anim] .st-line {
    transform: scaleX(0);
  }

  [data-anim].is-live .st-line {
    transform: scaleX(1);
    transition: transform 1.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 90ms + 150ms);
  }

  /* 4) Hərəkəti azalt. */
  @media (prefers-reduced-motion: reduce) {
    .stats-live-ring {
      animation: none;
    }

    [data-anim] .st-rise {
      opacity: 1;
      animation: none !important;
    }

    [data-anim] .st-line {
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // ---------- Sabitlər ----------
  // Bölmənin neçə hissəsi ekranda olanda animasiya və sayma başlasın (0.3 = 30%).
  const LIVE_THRESHOLD = 0.3
  // Hər rəqəm 0-dan son dəyərinə qədər bu qədər saniyə sayılır.
  const COUNT_DURATION_MS = 1400
  // Sayma bölmə görünəndən 0.2 saniyə sonra başlayır (o vaxt rəqəmin yazısı artıq görünməyə başlayır); hər növbəti rəqəm 90ms gec.
  const FIRST_COUNT_DELAY_MS = 200
  const COUNT_STAGGER_MS = 90
  // Minliklərin ayırıcısı: bölünməyən boşluq (frontmatter-dəki ilə eyni).
  const THOUSANDS_SEPARATOR = ' '

  // Əvvəl sürətli, sonda yavaşlayan hərəkət (ease-out): progress 0…1 → nəticə 0…1.
  function easeOutCubic(progress: number): number {
    return 1 - Math.pow(1 - progress, 3)
  }

  // 1200 → «1 200». Frontmatter-dəki formatNumber ilə eyni qayda: sayma bitəndə rəqəm «tullanmasın».
  function formatNumber(value: number): string {
    return value.toLocaleString('en-US').replaceAll(',', THOUSANDS_SEPARATOR)
  }

  // Rəqəmi 0-dan data-stat-count dəyərinə qədər sayır. requestAnimationFrame funksiyanı ekranın növbəti yenilənməsində
  // çağırır — hamar animasiya üçün. https://developer.mozilla.org/en-US/docs/Web/API/Window/requestAnimationFrame
  function countUp(counter: HTMLElement, delayMs: number): void {
    const target = Number(counter.dataset.statCount)
    setTimeout(function () {
      const startTime = performance.now()
      function drawFrame(now: number): void {
        const progress = Math.min((now - startTime) / COUNT_DURATION_MS, 1)
        counter.textContent = formatNumber(Math.round(target * easeOutCubic(progress)))
        if (progress < 1) {
          requestAnimationFrame(drawFrame)
        }
      }
      requestAnimationFrame(drawFrame)
    }, delayMs)
  }

  // Bölmə ekrana ilk dəfə kifayət qədər girəndə `is-live` sinfini verir, rəqəmləri saymağa başlayır və izləməni DAYANDIRIR:
  // hamısı bir dəfə olur. https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
  function startWhenVisible(section: HTMLElement): void {
    const observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting) {
          return
        }
        section.classList.add('is-live')
        const counters = section.querySelectorAll<HTMLElement>('[data-stat-count]')
        counters.forEach(function (counter, index) {
          countUp(counter, FIRST_COUNT_DELAY_MS + index * COUNT_STAGGER_MS)
        })
        observer.disconnect()
      },
      { threshold: LIVE_THRESHOLD }
    )
    observer.observe(section)
  }

  function initStats(): void {
    // Bölmə səhifədə olmaya bilər (STATS.show: false), onda heç nə etmirik.
    const section = document.querySelector<HTMLElement>('[data-stats]')
    if (!section) {
      return
    }

    // «Hərəkəti azalt» seçilibsə və ya brauzer IntersectionObserver-i bilmirsə: `data-anim` yazılmır, sayma olmur —
    // son rəqəmlər artıq HTML-dədir. https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
    const isMotionReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (isMotionReduced || !('IntersectionObserver' in window)) {
      return
    }

    section.dataset.anim = 'on'
    startWhenVisible(section)
  }

  initStats()
</script>
