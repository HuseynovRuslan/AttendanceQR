---
/**
 * Google-un rəsmi "Google Play" nişanı — Android tətbiqinə link.
 * Harada: Pwa.astro (mərkəzdə, 48px) və Footer.astro (sola düzülmüş, 40px).
 * Props: lang, height (qara nişanın görünən hündürlüyü), align ('start' | 'center'), class.
 * Necə işləyir: dilə görə PNG seçilir, sonra şəkil elə ölçülür ki, içindəki qara nişan düz
 * `height` px görünsün — faylın şəffaf kənarları isə olduğu kimi qalsın.
 */
import { Image } from 'astro:assets'
import { useTranslations, type Lang } from '../i18n/ui'
import { SITE } from '../data/site'
// Fayllar play.google.com/intl/en_us/badges/-dən olduğu kimi götürülüb (2026-09): nə kəsilib, nə
// rəngi dəyişib — Google-un qaydası budur.
import googlePlayEn from '../assets/images/badges/google-play-en.png'
import googlePlayRu from '../assets/images/badges/google-play-ru.png'

interface Props {
  lang: Lang
  /** Qara nişanın ÖZÜNÜN görünən hündürlüyü, px (şəffaf boşluq daxil deyil). Verilməsə — 48. */
  height?: number
  /**
   * 'start' — sol kənarı mətnlə bir xəttə düşsün deyə faylın sol şəffaf boşluğu mənfi margin ilə
   * kompensasiya olunur (fayl kəsilmir). 'center' — mərkəzdə, boşluq iki tərəfdə bərabərdir.
   */
  align?: 'start' | 'center'
  class?: string
}

const { lang, height = 48, align = 'center', class: className } = Astro.props
const t = useTranslations(lang)

// Hər iki PNG 646×250-dir, amma içindəki qara nişan fərqli yer tutur: ingiliscədə ətrafda şəffaf
// boşluq var (Google-un tələb etdiyi "clear space"), rusca faylda demək olar yoxdur. Rəqəmlər
// piksellərin alfa kanalından ölçülüb — fayl dəyişsə, onları da yenidən ölç.
const EN_BADGE = {
  file: googlePlayEn,
  leftGapInFile: 41, // qara nişanın faylın sol kənarından məsafəsi, px
  heightInFile: 168, // qara nişanın öz hündürlüyü, px
}
const RU_BADGE = {
  file: googlePlayRu,
  leftGapInFile: 0, // rusca faylda qara nişan düz sol kənardan başlayır — sol boşluq yoxdur
  heightInFile: 192, // qara nişanın öz hündürlüyü, px
}

// AZ və EN ingiliscə nişanı işlədir. Google-un azərbaycanca nişanı da var, amma o hələ köhnə Play
// loqosu ilə çəkilib; rusca nişan isə yenidir.
let badge = EN_BADGE
if (lang === 'ru') {
  badge = RU_BADGE
}

// Ölçü hesabı: qara nişanın istədiyimiz hündürlüyündən bütöv şəklin ölçüsünə keçirik. Belə olanda
// iki dildə nişan eyni boyda görünür, halbuki fayllardakı şəffaf boşluq fərqlidir.
const fileHeight = badge.file.height
// 1) Şəkil nə qədər hündür olmalıdır ki, içindəki qara nişan düz `height` px görünsün.
const imageHeight = Math.round((height * fileHeight) / badge.heightInFile)
// 2) En də eyni nisbətdə dəyişir — şəkil dartılmasın.
const imageWidth = Math.round((imageHeight * badge.file.width) / fileHeight)
// 3) Yalnız align="start": sol şəffaf boşluq ekranda neçə px tutursa, linki o qədər sola çəkirik.
let leftShift = 0
if (align === 'start') {
  leftShift = Math.round((badge.leftGapInFile / fileHeight) * imageHeight)
}
// Aşağıda <Image>-ə verilən densities={[1, 2]}: Astro bu ölçüdə adi və iki qat böyük (retina
// ekran üçün) şəkil yaradır, brauzer ekrana uyğun olanı seçir.
---

<a
  class:list={['gplay', className]}
  href={SITE.playStore}
  target="_blank"
  rel="noopener noreferrer"
  style={leftShift ? `margin-left:-${leftShift}px` : undefined}
>
  <Image src={badge.file} alt={t('gplay.alt')} width={imageWidth} height={imageHeight} densities={[1, 2]} />
</a>

<style>
  .gplay {
    display: inline-block;
    line-height: 0;
    /* Linkin fonu və çərçivəsi yoxdur, ona görə bu radius yalnız fokus halqasında (outline) və
       mobil toxunuş işığında (tap highlight) görünür. */
    border-radius: 12px;
  }

  .gplay img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .gplay:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
</style>
