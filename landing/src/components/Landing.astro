---
import type { Lang } from '../i18n/ui'
import { PRICING, STATS } from '../data/site'
import Hero from './Hero/Hero.astro'
import Trust from './Trust/Trust.astro'
import Problem from './Problem/Problem.astro'
import HowItWorks from './HowItWorks/HowItWorks.astro'
import Modules from './Modules/Modules.astro'
import Stats from './Stats/Stats.astro'
import AdminPanel from './AdminPanel/AdminPanel.astro'
import AntiFraud from './AntiFraud/AntiFraud.astro'
import Audience from './Audience/Audience.astro'
import Security from './Security/Security.astro'
import Testimonials from './Testimonials/Testimonials.astro'
import Pricing from './Pricing/Pricing.astro'
import FAQ from './FAQ/FAQ.astro'
import Pwa from './Pwa/Pwa.astro'

const { lang } = Astro.props as { lang: Lang }
---

<Hero lang={lang} />
<Trust lang={lang} />
<Problem lang={lang} />
<HowItWorks lang={lang} />
<AdminPanel lang={lang} />
<AntiFraud lang={lang} />
<Modules lang={lang} />
{STATS.show && <Stats lang={lang} />}
<Audience lang={lang} />
<Security lang={lang} />
<Testimonials lang={lang} />
{PRICING.enabled && <Pricing lang={lang} />}
<Pwa lang={lang} />
<FAQ lang={lang} />
