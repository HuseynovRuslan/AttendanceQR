---
/**
 * Üzən başlıq: loqo, bölmə linkləri, dil seçimi, "Daxil ol" və "Əlaqə saxlayın"; dar ekranda mobil menyu.
 * BaseLayout hər səhifəyə qoyur. Props: lang — səhifənin dili; path — dil prefiksi olmadan cari ünvan.
 * Script menyuları açıb-bağlayır, aşağı sürüşəndə şəffaf zolağı şüşə qapsula çevirir.
 */
import { AZ, RU, US } from "country-flag-icons/string/3x2";
import {
  useTranslations,
  localizedPath,
  availableLangs,
  type Lang,
} from "../../i18n/ui";
import { SITE, PRICING } from "../../data/site";
import { getImage } from "astro:assets";
import { LOGO_WORD } from "../../data/brand";

// Loqo yazısının yeganə variantı: BaseLayout onu preload edir, hero posteri də eyni faylı işlədir (src/data/brand.ts).
const logoWord = await getImage(LOGO_WORD);

interface Props {
  lang: Lang;
  /** Dil prefiksi olmadan cari ünvan: dil seçimi və aria-current üçün. */
  path?: string;
}
const { lang, path = "/" } = Astro.props;
const t = useTranslations(lang);

// Dil seçimi yalnız səhifənin həqiqətən build olunduğu dilləri təklif edir; tək dilli səhifədə (məs. 404) görünmür.
const routeLangs = availableLangs(path);
const otherLangs = routeLangs.filter((routeLang) => routeLang !== lang);

// Hər dil öz dilində adlanır; bayraqlar inline SVG sətirləridir. İngilis dili ABŞ bayrağını alır: sayt
// başqa yerlərdə en-US elan edir (htmlLang, og:locale, sitemap).
// Record<Lang, ...> yeni dil əlavə edilib burada unudulsa tip xətası verir.
const langMeta: Record<Lang, { name: string; flag: string }> = {
  az: { name: "Azərbaycan", flag: AZ },
  ru: { name: "Русский", flag: RU },
  en: { name: "English", flag: US },
};

// Bölmə linkləri tam ünvandır (ana səhifə + #hash), ona görə header /elaqe/ və /blog/-da da işləyir.
// `isVisible: false` link menyuya düşmür: «Qiymət» yalnız site.ts → PRICING.enabled olanda var (Footer-də eyni).
// `page` — ayrıca səhifəyə link üçündür, açıq səhifənin linki aria-current="page" alır (hazırda yalnız «Bloq»).
// "Əlaqə" linki yoxdur: "Əlaqə saxlayın" düyməsi eyni yerə aparır (Footer-də qalır).
interface NavLink {
  href: string;
  label: string;
  isVisible: boolean;
  page?: string;
}
const home = localizedPath(lang, "/");
const allLinks: NavLink[] = [
  { href: `${home}#how`, label: t("nav.how"), isVisible: true },
  { href: `${home}#modules`, label: t("nav.modules"), isVisible: true },
  { href: `${home}#pricing`, label: t("nav.pricing"), isVisible: PRICING.enabled },
  { href: `${home}#faq`, label: t("nav.faq"), isVisible: true },
  { href: localizedPath(lang, "/blog/"), label: t("nav.blog"), isVisible: true, page: "/blog/" },
];
const links = allLinks.filter((link) => link.isVisible);

// İşçilərin daxil olduğu tətbiq — bütün şirkətlər üçün eyni ünvan.
const appUrl = "https://app.qrlog.az";
const contactHref = localizedPath(lang, "/elaqe/");

// Ortaq sinif sətirləri. Tailwind Preflight yoxdur (styles/tailwind.css), ona görə <button> və <ul>
// brauzer stilini özü sıfırlayır. Neytral rənglər `stone`-dur (saytın boz tonları istidir, slate
// bənövşəyi görünür); `brand` — loqodakı göy (#155EEF).
const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";
// "Daxil ol": ağ fonlu, mavi çərçivəli düymə; hover-də `brand` ilə dolur. Hündürlük (h-11) "Əlaqə saxlayın"
// ilə eyni olmalıdır; görünmə və padding çağırılan yerdə verilir (masaüstü və mobil fərqlidir).
const buttonLogin = `items-center justify-center gap-2 whitespace-nowrap h-11 rounded-xl! border border-[#155EEF] bg-white text-[15px] font-semibold text-[#155EEF] transition-colors duration-500 hover:border-brand hover:bg-brand hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#155EEF]`;
const linkHover = "hover:bg-brand-50 hover:text-brand focus-visible:bg-brand-50";
// "Əlaqə saxlayın": tünd əsas düymə, ölçüsü "Daxil ol" ilə eyni. Haşiyə və kölgə qəsdən yoxdur: düymə grid-də
// eni 0-a yığılır, onlar yığılanda kəsilib qalardı.
// Hero-dakı eyni düymə görünərkən bu düymə gizlənir (setupHeaderCta → `data-cta-hidden`). Grid: `width: auto`
// animasiya olunmur, `1fr → 0fr` olunur. Padding içdəki <span>-dadır: düymədə olsaydı, gizli halda da yer tutardı.
// Düymələr sığmayanda mobil menyuya keçir: "Əlaqə saxlayın" 540px-dən, "Daxil ol" `sm`-dən dar ekranda
// (menyudakı nüsxələr güzgü breakpoint-lərlədir).
const buttonPrimary = `items-center justify-center whitespace-nowrap h-11 rounded-xl! bg-stone-900 text-[15px] font-semibold text-white transition-colors duration-500 hover:bg-stone-700 active:scale-[0.98] ${focusRing}`;
// Əlaqə düyməsinin oxu (Lucide "arrow-right").
const arrowIcon = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
const flagBox =
  "block h-3.5 w-[21px] shrink-0 overflow-hidden rounded-[3px] ring-1 ring-stone-900/10 [&>svg]:block [&>svg]:size-full";

// Header fixed-dir və yer tutmur: global.css .hero hündürlüyü --header-h ilə geri verir.
// ---- Zolağın şəffaf → şüşə qapsul animasiyası ----
// Skript aşağı sürüşəndə `data-scrolled` qoyur (barGlass + barNarrow); mobil menyu açıqda (`data-open`)
// də şüşə fon lazımdır. Tailwind yalnız tam yazılmış sinif adlarını tapır, ona görə hər sinif iki variantla yazılıb.
// backdrop-saturate yalnız şüşə halında: şəffaf zolaqda hero fonunun rəngi ayrıca lent kimi seçilərdi.
const barFlat =
  "border-transparent bg-transparent shadow-none backdrop-blur-[0px] backdrop-saturate-100";
const barGlass =
  "data-scrolled:border-stone-200/60 data-open:border-stone-200/60 data-scrolled:bg-white/90 data-open:bg-white/90 data-scrolled:shadow-md data-open:shadow-md data-scrolled:shadow-stone-900/5 data-open:shadow-stone-900/5 data-scrolled:backdrop-blur-xl data-open:backdrop-blur-xl data-scrolled:backdrop-saturate-150 data-open:backdrop-saturate-150";
// Hər tərəfdən 32px daralır (yalnız `sm`-dən yuxarı). En və max-en birlikdə dəyişir: dar ekranda
// max-en, geniş ekranda en işləmir.
const barNarrow =
  "sm:data-scrolled:w-[calc(100%-4rem)] sm:data-scrolled:max-w-[calc(var(--maxw)-96px)]";
// Zolaq içindəki sətrin kənar boşluğu: düz halda loqo hero başlığı ilə eyni xətdə durmalıdır
// (global.css .wrap: yan boşluq `lg`-dən yuxarı 32px, aşağı 22px). Qapsulda və açıq menyuda hər yerdə 16/12px.
const rowEdge =
  "pl-1.5 pr-1.5 lg:pl-4 lg:pr-3 group-data-scrolled/header:pl-4 group-data-scrolled/header:pr-3 group-data-open/header:pl-4 group-data-open/header:pr-3 transition-[padding] duration-400 ease-[cubic-bezier(0.22,0.61,0.36,1)]";
// Müddət və əyri saytın başqa bölmələri ilə eynidir.
const barMotion =
  "transition-[width,max-width,background-color,border-color,box-shadow,backdrop-filter] duration-400 ease-[cubic-bezier(0.22,0.61,0.36,1)]";
---

<header
  data-header
  class="pointer-events-none fixed inset-x-0 top-0 z-50 p-3 sm:p-4"
>
  <div
    data-header-bar
    class={`group/header pointer-events-auto relative mx-auto w-full max-w-[calc(var(--maxw)-32px)] rounded-2xl border ${barFlat} ${barGlass} ${barNarrow} ${barMotion}`}
  >
    <div class={`flex h-16 items-center gap-3 lg:gap-8 ${rowEdge}`}>
      <a class={`shrink-0 rounded-md ${focusRing}`} href={home} aria-label={SITE.name} data-header-item>
        <img
          class="h-6.5 w-auto sm:h-7"
          src={logoWord.src}
          alt={SITE.name}
          width={LOGO_WORD.width}
          height={LOGO_WORD.height}
        />
      </a>

      <nav class="hidden lg:block" aria-label={t("a11y.nav")}>
        <ul class="flex list-none items-center gap-1">
          {
            links.map((link) => (
              <li data-header-item>
                <a
                  class={`inline-flex h-10 items-center rounded-full px-3 text-[14.5px] font-medium text-stone-600 transition-colors duration-200 ${linkHover} aria-[current=page]:text-brand ${focusRing}`}
                  href={link.href}
                  aria-current={link.page === path ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1 sm:gap-2">
        {
          otherLangs.length > 0 && (
            <div class="group/lang relative" data-lang data-header-item>
              <button
                type="button"
                class={`flex h-10 cursor-pointer items-center gap-2 rounded-full border-0 bg-transparent px-3 text-sm font-semibold text-stone-700 transition-colors duration-200 ${linkHover} group-data-open/lang:bg-brand-50 group-data-open/lang:text-brand ${focusRing}`}
                aria-expanded="false"
                aria-controls="lang-menu"
                aria-label={`${t("a11y.lang")}: ${lang.toUpperCase()} (${langMeta[lang].name})`}
                data-lang-trigger
              >
                <span class={flagBox} aria-hidden="true" set:html={langMeta[lang].flag} />
                <span aria-hidden="true">{lang.toUpperCase()}</span>
                <svg
                  class="size-3.5 text-stone-500 transition-transform duration-200 group-data-open/lang:rotate-180"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 7.5 5 5 5-5" />
                </svg>
              </button>

              {/* `visibility` yalnız bağlananda keçiddədir (sönmə görünsün); açılanda menyu dərhal görünür ki, ↓ fokusu içəri keçirə bilsin. */}
              <ul
                id="lang-menu"
                class="invisible absolute right-0 top-full z-10 mt-5 min-w-48 origin-top-right -translate-y-1 scale-95 list-none rounded-xl border border-stone-200/70 bg-white p-1.5 opacity-0 shadow-lg shadow-stone-900/10 transition-[opacity,translate,scale,visibility] duration-150 ease-out group-data-open/lang:visible group-data-open/lang:translate-y-0 group-data-open/lang:scale-100 group-data-open/lang:opacity-100 group-data-open/lang:transition-[opacity,translate,scale]"
                data-lang-menu
              >
                {otherLangs.map((otherLang) => (
                  <li>
                    <a
                      class={`flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-stone-700 transition-colors duration-150 hover:bg-brand-50 hover:text-brand focus-visible:bg-brand-50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand`}
                      href={localizedPath(otherLang, path)}
                      hreflang={otherLang}
                      lang={otherLang}
                    >
                      <span class={flagBox} aria-hidden="true" set:html={langMeta[otherLang].flag} />
                      <span class="flex-1 font-medium">{langMeta[otherLang].name}</span>
                      <span
                        class="text-xs font-semibold tracking-wide text-stone-500"
                        aria-hidden="true"
                      >
                        {otherLang.toUpperCase()}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <a class={`${buttonLogin} hidden px-5 sm:inline-flex`} href={appUrl} data-header-item>
          {/* Lucide "log-in" */}
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 3h3a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3h-3" />
            <path d="M10 17l5-5-5-5M15 12H3" />
          </svg>
          {t("cta.login")}
        </a>
        <div
          class="hidden min-[540px]:grid grid-cols-[1fr] transition-[grid-template-columns,opacity] duration-450 ease-out group-data-cta-hidden/header:pointer-events-none group-data-cta-hidden/header:grid-cols-[0fr] group-data-cta-hidden/header:opacity-0"
        >
          <a
            class={`${buttonPrimary} inline-flex min-w-0 overflow-hidden whitespace-nowrap`}
            href={contactHref}
            data-header-cta
            data-header-item
          >
            {/* Padding düymədə yox, burada (bax: buttonPrimary üstündəki qeyd). */}
            <span class="inline-flex h-full shrink-0 items-center gap-2 px-5">
              {t("cta.btn1")}
              <Fragment set:html={arrowIcon} />
            </span>
          </a>
        </div>

        <button
          type="button"
          class={`group/burger relative flex size-10 cursor-pointer items-center justify-center rounded border-0 bg-transparent text-stone-800 transition-colors duration-200 hover:bg-stone-100 lg:hidden ${focusRing}`}
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t("nav.menu")}
          data-menu-trigger
          data-header-item
        >
          <span
            class="absolute h-0.5 w-5 -translate-y-1.5 rounded-full bg-current transition duration-300 group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:rotate-45"
            aria-hidden="true"></span>
          <span
            class="absolute h-0.5 w-5 rounded-full bg-current transition duration-200 group-aria-expanded/burger:scale-x-0 group-aria-expanded/burger:opacity-0"
            aria-hidden="true"></span>
          <span
            class="absolute h-0.5 w-5 translate-y-1.5 rounded-full bg-current transition duration-300 group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:-rotate-45"
            aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="invisible grid grid-rows-[0fr] transition-[grid-template-rows,visibility] duration-300 ease-out group-data-open/header:visible group-data-open/header:grid-rows-[1fr] lg:hidden"
      data-menu
    >
      <div class="min-h-0 overflow-hidden">
        <div
          class="mx-2 max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain border-t border-stone-200/70 pb-3 pt-2"
          data-lenis-prevent
        >
          <nav aria-label={t("a11y.nav")}>
            <ul class="list-none">
              {
                links.map((link) => (
                  <li>
                    <a
                      class="block rounded-xl px-2 py-3 text-[15px] font-medium text-stone-700 transition-colors duration-200 hover:bg-brand-50 hover:text-brand focus-visible:bg-brand-50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand aria-[current=page]:text-brand"
                      href={link.href}
                      aria-current={link.page === path ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="mt-2 grid gap-2 border-t border-stone-200/70 pt-3 sm:hidden">
            <a
              class={`${buttonLogin} flex px-5`}
              href={appUrl}
            >
              {/* Lucide "log-in" */}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 3h3a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3h-3" />
                <path d="M10 17l5-5-5-5M15 12H3" />
              </svg>
              {t("cta.login")}
            </a>
            <a
              class={`${buttonPrimary} flex gap-2 px-5 min-[540px]:hidden`}
              href={contactHref}
            >
              {t("cta.btn1")}
              <Fragment set:html={arrowIcon} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { gsap, ScrollTrigger } from "../../scripts/motion/gsap";
  import { CLEARED_PROPS, hasMotion, pageRevealed } from "../../scripts/motion/shared";

  // Header davranışı: dil menyusu, mobil menyu, onların bağlanması və sürüşəndə şüşə qapsul.
  // Hər hissə öz setup...() funksiyasındadır.

  // Bu qədər (px) aşağı sürüşəndən sonra şəffaf zolaq şüşə qapsula çevrilir (data-scrolled).
  const SCROLLED_AFTER_PX = 8;
  // Tailwind-in `lg` sərhədi: bu enlikdən burger düyməsi və mobil menyu gizlənir (lg:hidden).
  const DESKTOP_MEDIA_QUERY = "(min-width: 1024px)";
  // Header hündürlüyü global.css-dəki --header-h-dən oxunur (90px, 640px-dən geniş ekranda 98px); oxunmasa bu ehtiyat dəyər.
  const FALLBACK_HEADER_HEIGHT_PX = 90;

  // ---------- Page-load intro ----------
  const INTRO_SHIFT_PERCENT = -130;
  const INTRO_DURATION = 0.9;
  const ITEMS_START = 0.25;
  const ITEMS_SHIFT = -12;
  const ITEMS_DURATION = 0.6;
  const ITEMS_STAGGER = 0.04;

  // ---------- Smart header ----------
  const HIDE_AFTER_PX = 120;
  const HIDE_SHIFT_PERCENT = -120;
  const HIDE_DURATION = 0.4;

  const header = document.querySelector<HTMLElement>("[data-header]");
  const bar = document.querySelector<HTMLElement>("[data-header-bar]");

  if (header && bar) {
    const menuButton = bar.querySelector<HTMLButtonElement>("[data-menu-trigger]");
    const mobileMenu = bar.querySelector<HTMLElement>("[data-menu]");
    const langDropdown = bar.querySelector<HTMLElement>("[data-lang]");
    const langButton = langDropdown?.querySelector<HTMLButtonElement>("[data-lang-trigger]");
    const langLinks = langDropdown
      ? Array.from(langDropdown.querySelectorAll<HTMLAnchorElement>("[data-lang-menu] a"))
      : [];

    // ---------- Vəziyyət ----------
    // Panellərin açıq/bağlı vəziyyəti yalnız atributlardadır (`data-open` görünüşü, aria-expanded ekran
    // oxuyucunu idarə edir); onları əl ilə dəyişmə, setLangDropdownOpen() və setMobileMenuOpen() ikisini yeniləyir.
    let isScrolled = false; // `data-scrolled`-in kopyası

    // ---------- Panelləri açıb-bağlamaq ----------
    const isMobileMenuOpen = () => bar.hasAttribute("data-open");

    const isLangDropdownOpen = () => {
      if (!langDropdown) return false;
      return langDropdown.hasAttribute("data-open");
    };

    // Eyni anda yalnız bir panel açıq ola bilər, ona görə açılan panel o birini bağlayır.
    const setLangDropdownOpen = (open: boolean) => {
      if (!langDropdown || !langButton) return;
      langDropdown.toggleAttribute("data-open", open);
      langButton.setAttribute("aria-expanded", String(open));
      if (open) {
        setMobileMenuOpen(false);
      }
    };

    const setMobileMenuOpen = (open: boolean) => {
      if (!menuButton) return;
      bar.toggleAttribute("data-open", open);
      menuButton.setAttribute("aria-expanded", String(open));
      if (open) {
        setLangDropdownOpen(false);
      }
    };

    // ---------- Dil menyusu ----------
    // Dil düyməsində ↓ və ya ↑: menyunu açır və fokusu birinci (↓) və ya sonuncu (↑) dilə keçirir.
    const openLangDropdownFromKeyboard = (event: KeyboardEvent) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault(); // ox düyməsi səhifəni sürüşdürməsin
      setLangDropdownOpen(true);
      const targetIndex = event.key === "ArrowDown" ? 0 : langLinks.length - 1;
      langLinks[targetIndex]?.focus();
    };

    // Basılan düyməyə görə fokusun keçəcəyi dilin indeksini qaytarır.
    // -1 qaytarırsa, bu düymə siyahıda gəzmək üçün deyil.
    const findNextLangIndex = (key: string, currentIndex: number) => {
      const linkCount = langLinks.length;
      if (key === "ArrowDown") {
        return (currentIndex + 1) % linkCount; // sonuncudan sonra yenidən birinciyə
      }
      if (key === "ArrowUp") {
        return (currentIndex - 1 + linkCount) % linkCount; // birincidən əvvəl sonuncuya
      }
      if (key === "Home") {
        return 0;
      }
      if (key === "End") {
        return linkCount - 1;
      }
      return -1;
    };

    // Fokus siyahıdadırsa ↓ ↑ Home End dillər arasında gəzdirir. event.target işlədilir, activeElement yox:
    // düymədəki ↓ fokusu artıq birinci dilə keçirib, activeElement-i oxusaq fokus ikinci dəfə sürüşərdi.
    const moveFocusInLangDropdown = (event: KeyboardEvent) => {
      const currentIndex = langLinks.indexOf(event.target as HTMLAnchorElement);
      if (currentIndex < 0) return;
      const nextIndex = findNextLangIndex(event.key, currentIndex);
      if (nextIndex < 0) return;
      event.preventDefault();
      langLinks[nextIndex].focus();
    };

    const setupLanguageMenu = () => {
      langButton?.addEventListener("click", () => setLangDropdownOpen(!isLangDropdownOpen()));
      langButton?.addEventListener("keydown", openLangDropdownFromKeyboard);
      langDropdown?.addEventListener("keydown", moveFocusInLangDropdown);
    };

    // ---------- Mobil menyu ----------
    const setupMobileMenu = () => {
      menuButton?.addEventListener("click", () => setMobileMenuOpen(!isMobileMenuOpen()));

      // Ana səhifədə bölmə linki (#how və s.) yeni səhifə yükləmir, ona görə menyu özü bağlanmalıdır.
      if (mobileMenu) {
        for (const link of mobileMenu.querySelectorAll("a")) {
          link.addEventListener("click", () => setMobileMenuOpen(false));
        }
      }

      // `lg`-dən genişləndirəndə burger gizlənir; açıq qalmış menyu daralanda yenidən görünməsin deyə bağlanır.
      window.matchMedia(DESKTOP_MEDIA_QUERY).addEventListener("change", (event) => {
        if (event.matches) setMobileMenuOpen(false);
      });
    };

    // ---------- Ortaq bağlanma: fokus, kənara klik, Escape, "Geri" düyməsi ----------
    // Fokus zolaqdan çıxanda açıq panel bağlanır. relatedTarget null olanda bağlamırıq: Safari klikdə linkə
    // fokus vermir, bağlasaq kliklənən element altdan çəkilərdi (kənara klik ayrıca tutulur).
    const closePanelsWhenFocusLeaves = (event: FocusEvent) => {
      const newFocus = event.relatedTarget as Node | null;
      if (!newFocus || bar.contains(newFocus)) return;
      setLangDropdownOpen(false);
      setMobileMenuOpen(false);
    };

    // Kənara klik: dil menyusu öz qutusundan, mobil menyu zolaqdan kənarda bağlanır.
    const closePanelsOnOutsideClick = (event: MouseEvent) => {
      const target = event.target as Node;
      if (isLangDropdownOpen() && !langDropdown?.contains(target)) setLangDropdownOpen(false);
      if (isMobileMenuOpen() && !bar.contains(target)) setMobileMenuOpen(false);
    };

    // Escape açıq paneli bağlayıb fokusu onu açan düyməyə qaytarır.
    const closePanelOnEscape = (event: KeyboardEvent) => {
      if (event.key !== "Escape") return;
      if (isLangDropdownOpen()) {
        setLangDropdownOpen(false);
        langButton?.focus();
      } else if (isMobileMenuOpen()) {
        setMobileMenuOpen(false);
        menuButton?.focus();
      }
    };

    // "Geri" ilə qayıdanda səhifə bfcache-dən açıq menyu ilə bərpa olunur, ona görə panelləri bağlayırıq.
    const resetAfterBackButton = (event: PageTransitionEvent) => {
      if (!event.persisted) return;
      setLangDropdownOpen(false);
      setMobileMenuOpen(false);
    };

    const setupClosing = () => {
      bar.addEventListener("focusout", closePanelsWhenFocusLeaves);
      document.addEventListener("click", closePanelsOnOutsideClick);
      document.addEventListener("keydown", closePanelOnEscape);
      window.addEventListener("pageshow", resetAfterBackButton);
    };

    // ---------- Page-load intro ----------
    const setupIntro = () => {
      if (!hasMotion()) return;
      const items = header.querySelectorAll("[data-header-item]");
      const intro = gsap.timeline({ paused: true });
      intro.fromTo(
        header,
        { yPercent: INTRO_SHIFT_PERCENT },
        { yPercent: 0, duration: INTRO_DURATION, ease: "power3.out" }
      );
      intro.fromTo(
        items,
        { opacity: 0, y: ITEMS_SHIFT, transition: "none" },
        {
          opacity: 1,
          y: 0,
          duration: ITEMS_DURATION,
          ease: "power3.out",
          stagger: ITEMS_STAGGER,
          clearProps: CLEARED_PROPS,
        },
        ITEMS_START
      );
      pageRevealed.then(() => intro.play());
    };

    // ---------- Scroll: glass capsule ----------
    const updateScrolledLook = (scrollTop: number) => {
      const nowScrolled = scrollTop > SCROLLED_AFTER_PX;
      if (nowScrolled !== isScrolled) {
        isScrolled = nowScrolled;
        bar.toggleAttribute("data-scrolled", nowScrolled);
      }
    };

    // ---------- Scroll: smart header (hide down, show up) ----------
    let isHeaderHidden = false;

    const setHeaderHidden = (hidden: boolean) => {
      if (hidden === isHeaderHidden) return;
      isHeaderHidden = hidden;
      gsap.to(header, {
        yPercent: hidden ? HIDE_SHIFT_PERCENT : 0,
        duration: HIDE_DURATION,
        ease: "power2.out",
        overwrite: "auto",
      });
    };

    const canHideHeader = () => {
      const hasKeyboardFocus = bar.querySelector(":focus-visible") !== null;
      return !isMobileMenuOpen() && !isLangDropdownOpen() && !hasKeyboardFocus;
    };

    const updateOnScroll = (self: ScrollTrigger) => {
      const scrollTop = Math.max(self.scroll(), 0);
      updateScrolledLook(scrollTop);
      if (scrollTop <= HIDE_AFTER_PX || self.direction < 0) {
        setHeaderHidden(false);
      } else if (canHideHeader()) {
        setHeaderHidden(true);
      }
    };

    const setupScrollBehaviour = () => {
      ScrollTrigger.create({ start: 0, end: "max", onUpdate: updateOnScroll });
      bar.addEventListener("focusin", () => setHeaderHidden(false));
      updateScrolledLook(Math.max(window.scrollY, 0));
    };

    // ---------- Header-dəki "Əlaqə saxlayın" düyməsi ----------
    // Hero-dakı düymə (`data-hero-cta`) görünərkən header düyməsi gizlənir: `data-cta-hidden` atributu
    // (görünüşü markupdakı `group-data-cta-hidden/header:` sinifləri çəkir). Gizli düymə sıfır enlidir,
    // ona görə tabindex="-1" və aria-hidden ilə klaviaturadan və ekran oxuyucudan çıxarılır.
    const setHeaderCtaHidden = (headerCta: HTMLElement, isHidden: boolean) => {
      bar.toggleAttribute("data-cta-hidden", isHidden);
      if (isHidden) {
        headerCta.setAttribute("tabindex", "-1");
        headerCta.setAttribute("aria-hidden", "true");
      } else {
        headerCta.removeAttribute("tabindex");
        headerCta.removeAttribute("aria-hidden");
      }
    };

    // ---------- Scroll: hero CTA visible below the header ----------
    const setupHeaderCta = () => {
      const heroCta = document.querySelector("[data-hero-cta]");
      const headerCta = bar.querySelector<HTMLElement>("[data-header-cta]");
      if (!heroCta || !headerCta) return;

      const headerHeight =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) ||
        FALLBACK_HEADER_HEIGHT_PX;

      ScrollTrigger.create({
        trigger: heroCta,
        start: "top bottom",
        end: `bottom top+=${headerHeight}`,
        onToggle: (self) => setHeaderCtaHidden(headerCta, self.isActive),
      });
    };

    // const funksiyaları təyin olunmadan çağırmaq olmur, ona görə çağırışlar sondadır.
    setupLanguageMenu();
    setupMobileMenu();
    setupClosing();
    setupIntro();
    setupScrollBehaviour();
    setupHeaderCta();
  }
</script>
