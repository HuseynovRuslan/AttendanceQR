---
/**
 * Google-un rəsmi "Google Play" nişanı (Android tətbiqinə link): Pwa.astro (48px, mərkəz), Footer.astro (40px, sola).
 * Props: lang, height (qara nişanın görünən hündürlüyü), align ('start' | 'center'), class.
 * Dilə görə PNG seçilir və elə ölçülür ki, içindəki qara nişan düz `height` px görünsün.
 */
import { Image } from 'astro:assets'
import { useTranslations, type Lang } from '../../i18n/ui'
import { SITE } from '../../data/site'
// Fayllar play.google.com/intl/en_us/badges/-dən olduğu kimi götürülüb (2026-09): nə kəsilib, nə
// rəngi dəyişib — Google-un qaydası budur.
import googlePlayEn from '../../assets/images/badges/google-play-en.png'
import googlePlayRu from '../../assets/images/badges/google-play-ru.png'

interface Props {
  lang: Lang
  /** Qara nişanın özünün görünən hündürlüyü, px (şəffaf boşluq daxil deyil). Standart 48. */
  height?: number
  /** 'start' — sol şəffaf boşluq mənfi margin ilə kompensasiya olunur (mətnlə bir xəttə düşsün); 'center' — mərkəzdə. */
  align?: 'start' | 'center'
  class?: string
}

const { lang, height = 48, align = 'center', class: className } = Astro.props
const t = useTranslations(lang)

// Hər iki PNG 646×250-dir, amma qara nişan fərqli yer tutur: ingiliscədə ətrafda şəffaf boşluq
// (Google-un "clear space"-i) var, rusca faylda demək olar yoxdur. Rəqəmlər alfa kanalından
// ölçülüb, fayl dəyişsə yenidən ölç.
const EN_BADGE = {
  file: googlePlayEn,
  leftGapInFile: 41, // qara nişanın faylın sol kənarından məsafəsi, px
  heightInFile: 168, // qara nişanın öz hündürlüyü, px
}
const RU_BADGE = {
  file: googlePlayRu,
  leftGapInFile: 0, // sol boşluq yoxdur
  heightInFile: 192, // qara nişanın öz hündürlüyü, px
}

// AZ və EN ingiliscə nişanı işlədir: Google-un azərbaycanca nişanı hələ köhnə Play loqosu ilədir.
let badge = EN_BADGE
if (lang === 'ru') {
  badge = RU_BADGE
}

// Ölçü: qara nişanın istədiyimiz hündürlüyündən bütöv şəklin ölçüsünə keçirik ki, iki dildə nişan eyni boyda görünsün.
const fileHeight = badge.file.height
// 1) Şəkil nə qədər hündür olmalıdır ki, qara nişan düz `height` px görünsün.
const imageHeight = Math.round((height * fileHeight) / badge.heightInFile)
// 2) En eyni nisbətdə dəyişir, şəkil dartılmasın.
const imageWidth = Math.round((imageHeight * badge.file.width) / fileHeight)
// 3) Yalnız align="start": sol şəffaf boşluq qədər linki sola çəkirik.
let leftShift = 0
if (align === 'start') {
  leftShift = Math.round((badge.leftGapInFile / fileHeight) * imageHeight)
}
---

<a
  class:list={['gplay', className]}
  href={SITE.playStore}
  target="_blank"
  rel="noopener noreferrer"
  style={leftShift ? `margin-left:-${leftShift}px` : undefined}
>
  <Image src={badge.file} alt={t('gplay.alt')} width={imageWidth} height={imageHeight} densities={[1, 2]} />
</a>

<style>
  .gplay {
    display: inline-block;
    line-height: 0;
    /* Linkin fonu yoxdur: radius yalnız fokus halqasında və toxunuş işığında görünür. */
    border-radius: 12px;
  }

  .gplay img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .gplay:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
</style>
