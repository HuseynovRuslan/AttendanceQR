---
/**
 * "Səhifənin əvvəlinə qayıt" düyməsi: ~600px aşağı sürüşəndən sonra WhatsApp düyməsinin üstündə görünür.
 * BaseLayout hər səhifəyə qoyur. Props: lang. Yeri WhatsAppButton.astro-dakı --wa-size və --wa-edge ilə hesablanır.
 * Mavi fonlu yeni bölməyə data-surface="brand" yaz: düymə onun üstündə olanda künclər ağ olur.
 */
import { faArrowUp } from '@fortawesome/free-solid-svg-icons/faArrowUp'
import { useTranslations, type Lang } from '../../i18n/ui'
import FaIcon from './FaIcon.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<button type="button" class="back-to-top" aria-label={t('top.aria')} data-back-to-top>
  <span class="back-to-top__corner back-to-top__corner--top-left" aria-hidden="true"></span>
  <span class="back-to-top__corner back-to-top__corner--top-right" aria-hidden="true"></span>
  <span class="back-to-top__corner back-to-top__corner--bottom-left" aria-hidden="true"></span>
  <span class="back-to-top__corner back-to-top__corner--bottom-right" aria-hidden="true"></span>
  <FaIcon icon={faArrowUp} class="back-to-top__arrow" style="color: rgb(243, 240, 240)" />
</button>
<style is:global>
  /* is:global: qaydalar komponentdən kənara baxır (<html>-dəki qrl-lock, qrl-reveal və header-dəki data-open). */
  .back-to-top {
    /* ---- Ölçü və yer ---- */
    --back-to-top-size: 50px;
    --back-to-top-gap: 12px; /* WhatsApp düyməsi ilə aradakı boşluq */
    --back-to-top-hidden-transform: translateY(10px) scale(0.9);

    /* ---- Hərəkət ---- */
    --back-to-top-speed: 0.22s; /* görünmə və gizlənmə */
    /* WhatsApp düyməsinin görünmə əyrisi (wa-in) ilə eyni. */
    --back-to-top-ease: cubic-bezier(0.22, 0.61, 0.36, 1);

    /* ---- Vizör küncləri ---- */
    --corner-size: 10px;
    --corner-line: 2px; /* xəttin qalınlığı */
    --corner-radius: 3px; /* loader-in künc əyriliyinin (22px-ə 7px) kiçildilmişi */
    --corner-offset: 7px; /* künc düymədən bu qədər kənarda durur */
    --corner-shift: 3px; /* gizli künc əlavə olaraq bu qədər kənara çəkilib */
    --corner-speed: 0.18s; /* künclərin yerinə "oturması" */
    /* Loader-dəki künclərin əyrisi (qrl-b-in). */
    --corner-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --corner-color: var(--color-brand);

    /* position: fixed valideynlərdə transform olmayanda ekrana bağlanır — BaseLayout düyməni
       .qrl-page-dən kənara qoyur (bax: WhatsAppButton.astro). */
    position: fixed;
    /* WhatsApp-ın mərkəz xəttinə düşür. */
    right: calc(var(--wa-edge) + (var(--wa-size) - var(--back-to-top-size)) / 2);
    /* WhatsApp-ın üstü + boşluq; env(...) — iPhone-un aşağı sistem zolağı. */
    bottom: calc(
      var(--wa-edge) + var(--wa-size) + var(--back-to-top-gap) + env(safe-area-inset-bottom, 0px)
    );
    /* WhatsApp ilə eyni: loader-in (1000) altında. */
    z-index: 900;
    display: grid;
    place-items: center;
    width: var(--back-to-top-size);
    height: var(--back-to-top-size);
    padding: 0;
    border-radius: 50%;
    /* Tünd bölmələrdə (məsələn, footer) düyməni fondan yalnız bu xətt ayırır. */
    border: 1px solid rgba(255, 255, 255, 0.16);
    background-color: var(--ink);
    color: var(--white);
    /* WhatsApp-ın kölgəsi ilə eyni hündürlük. Rəng qara yox, --ink-dir: isti boz fonda təmiz qara çirkli görünür. */
    box-shadow: 0 8px 20px -8px rgba(17, 18, 17, 0.45);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;

    /* Gizli hal (standart). pointer-events: none — görünməz düymə klikləri tutmasın. */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: var(--back-to-top-hidden-transform);
    /* Gizlənəndə visibility animasiyanın sonunda dəyişir ki, opacity-nin sönməsi görünsün. */
    transition:
      opacity var(--back-to-top-speed) ease,
      transform var(--back-to-top-speed) var(--back-to-top-ease),
      visibility 0s linear var(--back-to-top-speed),
      background-color 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    /* Görünəndə heç nə gözləmir — visibility də dərhal dəyişir. */
    transition-delay: 0s;
  }

  /* Basanda tez (0.1s) kiçilir, buraxanda adi sürətlə yerinə qayıdır. */
  .back-to-top.is-visible:active {
    transform: scale(0.94);
    transition-duration: 0.1s;
  }

  .back-to-top__arrow {
    font-size: 1rem;
    display: block;
    transition: transform var(--corner-speed) var(--corner-ease);
  }

  /* ---------- Vizör küncləri ----------
     Hər künc iki tərəfi xətli boş kvadratdır; gizli halda kənara çəkilib durur.
     pointer-events: none — künclər düymədən çıxır, klik və hover sahəsini böyütməməlidir. */
  .back-to-top__corner {
    position: absolute;
    width: var(--corner-size);
    height: var(--corner-size);
    border: 0 solid var(--corner-color);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--corner-speed) ease,
      transform var(--corner-speed) var(--corner-ease);
  }

  .back-to-top__corner--top-left {
    top: calc(var(--corner-offset) * -1);
    left: calc(var(--corner-offset) * -1);
    border-top-width: var(--corner-line);
    border-left-width: var(--corner-line);
    border-top-left-radius: var(--corner-radius);
    transform: translate(calc(var(--corner-shift) * -1), calc(var(--corner-shift) * -1));
  }

  .back-to-top__corner--top-right {
    top: calc(var(--corner-offset) * -1);
    right: calc(var(--corner-offset) * -1);
    border-top-width: var(--corner-line);
    border-right-width: var(--corner-line);
    border-top-right-radius: var(--corner-radius);
    transform: translate(var(--corner-shift), calc(var(--corner-shift) * -1));
  }

  .back-to-top__corner--bottom-left {
    bottom: calc(var(--corner-offset) * -1);
    left: calc(var(--corner-offset) * -1);
    border-bottom-width: var(--corner-line);
    border-left-width: var(--corner-line);
    border-bottom-left-radius: var(--corner-radius);
    transform: translate(calc(var(--corner-shift) * -1), var(--corner-shift));
  }

  .back-to-top__corner--bottom-right {
    bottom: calc(var(--corner-offset) * -1);
    right: calc(var(--corner-offset) * -1);
    border-bottom-width: var(--corner-line);
    border-right-width: var(--corner-line);
    border-bottom-right-radius: var(--corner-radius);
    transform: translate(var(--corner-shift), var(--corner-shift));
  }

  /* Düymə mavi fonlu bölmənin (data-surface="brand") üstündədir: mavi künc görünməzdi, ağın kontrastı 5.4:1-dir. */
  .back-to-top.is-on-brand {
    --corner-color: var(--white);
  }

  /* ---------- Hover və klaviatura fokusu ----------
     Künclər fokus göstəricisidir, ona görə brauzerin outline-ı söndürülüb. */
  .back-to-top:focus-visible {
    outline: none;
    background-color: var(--ink-2);
  }

  .back-to-top:focus-visible .back-to-top__arrow {
    transform: translateY(-2px);
  }

  .back-to-top:focus-visible .back-to-top__corner {
    opacity: 1;
    transform: none;
  }

  /* Hover yalnız siçanlı cihazda: telefonda :hover toxunuşdan sonra ilişib qalır. */
  @media (hover: hover) {
    .back-to-top:hover {
      background-color: var(--ink-2);
    }

    .back-to-top:hover .back-to-top__arrow {
      transform: translateY(-2px);
    }

    .back-to-top:hover .back-to-top__corner {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Telefon ---------- */
  /* WhatsApp-ın telefon ölçüsü də eyni sərhəddə dəyişir (WhatsAppButton.astro). */
  @media (max-width: 640px) {
    .back-to-top {
      --back-to-top-size: 46px;
      --back-to-top-gap: 10px;
    }
  }

  /* ---------- Loader, mobil menyu ---------- */
  /* Loader ekrandadırsa düymə gizlidir (WhatsApp kimi). */
  html.qrl-lock .back-to-top {
    opacity: 0;
    visibility: hidden;
    transform: var(--back-to-top-hidden-transform);
  }

  /* Səhifə ortadan yenilənibsə, düymə WhatsApp ilə birlikdə görünsün. qrl-reveal sinfini PageLoader.astro verir. */
  html.qrl-reveal .back-to-top {
    transition-delay: var(--wa-appear-delay);
  }

  /* Açıq mobil menyu ekranın aşağısına qədər uzana bilər — WhatsApp ilə eyni qayda. */
  html:has([data-header-bar][data-open]) .back-to-top {
    visibility: hidden;
  }

  @media print {
    .back-to-top {
      display: none !important;
    }
  }
</style>

<script>
  // ---------- Sabitlər ----------
  const SHOW_AFTER_PX = 600 // bu qədər aşağı sürüşəndən sonra düymə görünür (təxminən bir ekran)

  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]')
  // Header-in ilk linki (loqo): klikdən sonra fokus bura keçir.
  const firstHeaderLink = document.querySelector<HTMLAnchorElement>('[data-header] a')
  // Mavi fonlu bölmələr; səhifə açıldıqdan sonra dəyişmir.
  const brandSurfaces = document.querySelectorAll<HTMLElement>('[data-surface="brand"]')

  // Düymə mavi fonlu bölmənin üstündədirmi? Künclərin rəngi --color-brand-dır: mavi fonda görünmür,
  // klaviatura istifadəçisi fokusu itirir.
  function isButtonOverBrandSurface(button: HTMLElement) {
    const buttonRect = button.getBoundingClientRect()
    for (const surface of brandSurfaces) {
      const surfaceRect = surface.getBoundingClientRect()
      const overlapsVertically = buttonRect.bottom > surfaceRect.top && buttonRect.top < surfaceRect.bottom
      const overlapsHorizontally = buttonRect.right > surfaceRect.left && buttonRect.left < surfaceRect.right
      if (overlapsVertically && overlapsHorizontally) {
        return true
      }
    }
    return false
  }

  // Düymənin iki vəziyyətini yeniləyir: is-visible və is-on-brand. Əvvəl ölçülür, sonra sinif yazılır:
  // əks halda brauzer səhifəni təzədən hesablamalı olar.
  function updateButton(button: HTMLElement) {
    const isOverBrand = isButtonOverBrandSurface(button)
    const shouldShow = window.scrollY > SHOW_AFTER_PX
    button.classList.toggle('is-visible', shouldShow)
    button.classList.toggle('is-on-brand', isOverBrand)
  }

  // Düymə yuxarıda gizlənir; fokus onda qalsaydı, növbəti Tab səhifənin sonundan davam edərdi.
  // preventScroll: fokus hamar sürüşməni yarıda kəsməsin.
  function moveFocusToHeader() {
    if (!firstHeaderLink) return
    firstHeaderLink.focus({ preventScroll: true })
  }

  // Lenis işləyirsə yuxarı qalxmanı o aparır (brauzerin smooth sürüşməsi onunla toqquşardı).
  // window.qrlLenis-i SmoothScroll.astro yazır; telefonda Lenis yoxdur.
  function scrollToTop() {
    if (window.qrlLenis) {
      // Müddət və əyri menyu linkləri ilə eynidir (SmoothScroll.astro → ANCHOR_DURATION).
      window.qrlLenis.scrollTo(0, window.qrlAnchorScroll)
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }
    moveFocusToHeader()
  }

  if (button) {
    // window.onscroll yox: başqa faylın (məsələn, Header-in) scroll kodunu silə bilər.
    window.addEventListener('scroll', () => updateButton(button), { passive: true })
    // Künclər fokusda görünür; rəngi dəqiq olsun deyə yenidən hesablanır (şəkil yüklənib bölməni oynada bilər).
    button.addEventListener('focus', () => updateButton(button))
    button.addEventListener('click', scrollToTop)
    // Səhifə ortadan açılıbsa (refresh), düymə scroll gözləmədən düzgün vəziyyətdə olsun.
    updateButton(button)
  }
</script>
