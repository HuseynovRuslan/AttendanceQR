---
import { useTranslations, fmt, type Lang, type UIKey } from '../i18n/ui'

/**
 * 08:15 — "İdarəetmə paneli". «Rəhbərin bir günü» bölməsinin (AdminPanel.astro) birinci ekranı.
 *
 * Etiketlər məhsulun öz mətnidir → panel.ui.* (i18n/ui.ts → panelUi). Adlar, filiallar, saatlar və
 * rəqəmlər nümunə datadır → burada.
 *
 * Canlı hadisə: göstəricilər 0-dan sayılır, iştirak dairəsi dolur; 1.7 s sonra "Son fəaliyyət"ə
 * yuxarıdan yeni giriş düşür, "İndi iş başında" 47 → 48, dairə 73% → 75%. Qarmaqları
 * AdminPanel.astro-nun skripti oxuyur:
 *   data-up     slayd açılanda rəqəm 0-dan öz dəyərinə sayılır
 *   data-a      hadisədən sonrakı mətn; əvvəlki mətn elementin öz mətnidir
 *   data-ring   iştirak dairəsi — "əvvəl sonra", faizlə
 *   data-swap   in: hadisədə görünür, out: hadisədə gizlənir
 *   data-enter  hadisədə yuxarıdan düşən sətir
 * `data-count` işlənmir: BaseLayout səhifədəki bütün [data-count]-ları özü sayır.
 *
 * CLS sıfır qalsın deyə hadisədə mövcud heç bir qutu yerini dəyişmir. Siyahıya sətir əlavə olunmur:
 * hər sətirdə iki variant var — indiki və bir yuxarıdakı — və hadisədə biri o biri ilə əvəzlənir.
 * Mətni yerində dəyişmək olmazdı: ad qısalıb-uzananda eyni sətirdəki filial yazısı sürüşür və Chrome
 * onu layout shift sayır. Sayğacın enini isə görünməz ən geniş dəyər saxlayır — 0 → 47 sayılanda
 * "nəfər" yerindən oynamır.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)

// Faiz "İndi iş başında"dan hesablanır ki, iki rəqəm bir-birinə zidd düşməsin: 47/64 → 73%, 48/64 → 75%.
const staff = 64
const branches = 3
const present = 47
const pct = (n: number) => Math.round((n / staff) * 100)

const tiles = [
  { n: staff, label: 'panel.ui.total', accent: 'border-l-[#9CA3AF]' },
  { n: present, after: present + 1, label: 'panel.ui.in', accent: 'border-l-brand' },
  { n: 2, label: 'panel.ui.absent', accent: 'border-l-[#E4572E]' },
  // Bənövşəyi: məhsulda "Həftəlik istirahət" belədir, 18:30 ekranındakı "İstirahət" də.
  { n: 12, label: 'panel.ui.dayOff', accent: 'border-l-[#8B5CF6]' },
] satisfies { n: number; after?: number; label: UIKey; accent: string }[]

// Ən yenisi yuxarıda. Birincisi canlı hadisədə düşən girişdir: ondan əvvəl siyahı ikincidən başlayır,
// sonra hər sətir bir yuxarıdakını göstərir və sonuncu (Tural) çıxır.
const feed = [
  { name: 'Rəşad Quliyev', branch: 'Mərkəz', at: '08:15' },
  { name: 'Leyla Kərimova', branch: 'Nərimanov', at: '08:14' },
  { name: 'Orxan Səfərov', branch: 'Mərkəz', at: '08:13' },
  { name: 'Aysel Hüseynova', branch: 'Mərkəz', at: '08:11' },
  { name: 'Tural Əliyev', branch: 'Xətai anbarı', at: '08:09' },
]
const slots = feed.slice(1).map((before, i) => [before, feed[i]])
const card = 'border border-[#E7E9EE] bg-white'
---

<div class="flex items-start justify-between gap-3">
  <div>
    <p class="text-[17px] font-semibold tracking-[-0.02em]">{t('panel.ui.m1.title')}</p>
    <p class="mt-0.5 text-[12px] text-slate-500">{t('panel.ui.m1.sub')}</p>
  </div>
  <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-brand/10 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.08em] text-brand">
    <i class="ap-live size-1.5 rounded-full bg-brand"></i>
    <span class="ap-caps mr-[-0.08em]">{t('panel.ui.live')}</span>
  </span>
</div>

<div class={`mt-4 flex items-center justify-between gap-3 rounded-2xl px-5 py-4 ${card}`}>
  <div class="min-w-0">
    <p class="text-[10.5px] font-semibold tracking-[0.14em] text-slate-500 uppercase">{t('panel.ui.m1.now')}</p>
    <p class="mt-1 flex items-baseline gap-2">
      {/* Eyni xanada iki qat: görünməz ən geniş dəyər eni saxlayır, sayğac onun üstündə sayır. */}
      <span class="inline-grid text-[48px] leading-none font-semibold tracking-[-0.04em] tabular-nums">
        <span class="invisible col-start-1 row-start-1">{present + 1}</span>
        <span data-up data-a={present + 1} class="col-start-1 row-start-1">{present}</span>
      </span>
      <span class="text-[18px] font-medium text-slate-400">{t('panel.ui.m1.people')}</span>
    </p>
    <p class="mt-2 text-[12.5px] text-slate-500">{fmt(t('panel.ui.m1.count'), { n: staff, b: branches })}</p>
  </div>
  <div class="shrink-0 text-center">
    <svg width="66" height="66" viewBox="0 0 66 66" aria-hidden="true" class="mx-auto block">
      <circle cx="33" cy="33" r="27" fill="none" stroke-width="5" class="stroke-brand/10"></circle>
      <circle
        data-ring={`${pct(present)} ${pct(present + 1)}`}
        cx="33"
        cy="33"
        r="27"
        fill="none"
        stroke-width="5"
        stroke-linecap="round"
        pathLength="100"
        stroke-dasharray="100"
        stroke-dashoffset={100 - pct(present)}
        transform="rotate(-90 33 33)"
        class="stroke-brand"></circle>
      <text
        data-a={`${pct(present + 1)}%`}
        x="33"
        y="37.5"
        text-anchor="middle"
        font-size="13.5"
        font-weight="600"
        class="fill-ink">{pct(present)}%</text
      >
    </svg>
    <p class="mt-1 hidden text-[10.5px] text-slate-400 @min-[30rem]:block">{t('panel.ui.m1.rate')}</p>
  </div>
</div>

<div class="mt-3 grid grid-cols-2 gap-2.5 @min-[30rem]:grid-cols-4">
  {
    tiles.map((tile) => (
      <div class:list={['rounded-xl border-l-[3px] px-3.5 py-3', card, tile.accent]}>
        <p data-up data-a={tile.after} class="text-[22px] leading-none font-semibold tabular-nums">
          {tile.n}
        </p>
        <p class="mt-1.5 text-[11.5px] text-slate-500">{t(tile.label)}</p>
      </div>
    ))
  }
</div>

<div class={`mt-3 overflow-hidden rounded-2xl ${card}`}>
  <div class="flex items-center justify-between px-4 py-2.5">
    <p class="text-[13.5px] font-semibold">{t('panel.ui.m1.feed')}</p>
    <p class="font-mono text-[10.5px] text-slate-400">{t('panel.ui.m1.today')}</p>
  </div>
  <ul class="list-none divide-y divide-[#F0F1F4] border-t border-[#F0F1F4]">
    {
      slots.map((variants, i) => (
        <li data-enter={i === 0 ? '' : undefined} class="px-4 py-2.5">
          {variants.map((row, k) => (
            <p data-swap={k ? 'in' : 'out'} hidden={k === 1} class="flex items-center gap-2.5">
              <i class="size-1.5 shrink-0 rounded-full bg-brand" />
              <span class="truncate text-[13px] font-semibold">{row.name}</span>
              <span class="truncate text-[11.5px] text-slate-400">
                {t('panel.ui.m1.checkIn')} · {row.branch}
              </span>
              <span class="ml-auto shrink-0 font-mono text-[12px] text-slate-600 tabular-nums">{row.at}</span>
            </p>
          ))}
        </li>
      ))
    }
  </ul>
</div>
