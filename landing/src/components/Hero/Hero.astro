---
import { Image, getImage } from "astro:assets";
import { useTranslations, localizedPath, type Lang } from "../../i18n/ui";
import { LOGO_WORD } from "../../data/brand";
import qrPoster from "../../assets/images/product/qrlog.png";
import appShot from "../../assets/images/product/qrlog-app.png";
import PhoneFrame from "../Shared/PhoneFrame.astro";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Header-in preload etdiyi eyni şəkil: poster loqosu əlavə sorğu yaratmır.
const logoWord = await getImage(LOGO_WORD);

const stats = [
  { n: t("hero.s1n"), l: t("hero.s1l") },
  { n: t("hero.s2n"), l: t("hero.s2l") },
  { n: t("hero.s3n"), l: t("hero.s3l") },
];

// Nümunə məlumatdır; ad və saat tətbiq şəklindəki "Salam, Əli Məmmədov" / "Giriş 08:58" ilə eyni olmalıdır.
const person = { name: "Əli Məmmədov", initials: "ƏM", time: "08:58" };
const team = ["CH", "NM", "RH"];
const checks = [t("hero.d.c1"), t("hero.d.c2"), t("hero.d.c3"), t("hero.d.c4")];
// hero.d.liveD cümləsindəki 184 ilə eyni olmalıdır.
const atWork = 184;

// Kartların ortaq görünüşü; border rəngi yoxdur, hər kart öz rəngini gətirir (iki border-* sinfi toqquşur).
// backdrop-blur qəsdən yoxdur: kartlar daim üzür, blur hər kadrda yenidən hesablanırdı.
const cardSkin =
  "rounded-2xl border p-2.5 shadow-[0_12px_30px_-14px_rgb(15_23_42/0.45)] transition-[scale] duration-300 will-change-transform";
const cardWhite = `${cardSkin} border-white/70 bg-white/90`;
const card = `absolute z-20 ${cardWhite} hover:scale-105`;
const cardLive = `absolute z-20 ${cardSkin} border-emerald-500/20 bg-white/95 hover:scale-105`;
// Qeyd kartı dar səhnədə axının içindədir, hover-i yalnız üzəndə (@md) işləyir.
const cardFlow = `${cardWhite} @md:hover:scale-105`;
// Üzmə `translate`-də, hover `scale`-də, siçan izləməsi (heroMotion.ts) `transform`-dadır — toqquşmur.
// Keçid yalnız `scale`-dədir: `transition-transform` hər kadrda yazılan transform-u 300 ms gecikdirərdi.
// Mətn ölçüsü yoxdur: "+181" nişanı üçün başqa ölçü lazımdır.
const avatar =
  "flex size-6 shrink-0 items-center justify-center rounded-full font-bold ring-2 ring-white @md:size-7";

// Aşağıdakı <section class="hero"> sinfi qalmalıdır: global.css fonu və hündürlüyü həmin seçiciyə bağlayıb.
const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";
const btnBase = `inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-4 text-[15px] font-semibold transition-all duration-200 sm:w-auto ${focusRing}`;
---

<section class="hero" id="top" data-hero>
  <div
    class="wrap grid items-center gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16"
  >
    <div class="max-w-160 lg:col-start-1 lg:row-start-1">
      <h1
        class="text-[clamp(42px,6.2vw,76px)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance"
        data-hero-title
      >
        {
          t("hero.title.a")
        }
        <span
          class="relative inline-flex whitespace-nowrap px-[0.16em] py-[0.04em]"
          data-hero-scan
        >
          <span class="hero-scan-word">{t("hero.title.hl")}</span>
          <span aria-hidden="true" class="hero-scan-frame absolute inset-0">
            <span
              class="absolute top-0 left-0 size-[0.3em] border-t-[0.05em] border-l-[0.05em] border-brand"
            ></span>
            <span
              class="absolute top-0 right-0 size-[0.3em] border-t-[0.05em] border-r-[0.05em] border-brand"
            ></span>
            <span
              class="absolute bottom-0 left-0 size-[0.3em] border-b-[0.05em] border-l-[0.05em] border-brand"
            ></span>
            <span
              class="absolute right-0 bottom-0 size-[0.3em] border-r-[0.05em] border-b-[0.05em] border-brand"
            ></span>
            <span
              class="hero-scan-line absolute inset-x-[0.1em] h-[0.045em] rounded-full bg-linear-to-r from-transparent via-brand to-transparent shadow-[0_0_0.3em_rgba(21,94,239,.55)]"
            ></span>
          </span>
        </span>{t("hero.title.b")}
      </h1>

      <p
        class="mt-6 max-w-147.5 text-[16px] leading-[1.7] text-pretty text-stone-600 sm:text-[17px]"
        data-hero-in
      >
        {t("hero.sub")}
      </p>

      <div
        class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:items-center"
      >
        {/* data-hero-cta: Header.astro-dakı skript bu düyməni izləyir, atributu silmə. */}
        <a
          class={`${btnBase} bg-brand bg-linear-to-b from-brand to-brand-600 text-white shadow-lg shadow-brand/25 hover:from-brand-600 hover:to-brand-700 hover:shadow-xl hover:shadow-brand/30 active:scale-[0.99]`}
          href={localizedPath(lang, "/elaqe/")}
          data-hero-cta
          data-hero-in
        >
          {t("cta.btn1")}
        </a>
        <a
          class={`${btnBase} border border-stone-300/70 bg-white text-stone-800 hover:border-brand hover:text-brand`}
          href={localizedPath(lang, "/haqqimizda/")}
          data-hero-in
        >
          {t("nav.about")}
        </a>
      </div>
    </div>

    {/* Həndəsə `cqw`-dədir (səhnə bütöv miqyaslanır), mətn px-dədir; @md/@xl səhnənin öz eninə görədir, viewport-a yox. */}
    <div
      class="@container relative isolate mx-auto w-full max-w-160 not-supports-[width:1cqw]:hidden lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mr-0 lg:ml-auto"
      data-hero-scene
    >
      {/* `isolate` lazımdır: mənfi z-index həlqələr yoxsa bölmənin fonunun altına düşər. */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-10 -right-10 -z-20 size-64 rounded-full bg-brand/30 blur-3xl sm:size-80"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-12 -left-10 -z-20 size-56 rounded-full bg-indigo-400/25 blur-3xl sm:size-72"
      >
      </div>

      <div
        aria-hidden="true"
        class="pointer-events-none absolute -inset-[6%] -z-10 bg-[radial-gradient(#cbd5e1_1.2px,transparent_1.2px)] bg-size-[20px_20px] opacity-70 [mask-image:radial-gradient(ellipse_82%_76%_at_52%_45%,black_35%,transparent_88%)]"
      >
      </div>

      {/* `@md` = səhnənin eni 448px; üzən qeyd kartı da bu qutuya görə yerləşir. */}
      <figure
        class="relative aspect-5/7 w-full @md:aspect-square"
        data-skew
      >
        <div
          aria-hidden="true"
          class="absolute top-[4%] left-[32%] aspect-square w-[76%] animate-halo rounded-full bg-[radial-gradient(circle,rgb(21_94_239/0.3)_0%,rgb(99_102_241/0.16)_42%,transparent_70%)] blur-[4cqw] @md:top-[2%] @md:left-[28%] @md:w-[70%]"
        >
        </div>
        <div
          aria-hidden="true"
          class="absolute inset-[10%] rounded-[50%] bg-[radial-gradient(60%_55%_at_58%_50%,rgb(21_94_239/0.10),transparent_72%)] blur-[3cqw]"
        >
        </div>

        {/* `data-hero-layer` qatlarına heroMotion.ts siçan hərəkətini verir. Poster və telefonun öz `transform`-u (poza) var, ona görə hərəkət boş sarğıya yazılır. */}
        <div
          class="pointer-events-none absolute inset-0 z-0 perspective-distant"
          data-hero-layer="poster"
        >
          <div
            class="pointer-events-auto absolute top-[13%] bottom-[30%] left-0 flex w-[42%] flex-col -rotate-3 rounded-[3cqw] border border-white/70 bg-white p-[3cqw] shadow-[0_3cqw_5cqw_-2cqw_rgb(15_23_42/0.28)] transition-transform duration-500 ease-out will-change-transform hover:rotate-0 hover:rotate-y-0 @md:top-[10%] @md:bottom-[26%] @md:left-0 @md:w-[44%] @md:-rotate-2 @md:-rotate-y-6 @md:rounded-[2cqw] @md:p-[2.2cqw]"
          >
            <div class="flex items-center justify-between gap-1.5">
              <img
                class="h-3 w-auto @md:h-3.5"
                src={logoWord.src}
                alt=""
                width={LOGO_WORD.width}
                height={LOGO_WORD.height}
              />
              <span class="hidden text-[10px] text-slate-400 @md:inline"
                >{t("hero.d.site")}</span
              >
            </div>
            <p
              class="mt-2 text-[12px] leading-[1.2] font-semibold text-slate-900 @md:text-[13px] @xl:text-[15px]"
            >
              {t("hero.d.poster")}
            </p>
            {/* width 512 = ən geniş çəkilişin (253px) 2x-i; quality yüksəkdir, çünki QR-ın kəskin kənarları webp ilə dalğalanır.
                Skan xətti və işıq (heroMotion.ts) `opacity-0`-dır: skript işləməsə görünmürlər. */}
            <div class="relative mt-2 min-h-0 w-full flex-1" data-hero-qr>
              <Image
                class="absolute inset-0 size-full object-contain"
                src={qrPoster}
                alt=""
                width={512}
                quality={90}
                loading="eager"
                decoding="async"
              />
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 rounded-lg bg-brand/10 opacity-0 ring-2 ring-brand/60"
                data-hero-scan-glow></span>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-0.5 rounded-full bg-linear-to-r from-transparent via-brand to-transparent opacity-0 shadow-[0_0_10px_2px] shadow-brand/50"
                data-hero-scan-line></span>
            </div>
            <p
              class="mt-2 hidden text-[10px] leading-[1.35] text-slate-500 @md:line-clamp-2"
            >
              {t("hero.d.posterNote")}
            </p>
          </div>
        </div>

        {/* Telefonun yeri, eni və pozası (--rx arxaya, --ry yana dönmə, --rz yana əyilmə) burada verilir; quruluşu PhoneFrame.astro-dadır. */}
        <div
          class="pointer-events-none absolute inset-0 z-10"
          data-hero-layer="phone"
        >
          <PhoneFrame
            class="pointer-events-auto absolute top-[4%] left-[40%] z-10 w-[52%] [--rx:15deg] [--ry:-20deg] [--rz:6deg] hover:[--rx:3deg] hover:[--ry:-6deg] hover:[--rz:2deg] @md:left-[42%] @md:w-[42%] @md:[--rx:22deg] @md:[--ry:-30deg] @md:[--rz:13deg] @md:hover:[--rx:4deg] @md:hover:[--ry:-8deg] @md:hover:[--rz:2deg]"
          >
            {/* width 640: dar halda telefon 52% enlidir, 430px ekranda 3x = 545px; mənbə 1170px-dir. */}
            <Image
              class="block h-auto w-full"
              src={appShot}
              alt={t("hero.d.shotAlt")}
              width={640}
              loading="eager"
              decoding="async"
            />
          </PhoneFrame>
        </div>

        <div
          data-hero-layer="card"
          class={`${card} animate-float-scan top-0 left-[34%] flex w-[66%] items-center gap-2 @md:left-[16%] @md:w-[40%]`}
        >
          <span
            class="grid size-7 shrink-0 place-items-center rounded-full bg-blue-100 text-[10px] font-bold text-brand-600 @md:size-8 @md:text-[11px]"
            aria-hidden="true"
            data-hero-scanned
          >
            {person.initials}
          </span>
          <div class="min-w-0">
            <p
              class="text-[10px] font-semibold text-emerald-700 @md:text-[11px]"
            >
              {t("hero.d.scanned")}
            </p>
            <p
              class="truncate text-[12px] font-semibold text-slate-900 @md:text-[13px]"
            >
              {person.name}
            </p>
            <p class="text-[10px] text-slate-500 @md:text-[11px]">
              {t("hero.d.checkIn")}, {person.time}
            </p>
          </div>
        </div>

        <div
          data-hero-layer="card"
          class={`${card} animate-float-offline hidden items-start gap-2 @md:top-[26%] @md:left-[68%] @md:flex @md:w-[36%]`}
        >
          <span
            class="grid size-7 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-500"
            aria-hidden="true"
          >
            <svg
              class="size-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 36 36"
              aria-hidden="true"
              ><circle cx="18" cy="29.54" r="3" fill="currentColor"></circle><path
                fill="currentColor"
                d="m29.18 17.71l.11-.17a1.51 1.51 0 0 0-.47-2.1A20.57 20.57 0 0 0 18 12.37c-.56 0-1.11 0-1.65.07l3.21 3.21a17.4 17.4 0 0 1 7.6 2.52a1.49 1.49 0 0 0 2.02-.46"
              ></path><path
                fill="currentColor"
                d="M32.76 9.38a27.9 27.9 0 0 0-22.58-3.11l2.63 2.63a24.68 24.68 0 0 1 18.29 3.22a1.49 1.49 0 0 0 2-.46l.11-.17a1.51 1.51 0 0 0-.45-2.11"
              ></path><path
                fill="currentColor"
                d="m3 4.75l3.1 3.1a27 27 0 0 0-2.92 1.57a1.51 1.51 0 0 0-.48 2.11l.11.17a1.49 1.49 0 0 0 2 .46a24.7 24.7 0 0 1 3.67-1.9l3.14 3.14a20.6 20.6 0 0 0-4.53 2.09a1.51 1.51 0 0 0-.46 2.1l.11.17a1.49 1.49 0 0 0 2 .46A17.5 17.5 0 0 1 14.25 16l3.6 3.6a13.4 13.4 0 0 0-6.79 1.93a1.5 1.5 0 0 0-.46 2.09l.1.16a1.52 1.52 0 0 0 2.06.44a10.2 10.2 0 0 1 9-.7L29 30.75l1.41-1.41l-26-26Z"
              ></path></svg
            >
          </span>
          <div class="min-w-0">
            <p
              class="text-[12px] font-semibold text-slate-900 @md:text-[13px]"
            >
              {t("hero.d.offlineT")}
            </p>
            <p
              class="mt-0.5 text-[10px] leading-[1.35] text-slate-600 @md:text-[11px]"
            >
              {t("hero.d.offlineD")}
            </p>
          </div>
        </div>

        <div
          data-hero-layer="card"
          class={`${cardLive} animate-float-live bottom-[2%] left-[-1%] w-[70%] @md:top-[72%] @md:bottom-auto @md:left-[-2%] @md:w-[40%]`}
        >
          <p
            class="flex items-center gap-2 text-[11px] font-semibold text-slate-900 @md:text-[12px]"
          >
            <span
              class="relative flex size-2 shrink-0 @md:size-2.5"
              aria-hidden="true"
            >
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex size-full rounded-full bg-emerald-500"
              ></span>
            </span>
            <span
              >{t("hero.d.liveT")}: <span class="text-emerald-700"
                >{t("hero.d.liveOn")}</span
              ></span
            >
          </p>
          <div
            class="mt-2 flex flex-col gap-2 @md:flex-row @md:items-center @md:justify-between @md:gap-1.5"
          >
            <span
              class="text-[10px] leading-[1.35] text-slate-500"
            >
              {t("hero.d.liveD")}
            </span>
            <span class="flex shrink-0 -space-x-1" aria-hidden="true">
              {
                team.map((i) => (
                  <span class={`${avatar} bg-emerald-50 text-[10px] text-emerald-700 @md:text-[11px]`} data-hero-avatar>
                    {i}
                  </span>
                ))
              }
              <span
                class={`${avatar} bg-slate-100 text-[9px] text-slate-600 @md:text-[10px]`}
                data-hero-avatar
              >
                +{atWork - team.length}
              </span>
            </span>
          </div>
        </div>
      </figure>

      {/* Dar səhnədə axının içindədir, yer olanda telefonun üstündə üzür. Pill-lər şəbəkə yox, wrap-dır: RU mətn AZ-dan enlidir. */}
      <div
        data-hero-layer="card"
        class={`${cardFlow} relative z-20 mt-3 w-full @md:absolute @md:animate-float-recorded @md:top-[67%] @md:left-[46%] @md:mt-0 @md:w-[42%]`}
      >
        <div class="flex items-center gap-2">
          <span
            class="grid size-6 shrink-0 place-items-center rounded-full bg-emerald-500 text-white @md:size-7"
            aria-hidden="true"
            data-hero-check
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m5 13 4 4L19 7"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p
              class="text-[12px] font-semibold text-slate-900 @md:text-[13px]"
            >
              {t("hero.d.recorded")}
            </p>
            <p class="text-[10px] text-slate-500 @md:text-[11px]">
              {person.time}, {t("hero.d.site")}
            </p>
          </div>
        </div>
        <ul role="list" class="mt-2 flex list-none flex-wrap gap-1">
          {
            checks.map((c) => (
              <li
                class="inline-flex items-center gap-1 rounded-lg bg-emerald-50/90 px-1.5 py-1 text-[10px] leading-[1.2] font-medium text-emerald-700 @md:text-[11px]"
                data-hero-pill
              >
                <svg
                  class="size-3 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 13 4 4L19 7" />
                </svg>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <ul
      role="list"
      class="grid list-none grid-cols-3 gap-4 border-t border-stone-300/60 pt-7 sm:gap-8 lg:col-start-1 lg:row-start-2"
      aria-label={t("stats.title")}
      data-hero-in
    >
      {
        stats.map((s) => (
          <li>
            <span class="block text-[22px] font-semibold tracking-[-0.03em] sm:text-[28px]">
              {s.n}
            </span>
            <span class="mt-1 block text-[13px] leading-snug text-stone-500">
              {s.l}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Skan animasiyası: xətt və söz eyni anda, eyni 3 s dövrlə başlayır, ona görə söz xətt ortadan keçəndə yanır. */
  .hero-scan-line {
    top: 14%;
    animation: hero-scan 3s ease-in-out infinite;
  }

  /* Xətt `top` ilə yox, `transform` ilə hərəkət edir (düzülüşü yenidən hesablamır). `cqh` üçün
     qutu `container-type: size` almalıdır; qutu `absolute inset-0` olduğundan bu təhlükəsizdir. */
  .hero-scan-frame {
    container-type: size;
  }

  /* Xətt sözün ortasından (≈48%) dövrün 25%-də və 75%-də keçir; hero-hit faizləri buradan gəlir.
     Ad "hero-" ilə başlayır: Astro @keyframes adlarını təcrid etmir. */
  @keyframes hero-scan {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(68cqh);
    }
  }

  .hero-scan-word {
    animation: hero-hit 3s ease-in-out infinite;
  }

  /* Xətt sözün ortasından keçəndə (22–28% və 72–78%) söz mavi olur, qalan vaxt başlığın rəngindədir. */
  @keyframes hero-hit {
    0%,
    17%,
    33%,
    67%,
    83%,
    100% {
      color: inherit;
    }
    22%,
    28%,
    72%,
    78% {
      color: var(--color-brand);
    }
  }
</style>

<script>
  import { initHeroMotion } from "./heroMotion";

  initHeroMotion();
</script>
