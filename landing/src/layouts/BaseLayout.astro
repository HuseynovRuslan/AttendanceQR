---
/**
 * Saytın bütün səhifələrinin ümumi qabığı: src/pages/ içindəki hər səhifə öz məzmununu bu layout-a
 * bükür, məzmun <slot />-un yerinə düşür.
 * Props: lang (dil), path (dil prefiksi olmadan marşrut), title və description (verilməsə ui.ts-dəki
 * meta mətnləri), home (ana səhifə), heroTone (loader-in fonu), noindex (axtarışdan gizlət).
 * Necə işləyir: <head>-də SEO, sosial kart, şriftlər və schema.org datası; <body>-də loader, Header,
 * Footer, WhatsApp və "yuxarı" düymələri; sondakı skript səhifədəki canlı hissələri (sayğac, demo, FAQ) işə salır.
 */

// Sıra vacibdir: qatların (cascade layers) sırasını tailwind.css elan edir, global-layered.css isə
// global.css-i həmin qatlardan birinə (base) yerləşdirir. Əvvəl sıra elan olunmalıdır.
import '../styles/tailwind.css'
import '../styles/global-layered.css'
import PageLoader from '../components/PageLoader.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import BackToTop from '../components/BackToTop.astro'
import { useTranslations, htmlLang, localeMap, localizedPath, availableLangs, type Lang } from '../i18n/ui'
import { SITE } from '../data/site'
import { getImage } from 'astro:assets'
import { LOGO_WORD } from '../data/brand'

interface Props {
  lang: Lang
  /** Dil prefiksi olmadan marşrut, həmişə sonunda "/" ilə: '/', '/elaqe/', … */
  path?: string
  title?: string
  description?: string
  /** Yalnız ana səhifə: SoftwareApplication və FAQPage strukturlaşdırılmış datasını əlavə edir. */
  home?: boolean
  /**
   * Səhifənin açıldığı fon rəngi. Loader-in vizörü də eyni fonda dayanır ki, loader çəkiləndə rəng
   * sıçrayışı olmasın. 'tinted' — ana səhifə (Hero --paper fonundadır); <PageHero> ilə açılan hər
   * səhifə sadə --white fonundadır.
   */
  heroTone?: 'tinted' | 'white'
  noindex?: boolean
}

const { lang, path = '/', title, description, home = false, noindex = false, heroTone = 'tinted' } = Astro.props
const t = useTranslations(lang)

// Hex yox, CSS dəyişəni: global.css-də --white və ya --paper dəyişsə, loader da onlarla dəyişir.
// undefined olanda loader öz standart fonunda qalır, o da --paper-dir.
const loaderBg = heroTone === 'white' ? 'var(--white, #fff)' : undefined

// <html>-dəki qrl-lock: loader-in vizörü (components/PageLoader.astro) səhifəni örtür, ona görə o
// ekranda olanda səhifə scroll olunmur. Sinif skriptlə yox, birbaşa HTML-də yazılır ki, ilk kadrdan
// qüvvədə olsun. Loader bitəndə öz skripti sinfi götürür; JavaScript söndürülübsə, loader-in
// <noscript> bloku onu ləğv edir.

const site = SITE.url
const canonical = site + localizedPath(lang, path)
// src/assets/ yox, public/: axtarış botu paylaşım kartını keş etdiyi müddətdə bu URL-i saxlayır, ona
// görə ünvana hash əlavə olunmamalı və şəkil webp-yə çevrilməməlidir. Aşağıdakı ikonlar da eyni səbəblə.
const ogImage = site + '/og-image.png'
// <head>-də öncədən yüklənir (preload), Header onu çəkir — hər yerdə eyni fayl, bax src/data/brand.ts.
const logoWord = await getImage(LOGO_WORD)

const pageTitle = title ?? t('meta.title')
const pageDesc = description ?? t('meta.description')
// Paylaşım şəklinin alt mətni: təsvirin əvvəlində ad — amma yalnız bir dəfə. Təsvirlərin çoxu onsuz da
// "QRLog — …" (və ya "QRLog is …") ilə başlayır; hər dəfə ad əlavə etsək, "QRLog — QRLog — …" alınardı.
const imageAlt = pageDesc.startsWith(SITE.name) ? pageDesc : `${SITE.name} — ${pageDesc}`

// hreflang: səhifənin MÖVCUD OLDUĞU BÜTÜN dillər (cari dil də daxil — Google hər versiyanın özünə də
// istinad etməsini istəyir), üstəlik Azərbaycan dilinə x-default.
// Yalnız Azərbaycan dilində olan marşrut (blog, 404) heç bir alternate almır: tək hreflang heç nə
// demir, qalan iki dili yazsaq isə Google-u heç vaxt qurulmamış URL-lərə göndərərdik.
const routeLangs = availableLangs(path)
const alternates: { hreflang: string; href: string }[] = []
if (routeLangs.length >= 2) {
  for (const routeLang of routeLangs) {
    alternates.push({ hreflang: routeLang, href: site + localizedPath(routeLang, path) })
  }
  alternates.push({ hreflang: 'x-default', href: site + localizedPath('az', path) })
}

// og:locale:alternate üçün: səhifənin mövcud olduğu dillər, cari dil çıxılmaqla.
const otherLangs = routeLangs.filter((routeLang) => routeLang !== lang)

// ---- Strukturlaşdırılmış data (schema.org, JSON-LD) ----
// Organization bütün saytda var. aggregateRating və offers qəsdən yoxdur: toplanmış rəyimiz yoxdur,
// schema.org-da uydurma reytinq həm yalandır, həm də Google-un strukturlaşdırılmış data qaydalarına ziddir.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: site + '/',
  logo: site + '/logo-mark.png',
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer support',
    areaServed: 'AZ',
    availableLanguage: ['az', 'ru', 'en'],
  },
}

// FAQPage yalnız ana səhifədə (home) çıxır. Sual-cavablar ui.ts-dəki faq.q1…q6 və faq.a1…a6 açarlarıdır.
const faqKeys = [1, 2, 3, 4, 5, 6] as const
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // Açar adı mətn kimi yığılır ("faq.q" + nömrə) — TypeScript onu yoxlaya bilmir, ona görə "as any".
  mainEntity: faqKeys.map((faqNumber) => ({
    '@type': 'Question',
    name: t(`faq.q${faqNumber}` as any),
    acceptedAnswer: { '@type': 'Answer', text: t(`faq.a${faqNumber}` as any) },
  })),
}

// Yalnız ana səhifədə (home) çıxır.
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web (PWA), iOS, Android',
  description: t('meta.description'),
  url: canonical,
  inLanguage: ['az', 'ru', 'en'],
}

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: 'QRLog işçi davamiyyəti sistemi',
  url: site + '/',
  inLanguage: ['az-AZ', 'ru-RU', 'en-US'],
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: site + '/',
  },
}
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr" class="qrl-lock">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Əsas SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={t('meta.keywords')} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0B1726" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />

    {!noindex && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}

    <!-- Open Graph: link paylaşılanda sosial şəbəkələrdə görünən kart -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={localeMap[lang]} />
    {otherLangs.map((otherLang) => <meta property="og:locale:alternate" content={localeMap[otherLang]} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- İkonlar -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo-mark.png" />
    <link rel="preload" href={logoWord.src} as="image" type="image/webp" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta2/css/all.min.css" integrity="sha512-YWzhKL2whUzgiheMoBFwW8CKV4qpHQAEuvilg9FAn5VJUDwKZZxkJNuGM4XkWuk94WCrrwslk8yWNGmY1EduTA==" crossorigin="anonymous" referrerpolicy="no-referrer">

    <!--
      --font-sans və --font-mono-nun şriftləri (bax styles/tailwind.css). Onest əsas şriftdir: yoxlanan
      pulsuz şriftlər içində Azərbaycan hərflərini (Ə, İ, Ğ, Ş), rus əlifbasını və ₼ işarəsini birlikdə
      daşıyan yeganəsidir; beş qalınlıqda (400–800) yüklənir. IBM Plex Mono kiçik mono yazılar
      üçündür.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Onest:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Strukturlaşdırılmış data (schema.org) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify(appLd)} />}
    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </head>
  <body>
    <PageLoader lang={lang} bg={loaderBg} />
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <div class="qrl-page">
      <Header lang={lang} path={path} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <!-- Hər iki düymə qəsdən .qrl-page-dən kənardadır: loader bitəndə .qrl-page-ə transform animasiyası
    verilir, transform olan valideyn isə position: fixed düyməni ekrana yox, özünə bağlayardı.
    BackToTop WhatsApp-dan SONRA gəlir: z-index-ləri eynidir, sonra gələn üstdə çəkilir — WhatsApp-ın
    nəbz halqası "yuxarı" düyməsinin altından keçir, üstündən yox. -->
    <WhatsAppButton lang={lang} />
    <BackToTop lang={lang} />
    <script>
      // Bu skript saytın hər səhifəsində işləyir, amma hər hissə öz elementini axtarır: element
      // səhifədə yoxdursa, həmin hissə heç nə etmir. Mobil menyu və dil seçimi Header.astro-dadır.

      // ---------- Sabitlər ----------
      // Dekorativ QR naxışı
      const QR_SIZE = 25 // QR 25×25 xanadır (PhoneDemo-dakı svg-nin viewBox-u da "0 0 25 25"-dir)
      // Təsadüfi ədəd (0…1) bundan BÖYÜK olanda xana dolur: 0.5 → təxminən yarısı dolu; kiçiltsən, QR sıxlaşar.
      const QR_FILL_THRESHOLD = 0.5
      const QR_FINDER_SIZE = 7 // künc "göz"ünün ölçüsü, xana ilə (buildFinderSquare-dəki 7×7 kvadrat)
      const QR_FINDER_FAR_EDGE = QR_SIZE - QR_FINDER_SIZE // = 18: sağ və aşağı künc gözü kənara dayanır
      // #qrsvg naxışının başlanğıc ədədi. Hazırda heç bir səhifədə #qrsvg yoxdur, ona görə
      // aşağıdakı paintQr('qrsvg', …) çağırışı heç nə etmir.
      const QRSVG_SEED = 1234567
      const PHONE_QR_SEED = 987654 // #pqr (telefon demosu) naxışının başlanğıc ədədi
      // LCG — ən sadə "təsadüfi" ədəd düsturu. Bunlar onun klassik sabitləridir; birini dəyişsən, naxış da dəyişər.
      const LCG_MULTIPLIER = 1103515245
      const LCG_INCREMENT = 12345
      const LCG_MAX = 0x7fffffff // 2^31 - 1: "&" ilə yalnız aşağı 31 bit qalır, nəticə 0…LCG_MAX olur

      // Canlı saat
      const CLOCK_TICK_MS = 1000 // saat hər saniyə yenilənir

      // Scroll ilə görünmə (.rv)
      const REVEAL_THRESHOLD = 0.14 // elementin 14%-i ekrana girəndə "in" sinfini alır

      // Sayğaclar ([data-count])
      const COUNTER_DURATION_MS = 1600 // rəqəm 1.6 saniyəyə son dəyərinə çatır
      const COUNTER_THRESHOLD = 0.5 // sayğacın yarısı ekrana girəndə sayma başlayır

      // Telefon demosu: addımın adı #phone-un data-state atributuna yazılır, CSS də həmin ekranı göstərir.
      // durationMs — addımın ekranda qalma müddəti, sonra növbəti addıma keçilir.
      const PHONE_DEMO_STEPS = [
        { state: 'scan', durationMs: 2400 }, // QR skan olunur
        { state: 'verify', durationMs: 2600 }, // cihaz və məkan yoxlanır
        { state: 'face', durationMs: 2400 }, // üz (selfi) yoxlanır
        { state: 'done', durationMs: 2800 }, // gəliş qeydə alındı
      ]
      const PHONE_DEMO_THRESHOLD = 0.3 // telefonun 30%-i ekrana girəndə demo başlayır

      // ---------- QR naxışı (dekorativ, həmişə eyni) ----------
      // QR-ın kiçik xanalarını doldurur. Təsadüf saxtadır (LCG): eyni seed həmişə eyni ardıcıllığı
      // verir, ona görə naxış hər yükləmədə eyni görünür. Real QR deyil, oxunmur.
      function buildQrCells(seed: number) {
        let randomState = seed
        let cells = ''
        for (let y = 0; y < QR_SIZE; y++) {
          for (let x = 0; x < QR_SIZE; x++) {
            randomState = (randomState * LCG_MULTIPLIER + LCG_INCREMENT) & LCG_MAX
            const randomValue = randomState / LCG_MAX
            if (randomValue > QR_FILL_THRESHOLD) {
              cells += `<rect x="${x}" y="${y}" width="1" height="1"/>`
            }
          }
        }
        return cells
      }

      // QR-ın küncündəki böyük "göz": üst-üstə üç kvadrat — 7×7, 5×5 və 3×3.
      // Xarici 7 QR_FINDER_SIZE ilə eyni olmalıdır: birini dəyişsən, o birini də dəyiş.
      function buildFinderSquare(left: number, top: number) {
        return (
          `<rect x="${left}" y="${top}" width="7" height="7"/>` +
          `<rect x="${left + 1}" y="${top + 1}" width="5" height="5" fill="#0B1726"/>` +
          `<rect x="${left + 2}" y="${top + 2}" width="3" height="3" fill="#fff"/>`
        )
      }

      // Naxışı verilən id-li <svg>-nin içinə çəkir; belə element yoxdursa, heç nə etmir.
      function paintQr(svgId: string, seed: number) {
        const svg = document.getElementById(svgId)
        if (!svg) return
        const cells = buildQrCells(seed)
        svg.innerHTML =
          cells +
          buildFinderSquare(0, 0) +
          buildFinderSquare(QR_FINDER_FAR_EDGE, 0) +
          buildFinderSquare(0, QR_FINDER_FAR_EDGE)
      }

      // ---------- Canlı saat (#clock) ----------
      // Diqqət: hazırda heç bir səhifədə #clock yoxdur, ona görə startClock() heç nə etmir.

      // Vaxtı "SS:DD:SS" formatında qaytarır: 9:05:03 → "09:05:03".
      function formatTime(date: Date) {
        const parts = [date.getHours(), date.getMinutes(), date.getSeconds()]
        const paddedParts = parts.map((part) => String(part).padStart(2, '0'))
        return paddedParts.join(':')
      }

      function startClock() {
        const clock = document.getElementById('clock')
        if (!clock) return
        const showCurrentTime = () => {
          clock.textContent = formatTime(new Date())
        }
        showCurrentTime()
        setInterval(showCurrentTime, CLOCK_TICK_MS)
      }

      // ---------- Scroll ilə görünmə (.rv) ----------
      // .rv elementi ekrana girəndə ona "in" sinfi verilir. Necə görünəcəyini JS yox, CSS həll edir:
      // global.css-dəki .rv və .rv.in qaydaları.
      // Diqqət: hazırda global.css-in sonundakı .rv qaydası (məzmun JS-siz də görünsün deyə) bu effekti
      // söndürür — "in" sinfi əlavə olunur, amma görünüş dəyişmir.
      // IntersectionObserver elementin ekrana girdiyini scroll hadisəsini hər an dinləmədən xəbər verir.
      // https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API
      function startScrollReveal() {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in')
                // Bir dəfə görünən element bir daha izlənmir.
                revealObserver.unobserve(entry.target)
              }
            })
          },
          { threshold: REVEAL_THRESHOLD }
        )
        document.querySelectorAll('.rv').forEach((element) => revealObserver.observe(element))
      }

      // ---------- Sayğaclar ([data-count]) ----------
      // Əvvəl sürətli, sonda yavaşlayan hərəkət (ease-out): progress 0…1 → nəticə 0…1.
      function easeOut(progress: number) {
        return 1 - Math.pow(1 - progress, 3)
      }

      // Rəqəmi 0-dan data-count dəyərinə qədər artırır. data-dec — onluq rəqəmlərin sayı,
      // data-prefix və data-suffix — rəqəmin önünə və arxasına yazılan mətn ("~", " ₼").
      // requestAnimationFrame funksiyanı ekranın növbəti yenilənməsində çağırır — hamar animasiya üçün.
      // https://developer.mozilla.org/en-US/docs/Web/API/Window/requestAnimationFrame
      function countUp(counter: HTMLElement) {
        const target = parseFloat(counter.dataset.count || '0')
        const decimals = parseInt(counter.dataset.dec || '0')
        const suffix = counter.dataset.suffix || ''
        const prefix = counter.dataset.prefix || ''
        const startTime = performance.now()
        function drawFrame(now: number) {
          const progress = Math.min((now - startTime) / COUNTER_DURATION_MS, 1)
          const currentValue = target * easeOut(progress)
          counter.textContent =
            prefix +
            currentValue.toLocaleString('en-US', {
              minimumFractionDigits: decimals,
              maximumFractionDigits: decimals,
            }) +
            suffix
          if (progress < 1) requestAnimationFrame(drawFrame)
        }
        requestAnimationFrame(drawFrame)
      }

      // Hərəkət istəməyənlər üçün (prefers-reduced-motion): animasiyasız, dərhal son rəqəm.
      function showFinalCount(counter: HTMLElement) {
        const target = parseFloat(counter.dataset.count || '0')
        const decimals = parseInt(counter.dataset.dec || '0')
        const prefix = counter.dataset.prefix || ''
        const suffix = counter.dataset.suffix || ''
        counter.textContent =
          prefix +
          target.toLocaleString('en-US', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          }) +
          suffix
      }

      function startCounters() {
        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                countUp(entry.target as HTMLElement)
                counterObserver.unobserve(entry.target)
              }
            })
          },
          { threshold: COUNTER_THRESHOLD }
        )
        // matchMedia JS-dən CSS media sorğusunu yoxlayır — istifadəçinin "hərəkəti azalt" ayarını bilmək üçün.
        // https://developer.mozilla.org/en-US/docs/Web/API/Window/matchMedia
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        // <HTMLElement> TypeScript-ə deyir ki, tapılanlar HTML elementləridir — adi Element tipində dataset yoxdur.
        // https://www.typescriptlang.org/docs/handbook/2/generics.html
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((counter) => {
          if (reduceMotion) {
            showFinalCount(counter)
          } else {
            counterObserver.observe(counter)
          }
        })
      }

      // ---------- Telefon demosu (#phone) ----------
      // Telefonu verilən addıma keçirir, addım siyahısında (#pdemoSteps) cari addımı "active",
      // keçilmişləri "done" edir.
      function showPhoneStep(phone: HTMLElement, stepItems: HTMLElement[], stepIndex: number) {
        phone.dataset.state = PHONE_DEMO_STEPS[stepIndex].state
        stepItems.forEach((stepItem, index) => {
          stepItem.classList.toggle('active', index === stepIndex)
          stepItem.classList.toggle('done', index < stepIndex)
        })
      }

      // Demonun hazırkı addımı. Bir ümumi dəyişəndir (funksiya parametri yox): demo nə qədər
      // işə salınsa da, hamısı eyni sayğacı irəli aparır — köhnə kodda da belə idi.
      let currentPhoneStep = 0

      // Cari addım öz müddəti qədər ekranda qalır, sonra növbəti addım göstərilir.
      // Sonuncu addımdan sonra yenidən birinciyə qayıdır — demo dayanmadan təkrarlanır.
      function scheduleNextPhoneStep(phone: HTMLElement, stepItems: HTMLElement[]) {
        const currentDuration = PHONE_DEMO_STEPS[currentPhoneStep].durationMs
        setTimeout(() => {
          currentPhoneStep = currentPhoneStep + 1
          if (currentPhoneStep === PHONE_DEMO_STEPS.length) {
            currentPhoneStep = 0
          }
          showPhoneStep(phone, stepItems, currentPhoneStep)
          scheduleNextPhoneStep(phone, stepItems)
        }, currentDuration)
      }

      // Demo yalnız telefon ekrana girəndə başlayır — səhifənin qalan hissəsində CPU-nu boş yerə yormamaq üçün.
      function startPhoneDemoWhenVisible(phone: HTMLElement, stepItems: HTMLElement[]) {
        const phoneObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                scheduleNextPhoneStep(phone, stepItems)
                observer.disconnect()
              }
            })
          },
          { threshold: PHONE_DEMO_THRESHOLD }
        )
        phoneObserver.observe(phone)
      }

      function startPhoneDemo() {
        const phone = document.getElementById('phone')
        if (!phone) return
        const stepItems = Array.from(document.querySelectorAll<HTMLElement>('#pdemoSteps .pstep'))
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        if (reduceMotion) {
          // Hərəkət istəməyənlərə dərhal son addım ("qeydə alındı") göstərilir, demo fırlanmır.
          showPhoneStep(phone, stepItems, PHONE_DEMO_STEPS.length - 1)
          return
        }
        showPhoneStep(phone, stepItems, 0)
        startPhoneDemoWhenVisible(phone, stepItems)
      }

      // ---------- FAQ akkordeonu ----------
      // Eyni anda yalnız bir cavab açıq qalır: yeni sual açılmazdan əvvəl açıq olanların hamısı bağlanır.
      function closeAllFaqItems() {
        document.querySelectorAll('.faq-item.open').forEach((openItem) => {
          openItem.classList.remove('open')
          const openAnswer = openItem.querySelector('.faq-a') as HTMLElement
          openAnswer.style.maxHeight = '0px'
          const openQuestion = openItem.querySelector('.faq-q')
          if (openQuestion) {
            openQuestion.setAttribute('aria-expanded', 'false')
          }
        })
      }

      // Kliklənən sual bağlıdırsa, açılır; açıqdırsa, bağlanır (closeAllFaqItems onu da bağlayır).
      function toggleFaqItem(question: Element) {
        const item = question.parentElement as HTMLElement
        const answer = item.querySelector('.faq-a') as HTMLElement
        const wasOpen = item.classList.contains('open')
        closeAllFaqItems()
        if (!wasOpen) {
          item.classList.add('open')
          // CSS "height: auto"-nu animasiya edə bilmir, max-height-i isə edə bilir (global.css-də
          // transition). Ona görə cavabın real hündürlüyünü (scrollHeight) max-height-ə yazırıq.
          answer.style.maxHeight = answer.scrollHeight + 'px'
          question.setAttribute('aria-expanded', 'true')
        }
      }

      function setupFaqAccordion() {
        document.querySelectorAll('.faq-q').forEach((question) => {
          question.addEventListener('click', () => toggleFaqItem(question))
        })
      }

      // ---------- İşə salma ----------
      // Hissələr bir-birindən asılı deyil: hər biri öz elementini tapıb işə düşür.
      paintQr('qrsvg', QRSVG_SEED)
      paintQr('pqr', PHONE_QR_SEED)
      startClock()
      startScrollReveal()
      startCounters()
      startPhoneDemo()
      setupFaqAccordion()
    </script>
  </body>
</html>
