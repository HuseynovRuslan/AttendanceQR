---
/**
 * Bütün səhifələrin ümumi qabığı: <head> (SEO, sosial kart, şriftlər, schema.org), loader, Header, Footer, düymələr.
 * Props: lang, path, title, description (verilməsə ui.ts-dəki meta mətnləri), home, heroTone, noindex.
 */

// Sıra vacibdir: tailwind.css qat sırasını elan edir, global-layered.css global.css-i qatlardan birinə yerləşdirir.
import '../styles/tailwind.css'
import '../styles/global-layered.css'
import PageLoader from '../components/Shared/PageLoader.astro'
import Header from '../components/Header/Header.astro'
import Footer from '../components/Footer/Footer.astro'
import WhatsAppButton from '../components/Shared/WhatsAppButton.astro'
import BackToTop from '../components/Shared/BackToTop.astro'
import SmoothScroll from '../components/Shared/SmoothScroll.astro'
import PauseOffscreen from '../components/Shared/PauseOffscreen.astro'
import Motion from '../components/Shared/Motion.astro'
import { useTranslations, htmlLang, localeMap, localizedPath, availableLangs, type Lang } from '../i18n/ui'
import { SITE } from '../data/site'
import { getImage } from 'astro:assets'
import { LOGO_WORD } from '../data/brand'

interface Props {
  lang: Lang
  /** Dil prefiksi olmadan marşrut, həmişə sonunda "/" ilə: '/', '/elaqe/', … */
  path?: string
  title?: string
  description?: string
  /** Yalnız ana səhifə: SoftwareApplication və FAQPage strukturlaşdırılmış datasını əlavə edir. */
  home?: boolean
  /** Səhifənin açıldığı fon; loader də eyni fonda olur. 'tinted' — ana səhifə (--paper), 'white' — qalanlar. */
  heroTone?: 'tinted' | 'white'
  noindex?: boolean
}

const { lang, path = '/', title, description, home = false, noindex = false, heroTone = 'tinted' } = Astro.props
const t = useTranslations(lang)

// CSS dəyişəni (hex yox): --white dəyişsə, loader də dəyişir. undefined = loader-in standart fonu (--paper).
const loaderBg = heroTone === 'white' ? 'var(--white, #fff)' : undefined

// <html class="qrl-lock"> loader ekranda olanda scroll-u bağlayır; sinfi loader-in skripti götürür
// (JS söndürülübsə, loader-in <noscript> bloku).

const site = SITE.url
const canonical = site + localizedPath(lang, path)
// public/-dadır, src/assets/ yox: paylaşım kartı keşlənir, ona görə URL-də hash və webp çevirməsi olmamalıdır (ikonlar da).
const ogImage = site + '/og-image.png'
// <head>-də preload olunur; Header eyni faylı çəkir (src/data/brand.ts).
const logoWord = await getImage(LOGO_WORD)

const pageTitle = title ?? t('meta.title')
const pageDesc = description ?? t('meta.description')
// Ad yalnız bir dəfə: təsvir artıq "QRLog" ilə başlayırsa, təkrar əlavə olunmur.
const imageAlt = pageDesc.startsWith(SITE.name) ? pageDesc : `${SITE.name} — ${pageDesc}`

// hreflang: səhifənin mövcud olduğu bütün dillər (cari dil də) + x-default = az.
// Yalnız az dilində olan marşrut (blog, 404) alternate almır.
const routeLangs = availableLangs(path)
const alternates: { hreflang: string; href: string }[] = []
if (routeLangs.length >= 2) {
  for (const routeLang of routeLangs) {
    alternates.push({ hreflang: routeLang, href: site + localizedPath(routeLang, path) })
  }
  alternates.push({ hreflang: 'x-default', href: site + localizedPath('az', path) })
}

// og:locale:alternate üçün: cari dildən başqa mövcud dillər.
const otherLangs = routeLangs.filter((routeLang) => routeLang !== lang)

// schema.org (JSON-LD). aggregateRating və offers qəsdən yoxdur: real rəy yoxdur, uydurma reytinq Google qaydalarına ziddir.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: site + '/',
  logo: site + '/logo-mark.png',
  // Official social profiles (from site.ts).
  sameAs: SITE.socials.map((social) => social.url),
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer support',
    areaServed: 'AZ',
    availableLanguage: ['az', 'ru', 'en'],
  },
}

// Sual-cavablar ui.ts-dəki faq.q1…q6 və faq.a1…a6 açarlarıdır.
const faqKeys = [1, 2, 3, 4, 5, 6] as const
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // Açar mətn kimi yığılır, TypeScript onu yoxlaya bilmir: "as any".
  mainEntity: faqKeys.map((faqNumber) => ({
    '@type': 'Question',
    name: t(`faq.q${faqNumber}` as any),
    acceptedAnswer: { '@type': 'Answer', text: t(`faq.a${faqNumber}` as any) },
  })),
}

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web (PWA), iOS, Android',
  description: t('meta.description'),
  url: canonical,
  inLanguage: ['az', 'ru', 'en'],
}

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: 'QRLog işçi davamiyyəti sistemi',
  url: site + '/',
  inLanguage: ['az-AZ', 'ru-RU', 'en-US'],
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: site + '/',
  },
}
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr" class="qrl-lock">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* ---------- Motion switch: hidden start states only with JS; dropped if GSAP is not loaded when the loader leaves ---------- */}
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        root.classList.add('has-motion')

        function showWithoutMotionIfGsapMissing() {
          if (!root.classList.contains('motion-loaded')) root.classList.remove('has-motion')
        }

        var loaderObserver = new MutationObserver(function () {
          if (root.classList.contains('qrl-lock')) return
          loaderObserver.disconnect()
          showWithoutMotionIfGsapMissing()
        })
        loaderObserver.observe(root, { attributes: true, attributeFilter: ['class'] })

        setTimeout(showWithoutMotionIfGsapMissing, 4500)
      })()
    </script>

    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={t('meta.keywords')} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0B1726" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />

    {!noindex && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={localeMap[lang]} />
    {otherLangs.map((otherLang) => <meta property="og:locale:alternate" content={localeMap[otherLang]} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo-mark.png" />
    <link rel="preload" href={logoWord.src} as="image" type="image/webp" />

    {/* Şriftlər tailwind.css-dəki --font-sans/--font-mono üçündür. Onest 200 yalnız 404 səhifəsi üçündür; 300 yüklənmir (yüngül qalınlıq 200-ə düşər). */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Onest:wght@200;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify(appLd)} />}
    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </head>
  <body>
    <PageLoader lang={lang} bg={loaderBg} />
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <div class="qrl-page">
      <Header lang={lang} path={path} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    {/* Düymələr .qrl-page-dən kənardadır: transform-lu valideyn position: fixed-i özünə bağlayardı.
    BackToTop WhatsApp-dan sonra gəlir (eyni z-index): nəbz halqası onun altından keçir. */}
    <WhatsAppButton lang={lang} />
    <BackToTop lang={lang} />
    <SmoothScroll />
    <PauseOffscreen />
    <Motion />
  </body>
</html>
