# Automatic HTTPS for the production stack. Caddy fetches and renews Let's Encrypt certificates on
# its own, the moment these names resolve to this server.
#   bax.qrlog.az  → the attendance app (frontend)
#   api.qrlog.az  → the backend API
#   qrlog.az      → the static marketing site (Astro build, served from /srv/qrlog, which is the
#                   host's ./landing-dist — produced by ops/build-landing.sh, not by compose)
#   <slug>.qrlog.az → any tenant, certificate issued on demand (see the catch-all at the bottom)

{
	# On-demand TLS: a certificate is fetched the first time a hostname is requested, but only if
	# the backend says that hostname belongs to a real, active tenant. Without the ask, anyone
	# pointing a DNS name here could make us request certificates on their behalf until Let's
	# Encrypt rate-limits the whole domain. Caddy appends ?domain=<host> to this URL itself.
	on_demand_tls {
		ask http://backend:8080/api/tenant/allow-tls
	}
}

# Headers every QRLog host serves. Until now only the marketing site sent any: the app itself — the
# one that holds attendance, salaries and photographs of people's faces — answered with none, so a
# tenant subdomain could be framed by any page on the internet, and a browser that had once reached
# it over http had nothing telling it never to do that again.
#
# Deliberately NOT here: Content-Security-Policy. It lives in its own snippet (app_csp below),
# because the API host it may connect to differs per environment — staging talks to api-test, every
# production host to api.qrlog.az — and because the static marketing site and the native-app host
# have different needs from the tenant frontends.
(security_headers) {
	header {
		# A year, and every subdomain: each tenant lives at one, and they are all this app.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# DENY, not SAMEORIGIN: nothing here is ever framed, and the app has one-tap buttons that
		# end a shift — exactly what clickjacking is for.
		X-Frame-Options "DENY"
		# The scan NEEDS camera and geolocation, and the assistant's voice input NEEDS the
		# microphone; the rest of the powerful APIs are switched off because nothing asks for them.
		#
		# microphone was () until 2026-08-13 — correct on the day it shipped, and exactly why this
		# header hides bugs: when the voice feature arrived, getUserMedia(audio) failed with an
		# instant NotAllowedError and NO permission prompt, on every browser, looking precisely like
		# the user had denied it. A policy of "off because unused" has to be revisited the day
		# something starts using it.
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(self), payment=(), usb=(), interest-cohort=()"
		# Don't advertise the server and its version to anyone scanning for a known CVE.
		-Server
	}
}

# Content-Security-Policy for the app frontends, ENFORCING. Argument = the API host this
# environment's frontend talks to (connect-src). Every source below is one the app really uses —
# read out of the code and the built bundle (all 45 chunks swept for external URLs), not guessed:
#   fonts.googleapis / gstatic  the Manrope + IBM Plex Mono stylesheet in index.html
#   tile.openstreetmap          LocationMapPicker
#   basemaps.cartocdn           the dashboard, problems, field-visit and HQ maps
#   nominatim.openstreetmap.org the address search in LocationMapPicker (connect, not img)
#   *.r2.cloudflarestorage.com  presigned selfie URLs, loaded straight from the browser
#   'unsafe-inline' for STYLE   the admin panel styles inline throughout, and leaflet injects its own
#   blob: for worker            the QR decoder spins one up; blob: img covers canvas captures
# script-src stays 'self' with no 'unsafe-inline' and no 'unsafe-eval' — that is the half that
# actually stops an injected script, and the half most easily lost by adding sources on a hunch.
#
# Proven before promotion: enforced on test.qrlog.az first, then a real-Chromium sweep of 16 screens
# (login, scan with its worker, both map screens WITH the address search, tabel, live board, charts)
# on 2026-08-20 — zero securitypolicyviolation events. That sweep is also what had earlier caught
# nominatim, which the first draft would have silently broken.
(app_csp) {
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://*.r2.cloudflarestorage.com; connect-src 'self' {args[0]} https://nominatim.openstreetmap.org; worker-src 'self' blob:; manifest-src 'self'"
}

# www → apex. The site declares https://qrlog.az/… as canonical in every <link rel="canonical">, so
# serving the same pages under both names would have search engines picking between two copies.
www.qrlog.az {
	redir https://qrlog.az{uri} permanent
}

qrlog.az {
	encode zstd gzip
	root * /srv/qrlog

	# Astro fingerprints everything it emits under /_astro/, so those files can be cached forever.
	# HTML deliberately is not: a deploy has to reach people who already have the page open.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages, the sitemap and robots.txt must revalidate, or a deploy would leave stale HTML in
	# browsers. `*/` covers the directory URLs the site actually serves (/qiymet/, /ru/elaqe/, …).
	@revalidate path */ *.html *.xml /robots.txt
	header @revalidate Cache-Control "no-cache"

	import security_headers

	file_server

	# The site is a multi-page build now (/, /qiymet/, /haqqimizda/, /elaqe/, /bloq/… in three
	# languages), so a mistyped path is a real possibility. Serve the built 404 page and keep the
	# 404 status — a "not found" that answers 200 gets indexed as a real page.
	handle_errors 404 {
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

bax.qrlog.az {
	encode zstd gzip
	import security_headers
	import app_csp https://api.qrlog.az
	reverse_proxy frontend:80
}

# The native app (TWA) is served from this company-neutral host — it names no tenant, so it needs its
# own explicit block (the on-demand catch-all's allow-tls ask would reject it as a non-tenant). Same
# frontend build; the app detects the "app" host and logs in via the cross-tenant app-login endpoint.
#
# app_csp is deliberately NOT here yet: this host renders inside the native WebView, where the
# Capacitor bridge injects its runtime into the page — script-src 'self' may refuse that injection,
# and the failure would look like "the app opens to a blank screen" on a tester's phone. Verify on a
# real device first, then add the same import.
app.qrlog.az {
	encode zstd gzip
	import security_headers
	reverse_proxy frontend:80
}

# EastCaf (tenant "ecaf") and CleanFix — kept as explicit blocks even though the catch-all below
# would now cover them. They have working certificates and there is no reason to move a live tenant
# onto a new code path to prove a point; new tenants need no block at all.
ecaf.qrlog.az {
	encode zstd gzip
	import security_headers
	import app_csp https://api.qrlog.az
	reverse_proxy frontend:80
}

cleanfix.qrlog.az {
	encode zstd gzip
	import security_headers
	import app_csp https://api.qrlog.az
	reverse_proxy frontend:80
}

api.qrlog.az {
	encode zstd gzip
	import security_headers
	reverse_proxy backend:8080
}

# Staging (docker-compose.staging.yml). Its containers join the same Docker network under the
# aliases stg-frontend / stg-backend; nothing else is shared with production, not even the database.
#
# These two blocks used to exist only as a hand edit of this file ON THE SERVER, and nothing in the
# repository knew about them. Recreating the Caddy container for an unrelated change was therefore
# enough to take staging off the internet — which is exactly what happened on 2026-07-24, silently,
# because a working staging deploy still reports success while nobody can reach it.
#
# Both names must stay above the catch-all's reach: without a block they would be matched by the
# on-demand `https://` site at the bottom and proxied to PRODUCTION, which is worse than a 404.
test.qrlog.az {
	encode zstd gzip
	import security_headers

	# The same policy as production (app_csp), pointed at the staging API. This is where every future
	# change to the policy is proven first — getting it wrong breaks the selfie, the map or the
	# typeface SILENTLY, on an employee's phone, at 08:00.
	import app_csp https://api-test.qrlog.az

	reverse_proxy stg-frontend:80
}

api-test.qrlog.az {
	encode zstd gzip
	import security_headers
	reverse_proxy stg-backend:8080
}

# QRCatalog (WOODMARK) — a separate project with its own stack in /opt/qrcatalog, reached over the
# shared docker network (its compose attaches to attendanceqr_default with the alias qrcatalog-web).
#
# IT LIVES HERE, IN THE REPO, ON PURPOSE. On the old host this block existed only on the server, typed
# in by hand — so when the cutover replaced that Caddyfile with one generated from this file, the block
# vanished with it and the catalogue went dark until somebody noticed. Anything that is only on a
# server is one deploy away from being lost.
woodmark.qrlog.az {
	encode zstd gzip
	reverse_proxy qrcatalog-web:8080
}

# The catalogue answered on katalog.qrlog.az until 2026-08-22, and QR codes printed under that name
# carry it inside them. They must keep working, so the old host name is kept and redirected rather
# than retired — a redirect a phone camera follows silently.
katalog.qrlog.az {
	redir https://woodmark.qrlog.az{uri} permanent
}

# The other projects that used to live on the old host, moved here 2026-08-22. Each has its own
# stack under /opt and joins the shared docker network with an alias (docker-compose.shared-caddy.yml
# in each project, started via that project's up.sh). They are reached BY NAME, not by an open port:
# this host only lets 80/443 through the provider firewall, and a name gets TLS for free.
budget.qrlog.az {
	encode zstd gzip
	reverse_proxy budget-web:80
}

pricebase.qrlog.az {
	encode zstd gzip
	reverse_proxy pricebase-web:8000
}

psklub.qrlog.az {
	encode zstd gzip
	reverse_proxy psklub-app:8080
}

# Every tenant from here on, without a block of its own. Adding a company used to mean editing this
# file and restarting Caddy over SSH — which is why the super-admin panel could not finish the job.
#
# This is a CATCH-ALL, not a wildcard. `*.qrlog.az` as a site address is what broke this before: it
# makes Caddy manage a *wildcard certificate*, which needs DNS-01, and failing that it took the
# explicit hosts down with it. `https://` names no host at all — it simply matches whatever the more
# specific blocks above did not, and each hostname then gets its own ordinary single-host
# certificate, issued on first request and gated by the ask above.
#
# Order does not decide this — Caddy routes by specificity, so bax/api/qrlog.az still win over it.
https:// {
	encode zstd gzip
	import security_headers
	# Every on-demand tenant is the same frontend bundle, so it gets the same policy (this also
	# covers admin.qrlog.az — the operator console is that same bundle too).
	import app_csp https://api.qrlog.az
	tls {
		on_demand
	}
	reverse_proxy frontend:80
}
