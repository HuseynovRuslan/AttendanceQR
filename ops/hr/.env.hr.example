# hr.test.qrlog.az — install as /opt/qrlog-hr-infra/.env.hr on the server (root:root, mode 600).
# Never commit the real file. Every secret is fresh: none may match production's or staging's.

POSTGRES_USER=qrlog_hr
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=qrlog_hr

Jwt__SigningKey=              # openssl rand -base64 48
QrToken__Secret=              # openssl rand -base64 48

# The HR test company and its first admin, created once on first boot (idempotent by slug "hr").
# The admin is forced to replace the PIN at first login.
TenantSeed__Name="HR modulu (test)"
TenantSeed__AdminPhone=+994500000001
TenantSeed__AdminPin=         # 4 digits
