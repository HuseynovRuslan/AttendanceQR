<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests that need a REAL PostgreSQL: unique and partial indexes, foreign keys, transactions, the migrations
    themselves, and the whole HTTP pipeline (WebApplicationFactory). The unit-test project next door runs on the
    EF InMemory provider, which enforces none of those — see docs on PostgresFactAttribute for how these run
    locally (Docker) and in CI (required).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AttendanceQR.Api\AttendanceQR.Api.csproj" />
  </ItemGroup>

</Project>
